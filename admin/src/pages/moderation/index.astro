---
import Admin from '@/layouts/Admin.astro';
import { pooledDb } from '@db/pool';
import * as dbSchema from '@db/schema';
import { eq, desc, sql } from 'drizzle-orm';

export const prerender = false;

const db = pooledDb();

// 1. Critical/High severity open reports
const criticalReports = await db
  .select()
  .from(dbSchema.reports)
  .where(
    sql`${dbSchema.reports.status} = 'open' AND ${dbSchema.reports.severity} IN ('high', 'critical')`,
  )
  .orderBy(desc(dbSchema.reports.createdAt))
  .limit(10);

// 2. Open reports (general queue)
const openReports = await db
  .select()
  .from(dbSchema.reports)
  .where(eq(dbSchema.reports.status, 'open'))
  .orderBy(desc(dbSchema.reports.createdAt))
  .limit(10);

// 3. Recently restricted projects and builders
const restrictedProjects = await db
  .select({ name: dbSchema.projects.title, updatedAt: dbSchema.projects.updatedAt })
  .from(dbSchema.projects)
  .where(eq(dbSchema.projects.moderationState, 'restricted'))
  .orderBy(desc(dbSchema.projects.updatedAt))
  .limit(5);

const restrictedBuilders = await db
  .select({ name: dbSchema.builders.name, updatedAt: dbSchema.builders.updatedAt })
  .from(dbSchema.builders)
  .where(eq(dbSchema.builders.moderationState, 'restricted'))
  .orderBy(desc(dbSchema.builders.updatedAt))
  .limit(5);

function formatAge(date: Date) {
  const diff = Date.now() - date.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days === 0) return 'Today';
  if (days === 1) return 'Yesterday';
  return `${days}d ago`;
}

/** The two report tables. They differ only in these fields. */
const queues = [
  {
    title: 'Critical & High Priority',
    rows: criticalReports,
    column: 'severity',
    heading: 'Severity',
    empty: 'No critical reports open.',
    href: '/reports?severity=critical,high',
    label: ' critical and high priority reports',
  },
  {
    title: 'Recent Open Reports',
    rows: openReports,
    column: 'status',
    heading: 'Status',
    empty: 'Inbox zero.',
    href: '/reports',
    label: ' open reports',
  },
] as const;
---

<Admin title="Moderation Dashboard" active="/moderation">
  <div class="page-head">
    <h1>Moderation Queue</h1>
    <p class="hint">Review reports and manage restricted content.</p>
  </div>

  {
    queues.map((queue) => (
      <section class="panel">
        <h2>{queue.title}</h2>
        {queue.rows.length > 0 ? (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Entity</th>
                  <th scope="col">Reason</th>
                  <th scope="col">{queue.heading}</th>
                  <th scope="col">Age</th>
                  <th scope="col">
                    <span class="visually-hidden">Open</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {queue.rows.map((report) => (
                  <tr>
                    <td>{report.entityType}</td>
                    <td>{report.reason}</td>
                    <td>
                      <span
                        class="chip"
                        data-severity={queue.column === 'severity' ? report.severity : undefined}
                        data-status={queue.column === 'status' ? report.status : undefined}
                      >
                        {report[queue.column]}
                      </span>
                    </td>
                    <td class="age">{formatAge(report.createdAt)}</td>
                    <td>
                      <a class="btn" href={`/reports/${report.id}`}>
                        Open
                        <span class="visually-hidden"> {report.entityType} report</span>
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="hint">{queue.empty}</p>
        )}
        <p>
          <a href={queue.href}>
            View all<span class="visually-hidden">{queue.label}</span>
          </a>
        </p>
      </section>
    ))
  }

  <section class="panel">
    <h2>Recently Restricted Content</h2>
    {
      [
        { heading: 'Projects', rows: restrictedProjects },
        { heading: 'Builders', rows: restrictedBuilders },
      ].map((list) => (
        <>
          <h3>{list.heading}</h3>
          {list.rows.length > 0 ? (
            <ul class="timeline">
              {list.rows.map((row) => (
                <li>
                  <span>{row.name}</span>
                  <span class="num">{row.updatedAt ? formatAge(row.updatedAt) : '—'}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="hint">None</p>
          )}
        </>
      ))
    }
  </section>
</Admin>
