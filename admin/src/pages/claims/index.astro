---
/**
 * PROJECT CLAIMS — members asking to own an imported project.
 *
 * Approve only on evidence you checked (the repository is theirs, an organiser
 * confirms, a teammate vouches). A matching name or a credit on the page is
 * not proof. Approval needs a note saying how it was verified.
 */
import Admin from '@/layouts/Admin.astro';
import { pooledDb } from '@db/pool';
import * as dbSchema from '@db/schema';
import { desc, eq } from 'drizzle-orm';
import { canReview } from '@/server/session';

export const prerender = false;

// The claim endpoints accept admins and editors. Those are the only roles that can sign in today,
// so this only matters if another role is ever added.
const canDecide = canReview(Astro.locals.user?.role ?? '');

const db = pooledDb();
const pending = await db
  .select({
    id: dbSchema.projectClaims.id,
    evidence: dbSchema.projectClaims.evidence,
    createdAt: dbSchema.projectClaims.createdAt,
    projectTitle: dbSchema.projects.title,
    projectSlug: dbSchema.projects.slug,
    username: dbSchema.memberProfiles.username,
    displayName: dbSchema.memberProfiles.displayName,
  })
  .from(dbSchema.projectClaims)
  .innerJoin(dbSchema.projects, eq(dbSchema.projects.id, dbSchema.projectClaims.projectId))
  .leftJoin(
    dbSchema.memberProfiles,
    eq(dbSchema.memberProfiles.memberId, dbSchema.projectClaims.memberId),
  )
  .where(eq(dbSchema.projectClaims.status, 'pending'))
  .orderBy(desc(dbSchema.projectClaims.createdAt))
  .limit(100);
const note = Astro.url.searchParams.get('note');
const error = Astro.url.searchParams.get('error');
const publicSite = process.env.PUBLIC_SITE_URL ?? 'https://www.withclaude.in';
---

<Admin title="Project claims" active="/claims">
  <div class="page-head">
    <h1>Project claims ({pending.length})</h1>
    <p class="hint">
      Approving makes the member the owner and moves the project from Baserow to the website. It
      cannot be undone from here; a mistaken approval is corrected by moderation and a new owner
      assignment.
    </p>
  </div>

  {
    error && (
      <p class="notice notice-error" role="alert">
        {error}
      </p>
    )
  }
  {note && <p class="notice notice-info">{note}</p>}
  {pending.length === 0 && <p class="empty">No claims are waiting.</p>}
  {
    pending.map((c) => (
      <section class="panel">
        {/* Wrapped so the title keeps its case: a bare panel h2 is a mono label. */}
        <header>
          <h2>
            {/* prettier-ignore */}
            <a href={`${publicSite}/projects/${c.projectSlug}/`} rel="noopener">{c.projectTitle}</a>
            {` — claimed by ${c.displayName ?? c.username ?? 'a member'} (@${c.username ?? '?'})`}
          </h2>
        </header>
        <p style="white-space: pre-wrap">{c.evidence}</p>
        <p class="num">{c.createdAt.toISOString().slice(0, 16).replace('T', ' ')} UTC</p>
        {!canDecide && <p class="hint">Only an admin or editor can decide a claim.</p>}
        {canDecide && (
          <>
            <form method="post" action={`/api/claims/${c.id}/approve`} class="actions">
              <label class="visually-hidden" for={`approve-${c.id}`}>
                How you verified it
              </label>
              <input
                id={`approve-${c.id}`}
                name="note"
                required
                placeholder="How you verified it"
              />
              <button class="btn btn-solid" type="submit">
                Approve
              </button>
            </form>
            <form method="post" action={`/api/claims/${c.id}/reject`} class="actions">
              <label class="visually-hidden" for={`reject-${c.id}`}>
                Reason (optional)
              </label>
              <input id={`reject-${c.id}`} name="note" placeholder="Reason (optional)" />
              <button class="btn btn-danger" type="submit">
                Reject
              </button>
            </form>
          </>
        )}
      </section>
    ))
  }
</Admin>
