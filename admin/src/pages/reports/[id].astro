---
import Admin from '@/layouts/Admin.astro';
import { pooledDb } from '@db/pool';
import * as dbSchema from '@db/schema';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

const db = pooledDb();

const [report] = await db
  .select()
  .from(dbSchema.reports)
  .where(eq(dbSchema.reports.id, id));

if (!report) return Astro.redirect('/404');

// Fetch entity
let entity: any = null;
let contentStatus = 'unknown';
let moderationState = 'unknown';
let entityName = 'Unknown Entity';

if (report.entityType === 'project') {
  const [project] = await db.select().from(dbSchema.projects).where(eq(dbSchema.projects.id, report.entityId));
  if (project) {
    entity = project;
    contentStatus = project.publicationStatus;
    moderationState = project.moderationState;
    entityName = project.title;
  }
} else if (report.entityType === 'builder') {
  const [builder] = await db.select().from(dbSchema.builders).where(eq(dbSchema.builders.id, report.entityId));
  if (builder) {
    entity = builder;
    contentStatus = builder.status;
    moderationState = builder.moderationState;
    entityName = builder.name;
  }
} else if (report.entityType === 'media') {
  const [media] = await db.select().from(dbSchema.media).where(eq(dbSchema.media.id, report.entityId));
  if (media) {
    entity = media;
    contentStatus = media.status;
    entityName = `Media ${media.id.slice(0,8)}`;
  }
}

// Fetch audit history for this entity
const auditHistory = await db
  .select()
  .from(dbSchema.auditLog)
  .where(eq(dbSchema.auditLog.entityId, report.entityId))
  .orderBy(desc(dbSchema.auditLog.createdAt));

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(date);
}
---

<Admin title={`Report ${id.slice(0,8)}`} active="/reports">
  <div class="space-y-8">
    <header>
      <div class="flex items-center gap-2 text-sm text-neutral-500 mb-2">
        <a href="/reports" class="hover:text-black">Reports</a>
        <span>/</span>
        <span class="text-neutral-900 font-mono">{id.slice(0,8)}</span>
      </div>
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900">
          Report on {entityName}
        </h1>
        <div class="flex items-center gap-3">
          <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${
            report.status === 'open' ? 'bg-blue-100 text-blue-800' :
            report.status === 'resolved' ? 'bg-green-100 text-green-800' :
            'bg-neutral-100 text-neutral-800'
          }`}>
            {report.status.toUpperCase()}
          </span>
          <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold ${
            report.severity === 'critical' ? 'bg-red-100 text-red-800' :
            report.severity === 'high' ? 'bg-orange-100 text-orange-800' :
            report.severity === 'medium' ? 'bg-yellow-100 text-yellow-800' :
            'bg-neutral-100 text-neutral-800'
          }`}>
            {report.severity.toUpperCase()}
          </span>
        </div>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">
        <!-- Report Details -->
        <section class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <div class="px-5 py-4 border-b border-neutral-100 bg-neutral-50">
            <h2 class="font-semibold text-neutral-900">Report Details</h2>
          </div>
          <div class="p-5 space-y-4">
            <div>
              <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-1">Reason</h3>
              <p class="text-neutral-900">{report.reason}</p>
            </div>
            {report.details && (
              <div>
                <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-1">Additional Details</h3>
                <p class="text-neutral-900 whitespace-pre-wrap">{report.details}</p>
              </div>
            )}
            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-neutral-100">
              <div>
                <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-1">Submitted</h3>
                <p class="text-sm text-neutral-900">{formatDate(report.createdAt)}</p>
              </div>
              <div>
                <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-1">Reporter</h3>
                <p class="text-sm font-mono text-neutral-900">{report.reporterMemberId}</p>
              </div>
            </div>
          </div>
          <div class="px-5 py-3 border-t border-neutral-100 bg-neutral-50 flex gap-2">
            {report.status !== 'dismissed' && (
              <form method="POST" action={`/api/moderation/reports/${report.id}/dismiss`}>
                <button class="px-3 py-1.5 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded hover:bg-neutral-50">
                  Dismiss
                </button>
              </form>
            )}
            {report.status !== 'resolved' && (
              <form method="POST" action={`/api/moderation/reports/${report.id}/resolve`}>
                <button class="px-3 py-1.5 text-sm font-medium text-white bg-green-600 rounded hover:bg-green-700">
                  Mark Resolved
                </button>
              </form>
            )}
          </div>
        </section>

        <!-- Audit History -->
        <section>
          <h2 class="font-semibold text-neutral-900 mb-4">Entity Audit History</h2>
          <div class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
            {auditHistory.length > 0 ? (
              <ul class="divide-y divide-neutral-100">
                {auditHistory.map((audit) => (
                  <li class="px-5 py-3 hover:bg-neutral-50">
                    <div class="flex items-center justify-between">
                      <span class="text-sm font-semibold text-neutral-900">{audit.action}</span>
                      <span class="text-xs text-neutral-500">{formatDate(audit.createdAt)}</span>
                    </div>
                    {(audit.fromStatus || audit.toStatus) && (
                      <p class="text-sm text-neutral-600 mt-1">
                        State changed from <span class="font-mono bg-neutral-100 px-1 rounded">{audit.fromStatus || 'none'}</span> 
                        to <span class="font-mono bg-neutral-100 px-1 rounded">{audit.toStatus}</span>
                      </p>
                    )}
                    {audit.note && (
                      <p class="text-sm text-neutral-500 mt-1 italic">Note: {audit.note}</p>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <div class="p-5 text-center text-sm text-neutral-500 italic">No audit history found for this entity.</div>
            )}
          </div>
        </section>
      </div>

      <div class="space-y-8">
        <!-- Entity Actions -->
        <section class="bg-white border border-neutral-200 rounded-lg overflow-hidden">
          <div class="px-5 py-4 border-b border-neutral-100 bg-neutral-50">
            <h2 class="font-semibold text-neutral-900">Entity: {report.entityType}</h2>
          </div>
          <div class="p-5 space-y-4">
            <div class="flex justify-between items-center text-sm">
              <span class="text-neutral-500">Current Status</span>
              <span class="font-mono font-medium">{contentStatus}</span>
            </div>
            {report.entityType !== 'media' && (
              <div class="flex justify-between items-center text-sm">
                <span class="text-neutral-500">Moderation State</span>
                <span class={`font-mono font-medium px-2 py-0.5 rounded-sm ${
                  moderationState === 'restricted' || moderationState === 'removed' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800'
                }`}>
                  {moderationState}
                </span>
              </div>
            )}
          </div>
          
          <div class="px-5 py-4 border-t border-neutral-100 bg-neutral-50 space-y-3">
            <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Moderator Actions</h3>
            
            {moderationState !== 'restricted' && (
              <form method="POST" action={`/api/moderation/content/${report.entityType}/${report.entityId}/restrict`}>
                <button class="w-full text-left px-3 py-2 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded border border-red-200">
                  Restrict Public Access
                </button>
              </form>
            )}
            
            {(moderationState === 'restricted' || moderationState === 'removed') && (
              <form method="POST" action={`/api/moderation/content/${report.entityType}/${report.entityId}/restore`}>
                <button class="w-full text-left px-3 py-2 text-sm font-medium text-green-700 bg-green-50 hover:bg-green-100 rounded border border-green-200">
                  Restore Public Access
                </button>
              </form>
            )}

            <form method="POST" action={`/api/moderation/content/${report.entityType}/${report.entityId}/delete`}>
              <button class="w-full text-left px-3 py-2 text-sm font-medium text-red-900 bg-white hover:bg-red-50 rounded border border-neutral-200" onclick="return confirm('Soft delete this entity?')">
                Soft Delete Entity
              </button>
            </form>
          </div>
        </section>
      </div>
    </div>
  </div>
</Admin>
