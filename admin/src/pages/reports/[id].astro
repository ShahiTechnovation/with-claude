---
import Admin from '@/layouts/Admin.astro';
import { pooledDb } from '@db/pool';
import * as dbSchema from '@db/schema';
import { desc, eq, inArray } from 'drizzle-orm';
import { UUID } from '@/server/moderation';
import { isAdmin } from '@/server/session';

export const prerender = false;

const { id } = Astro.params;
if (!id || !UUID.test(id)) return new Response('No report with that id.', { status: 404 });

const db = pooledDb();

const [report] = await db.select().from(dbSchema.reports).where(eq(dbSchema.reports.id, id));

if (!report) return new Response('No report with that id.', { status: 404 });

// The reported row's status and name. Media keeps its state in `status`, so the
// chip row is hidden below.
let found = false;
let contentStatus = 'unknown';
let moderationState = 'unknown';
let entityName = 'Unknown Entity';

if (report.entityType === 'project') {
  const [project] = await db
    .select()
    .from(dbSchema.projects)
    .where(eq(dbSchema.projects.id, report.entityId));
  if (project) {
    found = true;
    contentStatus = project.publicationStatus;
    moderationState = project.moderationState;
    entityName = project.title;
  }
} else if (report.entityType === 'builder') {
  const [builder] = await db
    .select()
    .from(dbSchema.builders)
    .where(eq(dbSchema.builders.id, report.entityId));
  if (builder) {
    found = true;
    contentStatus = builder.status;
    moderationState = builder.moderationState;
    entityName = builder.name;
  }
} else if (report.entityType === 'media') {
  const [media] = await db
    .select()
    .from(dbSchema.media)
    .where(eq(dbSchema.media.id, report.entityId));
  if (media) {
    found = true;
    contentStatus = media.status;
    moderationState = media.status;
    entityName = `Media ${media.id.slice(0, 8)}`;
  }
}

// Audit history for the entity, plus the report's own actions, which are logged under the report id.
const auditHistory = await db
  .select()
  .from(dbSchema.auditLog)
  .where(inArray(dbSchema.auditLog.entityId, [report.entityId, report.id]))
  .orderBy(desc(dbSchema.auditLog.createdAt));

// The action endpoints accept admins only (an editor gets a 401), so only admins see the buttons.
const canAct = isAdmin(Astro.locals.user?.role ?? '');

// Taken down or held, so Restore applies and Restrict does not. `deleted` is media's.
const held = ['restricted', 'removed', 'archived', 'deleted'].includes(moderationState);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(date);
}
---

<Admin title={`Report ${id.slice(0, 8)}`} active="/reports">
  <div class="page-head">
    <h1>Report on {entityName}</h1>
    <p class="hint">
      <a href="/reports">Reports</a>
      <span> / </span>
      <code>{id.slice(0, 8)}</code>
      <span> · </span>
      <span class="chip" data-status={report.status}>{report.status}</span>
      <span class="chip" data-severity={report.severity}>{report.severity}</span>
    </p>
  </div>

  <section class="panel">
    <h2>Report Details</h2>
    <dl class="meta-grid">
      <dt>Reason</dt>
      <dd>{report.reason}</dd>
      {
        report.details && (
          <>
            <dt>Additional Details</dt>
            <dd style="white-space: pre-wrap">{report.details}</dd>
          </>
        )
      }
      <dt>Submitted</dt>
      <dd>{formatDate(report.createdAt)}</dd>
      <dt>Reporter</dt>
      <dd><code>{report.reporterMemberId}</code></dd>
    </dl>
    {!canAct && <p class="hint">Only an admin can act on a report or its content.</p>}
    {
      canAct && (
        <div class="actions">
          {report.status !== 'dismissed' && (
            <form method="POST" action={`/api/moderation/reports/${report.id}/dismiss`}>
              <button class="btn" type="submit">
                Dismiss
              </button>
            </form>
          )}
          {report.status !== 'resolved' && (
            <form method="POST" action={`/api/moderation/reports/${report.id}/resolve`}>
              <button class="btn btn-solid" type="submit">
                Mark Resolved
              </button>
            </form>
          )}
        </div>
      )
    }
  </section>

  <section class="panel">
    <h2>Entity: {report.entityType}</h2>
    {!found && <p class="hint">Entity not found.</p>}
    <dl class="meta-grid">
      <dt>Current Status</dt>
      <dd><code>{contentStatus}</code></dd>
      {
        report.entityType !== 'media' && (
          <>
            <dt>Moderation State</dt>
            <dd>
              <span
                class="chip"
                data-status={
                  moderationState === 'clean'
                    ? 'approved'
                    : moderationState === 'restricted' || moderationState === 'removed'
                      ? 'rejected'
                      : 'pending'
                }
              >
                {moderationState}
              </span>
            </dd>
          </>
        )
      }
    </dl>

    {
      canAct && found && (
        <>
          <h3>Moderator Actions</h3>
          <div class="actions">
            {!held && (
              <form
                method="POST"
                action={`/api/moderation/content/${report.entityType}/${report.entityId}/restrict`}
              >
                <button class="btn btn-danger" type="submit">
                  Restrict Public Access
                </button>
              </form>
            )}
            {held && (
              <form
                method="POST"
                action={`/api/moderation/content/${report.entityType}/${report.entityId}/restore`}
              >
                <button class="btn" type="submit">
                  Restore Public Access
                </button>
              </form>
            )}
            <form
              method="POST"
              action={`/api/moderation/content/${report.entityType}/${report.entityId}/delete`}
            >
              <button
                class="btn btn-danger"
                type="submit"
                onclick="return confirm('Soft delete this entity?')"
              >
                Soft Delete Entity
              </button>
            </form>
          </div>
        </>
      )
    }
  </section>

  <section class="panel">
    <h2>Audit History</h2>
    {
      auditHistory.length > 0 ? (
        <ol class="timeline">
          {auditHistory.map((audit) => (
            <li>
              <span class="num">{formatDate(audit.createdAt)}</span>
              <strong>{audit.action}</strong>
              {(audit.fromStatus || audit.toStatus) && (
                <span>
                  State changed from <code>{audit.fromStatus || 'none'}</code> to{' '}
                  <code>{audit.toStatus}</code>
                </span>
              )}
              {audit.note && <span class="hint">Note: {audit.note}</span>}
            </li>
          ))}
        </ol>
      ) : (
        <p class="hint">No audit history found for this report or its entity.</p>
      )
    }
  </section>
</Admin>
