---
import Admin from '@/layouts/Admin.astro';
import { pooledDb } from '@db/pool';
import * as dbSchema from '@db/schema';
import { and, desc, eq, inArray } from 'drizzle-orm';
import { reportFilters, reportsHref } from '@/server/moderation';

export const prerender = false;

const db = pooledDb();
const PAGE_SIZE = 50;

const pageParam = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isSafeInteger(pageParam) && pageParam >= 1 ? pageParam : 1;
const offset = (page - 1) * PAGE_SIZE;

const { status, severities } = reportFilters(Astro.url.searchParams);

const reports = await db
  .select()
  .from(dbSchema.reports)
  .where(
    and(
      status === 'all' ? undefined : eq(dbSchema.reports.status, status),
      severities.length ? inArray(dbSchema.reports.severity, severities) : undefined,
    ),
  )
  .orderBy(desc(dbSchema.reports.createdAt))
  .limit(PAGE_SIZE + 1)
  .offset(offset);

const hasNext = reports.length > PAGE_SIZE;
const rows = hasNext ? reports.slice(0, PAGE_SIZE) : reports;

const filters = [
  { key: 'open', label: 'Open' },
  { key: 'resolved', label: 'Resolved' },
  { key: 'all', label: 'All' },
] as const;

function formatAge(date: Date) {
  const diff = Date.now() - date.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days === 0) return 'Today';
  if (days === 1) return 'Yesterday';
  return `${days}d ago`;
}
---

<Admin title="Reports Queue" active="/reports">
  <div class="page-head">
    <h1>Reports Queue</h1>
    <p class="hint">Review and action community reports.</p>
  </div>

  <nav class="filters" aria-label="Filter by status">
    {
      filters.map((filter) => (
        <a
          href={reportsHref({ status: filter.key, severities })}
          aria-current={status === filter.key ? 'true' : undefined}
        >
          {filter.label}
        </a>
      ))
    }
  </nav>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">Entity</th>
          <th scope="col">Reason</th>
          <th scope="col">Severity</th>
          <th scope="col">Status</th>
          <th scope="col">Age</th>
          <th scope="col">
            <span class="visually-hidden">Open</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          rows.length > 0 ? (
            rows.map((report) => (
              <tr>
                <td>
                  {report.entityType} <span class="num">({report.entityId.slice(0, 8)}…)</span>
                </td>
                <td>{report.reason}</td>
                <td>
                  <span class="chip" data-severity={report.severity}>
                    {report.severity}
                  </span>
                </td>
                <td>
                  <span class="chip" data-status={report.status}>
                    {report.status}
                  </span>
                </td>
                <td class="age">{formatAge(report.createdAt)}</td>
                <td>
                  <a class="btn" href={`/reports/${report.id}`}>
                    Open
                    <span class="visually-hidden"> {report.entityType} report</span>
                  </a>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colspan="6" class="empty">
                No reports found matching these filters.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>

  {
    (page > 1 || hasNext) && (
      <nav class="pager" aria-label="Pages">
        {page > 1 ? (
          <a rel="prev" href={reportsHref({ status, severities }, page - 1)}>
            &larr; Previous
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
        <span class="pager-at">Page {page}</span>
        {hasNext ? (
          <a rel="next" href={reportsHref({ status, severities }, page + 1)}>
            Next &rarr;
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
      </nav>
    )
  }
</Admin>
