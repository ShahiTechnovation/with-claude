{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path((?!projects/|_astro/|_image|_server-islands/|api/reports/|favicon|apple-touch-icon|robots\\.txt|site\\.webmanifest|fonts/|_vercel/).+)",
      "has": [{ "type": "host", "value": "projects.withclaude.in" }],
      "destination": "https://www.withclaude.in/:path",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/events-sync",
      "schedule": "45 21 * * *"
    },
    {
      "path": "/api/cron/rebuild",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/baserow-reconcile",
      "schedule": "15 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
