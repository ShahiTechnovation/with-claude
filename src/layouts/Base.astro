---
import '@fontsource-variable/fraunces/wonk.css';
import '@fontsource-variable/fraunces/wonk-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@/styles/fonts.css';

import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/primitives.css';
import '@/styles/forms.css';

// Preload the faces that paint the first screen: the headline serif, the title sans and body
// text. Fraunces is only the wordmark, so it loads without a preload. Importing the file gives
// us the hashed build URL, so the preload can never point at a stale name.
import serifUrl from '@/assets/fonts/anthropic-serif-display-light.woff2?url';
import sansUrl from '@/assets/fonts/anthropic-sans-display-semibold.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Masthead from '@/components/Masthead.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site, socials } from '@/data';
import { breadcrumbSchema, safeJsonLd, websiteSchema } from '@/lib/seo';
import type { Crumb } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  /**
   * The exact `<title>`, when a page needs one the suffix convention cannot
   * express. Everything else keeps `Name · With Claude`.
   */
  seoTitle?: string;
  /** Rendered as a real trail AND emitted as `BreadcrumbList`, both from three crumbs. */
  breadcrumbs?: Crumb[];
  /** Route prefix for nav highlighting. */
  active?: string;
  /** Absolute or root-relative share image. */
  image?: string;
  /** Open Graph type, defaults to website. */
  ogType?: 'website' | 'article';
  /** Alt text for the Open Graph image. */
  ogImageAlt?: string;
  /** Extra JSON-LD nodes to merge into the graph. */
  schema?: Record<string, unknown>[];
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
}

const {
  title,
  description,
  seoTitle,
  breadcrumbs = [],
  active = '/',
  image = '/og-card.jpg',
  ogType = 'website',
  ogImageAlt,
  schema = [],
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
// Dark is the default on every public page. The member area is locked light: its editors
// and the sign-in gate are built for the cream ground, and the theme toggle is hidden there.
const lockLight = Astro.url.pathname.startsWith('/me/');

const fullTitle =
  seoTitle ?? (title === site.wordmark ? `${site.wordmark} · India` : `${title} · With Claude`);

/**
 * The organisation node.
 *
 * `disambiguatingDescription` carries the affiliation statement, so even a
 * machine reading the structured data is told what this is and is not. There
 * is deliberately no `parentOrganization`, `sponsor` or `memberOf` pointing at
 * Anthropic — asserting a relationship in JSON-LD is still asserting it.
 */
const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.wordmark,
  alternateName: 'With Claude India',
  url: `${site.url}/`,
  logo: `${site.url}/logo.png`,
  description: site.positioning,
  disambiguatingDescription: site.affiliation,
  areaServed: { '@type': 'Country', name: 'India' },
  sameAs: socials.map((s) => s.url),
};

// The site node carries the internal search endpoint, so it goes everywhere
// rather than only on the homepage — `/discover` answers `?q=` on every route.
const graph = [
  organization,
  websiteSchema(),
  ...(breadcrumbs.length > 2 ? [breadcrumbSchema(breadcrumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html
  lang="en-IN"
  data-theme={lockLight ? 'light' : 'dark'}
  data-theme-lock={lockLight ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" as="font" type="font/woff2" href={serifUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={lockLight ? '#FAF9F5' : '#0C0B0A'} />
    <!-- Before first paint: mark the document as scripted (`.js-only`, `.no-js-only`) and
         apply the visitor's saved theme. Only the masthead toggle writes `wc-theme`. A
         visitor whose storage is blocked gets the dark default. -->
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        if (d.hasAttribute('data-theme-lock')) return;
        try {
          var t = localStorage.getItem('wc-theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
        if (d.dataset.theme === 'light')
          document.querySelector('meta[name="theme-color"]').content = '#FAF9F5';
      })(document.documentElement);
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.wordmark} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt ?? fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Claude_In_" />
    <meta name="twitter:creator" content="@Claude_In_" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={safeJsonLd({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead active={active} />

    <main id="main">
      <Breadcrumbs crumbs={breadcrumbs} />
      <slot />
    </main>

    <SiteFooter />

    <script>
      import { inject } from '@vercel/analytics';

      inject();
    </script>
  </body>
</html>
