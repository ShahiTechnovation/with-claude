---
import '@fontsource-variable/fraunces/wonk.css';
import '@fontsource-variable/fraunces/wonk-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/primitives.css';

// Preload the two faces that paint the first screen. Importing the file gives
// us the hashed build URL, so the preload can never point at a stale name.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wonk-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Masthead from '@/components/Masthead.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data';
import { breadcrumbSchema, websiteSchema } from '@/lib/seo';
import type { Crumb } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  /**
   * The exact `<title>`, when a page needs one the suffix convention cannot
   * express. Everything else keeps `Name · With Claude`.
   */
  seoTitle?: string;
  /** Rendered as a real trail AND emitted as `BreadcrumbList`. */
  breadcrumbs?: Crumb[];
  /** Route prefix for nav highlighting. */
  active?: string;
  /** Absolute or root-relative share image. */
  image?: string;
  /** Extra JSON-LD nodes to merge into the graph. */
  schema?: Record<string, unknown>[];
  /** Set on pages that should not be indexed. */
  noindex?: boolean;
}

const {
  title,
  description,
  seoTitle,
  breadcrumbs = [],
  active = '/',
  image = '/og-card.jpg',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const fullTitle =
  seoTitle ?? (title === site.wordmark ? `${site.wordmark} · India` : `${title} · With Claude`);

/**
 * The organisation node.
 *
 * `disambiguatingDescription` carries the affiliation statement, so even a
 * machine reading the structured data is told what this is and is not. There
 * is deliberately no `parentOrganization`, `sponsor` or `memberOf` pointing at
 * Anthropic — asserting a relationship in JSON-LD is still asserting it.
 */
const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.wordmark,
  alternateName: 'With Claude India',
  url: site.url,
  description: site.positioning,
  disambiguatingDescription: site.affiliation,
  areaServed: { '@type': 'Country', name: 'India' },
};

// The site node carries the internal search endpoint, so it goes everywhere
// rather than only on the homepage — `/discover` answers `?q=` on every route.
const graph = [
  organization,
  websiteSchema(),
  ...(breadcrumbs.length > 1 ? [breadcrumbSchema(breadcrumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />

    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F3EFE7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.wordmark} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.wordmark} — ${site.manifesto}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />

    <!-- Marks the document as scripted before first paint, so the reveal
         system only ever displaces content it can also restore.

         The timer is the safety net. `html.js` is what lets the reveal system
         hide content, and the only thing that brings it back is the
         enhancement bundle booting. If that bundle ever fails to load, the
         page would sit there blank — so if nothing has claimed the document
         after a couple of seconds, we drop back to the unscripted branch and
         everything is simply visible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        var html = document.documentElement;
        if (!html.classList.contains('enhanced')) html.classList.remove('js');
      }, 2500);
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead active={active} />

    <div class="page">
      <span class="rail-anchor meridian-anchor" aria-hidden="true">
        <span class="meridian"></span>
      </span>
      <main id="main">
        <Breadcrumbs crumbs={breadcrumbs} />
        <slot />
      </main>
    </div>

    <SiteFooter />

    <script>
      import { inject } from '@vercel/analytics';
      import '@/scripts/enhance';

      inject();
    </script>
  </body>
</html>

<style>
  .page {
    position: relative;
  }

  .meridian-anchor {
    top: 0;
    bottom: 0;
  }
</style>
