---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';

export const prerender = false;

const guard = await guardPage(Astro);
if (guard.ok) privateHeaders(Astro);
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Settings" description="Manage your settings." active="/me" noindex>
    <main class="account-page">
      <h1>Settings</h1>

      <section class="account-section">
        <h2>Account</h2>
        <p class="summary">@{guard.profile.username}</p>
      </section>

      <section class="account-section">
        <h2>Profile</h2>
        <p class="summary">Visibility: <strong>{guard.profile.visibility}</strong></p>
        <div class="actions">
          <a href="/me/profile/edit/" class="btn-secondary">Edit profile</a>
        </div>
      </section>

      <section class="account-section">
        <h2>Authentication</h2>
        <p class="summary">Connected sign-in methods are managed securely by Privy.</p>
      </section>

      <section class="account-section danger-zone">
        <h2>Sign out</h2>
        <div class="actions">
          {/*
            Portaled by `PrivyRoot`'s `SignOutSlot`, the same way the
            masthead's account control and the sign-in CTA are placed on
            other pages — one `PrivyProvider`, several visual slots. This
            used to be its own separate `<SignOutButton client:only="react">`
            island with no provider ancestor, so `logout()` there threw
            every time and the button did nothing. See `PrivyRoot.tsx`.
          */}
          <div id="signout-slot-root" />
        </div>
      </section>
    </main>
  </Base>
)}

<style>
  .account-page {
    width: min(100% - 2rem, 42rem);
    margin: 4rem auto;
    font-family: var(--font-sans);
  }
  .account-page h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 3rem;
  }
  .account-section {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }
  .account-section:last-child {
    border-bottom: none;
  }
  .account-section h2 {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    margin-bottom: 1rem;
  }
  .summary {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
  }
  .danger-zone h2 {
    color: var(--clay, #b45309);
  }
  .account-page :global(.btn-secondary) {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: transparent;
    cursor: pointer;
    transition: all var(--dur-1) var(--ease-out);
  }
  .account-page :global(.btn-secondary:hover) {
    border-color: var(--ink);
    background: var(--shade-1);
  }
</style>
