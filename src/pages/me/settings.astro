---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';
import { isPlaceholderUsername } from '@/server/members/username';

export const prerender = false;

const guard = await guardPage(Astro);
if (guard.ok) privateHeaders(Astro);
/** A new member's `m-<hex>` shell handle is not a name to show. */
const hasUsername = guard.ok && !isPlaceholderUsername(guard.profile.username);
// The profile editor's words for the setting (ProfileEditor.tsx, Visibility).
const visibilityLabel = guard.ok && guard.profile.visibility === 'unlisted' ? 'Unlisted' : 'Listed';
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base title="Settings" description="Manage your settings." active="/me" noindex>
      <div class="account-shell account-shell--narrow account-page">
        <AccountNavTabs current="/me/settings/" />
        <header class="account-head">
          <h1>Settings</h1>
        </header>

        {hasUsername && (
          <section class="account-section">
            <h2>Account</h2>
            <p class="summary">@{guard.profile.username}</p>
          </section>
        )}

        <section class="account-section">
          <h2>Profile</h2>
          <p class="summary">
            Visibility: <strong>{visibilityLabel}</strong>
          </p>
          <div class="actions">
            <a href="/me/profile/edit/" class="btn-secondary">
              Edit profile
            </a>
          </div>
        </section>

        <section class="account-section">
          <h2>Authentication</h2>
          <p class="summary">Connected sign-in methods are managed securely by Privy.</p>
        </section>

        <section class="account-section danger-zone">
          <h2>Sign out</h2>
          <div class="actions">
            {/*
            Portaled by `PrivyRoot`'s `SignOutSlot`, the same way the
            masthead's account control and the sign-in CTA are placed on
            other pages — one `PrivyProvider`, several visual slots. This
            used to be its own separate `<SignOutButton client:only="react">`
            island with no provider ancestor, so `logout()` there threw
            every time and the button did nothing. See `PrivyRoot.tsx`.
          */}
            <div id="signout-slot-root" />
          </div>
        </section>
      </div>
    </Base>
  )
}

<style>
  .account-section {
    margin-bottom: var(--s-7);
    padding-bottom: var(--s-7);
    border-bottom: var(--border-hair) solid var(--rule);
  }
  .account-section:last-child {
    border-bottom: none;
  }
  .account-section h2 {
    font-family: var(--font-title);
    font-size: var(--t-title);
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--s-3);
  }
  .summary {
    font-size: var(--t-body);
    color: var(--ink-2);
    margin-bottom: var(--s-5);
  }
  .actions {
    display: flex;
    gap: var(--s-3);
  }
  .danger-zone h2 {
    color: var(--clay-deep);
  }
  /* Also styles the Sign out button PrivyRoot portals into #signout-slot-root. Matches `.button` in forms.css. */
  .account-page :global(.btn-secondary) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    font-family: var(--font-title);
    font-size: var(--t-ui);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    border: var(--border-hair) solid var(--ink);
    border-radius: var(--radius-xs);
    background: var(--paper);
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-out);
  }
  .account-page :global(.btn-secondary:hover) {
    background: var(--paper-sunk);
  }
</style>
