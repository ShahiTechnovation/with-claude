---
/**
 * /me — the account home.
 *
 * SSR, private, no client JavaScript. See `src/server/http/page-guard.ts`.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import { ownedBuilder } from '@/server/members/publish';
import { claimsFor } from '@/server/members/claims';
import { isPlaceholderUsername } from '@/server/members/username';
import { missingForPublish } from '@/server/members/publish';

export const prerender = false;

privateHeaders(Astro);

const guard = await guardPage(Astro);
if (!guard.ok) return guard.redirect;

const { member, profile, db } = guard;
const builder = await ownedBuilder(member, db);
const claims = await claimsFor(member.id, db);

const needsUsername = isPlaceholderUsername(profile.username);
const missing = missingForPublish(profile);
const displayName = profile.displayName?.trim() || (needsUsername ? 'your passport' : profile.username);
---

<Base title="Your account" description="Your WITH CLAUDE account." active="/me" noindex>
  <PageIntro eyebrow="Account" title={`Hello, ${displayName}.`} size="md">
    {
      needsUsername ? (
        <p>Your passport is not finished. Choose a username and you have a page of your own.</p>
      ) : builder ? (
        <p>
          Your public page is <a href={`/builders/${builder.slug}/`}>/builders/{builder.slug}</a>.
        </p>
      ) : (
        <p>Your passport is saved but not published yet.</p>
      )
    }
  </PageIntro>

  <Section id="passport" labelledby="passport-heading">
    <h2 id="passport-heading">Builder Passport</h2>

    {
      missing.length > 0 ? (
        <p class="me-missing">
          Still needed before you can publish: {missing.join(', ')}.
        </p>
      ) : profile.publishedAt ? (
        <p class="me-ok">Published. Edits go live when the site next rebuilds.</p>
      ) : (
        <p class="me-ok">Ready to publish.</p>
      )
    }

    <p class="me-actions">
      <a href="/me/profile/edit/">Edit passport</a>
      {profile.publishedAt && <a href="/me/profile/">View what is public</a>}
      <a href="/me/settings/">Settings</a>
    </p>
  </Section>

  {
    claims.length > 0 && (
      <Section id="claims" tone="sunk" labelledby="claims-heading">
        <h2 id="claims-heading">Profile claims</h2>
        <ul class="me-claims">
          {claims.map((claim) => (
            <li>
              <a href={`/builders/${claim.slug}/`}>{claim.name}</a>
              {' — '}
              <span class="me-claim-status">{claim.status}</span>
              {claim.status === 'pending' && (
                <span class="me-claim-note"> · a person will look at this</span>
              )}
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</Base>

<style>
  .me-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .me-missing {
    color: var(--ink-2, inherit);
  }
  .me-claims {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .me-claim-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
