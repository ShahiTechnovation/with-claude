---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';
import { getMemberProjects } from '@/server/members/projects';

export const prerender = false;

const guard = await guardPage(Astro);

let published = 0;
let drafts = 0;

if (guard.ok) {
  privateHeaders(Astro);
  const allProjects = await getMemberProjects(guard.member.id, guard.db);
  published = allProjects.filter((p: any) => p.publicationStatus === 'published').length;
  drafts = allProjects.filter((p: any) => p.publicationStatus === 'draft').length;
}
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Your Account" description="Your WITH CLAUDE account." active="/me" noindex>
    <main class="account-page">
      <h1>Your account</h1>

      <section class="account-section">
        <h2>Your profile</h2>
        <p class="summary">
          <strong>{guard.profile.displayName ?? 'Not added'}</strong> &middot; @{guard.profile.username} &middot; {guard.profile.primaryRole ?? 'Role not added'}
        </p>
        <div class="actions">
          <a href="/me/profile/" class="btn-secondary">View profile</a>
          <a href="/me/profile/edit/" class="btn-secondary">Edit profile</a>
        </div>
      </section>

      <section class="account-section">
        <h2>Your projects</h2>
        <p class="summary">
          {published} published &middot; {drafts} drafts
        </p>
        <div class="actions">
          <a href="/me/projects/" class="btn-secondary">View projects</a>
          <a href="/me/projects/new/" class="btn-secondary">Add a project</a>
        </div>
      </section>

      <section class="account-section">
        <h2>Settings</h2>
        <div class="actions">
          <a href="/me/settings/" class="btn-secondary">Settings</a>
        </div>
      </section>
    </main>
  </Base>
)}

<style>
  .account-page {
    width: min(100% - 2rem, 42rem);
    margin: 4rem auto;
    font-family: var(--font-sans);
  }
  .account-page h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 3rem;
  }
  .account-section {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }
  .account-section:last-child {
    border-bottom: none;
  }
  .account-section h2 {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    margin-bottom: 1rem;
  }
  .summary {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    transition: all var(--dur-1) var(--ease-out);
  }
  .btn-secondary:hover {
    border-color: var(--ink);
    background: var(--shade-1);
  }
</style>
