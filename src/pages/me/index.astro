---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';
import { getMemberProjects } from '@/server/members/projects';
import { getBuilderSlug, citySlugFor } from '@/server/members/profile';

export const prerender = false;

const guard = await guardPage(Astro);

let published = 0;
let drafts = 0;
let builderSlug: string | null = null;
let cityName = '';

if (guard.ok) {
  privateHeaders(Astro);
  const allProjects = await getMemberProjects(guard.member.id, guard.db);
  published = allProjects.filter((p: any) => p.publicationStatus === 'published').length;
  drafts = allProjects.filter((p: any) => p.publicationStatus === 'draft').length;
  builderSlug = await getBuilderSlug(guard.member.id, guard.db);
  if (guard.profile.cityId) {
    cityName = await citySlugFor(guard.profile.cityId, guard.db);
  }
}

const initials = guard.ok
  ? (guard.profile.displayName ?? guard.profile.username ?? '?')
      .split(' ')
      .slice(0, 2)
      .map((w: string) => w[0]?.toUpperCase() ?? '')
      .join('')
  : '';

const isPublished = guard.ok && Boolean(guard.profile.publishedAt);
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Your account" description="Your WITH CLAUDE account." active="/me" noindex>
    <main class="hub">

      {/* ── Identity Header ──────────────────────────────────────────── */}
      <header class="hub-header">
        <div class="hub-avatar" aria-hidden="true">{initials}</div>
        <div class="hub-identity">
          <h1 class="hub-name">{guard.profile.displayName ?? guard.profile.username}</h1>
          <p class="hub-handle">@{guard.profile.username}</p>
          {guard.profile.headline && <p class="hub-headline">{guard.profile.headline}</p>}
          <p class="hub-meta">
            {guard.profile.primaryRole && <span>{guard.profile.primaryRole}</span>}
            {guard.profile.primaryRole && cityName && <span class="hub-sep">·</span>}
            {cityName && <span>{cityName}</span>}
          </p>
        </div>
        <div class="hub-status">
          <span class={`hub-badge ${isPublished ? 'hub-badge--live' : 'hub-badge--draft'}`}>
            {isPublished ? 'Published' : 'Draft'}
          </span>
        </div>
      </header>

      {/* ── Primary Actions ──────────────────────────────────────────── */}
      <div class="hub-actions">
        <a href="/me/profile/edit/" class="hub-btn hub-btn--primary">Edit profile</a>
        {isPublished && builderSlug ? (
          <a href={`/builders/${builderSlug}/`} class="hub-btn hub-btn--secondary" target="_blank" rel="noopener">
            View public profile
          </a>
        ) : (
          <a href="/me/profile/" class="hub-btn hub-btn--secondary">
            {isPublished ? 'View profile' : 'Publish profile'}
          </a>
        )}
      </div>

      {/* ── Stats ────────────────────────────────────────────────────── */}
      <div class="hub-stats">
        <div class="hub-stat">
          <span class="hub-stat-n">{published}</span>
          <span class="hub-stat-label">Published projects</span>
        </div>
        <div class="hub-stat">
          <span class="hub-stat-n">{drafts}</span>
          <span class="hub-stat-label">Drafts</span>
        </div>
      </div>

      {/* ── Sections ─────────────────────────────────────────────────── */}
      <nav class="hub-nav">
        <a href="/me/profile/" class="hub-nav-item">
          <span class="hub-nav-label">Builder Passport</span>
          <span class="hub-nav-desc">Your public profile and publication status</span>
        </a>
        <a href="/me/projects/" class="hub-nav-item">
          <span class="hub-nav-label">Projects</span>
          <span class="hub-nav-desc">{published} published · {drafts} drafts</span>
        </a>
        <a href="/me/projects/new/" class="hub-nav-item hub-nav-item--cta">
          <span class="hub-nav-label">Add a project</span>
          <span class="hub-nav-desc">Publish something you built with Claude</span>
        </a>
      </nav>

    </main>
  </Base>
)}

<style>
  .hub {
    width: min(100% - 2rem, 38rem);
    margin: 4rem auto 6rem;
    font-family: var(--font-sans);
  }

  /* ── Header ── */
  .hub-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.25rem;
    align-items: start;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 2rem;
  }

  .hub-avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--clay-deep, #92400e);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .hub-identity {
    min-width: 0;
  }

  .hub-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.15;
    margin-bottom: 0.15rem;
  }

  .hub-handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    margin-bottom: 0.5rem;
    letter-spacing: 0.03em;
  }

  .hub-headline {
    font-size: 0.9rem;
    color: var(--ink-2);
    margin-bottom: 0.4rem;
  }

  .hub-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
  }

  .hub-sep { color: var(--rule-strong); }

  .hub-status {
    flex-shrink: 0;
  }

  .hub-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    border: 1px solid currentColor;
  }

  .hub-badge--live { color: #166534; border-color: #bbf7d0; background: #f0fdf4; }
  .hub-badge--draft { color: var(--ink-3); border-color: var(--rule); background: var(--paper-sunk, #fafaf9); }

  /* ── Actions ── */
  .hub-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hub-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.15s;
  }

  .hub-btn--primary {
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
  }
  .hub-btn--primary:hover {
    background: var(--clay-deep, #92400e);
    border-color: var(--clay-deep, #92400e);
  }

  .hub-btn--secondary {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
  }
  .hub-btn--secondary:hover {
    border-color: var(--ink);
    background: var(--shade-1, #f9fafb);
  }

  /* ── Stats ── */
  .hub-stats {
    display: flex;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }

  .hub-stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .hub-stat-n {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink);
  }

  .hub-stat-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── Nav ── */
  .hub-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hub-nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: padding-left 0.15s;
  }

  .hub-nav-item:hover {
    padding-left: 0.5rem;
  }

  .hub-nav-item--cta .hub-nav-label {
    color: var(--clay-deep, #92400e);
  }

  .hub-nav-label {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .hub-nav-desc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }

  @media (max-width: 37.99em) {
    .hub-header {
      grid-template-columns: auto 1fr;
    }
    .hub-status {
      grid-column: 1 / -1;
    }
  }
</style>
