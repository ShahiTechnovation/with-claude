---
/**
 * THE ACCOUNT DASHBOARD. Server-authorised; plain HTML, works without JS.
 *
 * Says, in one place: is my profile public (and how), what is stopping it,
 * what state each of my projects is in, and what I can do next. Every link is
 * a real page; nothing here is a placeholder for a feature that does not exist.
 */
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';
import { getMemberProjects } from '@/server/members/projects';
import { getBuilderSlug } from '@/server/members/profile';
import { missingForPublish } from '@/server/members/publish';

export const prerender = false;

const guard = await guardPage(Astro);
const projects = guard.ok ? await getMemberProjects(guard.member.id, guard.db) : [];
const builderSlug = guard.ok ? await getBuilderSlug(guard.member.id, guard.db) : null;
if (guard.ok) privateHeaders(Astro);

const profile = guard.ok ? guard.profile : null;
const published = Boolean(profile?.publishedAt && builderSlug);
const blockers = profile ? missingForPublish(profile) : [];
const count = (status: string) => projects.filter((p) => p.publicationStatus === status).length;
const recent = projects.slice(0, 5);
const STATUS: Record<string, string> = {
  published: 'Published',
  draft: 'Draft',
  archived: 'Archived',
};
const ROLE: Record<string, string> = {
  owner: 'Owner',
  collaborator: 'Collaborator',
  contributor: 'Credited',
};
const name = profile?.displayName?.trim() || 'there';
const unlisted = profile?.visibility === 'unlisted';
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base title="Your account" description="Your WITH CLAUDE account." active="/me" noindex>
      <div class="account-shell">
        <AccountNavTabs current="/me/" />
        <header class="account-head">
          <h1>Hello, {name}.</h1>
          <p>Your profile and projects, and what each one needs next.</p>
        </header>

        <div class="dash">
          <section class="panel" aria-labelledby="profile-heading">
            <div class="panel-head">
              <h2 id="profile-heading">Your profile</h2>
              <span class={`status-badge status-badge--${published ? 'published' : 'draft'}`}>
                {published ? (unlisted ? 'Live · unlisted' : 'Live · listed') : 'Not public yet'}
              </span>
            </div>
            {published ? (
              <p class="panel-hint">
                Live at <a href={`/builders/${builderSlug}/`}>{`/builders/${builderSlug}/`}</a>.{' '}
                {unlisted
                  ? 'Unlisted: reachable by the link, not listed or indexed.'
                  : 'Listed in the builders directory.'}
              </p>
            ) : blockers.length > 0 ? (
              <div class="notice notice--info">
                To publish, your profile still needs {blockers.join(', ')}.
              </div>
            ) : (
              <p class="panel-hint">Everything needed is filled in. Publish when you are ready.</p>
            )}
            <div class="form-actions">
              <a class="button button--primary" href="/me/profile/edit/">
                {published ? 'Edit profile' : 'Complete your profile'}
              </a>
              {published && (
                <a class="button" href={`/builders/${builderSlug}/`}>
                  View public profile
                </a>
              )}
            </div>
          </section>

          <section class="panel" aria-labelledby="projects-heading">
            <div class="panel-head">
              <h2 id="projects-heading">Your projects</h2>
              <span class="panel-hint">
                {`${count('published')} published · ${count('draft')} drafts · ${count('archived')} archived`}
              </span>
            </div>
            {recent.length === 0 ? (
              <p class="panel-hint">
                Nothing yet. A project needs only a name to start; you can publish once it is
                complete.
              </p>
            ) : (
              <ul class="dash-list">
                {recent.map((p) => (
                  <li>
                    <a href={`/me/projects/${p.id}/edit/`}>{p.title}</a>
                    <span class={`status-badge status-badge--${p.publicationStatus}`}>
                      {STATUS[p.publicationStatus] ?? p.publicationStatus}
                    </span>
                    <span class="dash-role">{ROLE[p.role]}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="form-actions">
              <a class="button button--primary" href="/me/projects/new/">
                Add a project
              </a>
              {projects.length > 5 && (
                <a class="button" href="/me/projects/">
                  {`All ${projects.length} projects`}
                </a>
              )}
            </div>
          </section>

          <section class="panel" aria-labelledby="account-heading">
            <div class="panel-head">
              <h2 id="account-heading">Account</h2>
            </div>
            <p class="panel-hint">Signing out and account details are on the settings page.</p>
            <div class="form-actions">
              <a class="button" href="/me/settings/">
                Settings
              </a>
            </div>
          </section>
        </div>
      </div>
    </Base>
  )
}

<style>
  .dash {
    display: grid;
    gap: var(--s-5);
  }

  .dash .panel + .panel {
    margin-top: 0;
  }

  .dash-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    padding-block: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .dash-list a {
    margin-right: auto;
    font-weight: 600;
    color: var(--ink);
  }

  .dash-role {
    font-size: var(--t-small);
    color: var(--ink-3);
  }
</style>
