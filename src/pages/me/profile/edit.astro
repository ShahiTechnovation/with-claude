---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';
import ProfileEditor from '@/components/react/ProfileEditor';

export const prerender = false;

const guard = await guardPage(Astro);
if (guard.ok) privateHeaders(Astro);
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Edit Profile" description="Edit your profile." active="/me" noindex>
    <main class="account-page">
      <h1>Edit Profile</h1>
      <ProfileEditor profile={guard.profile} client:only="react" />
    </main>
  </Base>
)}

<style>
  .account-page {
    width: min(100% - 2rem, 42rem);
    margin: 4rem auto;
    font-family: var(--font-sans);
  }
  .account-page h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 3rem;
  }
  
  /* These global styles apply to the React ProfileEditor */
  .account-page :global(.account-editor) {
    margin-top: 2rem;
  }
  .account-page :global(.editor-grid) {
    display: grid;
    gap: 1.5rem;
  }
  .account-page :global(label) {
    display: block;
  }
  .account-page :global(label span) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    margin-bottom: 0.5rem;
  }
  .account-page :global(input),
  .account-page :global(textarea),
  .account-page :global(select) {
    width: 100%;
    padding: 0.75rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
  }
  .account-page :global(input:focus),
  .account-page :global(textarea:focus),
  .account-page :global(select:focus) {
    outline: none;
    border-color: var(--ink);
  }
  .account-page :global(.editor-actions) {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .account-page :global(.btn-primary) {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    color: var(--paper);
    background: var(--ink);
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-out);
  }
  .account-page :global(.btn-primary:hover:not(:disabled)) {
    background: var(--clay-deep, #92400e);
  }
  .account-page :global(.btn-primary:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .account-page :global(.editor-message) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .account-page :global(.editor-message.success) {
    color: var(--clay, #b45309);
  }
  .account-page :global(.editor-message.error) {
    color: red;
  }
</style>
