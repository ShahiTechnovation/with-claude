---
/**
 * EDIT YOUR PROFILE. Server-authorised; the editor itself is rendered by
 * `PrivyRoot` beneath the one provider — see `AccountIsland.astro`.
 */
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountIsland from '@/components/AccountIsland.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';
import { avatarUrlFor, citySlugFor, getBuilderSlug } from '@/server/members/profile';

export const prerender = false;

const guard = await guardPage(Astro);
let props: Record<string, unknown> = {};

if (guard.ok) {
  privateHeaders(Astro);
  /**
   * `ProfileRow` carries `cityId`; the editor works in slugs. Resolving it
   * here is what stops a save from silently clearing a member's city.
   */
  const [citySlug, builderSlug, avatarUrl] = await Promise.all([
    citySlugFor(guard.profile.cityId, guard.db),
    getBuilderSlug(guard.member.id, guard.db),
    avatarUrlFor(guard.member.id, guard.profile.avatarMediaId, guard.db),
  ]);
  props = {
    profile: {
      username: guard.profile.username,
      displayName: guard.profile.displayName,
      citySlug,
      primaryRole: guard.profile.primaryRole,
      headline: guard.profile.headline,
      bio: guard.profile.bio,
      claudeSince: guard.profile.claudeSince,
      website: guard.profile.website,
      visibility: guard.profile.visibility,
      publishedAt: guard.profile.publishedAt?.toISOString() ?? null,
      builderSlug,
      avatarMediaId: avatarUrl ? guard.profile.avatarMediaId : null,
      avatarUrl,
    },
    uploadPrefix: `avatars/${guard.member.id}/`,
  };
}
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base title="Edit profile" description="Edit your Builder Passport." active="/me" noindex>
      <div class="account-shell account-shell--narrow">
        <AccountNavTabs current="/me/profile/" />
        <header class="account-head">
          <h1>Edit your profile</h1>
          <p>Save a draft at any time. Publishing puts it on your public builder page.</p>
        </header>
        <AccountIsland name="profile-editor" props={props} />
      </div>
    </Base>
  )
}
