---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';
import { citySlugFor, getBuilderSlug } from '@/server/members/profile';

export const prerender = false;

const guard = await guardPage(Astro);
let builderSlug: string | null = null;
let cityName = '';

if (guard.ok) {
  privateHeaders(Astro);
  builderSlug = await getBuilderSlug(guard.member.id, guard.db);
  if (guard.profile.cityId) {
    cityName = await citySlugFor(guard.profile.cityId, guard.db);
  }
}

const isPublished = guard.ok && Boolean(guard.profile.publishedAt);

/** Missing publish-required fields for the profile. */
const missingFields = guard.ok
  ? ([
      !guard.profile.displayName && 'Name',
      !guard.profile.cityId && 'City',
      !guard.profile.primaryRole && 'Role',
    ].filter(Boolean) as string[])
  : [];
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base title="Your Builder Passport" description="View your profile." active="/me" noindex>
      <div class="account-shell account-shell--narrow pp">
        <AccountNavTabs current="/me/profile/" />

        {/* ── Passport header ──────────────────────────────────────────── */}
        <header class="pp-header">
          <div class="pp-head-top">
            <div>
              <h1 class="pp-name">{guard.profile.displayName ?? guard.profile.username}</h1>
              <p class="pp-handle">@{guard.profile.username}</p>
            </div>
            <span class={`status-badge status-badge--${isPublished ? 'published' : 'draft'}`}>
              {isPublished ? 'Published' : 'Draft'}
            </span>
          </div>

          {guard.profile.headline && <p class="pp-headline">{guard.profile.headline}</p>}

          {!isPublished && missingFields.length > 0 && (
            <div class="notice notice--info pp-missing">
              <p>Missing before publishing:</p>
              <ul>
                {missingFields.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </div>
          )}
        </header>

        {/* ── Fields ───────────────────────────────────────────────────── */}
        <dl class="pp-fields">
          <div class="pp-field">
            <dt>City</dt>
            <dd>{cityName || <span class="pp-empty">Not added</span>}</dd>
          </div>
          <div class="pp-field">
            <dt>Role</dt>
            <dd>{guard.profile.primaryRole || <span class="pp-empty">Not added</span>}</dd>
          </div>
          {guard.profile.bio && (
            <div class="pp-field pp-field--wide">
              <dt>Bio</dt>
              <dd>{guard.profile.bio}</dd>
            </div>
          )}
          {guard.profile.claudeSince && (
            <div class="pp-field">
              <dt>Claude tools</dt>
              <dd>{guard.profile.claudeSince}</dd>
            </div>
          )}
          <div class="pp-field">
            <dt>Visibility</dt>
            <dd>{guard.profile.visibility}</dd>
          </div>
          {guard.profile.website && (
            <div class="pp-field">
              <dt>Website</dt>
              <dd>
                <a href={guard.profile.website} target="_blank" rel="noopener noreferrer">
                  {guard.profile.website.replace(/^https?:\/\//, '')}
                </a>
              </dd>
            </div>
          )}
        </dl>

        {/* ── Actions ──────────────────────────────────────────────────── */}
        <div class="pp-actions">
          <a href="/me/profile/edit/" class="button button--primary">
            {isPublished ? 'Edit profile' : 'Complete & publish'}
          </a>
          {isPublished && builderSlug && (
            <a href={`/builders/${builderSlug}/`} class="button" target="_blank" rel="noopener">
              View public profile →
            </a>
          )}
          <a href="/me/" class="button button--quiet pp-back">
            ← Back to account
          </a>
        </div>
      </div>
    </Base>
  )
}

<style>
  /* ── Header ── */
  .pp-header {
    margin-bottom: var(--s-6);
  }

  .pp-head-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .pp-name {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: var(--lh-heading);
    letter-spacing: var(--track-display);
    overflow-wrap: anywhere;
  }

  .pp-handle {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .status-badge {
    flex-shrink: 0;
    margin-top: var(--s-3);
  }

  .pp-headline {
    margin-top: var(--s-4);
    max-width: 60ch;
    color: var(--ink-2);
  }

  .pp-missing {
    margin-top: var(--s-5);
  }

  /* ── Fields ── */
  .pp-fields {
    margin-bottom: var(--s-7);
    border-top: var(--border-hair) solid var(--rule);
  }

  .pp-field {
    display: grid;
    grid-template-columns: minmax(0, 30%) minmax(0, 1fr);
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .pp-field--wide {
    grid-template-columns: minmax(0, 1fr);
  }

  .pp-field dt {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .pp-field dd {
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .pp-field dd a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pp-empty {
    color: var(--ink-3);
    font-style: italic;
  }

  /* ── Actions ── */
  .pp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .pp-back {
    margin-left: auto;
  }
</style>
