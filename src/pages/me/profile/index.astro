---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';
import { citySlugFor, getBuilderSlug } from '@/server/members/profile';

export const prerender = false;

const guard = await guardPage(Astro);
let builderSlug: string | null = null;
let citySlug: string = '';

if (guard.ok) {
  privateHeaders(Astro);
  builderSlug = await getBuilderSlug(guard.member.id, guard.db);
  if (guard.profile.cityId) {
    citySlug = await citySlugFor(guard.profile.cityId, guard.db);
  }
}
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Your Builder Passport" description="View your profile." active="/me" noindex>
    <main class="account-page">
      <h1>Your Builder Passport</h1>

      <dl class="profile-list">
        <div class="list-item">
          <dt>Name</dt>
          <dd><strong>{guard.profile.displayName ?? 'Not added'}</strong> &middot; @{guard.profile.username}</dd>
        </div>
        <div class="list-item">
          <dt>Headline</dt>
          <dd>{guard.profile.headline ?? 'Not added'}</dd>
        </div>
        <div class="list-item">
          <dt>City</dt>
          <dd>{citySlug || 'Not added'}</dd>
        </div>
        <div class="list-item">
          <dt>Role</dt>
          <dd>{guard.profile.primaryRole ?? 'Not added'}</dd>
        </div>
        <div class="list-item">
          <dt>Bio</dt>
          <dd>{guard.profile.bio ?? 'Not added'}</dd>
        </div>
        <div class="list-item">
          <dt>Claude tools</dt>
          <dd>{guard.profile.claudeSince ?? 'Not added'}</dd>
        </div>
        <div class="list-item">
          <dt>Links</dt>
          <dd>{guard.profile.website ? <a href={guard.profile.website}>Website</a> : 'Not added'}</dd>
        </div>
        <div class="list-item">
          <dt>Visibility</dt>
          <dd>{guard.profile.visibility}</dd>
        </div>
      </dl>

      <div class="actions">
        <a href="/me/profile/edit/" class="btn-secondary">Edit profile</a>
        {builderSlug && (
           <a href={`/builders/${builderSlug}/`} class="btn-secondary">View public profile</a>
        )}
      </div>
    </main>
  </Base>
)}

<style>
  .account-page {
    width: min(100% - 2rem, 42rem);
    margin: 4rem auto;
    font-family: var(--font-sans);
  }
  .account-page h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 3rem;
  }
  .profile-list {
    margin-bottom: 3rem;
    border-top: 1px solid var(--rule);
  }
  .list-item {
    display: flex;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .list-item dt {
    width: 25%;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .list-item dd {
    width: 75%;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .list-item dd a {
    color: var(--ink);
    text-decoration: underline;
  }
  .actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    transition: all var(--dur-1) var(--ease-out);
  }
  .btn-secondary:hover {
    border-color: var(--ink);
    background: var(--shade-1);
  }
</style>
