---
/**
 * EDIT A PROJECT. The server resolves the caller's role first; the editor only
 * offers what that role allows, and every API route enforces it again.
 */
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountIsland from '@/components/AccountIsland.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';
import { getMemberProject } from '@/server/members/projects';

export const prerender = false;

const { id } = Astro.params;
const guard = await guardPage(Astro);
const project = guard.ok && id ? await getMemberProject(guard.member.id, id, guard.db) : null;

if (guard.ok) {
  privateHeaders(Astro);
  if (!project) Astro.response.status = 404;
}

const initialData = project
  ? {
      id: project.id,
      slug: project.slug,
      title: project.title,
      summary: project.summary,
      description: project.description,
      claudeUsage: project.claudeUsage,
      cityId: project.cityId,
      category: project.category,
      url: project.url,
      repoUrl: project.repoUrl,
      videoUrl: project.videoUrl,
      tags: project.tags,
      // A cover is shown only when it is a media reference; a legacy URL in
      // `image_path` is not something the editor can vouch for.
      coverMediaId: project.imageId,
      coverUrl: project.imageId ? project.imagePath : null,
      publicationStatus: project.publicationStatus,
      moderationState: project.moderationState,
      role: project.role,
      contentAuthority: project.contentAuthority,
    }
  : null;
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base
      title={project ? `Edit ${project.title}` : 'Project not found'}
      description="Edit your project."
      active="/me"
      noindex
    >
      <div class="account-shell account-shell--narrow">
        <AccountNavTabs current="/me/projects/" />
        {project && initialData ? (
          <>
            <header class="account-head">
              <h1>{project.role === 'contributor' ? project.title : `Edit ${project.title}`}</h1>
              <p>
                {project.role === 'owner'
                  ? 'You own this project.'
                  : project.role === 'collaborator'
                    ? 'You are a collaborator: you can edit it; the owner publishes and archives.'
                    : 'You are credited on this project.'}
              </p>
            </header>
            <AccountIsland name="project-editor" props={{ initialData }} />
          </>
        ) : (
          <div class="panel">
            <header class="account-head">
              <h1>Project not found</h1>
              <p>This project does not exist, or it is not one of yours.</p>
            </header>
            <a class="button" href="/me/projects/">
              Back to your projects
            </a>
          </div>
        )}
      </div>
    </Base>
  )
}
