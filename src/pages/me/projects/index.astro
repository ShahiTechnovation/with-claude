---
/** EVERY PROJECT YOU OWN, COLLABORATE ON OR ARE CREDITED ON — by state. */
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';
import { getMemberProjects } from '@/server/members/projects';

export const prerender = false;

const guard = await guardPage(Astro);
const projects = guard.ok ? await getMemberProjects(guard.member.id, guard.db) : [];
if (guard.ok) privateHeaders(Astro);

const groups = [
  { status: 'draft', title: 'Drafts', note: 'Only you and your collaborators can see these.' },
  { status: 'published', title: 'Published', note: 'On the projects archive now.' },
  {
    status: 'archived',
    title: 'Archived',
    note: 'Off the website. Restore one to bring it back as a draft.',
  },
]
  .map((g) => ({ ...g, items: projects.filter((p) => p.publicationStatus === g.status) }))
  .filter((g) => g.items.length > 0);
const ROLE: Record<string, string> = {
  owner: 'Owner',
  collaborator: 'Collaborator',
  contributor: 'Credited',
};
const held = (state: string) => ['restricted', 'removed', 'archived'].includes(state);
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base title="Your projects" description="Your projects." active="/me" noindex>
      <div class="account-shell">
        <AccountNavTabs current="/me/projects/" />
        <header class="account-head">
          <h1>Your projects</h1>
          <p>
            <a class="button button--primary" href="/me/projects/new/">
              Add a project
            </a>
          </p>
        </header>

        {projects.length === 0 ? (
          <div class="panel">
            <p class="panel-hint">
              You have no projects yet. Start one with just a name, then publish it when it is
              complete.
            </p>
          </div>
        ) : (
          groups.map((g) => (
            <section class="panel" aria-labelledby={`g-${g.status}`}>
              <div class="panel-head">
                <h2 id={`g-${g.status}`}>{`${g.title} (${g.items.length})`}</h2>
                <span class="panel-hint">{g.note}</span>
              </div>
              <ul class="plist">
                {g.items.map((p) => (
                  <li>
                    <div class="plist-main">
                      <a href={`/me/projects/${p.id}/edit/`}>{p.title}</a>
                      {p.summary && <span class="plist-summary">{p.summary}</span>}
                    </div>
                    <span class="plist-role">{ROLE[p.role]}</span>
                    {held(p.moderationState) && (
                      <span class="status-badge status-badge--held">Held by moderators</span>
                    )}
                    {p.publicationStatus === 'published' && !held(p.moderationState) && (
                      <a class="plist-public" href={`/projects/${p.slug}/`}>
                        Public page
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
        )}
      </div>
    </Base>
  )
}

<style>
  .plist li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    padding-block: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .plist-main {
    display: grid;
    flex: 1 1 16rem;
    min-width: 0;
  }

  .plist-main a {
    font-weight: 600;
    color: var(--ink);
  }

  .plist-summary {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .plist-role,
  .plist-public {
    font-size: var(--t-small);
    color: var(--ink-3);
  }
</style>
