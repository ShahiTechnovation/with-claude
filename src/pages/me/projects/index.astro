---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';
import { getMemberProjects } from '@/server/members/projects';

export const prerender = false;

const guard = await guardPage(Astro);
let allProjects: any[] = [];

if (guard.ok) {
  privateHeaders(Astro);
  allProjects = await getMemberProjects(guard.member.id, guard.db);
}

const list = (status: string) => allProjects.filter((p) => p.publicationStatus === status);
const statuses = ['published', 'draft', 'archived'] as const;
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Your Projects" description="Manage your projects." active="/me" noindex>
    <main class="account-page">
      <div class="page-header">
        <h1>Your Projects</h1>
        <a href="/me/projects/new/" class="btn-primary">Add a project</a>
      </div>

      {statuses.map((status) => {
        const items = list(status);
        return (
          <section class="account-section">
            <h2>{status === 'draft' ? 'Drafts' : status[0].toUpperCase() + status.slice(1)}</h2>
            {items.length > 0 ? (
              <ul class="project-list">
                {items.map(project => (
                  <li class="project-item">
                    <div class="project-info">
                      <strong>{project.title}</strong>
                      <span class="summary">{project.summary ?? 'No short description'}</span>
                    </div>
                    <div class="project-meta">
                      <span class="status-badge">{project.publicationStatus}</span>
                      <a href={`/me/projects/${project.id}/edit/`} class="btn-secondary">
                        {status === 'draft' ? 'Continue draft' : 'Edit'}
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty-state">No {status} projects.</p>
            )}
          </section>
        );
      })}
    </main>
  </Base>
)}

<style>
  .account-page {
    width: min(100% - 2rem, 42rem);
    margin: 4rem auto;
    font-family: var(--font-sans);
  }
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
  }
  .account-page h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
  }
  .account-section {
    margin-bottom: 3rem;
  }
  .account-section h2 {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
  }
  .project-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .project-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px dashed var(--rule);
  }
  .project-item:last-child {
    border-bottom: none;
  }
  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .project-info strong {
    font-size: 1.1rem;
  }
  .summary {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .project-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    background: var(--wash);
    border-radius: 2px;
  }
  .empty-state {
    color: var(--ink-2);
    font-style: italic;
    padding: 1rem 0;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    color: var(--paper);
    background: var(--ink);
    border: none;
    border-radius: 2px;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease-out);
  }
  .btn-primary:hover {
    background: var(--clay-deep, #92400e);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 2px;
    transition: all var(--dur-1) var(--ease-out);
  }
  .btn-secondary:hover {
    border-color: var(--ink);
    background: var(--shade-1);
  }
</style>
