---
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import Base from '@/layouts/Base.astro';
import ProjectEditor from '@/components/react/ProjectEditor';

export const prerender = false;

const guard = await guardPage(Astro);
if (guard.ok) privateHeaders(Astro);
---

{!guard.ok ? (
  <Base title="Sign in" description="Sign in to continue" noindex>
    <AuthRequired reason={guard.reason} />
  </Base>
) : (
  <Base title="Add a project" description="Create a project." active="/me" noindex>
    <main class="account-page">
      <h1>Add a project</h1>
      {guard.profile.cityId ? (
        <ProjectEditor initialData={{ cityId: guard.profile.cityId }} client:only="react" />
      ) : (
        <p class="empty-state">
          Add your city in <a href="/me/profile/edit/">your profile</a> first before publishing a project.
        </p>
      )}
    </main>
  </Base>
)}

<style>
  .account-page {
    width: min(100% - 2rem, 42rem);
    margin: 4rem auto;
    font-family: var(--font-sans);
  }
  .account-page h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 3rem;
  }
  .empty-state {
    font-size: 1.1rem;
    color: var(--ink-2);
  }
  .empty-state a {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
