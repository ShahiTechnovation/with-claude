---
/** START A PROJECT. A name is enough to save a draft; publishing asks for the rest. */
import { guardPage, privateHeaders } from '@/server/http/page-guard';
import AuthRequired from '@/components/AuthRequired.astro';
import AccountIsland from '@/components/AccountIsland.astro';
import AccountNavTabs from '@/components/AccountNavTabs.astro';
import Base from '@/layouts/Base.astro';

export const prerender = false;

const guard = await guardPage(Astro);
if (guard.ok) privateHeaders(Astro);
---

{
  !guard.ok ? (
    <Base title="Sign in" description="Sign in to continue" noindex>
      <AuthRequired reason={guard.reason} />
    </Base>
  ) : (
    <Base title="Add a project" description="Create a project." active="/me" noindex>
      <div class="account-shell account-shell--narrow">
        <AccountNavTabs current="/me/projects/" />
        <header class="account-head">
          <h1>Add a project</h1>
          <p>
            Start with a name and save a draft — nothing is public until you publish. To publish, a
            project needs a tagline, a description, how Claude was used, a category and a city.
          </p>
        </header>
        <AccountIsland
          name="project-editor"
          props={{ initialData: { cityId: guard.profile.cityId ?? '', role: 'owner', contentAuthority: 'member' } }}
        />
      </div>
    </Base>
  )
}
