---
/**
 * THE HOMEPAGE, rendered from live records.
 *
 * The hero and the room, then five sections: the next event, the cities, what
 * was made, the photographs and the way to bring a room to another city. Every
 * section reads one request-local `RecordSelectors`, loaded through the same
 * public predicates as the directory pages, and the CDN keeps it for the
 * bounded `publicCache` window.
 */
export const prerender = false;

import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Hero from '@/components/Hero.astro';
import EventFeature from '@/components/EventFeature.astro';
import CitiesBand from '@/components/home/CitiesBand.astro';
import MadeWith from '@/components/home/MadeWith.astro';
import PhotoStrip from '@/components/home/PhotoStrip.astro';
import JoinBand from '@/components/home/JoinBand.astro';
import { site } from '@/data';
import { RecordSelectors } from '@/data/selectors';
import { formatDate, isoDateTime } from '@/lib/datetime';
import { asset } from '@/lib/images';
import { lifecycleOf } from '@/lib/status';
import { titles } from '@/lib/seo';
import { loadLiveRecords } from '@/server/directory';
import { privateCache, publicCache } from '@/server/http/cache';
import { logReadFailure, type ReadFailure } from '@/server/public/read-failure';

/**
 * A failed read is a 503 with an honest message — never a raw 500, and never
 * cached (the next request should try again). See `read-failure.ts`.
 */
let failure: ReadFailure | null = null;
let selectors: RecordSelectors | undefined;
try {
  selectors = new RecordSelectors(await loadLiveRecords());
  publicCache(Astro);
} catch (error) {
  failure = logReadFailure('home', error);
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
  privateCache(Astro);
}
const devHint = import.meta.env.DEV && failure === 'schema-behind';

const now = new Date();
const next = selectors?.nextEvent(now);

// The room under the hero: the lead photo of the held event with the most
// projects (a stable sort keeps the newest first on a tie). The strip skips it.
const room = (selectors?.photoRecordByEvent() ?? [])
  .map(({ event, plates }) => ({
    photo: plates.find((p) => asset(p.src)),
    projects: selectors!.projectsFromEvent(event.slug).length,
  }))
  .filter((r) => r.photo)
  .sort((a, b) => b.projects - a.projects)[0]?.photo;

// The meta description follows the record rather than being rewritten by hand.
const description =
  selectors && next
    ? `${site.positioning} Next: ${next.title} in ${selectors.cityName(next.citySlug)}, ${formatDate(next.date)}.`
    : site.positioning;

/**
 * Structured data for every event still ahead of us.
 *
 * Only real, scheduled events are published here. Nothing on this site emits
 * structured data for an event, a chapter or an organisation that does not
 * exist in the record. A venue shared only with registrants is named by its
 * city, never by the venue the record keeps privately.
 */
const eventSchema = (selectors?.upcomingEvents(now) ?? []).map((event) => ({
  '@type': 'Event',
  name: `${event.title} · ${selectors!.cityName(event.citySlug)}`,
  description: event.description ?? event.summary,
  url: `${site.url}/events/${event.slug}/`,
  startDate: isoDateTime(event.date, event.startTime),
  ...(event.endTime ? { endDate: isoDateTime(event.date, event.endTime) } : {}),
  eventStatus:
    lifecycleOf(event, now) === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: event.free,
  location: {
    '@type': 'Place',
    name: event.venue.private ? selectors!.cityName(event.citySlug) : event.venue.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: selectors!.cityName(event.citySlug),
      addressCountry: 'IN',
    },
  },
  ...(event.registrationUrl
    ? {
        offers: {
          '@type': 'Offer',
          price: event.free ? '0' : undefined,
          priceCurrency: 'INR',
          url: event.registrationUrl,
          availability:
            lifecycleOf(event, now) === 'sold-out'
              ? 'https://schema.org/SoldOut'
              : 'https://schema.org/InStock',
        },
      }
    : {}),
  organizer: { '@id': `${site.url}/#organization` },
}));
---

<Base
  title={site.wordmark}
  seoTitle={titles.home()}
  description={description}
  active="/"
  schema={eventSchema}
>
  {
    !selectors ? (
      <Section id="unavailable" labelledby="unavailable-heading" class="type-home">
        <div class="section-head" role="alert">
          <h1 id="unavailable-heading">This page could not be loaded</h1>
          <p class="prose">Something went wrong on our side. Please try again in a moment.</p>
          {devHint && (
            <p class="prose">
              <strong>Development:</strong> the database behind <code>DATABASE_URL</code> is missing
              migrations this code needs. Run <code>npm run db:migrate</code> against it, or point
              the dev server at a migrated database.
            </p>
          )}
        </div>
        <a class="btn" href="/">
          <span>Try again</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </Section>
    ) : (
      <>
        <Hero selectors={selectors} room={room} />

        <Section id="next" labelledby="next-heading" class="type-home">
          <EventFeature event={next} selectors={selectors} headingId="next-heading" />
        </Section>

        <Section id="cities" tone="sunk" labelledby="cities-heading" class="type-home">
          <CitiesBand selectors={selectors} />
        </Section>

        <Section id="projects" labelledby="projects-heading" class="type-home">
          <MadeWith selectors={selectors} />
        </Section>

        <Section id="photos" tone="sunk" labelledby="photos-heading" bleed class="type-home">
          <PhotoStrip selectors={selectors} skip={room?.src} />
        </Section>

        <Section id="join" labelledby="join-heading" bleed class="join-band type-home">
          <JoinBand />
        </Section>
      </>
    )
  }
</Base>
