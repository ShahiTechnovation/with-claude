---
/**
 * THE HOMEPAGE — server-rendered from live data, five sections.
 *
 * It used to be a prerendered page of twelve competing sections, several of
 * which fell back to the build-time snapshot, so it could disagree with the
 * live directory pages it linked to (a project published this morning was on
 * /projects/ and missing here until the next deploy). Now everything comes
 * from `homeData()`, a handful of bounded queries, and the page says:
 *
 *   1. what this is            — and the two things to do next
 *   2. what you can join       — up to three upcoming events, or the latest
 *   3. what people made        — six eligible projects
 *   4. who is building         — real builders, and where
 *   5. how to take part        — one call to action
 *
 * The long-form pieces that used to live here moved to their own pages
 * (/about, /community, /cities, /practice, /stories); nothing was deleted.
 */
export const prerender = false;

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import EventCard from '@/components/EventCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { site } from '@/data';
import { formatDate, isoDateTime } from '@/lib/datetime';
import { asset, requireAsset } from '@/lib/images';
import { lifecycleOf } from '@/lib/status';
import { titles } from '@/lib/seo';
import { homeData } from '@/server/public/pages';
import { asLifecycleEvent } from '@/server/public/events';
import { publicCache } from '@/server/http/cache';

const now = new Date();
const { upcoming, latest, projects, builders, counts } = await homeData(now);
publicCache(Astro);

const next = upcoming[0];
const description = next
  ? `${site.positioning} Next: ${next.title} in ${next.city.name}, ${formatDate(next.date)}.`
  : site.positioning;

/** Structured data for real, scheduled events only — from the same rows rendered below. */
const eventSchema = upcoming.map((event) => ({
  '@type': 'Event',
  name: `${event.title} · ${event.city.name}`,
  description: event.summary,
  url: `${site.url}/events/${event.slug}/`,
  startDate: isoDateTime(event.date, event.startTime),
  ...(event.endTime ? { endDate: isoDateTime(event.date, event.endTime) } : {}),
  eventStatus:
    lifecycleOf(asLifecycleEvent(event), now) === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: event.free,
  location: {
    '@type': 'Place',
    name: event.venuePrivate ? event.city.name : event.venueName,
    address: { '@type': 'PostalAddress', addressLocality: event.city.name, addressCountry: 'IN' },
  },
  ...(event.registrationUrl
    ? { offers: { '@type': 'Offer', price: event.free ? '0' : undefined, priceCurrency: 'INR', url: event.registrationUrl } }
    : {}),
  organizer: { '@id': `${site.url}/#organization` },
}));

const proof = requireAsset('events/vol06-3.jpg');

/** Uploaded portraits are absolute URLs; curated ones are asset keys. */
const builderCards = builders.map((builder) => {
  const remote = builder.image && builder.image.startsWith('https://') ? builder.image : undefined;
  return { ...builder, remote, portrait: builder.image && !remote ? asset(builder.image) : undefined };
});
---

<Base title={site.wordmark} seoTitle={titles.home()} description={description} active="/" schema={eventSchema}>
  <!-- 1 — WHAT THIS IS -->
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container-wide home-hero-inner">
      <div class="home-hero-copy">
        <p class="eyebrow">WITH CLAUDE · India</p>
        <h1 id="home-title" class="home-title">
          <span class="visually-hidden">{`${site.wordmark}. `}</span>India is <em>building</em>.
        </h1>
        <p class="home-lede">
          {site.descriptor} Find the projects people have made, the events where they made them, and
          the builders behind them.
        </p>
        <div class="home-actions">
          <a class="btn btn-solid" href="/projects/">
            <span>Explore projects</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href="/events/">
            <span>Find an event</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <figure class="home-hero-plate">
        <div class="plate plate-mounted">
          <Image
            src={proof}
            alt="Around sixty participants among the desks at the Claude Code Workshop in Bhopal"
            widths={[360, 560, 760]}
            sizes="(max-width: 61.99em) 92vw, 440px"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="plate-caption">
          <span>Claude Code Workshop · Bhopal</span>
          <span>Aug 2026</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2 — WHAT YOU CAN JOIN -->
  <Section id="events" tone="sunk" labelledby="events-heading">
    <div class="section-row">
      <div class="section-head">
        <p class="eyebrow">Events</p>
        <h2 id="events-heading">{upcoming.length > 0 ? 'Coming up' : 'The latest room'}</h2>
      </div>
      <a class="link-arrow" href="/events/">
        <span>All events</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    {
      upcoming.length > 0 ? (
        <div class="event-grid">
          {upcoming.map((event) => (
            <EventCard event={event} now={now} />
          ))}
        </div>
      ) : latest ? (
        <div class="event-grid event-grid--single">
          <EventCard event={latest} now={now} />
          <p class="quiet-note">
            Nothing is scheduled right now. New events are announced on the events page as soon as they
            are confirmed.
          </p>
        </div>
      ) : (
        <p class="quiet-note">No events are on the record yet.</p>
      )
    }
  </Section>

  <!-- 3 — WHAT PEOPLE MADE -->
  <Section id="projects" labelledby="projects-heading">
    <div class="section-row">
      <div class="section-head">
        <p class="eyebrow">Projects</p>
        <h2 id="projects-heading">Built with Claude</h2>
      </div>
      <a class="link-arrow" href="/projects/">
        <span>{counts.projects > 0 ? `All ${counts.projects} projects` : 'The archive'}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    {
      projects.length > 0 ? (
        <ul class="project-grid" role="list">
          {projects.map((project) => (
            <li>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="quiet-note">
          No projects are published yet. <a href="/me/projects/new/">Add the first one.</a>
        </p>
      )
    }
  </Section>

  <!-- 4 — WHO IS BUILDING -->
  <Section id="community" tone="sunk" labelledby="community-heading">
    <div class="section-row">
      <div class="section-head">
        <p class="eyebrow">Community</p>
        <h2 id="community-heading">The people building</h2>
      </div>
      <a class="link-arrow" href="/builders/">
        <span>All builders</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <dl class="counts">
      <div><dt>Builders</dt><dd>{counts.builders}</dd></div>
      <div><dt>Projects</dt><dd>{counts.projects}</dd></div>
      <div><dt>Events held</dt><dd>{counts.events}</dd></div>
      <div><dt>Cities with events</dt><dd>{counts.cities}</dd></div>
    </dl>
    {
      builderCards.length > 0 && (
        <ul class="builder-strip" role="list">
          {builderCards.map((builder) => (
            <li>
              <a class="builder-chip" href={`/builders/${builder.slug}/`}>
                <span class="builder-face" aria-hidden="true">
                  {builder.remote ? (
                    <img src={builder.remote} alt="" width="56" height="56" loading="lazy" decoding="async" />
                  ) : builder.portrait ? (
                    <Image src={builder.portrait} alt="" widths={[112]} sizes="56px" loading="lazy" decoding="async" />
                  ) : (
                    <span>{builder.name.slice(0, 1)}</span>
                  )}
                </span>
                <span class="builder-text">
                  <span class="builder-name">{builder.name}</span>
                  <span class="builder-meta">{`${builder.role} · ${builder.city.name}`}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="quiet-note">
      Building with Claude somewhere in India? <a href="/cities/">See every city</a> on the map.
    </p>
  </Section>

  <!-- 5 — TAKE PART -->
  <Section id="join" labelledby="join-heading">
    <div class="join">
      <h2 id="join-heading">Made something with Claude?</h2>
      <p>
        Put it in the archive with who built it and how Claude was actually used. It takes a few
        minutes, and you can save a draft first.
      </p>
      <div class="home-actions">
        <a class="btn btn-clay" href="/me/projects/new/">
          <span>Add your project</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="link-arrow" href="/me/profile/edit/">
          <span>Or create your builder profile</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .home-hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .home-hero-inner {
    display: grid;
    gap: var(--s-8);
    align-items: center;
  }

  .home-title {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: 600;
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
  }

  .home-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--clay-deep);
  }

  .home-lede {
    margin-top: var(--s-5);
    max-width: 52ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }

  .home-hero-plate {
    max-width: 30rem;
  }

  .home-hero-plate .plate {
    aspect-ratio: 4 / 3;
  }

  .section-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--s-5);
  }

  .event-grid--single {
    grid-template-columns: minmax(0, 36rem);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: var(--s-8) var(--s-6);
  }

  .quiet-note {
    margin-top: var(--s-5);
    max-width: 60ch;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--s-4);
    margin-bottom: var(--s-6);
    padding-block: var(--s-4);
    border-block: var(--border-hair) solid var(--rule-strong);
  }

  .counts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .counts dd {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 600;
    line-height: 1.1;
  }

  .builder-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--s-3);
  }

  .builder-chip {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 4.5rem;
    padding: var(--s-3);
    color: var(--ink);
    text-decoration: none;
    background: var(--paper-raised);
    border: var(--border-hair) solid var(--rule);
  }

  .builder-chip:hover,
  .builder-chip:focus-visible {
    border-color: var(--ink);
  }

  .builder-face {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 50%;
    background: var(--clay-tint);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--clay-deep);
  }

  .builder-face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .builder-text {
    display: grid;
    min-width: 0;
  }

  .builder-name {
    font-weight: 600;
  }

  .builder-meta {
    overflow: hidden;
    font-size: var(--t-micro);
    color: var(--ink-3);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .join {
    display: grid;
    gap: var(--s-4);
    max-width: 46rem;
  }

  .join h2 {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 600;
    line-height: var(--lh-heading);
  }

  .join p {
    color: var(--ink-2);
    font-size: var(--t-lead);
  }

  @media (min-width: 62em) {
    .home-hero-inner {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: var(--s-10);
    }
  }
</style>
