---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Hero from '@/components/Hero.astro';
import CommunitySignal from '@/components/CommunitySignal.astro';
import NextEvent from '@/components/NextEvent.astro';
import CityAtlas from '@/components/CityAtlas.astro';
import BuilderIndex from '@/components/BuilderIndex.astro';
import ProjectArchive from '@/components/ProjectArchive.astro';
import StoryStrip from '@/components/StoryStrip.astro';
import EventArchive from '@/components/EventArchive.astro';
import CityIndex from '@/components/CityIndex.astro';
import Participation from '@/components/Participation.astro';
import Manifesto from '@/components/Manifesto.astro';
import { cityName, nationalSignal, nextEvent, site, upcomingEvents } from '@/data';
import { formatDate, isoDateTime } from '@/lib/datetime';
import { lifecycleOf } from '@/lib/status';
import { inWordsCap } from '@/lib/words';

const next = nextEvent();
const signal = nationalSignal();

// The meta description follows the record rather than being rewritten by hand.
const description = next
  ? `${site.positioning} Next: ${next.title} in ${cityName(next.citySlug)}, ${formatDate(next.date)}.`
  : site.positioning;

/**
 * Structured data for every event still ahead of us.
 *
 * Only real, scheduled events are published here. Nothing on this site emits
 * structured data for an event, a chapter or an organisation that does not
 * exist in the record.
 */
const eventSchema = upcomingEvents().map((event) => ({
  '@type': 'Event',
  name: `${event.title} · ${cityName(event.citySlug)}`,
  description: event.description ?? event.summary,
  url: `${site.url}/events/${event.slug}`,
  startDate: isoDateTime(event.date, event.startTime),
  ...(event.endTime ? { endDate: isoDateTime(event.date, event.endTime) } : {}),
  eventStatus:
    lifecycleOf(event) === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: event.free,
  location: {
    '@type': 'Place',
    name: event.venue.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: cityName(event.citySlug),
      addressCountry: 'IN',
    },
  },
  ...(event.registrationUrl
    ? {
        offers: {
          '@type': 'Offer',
          price: event.free ? '0' : undefined,
          priceCurrency: 'INR',
          url: event.registrationUrl,
          availability:
            lifecycleOf(event) === 'sold-out'
              ? 'https://schema.org/SoldOut'
              : 'https://schema.org/InStock',
        },
      }
    : {}),
  organizer: { '@id': `${site.url}/#organization` },
}));
---

<Base title={site.wordmark} description={description} active="/" schema={eventSchema}>
  <!-- 01 — THE COVER ---------------------------------------------------- -->
  <Hero />

  <!-- 02 — THE SIGNAL ---------------------------------------------------- -->
  <Section id="signal" tone="sunk" size="sm" labelledby="signal-heading">
    <CommunitySignal />
  </Section>

  <!-- 03 — NEXT EVENT ---------------------------------------------------- -->
  <Section id="next" labelledby="next-heading">
    <NextEvent />
  </Section>

  <!-- 04 — DISCOVER INDIA. The page's first dark movement. ---------------- -->
  <Section id="atlas" tone="night" size="lg" labelledby="atlas-heading">
    <div class="atlas-head">
      <div class="section-head">
        <p class="eyebrow">Discover</p>
        <h2 id="atlas-heading">
          {`${inWordsCap(signal.citiesPlotted)} cities, plotted.`}
        </h2>
        <p class="prose">
          Every point sits at its true latitude and longitude. What the plate shows is community
          state — where a verified Ambassador is hosting, where events have happened, where people
          have registered interest, and where the map is simply a map.
        </p>
      </div>
    </div>
    <CityAtlas />
  </Section>

  <!-- 05 — WHO'S BUILDING ------------------------------------------------- -->
  <Section id="builders" labelledby="builders-heading">
    <BuilderIndex limit={6} />
  </Section>

  <!-- 06 — MADE WITH CLAUDE. The deepest ground on the page. -------------- -->
  <Section id="projects" tone="deep" size="lg" labelledby="projects-heading">
    <ProjectArchive />
  </Section>

  <!-- 07 — FROM THE COMMUNITY (full bleed) -------------------------------- -->
  <Section id="stories" size="lg" bleed labelledby="stories-heading">
    <StoryStrip />
  </Section>

  <!-- 08 — EVENTS ACROSS INDIA -------------------------------------------- -->
  <Section id="events" tone="sunk" labelledby="events-heading">
    <EventArchive limit={6} />
  </Section>

  <!-- 09 — FIND YOUR CITY -------------------------------------------------- -->
  <Section id="cities" labelledby="cities-heading">
    <CityIndex compact />
  </Section>

  <!-- 10 — WAYS IN --------------------------------------------------------- -->
  <Section id="join" tone="raised" labelledby="join-heading">
    <Participation />
  </Section>

  <!-- 11 — THE CLOSE -------------------------------------------------------- -->
  <Section id="record" tone="night" size="lg" labelledby="manifesto-heading">
    <Manifesto />
  </Section>
</Base>

<style>
  .atlas-head {
    margin-bottom: var(--s-8);
    max-width: 64ch;
  }
</style>
