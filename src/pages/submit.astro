---
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import Section from '@/components/Section.astro';
---

<Base
  title="Publish a Project"
  description="Contribute a project to WITH CLAUDE."
>
  <PageIntro eyebrow="Contribute" title="Publish a Project" size="md">
    <p>
      Share what you are building with the community. Projects are tied to your Builder Passport, 
      giving you full control over what you share and how it's presented.
    </p>
  </PageIntro>

  <Section id="auth" labelledby="auth-heading" tone="sunk">
    <h2 id="auth-heading" class="sr-only">Sign In</h2>
    <div class="auth-panel">
      <p>
        Sign in to your Builder Passport to create and publish projects instantly.
      </p>
      <div class="auth-action">
        <!-- PrivyRoot (mounted once, sitewide) portals its login button here. -->
        <div id="join-cta-root" data-next="/me/projects/new">
          <p class="signin-status js-hydrate-hide">Checking…</p>
        </div>
      </div>
    </div>
  </Section>
</Base>

<script>
  // Soft redirect if they have an active privy session cookie
  if (document.cookie.includes('privy-token=')) {
    window.location.href = '/me/projects/new';
  }
</script>

<style>
  .auth-panel {
    max-width: 32rem;
    padding: var(--s-6);
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .auth-panel p {
    margin-bottom: var(--s-5);
    color: var(--ink-2);
  }
  .auth-action {
    display: flex;
  }
</style>
