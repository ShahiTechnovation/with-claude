---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import Timeline from '@/components/Timeline.astro';
import { titles, trail } from '@/lib/seo';

/**
 * THE RECORD.
 *
 * Community memory as a single page. It is the site's slowest-compounding
 * asset and the one hardest for anybody else to copy: an events page can be
 * rebuilt in a weekend, but three years of what actually happened, in order,
 * cannot.
 *
 * Nothing on this page is authored. Every line is generated from a record
 * that carries a real date, which is why there is no editorial voice here at
 * all — the record speaks or it does not.
 */
const crumbs = trail({ name: 'The record', href: '/record' });

const description =
  'Everything that has happened in the Claude community in India, by month — events held, events scheduled, people who joined the index, and what has been published.';
---

<Base
  title="The record"
  seoTitle={titles.record()}
  description={description}
  active="/record"
  breadcrumbs={crumbs}
>
  <PageIntro title="Everything, in order." size="lg">
    <p>A filled mark has happened; an open one is still ahead.</p>
  </PageIntro>

  <Section id="timeline" tone="sunk" labelledby="timeline-heading">
    <h2 class="visually-hidden" id="timeline-heading">The timeline</h2>
    <Timeline />
  </Section>
</Base>
