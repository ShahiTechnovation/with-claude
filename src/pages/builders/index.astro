---
import { titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import BuilderIndex from '@/components/BuilderIndex.astro';
import SubmitPanel from '@/components/SubmitPanel.astro';
import StoryStrip from '@/components/StoryStrip.astro';
import { site } from '@/data';
import { getPublicBuilderList, loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';

/**
 * LIVE BUILDERS LISTING.
 *
 * `prerender = false` makes this an SSR route: it queries the database at
 * request time, so a member who just published their Builder Passport appears
 * here immediately — without a Git push, without a rebuild.
 *
 * The individual profile page `/builders/[slug]` has always been SSR for the
 * same reason. This page now matches it.
 *
 * Cache-Control: `s-maxage=60` lets Vercel's CDN cache for up to one minute,
 * so the database is not queried on every single request during a burst, but a
 * newly published builder is visible within 60 seconds at most.
 */
export const prerender = false;

const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

const liveBuilders = selectors.publicBuilders;

// Cache at the CDN for up to 60 s; stale responses may be served for up to
// 24 h while a fresh fetch runs in the background. A newly published builder
// therefore appears on the CDN within one minute without a rebuild.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=86400',
);
---

<Base
  title="Builders"
  seoTitle={titles.builders()}
  description="The people building with Claude in India. An open index — anyone building can add themselves."
  active="/builders"
  breadcrumbs={trail({ name: 'Builders', href: '/builders' })}
>
  <PageIntro
    eyebrow="Builders"
    title="Claude Builders in India"
    stamp={`${String(liveBuilders.length).padStart(2, '0')} on the index`}
    facts={[
      { label: 'On the index', value: String(liveBuilders.length).padStart(2, '0') },
      { label: 'Ambassadors', value: String(selectors.publicAmbassadors.length).padStart(2, '0') },
      {
        label: 'Cities',
        value: String(new Set(liveBuilders.map((b) => b.citySlug)).size).padStart(2, '0'),
      },
    ]}
  >
    <p><strong>Who’s building.</strong></p>
    <p>
      Profiles of the people building with Claude in India. An open index where anyone can add themselves; entries are reviewed before they appear, and being listed is not a role or an appointment.
    </p>
    <p class="intro-note">{site.ambassadorNote}</p>
  </PageIntro>

  <Section id="roster" tone="sunk" labelledby="builders-heading">
    <BuilderIndex heading="The index" eyebrow="Index" builders={liveBuilders} selectors={selectors} />
  </Section>

  <Section id="add" labelledby="contribute-heading">
    <SubmitPanel formId="contribute" />
  </Section>

  <Section id="rooms" size="lg" bleed labelledby="stories-heading">
    <StoryStrip heading="The rooms they were in" eyebrow="Photographs" />
  </Section>
</Base>

<style>
  .intro-note {
    margin-top: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.75;
    color: var(--ink-3);
  }
</style>
