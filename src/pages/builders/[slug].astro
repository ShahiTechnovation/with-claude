---
/**
 * BUILDER DETAIL — SSR, always reads from Neon.
 *
 * ── WHY THIS PAGE NO LONGER USES useLiveRecords() + publicBuilders.find() ──
 *
 * The old flow was:
 *
 *   await useLiveRecords();       // mutates module-global cached RecordSet
 *   publicBuilders.find(b => b.slug === slug)  // reads that global
 *
 * This had two bugs:
 *
 *   1. A freshly self-published builder exists in Neon but was never in the
 *      build-time dataset.json snapshot, so publicBuilders.find() returned
 *      undefined → Astro.redirect('/404'). The publish flow appeared to work
 *      (POST returned 200, /builders/ showed the new entry via SSR), but the
 *      detail page always 404'd.
 *
 *   2. Under concurrent SSR, request B's useLiveRecords() call could overwrite
 *      the module-global `cached` between request A's load and its find(),
 *      causing request A to search the wrong dataset — a P0 isolation bug.
 *
 * The fix: query Neon directly via getPublicBuilderBySlug(). The result is
 * request-local and includes the correct row for any builder that exists in
 * the live database, including ones published seconds ago.
 *
 * The supplementary data — events, projects, ambassador links, etc. — still
 * comes from the build-time RecordSet via publicBuilders selectors. That data
 * is curated editorial content: it changes on deployment, not on self-publish,
 * and the build-time snapshot is the correct source for it. Only the builder's
 * own profile fields (name, bio, city, role, image) come from the live query.
 */
export const prerender = false;

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=86400',
);

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import {
  ambassadorForBuilder,
  cityName,
  eventsHostedBy,
  eventsOf,
  guidesBy,
  projectsOf,
  site,
  useCasesBy,
} from '@/data';
import { formatDate } from '@/lib/datetime';
import { asset } from '@/lib/images';
import { formatName, lifecycleLabel, lifecycleOf, lifecycleTone } from '@/lib/status';
import { profileSchema, titles, trail } from '@/lib/seo';
import ClaimProfile from '@/components/ClaimProfile.astro';
import {
  getPublicBuilderBySlug,
  isPublicBuilder,
} from '@/server/directory';
import { ReportModal } from '@/components/react/ReportModal';
import ModeratorControls from '@/components/ModeratorControls.astro';
import { isRequestModerator } from '@/server/moderation';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const isModerator = await isRequestModerator(Astro.request);

/**
 * Fetch the builder row directly from Neon.
 *
 * This returns the row regardless of visibility state. The caller (this page)
 * decides whether to show it: non-moderators are redirected to /404 for
 * restricted/removed content; moderators see a banner.
 *
 * Previously this was `getBuilderRow(slug)` (bare DB row) followed by
 * `publicBuilders.find()` (build-time global). The new function returns the
 * full projected shape — city slug, image URL — so both the moderation check
 * and the template can use it without a second source.
 */
const builderRow = await getPublicBuilderBySlug(slug);
if (!builderRow) return Astro.redirect('/404');

/**
 * Canonical visibility check.
 *
 * isPublicBuilder() = status === 'published' && moderationState === 'clean'
 *
 * 'reported' is NOT public. A reported builder awaits moderator action.
 * Previously this page admitted 'reported' as public (treated same as 'clean');
 * that was inconsistent with the stated moderation semantics.
 */
const isPublic = isPublicBuilder(builderRow);

// Non-moderators cannot see non-public builders.
if (!isPublic && !isModerator) {
  return Astro.redirect('/404');
}

/**
 * Supplementary editorial data — events, projects, ambassador links.
 *
 * These come from the build-time RecordSet via selectors in src/data/index.ts.
 * This is correct: the curated archive changes on deployment, not on
 * self-publish. A newly published builder has no event credits or projects in
 * the archive yet, and that is accurate.
 *
 * The builder's own profile fields (name, bio, city, role, image) come from
 * the live `builderRow` above.
 */
const ambassador = ambassadorForBuilder({ slug: builderRow.slug } as any);
const events = eventsOf({ slug: builderRow.slug } as any);
const hosted = ambassador ? eventsHostedBy(ambassador.slug) : [];
const projects = projectsOf({ slug: builderRow.slug } as any);

/**
 * Portrait: prefer the uploaded avatar (from the live Neon query) over the
 * repository image asset. For legacy/curated builders the image field is a
 * repository-relative path; for self-published builders it is a Blob URL from
 * the media table. `asset()` handles the former; the Blob URL is used directly
 * for the latter.
 */
const uploadedImage = builderRow.image ?? null;
const portrait = uploadedImage ? null : asset(undefined);

// Everything this person is on the record for, deduplicated across the two
// routes into the event list: speaking, and hosting as an Ambassador.
const allEvents = [...new Set([...events, ...hosted])].sort((a, b) => (a.date < b.date ? 1 : -1));

// The record is thin for most people. Say so plainly rather than dressing it up
// or padding it with placeholders.
const missing = [
  !builderRow.bio && 'a short bio',
  !uploadedImage && 'a portrait',
].filter(Boolean) as string[];

const description =
  builderRow.bio ?? `${builderRow.name} — ${builderRow.role} in ${cityName(builderRow.citySlug)}.`;

// The practice half of this person's record. Empty until somebody writes one.
const written = useCasesBy(builderRow.slug);
const guides = guidesBy(builderRow.slug);

const url = `${site.url}/builders/${builderRow.slug}`;
const crumbs = trail(
  { name: 'Builders', href: '/builders' },
  { name: builderRow.name, href: `/builders/${builderRow.slug}` },
);

/**
 * `ProfilePage` → `Person`.
 *
 * Only what the page renders: the role it prints, the bio it shows, the links
 * it lists. The Ambassador title is passed as the job title ONLY when a
 * verified Ambassador record claims this person.
 */
const schema = profileSchema(
  {
    name: builderRow.name,
    slug: builderRow.slug,
    city: cityName(builderRow.citySlug),
    role: ambassador ? ambassador.title : builderRow.role,
    bio: builderRow.bio,
    links: undefined,
    image: uploadedImage ?? undefined,
  },
  url,
);
---

<Base
  title={builderRow.name}
  seoTitle={titles.builder(builderRow.name, cityName(builderRow.citySlug))}
  description={description}
  active="/builders"
  breadcrumbs={crumbs}
  schema={schema}
>
  {(!isPublic && isModerator) && (
    <div class="moderator-banner" style="background-color: var(--clay-deep); color: white; padding: 1rem; text-align: center; font-weight: bold; margin-bottom: 2rem;">
      RESTRICTED / REMOVED — not visible to the public.
    </div>
  )}

  <PageIntro
    eyebrow={`${cityName(builderRow.citySlug)} · ${builderRow.role}`}
    title={builderRow.name}
    size="lg"
    stamp={ambassador ? ambassador.title : undefined}
  >
    {builderRow.bio && <p>{builderRow.bio}</p>}
  </PageIntro>

      <Section id="record" tone="sunk" labelledby="record-heading">
        <h2 id="record-heading" class="visually-hidden">{`${builderRow.name} on the record`}</h2>

        <div class="profile">
          <div class="profile-main">
            <div class="roles">
              {ambassador ? <span class="chip chip-verified">{ambassador.title}</span> : null}
              {
                (builderRow.roles as string[])
                  .filter((role) => role !== 'ambassador')
                  .map((role) => <span class="chip chip-role">{formatName(role)}</span>)
              }
            </div>

            {
              ambassador && (
                <p class="amb-source">
                  {ambassador.verifiedVia}. Ambassadors are appointed by Anthropic — this site records
                  the status, it does not grant it.
                </p>
              )
            }

            {
              allEvents.length > 0 && (
                <div class="block">
                  <h3 class="label block-head">Events</h3>
                  <ul class="list">
                    {allEvents.map((event) => (
                      <li>
                        <a href={`/events/${event.slug}`}>
                          <span class="list-title">{event.title}</span>
                          <span class="list-meta">
                            {`${formatDate(event.date)} · ${cityName(event.citySlug)}`}
                          </span>
                          <span class:list={['pip', `pip-${lifecycleTone(lifecycleOf(event))}`]}>
                            {lifecycleLabel(lifecycleOf(event))}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <div class="block">
              <h3 class="label block-head">Projects</h3>
              {
                projects.length > 0 ? (
                  <ul class="list">
                    {projects.map((project) => (
                      <li>
                        <a href={`/projects/${project.slug}`}>
                          <span class="list-title">{project.title}</span>
                          <span class="list-meta">{project.summary}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="block-empty">
                    Nothing from {builderRow.name} is in the archive yet.{' '}
                    <a href="/submit/">Submissions are open.</a>
                  </p>
                )
              }
            </div>

            {
              (written.length > 0 || guides.length > 0) && (
                <div class="block">
                  <h3 class="label block-head">Practice</h3>
                  <ul class="list">
                    {written.map((useCase) => (
                      <li>
                        <a href={`/use-cases/${useCase.slug}`}>
                          <span class="list-title">{useCase.title}</span>
                          <span class="list-meta">{useCase.summary}</span>
                        </a>
                      </li>
                    ))}
                    {guides.map((guide) => (
                      <li>
                        <a href={`/guides/${guide.slug}`}>
                          <span class="list-title">{guide.title}</span>
                          <span class="list-meta">{guide.standfirst}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>

          <aside class="profile-side">
            {
              uploadedImage ? (
                <div class="plate plate-framed portrait">
                  <img
                    src={uploadedImage}
                    alt={builderRow.name}
                    width="640"
                    height="800"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ) : portrait ? (
                <div class="plate plate-framed portrait">
                  <Image
                    src={portrait}
                    alt={builderRow.name}
                    widths={[320, 640]}
                    sizes="(max-width: 61.99em) 60vw, 280px"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ) : null
            }

            <dl class="facts">
              <div>
                <dt>City</dt>
                <dd><a href={`/cities/${builderRow.citySlug}`}>{cityName(builderRow.citySlug)}</a></dd>
              </div>
              <div>
                <dt>Events</dt>
                <dd>{String(allEvents.length).padStart(2, '0')}</dd>
              </div>
              <div>
                <dt>Projects</dt>
                <dd>{String(projects.length).padStart(2, '0')}</dd>
              </div>
            </dl>

            {
              missing.length > 0 && (
                <p class="thin">
                  This entry is missing {missing.join(', ')}. If it is yours,{' '}
                  <a href="/me/profile/edit/">send the rest</a> and it will be filled in.
                </p>
              )
            }

            <div class="mt-8 pt-6 border-t border-neutral-100">
              <ReportModal client:load entityType="builder" entityId={builderRow.id} />
              <ModeratorControls entityType="builders" entityId={builderRow.id} initialState={builderRow.moderationState} isModerator={isModerator} />
            </div>
          </aside>
        </div>
      </Section>

      <Section id="claim" size="sm">
        <ClaimProfile slug={builderRow.slug} name={builderRow.name} owned={Boolean(builderRow.ownerMemberId)} />
      </Section>
  <Section id="back" size="sm">
    <a class="link-arrow" href="/builders">
      <span>The whole index</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </Section>
</Base>

<style>
  .profile {
    display: grid;
    gap: var(--s-8);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  .amb-source {
    margin-top: var(--s-4);
    max-width: 60ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  .block {
    margin-top: var(--s-7);
  }

  .block-head {
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .list-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .list a:hover .list-title {
    color: var(--clay-deep);
  }

  .list-meta {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }

  .list .pip {
    margin-left: auto;
  }

  .block-empty {
    padding-block: var(--s-5);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  /* --- Side ---------------------------------------------------------------- */
  .profile-side {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .portrait {
    aspect-ratio: 4 / 5;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--border-heavy) solid var(--ink);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .facts a {
    text-decoration: none;
  }

  .facts a:hover {
    color: var(--clay-deep);
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-4);
  }

  .links a {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--clay-deep);
  }

  .thin {
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    max-width: 40ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  @media (min-width: 62em) {
    .profile {
      grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
      gap: var(--s-9);
      align-items: start;
    }
  }
</style>
