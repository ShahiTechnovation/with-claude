---
/**
 * BUILDER DETAIL — server-rendered, live from Neon.
 *
 * The builder's own row comes from `getPublicBuilderBySlug()`; their projects
 * from `builderProjects()`, which applies the same public-project predicate as
 * every list. Curated event credits and practice write-ups still come from the
 * record selectors — those change on deployment, not on self-publish.
 *
 * Non-public → a real 404 for everyone except a moderator, whose render is
 * private. Moderation controls on a PUBLIC profile appear only with
 * `?moderate=1`, a separate CDN cache key, so the plain URL is never rendered
 * per viewer. See `src/server/http/cache.ts`.
 */
export const prerender = false;

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import NotFound from '@/components/NotFound.astro';
import {
  ambassadorForBuilder,
  cityName,
  eventsHostedBy,
  eventsOf,
  guidesBy,
  site,
  useCasesBy,
} from '@/data';
import { formatDate } from '@/lib/datetime';
import { asset } from '@/lib/images';
import { formatName, lifecycleLabel, lifecycleOf, lifecycleTone } from '@/lib/status';
import { profileSchema, titles, trail } from '@/lib/seo';
import ClaimProfile from '@/components/ClaimProfile.astro';
import { getPublicBuilderBySlug, isPublicBuilder } from '@/server/directory';
import { builderProjects } from '@/server/public/pages';
import { ReportModal } from '@/components/react/ReportModal';
import ModeratorControls from '@/components/ModeratorControls.astro';
import { isRequestModerator } from '@/server/moderation';
import { privateCache, publicCache } from '@/server/http/cache';

const slug = Astro.params.slug ?? '';
const found = /^[a-z0-9][a-z0-9_-]{0,80}$/.test(slug) ? await getPublicBuilderBySlug(slug) : null;
const isPublic = found ? isPublicBuilder(found) : false;
const isModerator =
  found && (!isPublic || Astro.url.searchParams.has('moderate'))
    ? await isRequestModerator(Astro.request)
    : false;
const builderRow = found && (isPublic || isModerator) ? found : null;

if (!builderRow) {
  Astro.response.status = 404;
  publicCache(Astro);
} else if (isModerator || !isPublic) {
  privateCache(Astro);
} else {
  publicCache(Astro);
}

const ref = { slug: builderRow?.slug ?? '' } as never;
const ambassador = builderRow ? ambassadorForBuilder(ref) : undefined;
const events = builderRow ? eventsOf(ref) : [];
const hosted = ambassador ? eventsHostedBy(ambassador.slug) : [];
const allProjects = builderRow ? await builderProjects(builderRow) : [];

/**
 * Portrait: an uploaded avatar is an absolute URL (rendered as `<img>`); a
 * curated portrait is a repository asset key (rendered through `<Image>`).
 * `builderImage()` in `src/server/directory.ts` produces one or the other.
 */
const uploadedImage =
  builderRow?.image && /^https?:\/\//.test(builderRow.image) ? builderRow.image : null;
const portrait = builderRow?.image && !uploadedImage ? asset(builderRow.image) : undefined;

// Everything this person is on the record for, deduplicated across the two
// routes into the event list: speaking, and hosting as an Ambassador.
const allEvents = [...new Set([...events, ...hosted])].sort((a, b) => (a.date < b.date ? 1 : -1));

// The record is thin for most people. Say so plainly rather than padding it.
const missing = [
  !builderRow?.bio && 'a short bio',
  !uploadedImage && !portrait && 'a portrait',
].filter(Boolean) as string[];

const description = builderRow
  ? builderRow.bio ?? `${builderRow.name} — ${builderRow.role} in ${cityName(builderRow.citySlug)}.`
  : 'Not found.';

// The practice half of this person's record. Empty until somebody writes one.
const written = builderRow ? useCasesBy(builderRow.slug) : [];
const guides = builderRow ? guidesBy(builderRow.slug) : [];

const url = `${site.url}/builders/${builderRow?.slug ?? ''}/`;
const crumbs = builderRow
  ? trail(
      { name: 'Builders', href: '/builders/' },
      { name: builderRow.name, href: `/builders/${builderRow.slug}/` },
    )
  : undefined;

/**
 * `ProfilePage` → `Person`. Only what the page renders. The Ambassador title
 * is the job title ONLY when a verified Ambassador record claims this person.
 */
const schema = builderRow
  ? profileSchema(
      {
        name: builderRow.name,
        slug: builderRow.slug,
        city: cityName(builderRow.citySlug),
        role: ambassador ? ambassador.title : builderRow.role,
        bio: builderRow.bio,
        links: undefined,
        image: uploadedImage ?? undefined,
      },
      url,
    )
  : [];
---

{
  !builderRow ? (
    <Base title="Not found" description="That profile is not part of the index." noindex>
      <NotFound />
    </Base>
  ) : (
<Base
  title={builderRow.name}
  noindex={!isPublic || builderRow.profileVisibility === 'unlisted'}
  seoTitle={titles.builder(builderRow.name, cityName(builderRow.citySlug))}
  description={description}
  active="/builders"
  breadcrumbs={crumbs}
  schema={schema}
>
  {(!isPublic && isModerator) && (
    <div class="moderator-banner" style="background-color: var(--clay-deep); color: white; padding: 1rem; text-align: center; font-weight: bold; margin-bottom: 2rem;">
      RESTRICTED / REMOVED — not visible to the public.
    </div>
  )}

  <PageIntro
    eyebrow={`${cityName(builderRow.citySlug)} · ${builderRow.role}`}
    title={builderRow.name}
    size="lg"
    stamp={ambassador ? ambassador.title : undefined}
  >
    {builderRow.bio && <p>{builderRow.bio}</p>}
  </PageIntro>

      <Section id="record" tone="sunk" labelledby="record-heading">
        <h2 id="record-heading" class="visually-hidden">{`${builderRow.name} on the record`}</h2>

        <div class="profile">
          <div class="profile-main">
            <div class="roles">
              {ambassador ? <span class="chip chip-verified">{ambassador.title}</span> : null}
              {
                (builderRow.roles as string[])
                  .filter((role) => role !== 'ambassador')
                  .map((role) => <span class="chip chip-role">{formatName(role)}</span>)
              }
            </div>

            {
              ambassador && (
                <p class="amb-source">
                  {ambassador.verifiedVia}. Ambassadors are appointed by Anthropic — this site records
                  the status, it does not grant it.
                </p>
              )
            }

            {
              allEvents.length > 0 && (
                <div class="block">
                  <h3 class="label block-head">Events</h3>
                  <ul class="list">
                    {allEvents.map((event) => (
                      <li>
                        <a href={`/events/${event.slug}`}>
                          <span class="list-title">{event.title}</span>
                          <span class="list-meta">
                            {`${formatDate(event.date)} · ${cityName(event.citySlug)}`}
                          </span>
                          <span class:list={['pip', `pip-${lifecycleTone(lifecycleOf(event))}`]}>
                            {lifecycleLabel(lifecycleOf(event))}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <div class="block">
              <h3 class="label block-head">Projects</h3>
              {
                allProjects.length > 0 ? (
                  <ul class="list">
                    {allProjects.map((project) => (
                      <li>
                        <a href={`/projects/${project.slug}/`}>
                          <span class="list-title">{project.title}</span>
                          <span class="list-meta">{project.summary}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="block-empty">
                    Nothing from {builderRow.name} is in the archive yet.{' '}
                    <a href="/submit/">Submissions are open.</a>
                  </p>
                )
              }
            </div>

            {
              (written.length > 0 || guides.length > 0) && (
                <div class="block">
                  <h3 class="label block-head">Practice</h3>
                  <ul class="list">
                    {written.map((useCase) => (
                      <li>
                        <a href={`/use-cases/${useCase.slug}`}>
                          <span class="list-title">{useCase.title}</span>
                          <span class="list-meta">{useCase.summary}</span>
                        </a>
                      </li>
                    ))}
                    {guides.map((guide) => (
                      <li>
                        <a href={`/guides/${guide.slug}`}>
                          <span class="list-title">{guide.title}</span>
                          <span class="list-meta">{guide.standfirst}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }
          </div>

          <aside class="profile-side">
            {
              uploadedImage ? (
                <div class="plate plate-framed portrait">
                  <img
                    src={uploadedImage}
                    alt={builderRow.name}
                    width="640"
                    height="800"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ) : portrait ? (
                <div class="plate plate-framed portrait">
                  <Image
                    src={portrait}
                    alt={builderRow.name}
                    widths={[320, 640]}
                    sizes="(max-width: 61.99em) 60vw, 280px"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ) : null
            }

            <dl class="facts">
              <div>
                <dt>City</dt>
                <dd><a href={`/cities/${builderRow.citySlug}`}>{cityName(builderRow.citySlug)}</a></dd>
              </div>
              <div>
                <dt>Events</dt>
                <dd>{String(allEvents.length).padStart(2, '0')}</dd>
              </div>
              <div>
                <dt>Projects</dt>
                <dd>{String(allProjects.length).padStart(2, '0')}</dd>
              </div>
            </dl>

            {
              missing.length > 0 && (
                <p class="thin">
                  This entry is missing {missing.join(', ')}. If it is yours,{' '}
                  <a href="/me/profile/edit/">send the rest</a> and it will be filled in.
                </p>
              )
            }

            <div class="mt-8 pt-6 border-t border-neutral-100">
              <ReportModal client:load entityType="builder" entityId={builderRow.id} />
              <ModeratorControls entityType="builders" entityId={builderRow.id} initialState={builderRow.moderationState} isModerator={isModerator} />
            </div>
          </aside>
        </div>
      </Section>

      <Section id="claim" size="sm">
        <ClaimProfile slug={builderRow.slug} name={builderRow.name} owned={Boolean(builderRow.ownerMemberId)} />
      </Section>
  <Section id="back" size="sm">
    <a class="link-arrow" href="/builders">
      <span>The whole index</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </Section>
</Base>
  )
}

<style>
  .profile {
    display: grid;
    gap: var(--s-8);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  .amb-source {
    margin-top: var(--s-4);
    max-width: 60ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  .block {
    margin-top: var(--s-7);
  }

  .block-head {
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .list-title {
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .list a:hover .list-title {
    color: var(--clay-deep);
  }

  .list-meta {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }

  .list .pip {
    margin-left: auto;
  }

  .block-empty {
    padding-block: var(--s-5);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  /* --- Side ---------------------------------------------------------------- */
  .profile-side {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .portrait {
    aspect-ratio: 4 / 5;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--border-heavy) solid var(--ink);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd {
    margin-top: var(--s-2);
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .facts a {
    text-decoration: none;
  }

  .facts a:hover {
    color: var(--clay-deep);
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-4);
  }

  .links a {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--clay-deep);
  }

  .thin {
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    max-width: 40ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  @media (min-width: 62em) {
    .profile {
      grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
      gap: var(--s-9);
      align-items: start;
    }
  }
</style>
