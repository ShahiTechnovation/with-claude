---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import {
  ambassadorForBuilder,
  cityName,
  eventsHostedBy,
  eventsOf,
  projectsOf,
  publicBuilders,
} from '@/data';
import { formatDate } from '@/lib/datetime';
import { asset } from '@/lib/images';
import { formatName, lifecycleLabel, lifecycleOf, lifecycleTone } from '@/lib/status';

export const getStaticPaths = (() =>
  publicBuilders.map((builder) => ({
    params: { slug: builder.slug },
    props: { builder },
  }))) satisfies GetStaticPaths;

const { builder } = Astro.props;

const ambassador = ambassadorForBuilder(builder);
const events = eventsOf(builder);
const hosted = ambassador ? eventsHostedBy(ambassador.slug) : [];
const projects = projectsOf(builder);
const portrait = asset(builder.image);

// Everything this person is on the record for, deduplicated across the two
// routes into the event list: speaking, and hosting as an Ambassador.
const allEvents = [...new Set([...events, ...hosted])].sort((a, b) => (a.date < b.date ? 1 : -1));

// The record is thin for most people. Say so plainly rather than dressing it up
// or padding it with placeholders.
const missing = [
  !builder.bio && 'a short bio',
  !builder.image && 'a portrait',
  !builder.links?.length && 'links',
].filter(Boolean) as string[];

const description =
  builder.bio ?? `${builder.name} — ${builder.role} in ${cityName(builder.citySlug)}.`;
---

<Base title={builder.name} description={description} active="/builders">
  <PageIntro
    eyebrow={`${cityName(builder.citySlug)} · ${builder.role}`}
    title={builder.name}
    size="lg"
    stamp={ambassador ? ambassador.title : undefined}
  >
    {builder.bio && <p>{builder.bio}</p>}
    {builder.building && <p>{builder.building}</p>}
  </PageIntro>

  <Section id="record" tone="sunk" labelledby="record-heading">
    <h2 id="record-heading" class="visually-hidden">{`${builder.name} on the record`}</h2>

    <div class="profile">
      <div class="profile-main">
        <div class="roles">
          {ambassador ? <span class="chip chip-verified">{ambassador.title}</span> : null}
          {
            builder.roles
              .filter((role) => role !== 'ambassador')
              .map((role) => <span class="chip chip-role">{formatName(role)}</span>)
          }
        </div>

        {
          ambassador && (
            <p class="amb-source">
              {ambassador.verifiedVia}. Ambassadors are appointed by Anthropic — this site records
              the status, it does not grant it.
            </p>
          )
        }

        {
          allEvents.length > 0 && (
            <div class="block">
              <h3 class="label block-head">Events</h3>
              <ul class="list">
                {allEvents.map((event) => (
                  <li>
                    <a href={`/events/${event.slug}`}>
                      <span class="list-title">{event.title}</span>
                      <span class="list-meta">
                        {`${formatDate(event.date)} · ${cityName(event.citySlug)}`}
                      </span>
                      <span class:list={['pip', `pip-${lifecycleTone(lifecycleOf(event))}`]}>
                        {lifecycleLabel(lifecycleOf(event))}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="block">
          <h3 class="label block-head">Projects</h3>
          {
            projects.length > 0 ? (
              <ul class="list">
                {projects.map((project) => (
                  <li>
                    <a href={`/projects/${project.slug}`}>
                      <span class="list-title">{project.title}</span>
                      <span class="list-meta">{project.summary}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="block-empty">
                Nothing from {builder.name} is in the archive yet.{' '}
                <a href="/join#build">Submissions are open.</a>
              </p>
            )
          }
        </div>

        {
          builder.claudeTools && builder.claudeTools.length > 0 && (
            <div class="block">
              <h3 class="label block-head">Works with</h3>
              <p class="tools">{builder.claudeTools.join(' · ')}</p>
            </div>
          )
        }
      </div>

      <aside class="profile-side">
        {
          portrait && (
            <div class="plate plate-framed portrait">
              <Image
                src={portrait}
                alt={builder.name}
                widths={[320, 640]}
                sizes="(max-width: 61.99em) 60vw, 280px"
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }

        <dl class="facts">
          <div>
            <dt>City</dt>
            <dd><a href={`/cities/${builder.citySlug}`}>{cityName(builder.citySlug)}</a></dd>
          </div>
          <div>
            <dt>Events</dt>
            <dd>{String(allEvents.length).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>Projects</dt>
            <dd>{String(projects.length).padStart(2, '0')}</dd>
          </div>
        </dl>

        {
          builder.links && builder.links.length > 0 && (
            <div class="links">
              <h3 class="label block-head">Elsewhere</h3>
              <ul>
                {builder.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          missing.length > 0 && (
            <p class="thin">
              This entry is missing {missing.join(', ')}. If it is yours,{' '}
              <a href="/join#contribute">send the rest</a> and it will be filled in.
            </p>
          )
        }
      </aside>
    </div>
  </Section>

  <Section id="back" size="sm">
    <a class="link-arrow" href="/builders">
      <span>The whole index</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </Section>
</Base>

<style>
  .profile {
    display: grid;
    gap: var(--s-8);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  .amb-source {
    margin-top: var(--s-4);
    max-width: 60ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  .block {
    margin-top: var(--s-7);
  }

  .block-head {
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .list-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .list a:hover .list-title {
    color: var(--clay-deep);
  }

  .list-meta {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }

  .list .pip {
    margin-left: auto;
  }

  .block-empty {
    padding-block: var(--s-5);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .tools {
    padding-top: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  /* --- Side ---------------------------------------------------------------- */
  .profile-side {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .portrait {
    aspect-ratio: 4 / 5;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--border-heavy) solid var(--ink);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .facts a {
    text-decoration: none;
  }

  .facts a:hover {
    color: var(--clay-deep);
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-4);
  }

  .links a {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--clay-deep);
  }

  .thin {
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    max-width: 40ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  @media (min-width: 62em) {
    .profile {
      grid-template-columns: minmax(0, 1.25fr) minmax(240px, 0.75fr);
      gap: var(--s-9);
      align-items: start;
    }
  }
</style>
