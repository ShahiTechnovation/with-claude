---
/**
 * BUILDER DETAIL — server-rendered, live from Neon.
 *
 * The builder's own row comes from `getPublicBuilderBySlug()`; their projects
 * from `builderProjects()`, which applies the same public-project predicate as
 * every list. Curated event credits and practice write-ups still come from the
 * record selectors — those change on deployment, not on self-publish.
 *
 * Non-public → a real 404 for everyone except a moderator, whose render is
 * private. Moderation controls on a PUBLIC profile appear only with
 * `?moderate=1`, a separate CDN cache key, so the plain URL is never rendered
 * per viewer. See `src/server/http/cache.ts`.
 */
export const prerender = false;

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import NotFound from '@/components/NotFound.astro';
import {
  ambassadorForBuilder,
  cityName,
  eventsHostedBy,
  eventsOf,
  guidesBy,
  site,
  useCasesBy,
} from '@/data';
import { asset } from '@/lib/images';
import { cardProps } from '@/lib/project-display';
import { formatName } from '@/lib/status';
import ProjectGrid from '@/components/ProjectGrid.astro';
import EventRecord from '@/components/EventRecord.astro';
import { profileSchema, titles, trail } from '@/lib/seo';
import ClaimProfile from '@/components/ClaimProfile.astro';
import { getPublicBuilderBySlug, isPublicBuilder } from '@/server/directory';
import { builderProjects } from '@/server/public/pages';
import { ReportModal } from '@/components/react/ReportModal';
import ModeratorControls from '@/components/ModeratorControls.astro';
import { isRequestModerator } from '@/server/moderation';
import { privateCache, publicCache } from '@/server/http/cache';

const slug = Astro.params.slug ?? '';
const found = /^[a-z0-9][a-z0-9_-]{0,80}$/.test(slug) ? await getPublicBuilderBySlug(slug) : null;
const isPublic = found ? isPublicBuilder(found) : false;
const isModerator =
  found && (!isPublic || Astro.url.searchParams.has('moderate'))
    ? await isRequestModerator(Astro.request)
    : false;
const builderRow = found && (isPublic || isModerator) ? found : null;

if (!builderRow) {
  Astro.response.status = 404;
  publicCache(Astro);
} else if (isModerator || !isPublic) {
  privateCache(Astro);
} else {
  publicCache(Astro);
}

const ref = { slug: builderRow?.slug ?? '' } as never;
const ambassador = builderRow ? ambassadorForBuilder(ref) : undefined;
const events = builderRow ? eventsOf(ref) : [];
const hosted = ambassador ? eventsHostedBy(ambassador.slug) : [];
const allProjects = builderRow ? await builderProjects(builderRow) : [];

/**
 * Portrait: an uploaded avatar is an absolute URL (rendered as `<img>`); a
 * curated portrait is a repository asset key (rendered through `<Image>`).
 * `builderImage()` in `src/server/directory.ts` produces one or the other.
 */
const uploadedImage =
  builderRow?.image && /^https?:\/\//.test(builderRow.image) ? builderRow.image : null;
const portrait = builderRow?.image && !uploadedImage ? asset(builderRow.image) : undefined;

// Everything this person is on the record for, deduplicated across the two
// routes into the event list: speaking, and hosting as an Ambassador.
const allEvents = [...new Set([...events, ...hosted])].sort((a, b) => (a.date < b.date ? 1 : -1));

const description = builderRow
  ? (builderRow.bio ??
    `${builderRow.name} — ${builderRow.role} in ${cityName(builderRow.citySlug)}.`)
  : 'Not found.';

// The practice half of this person's record. Empty until somebody writes one.
const written = builderRow ? useCasesBy(builderRow.slug) : [];
const guides = builderRow ? guidesBy(builderRow.slug) : [];

const url = `${site.url}/builders/${builderRow?.slug ?? ''}/`;
const crumbs = builderRow
  ? trail(
      { name: 'Builders', href: '/builders/' },
      { name: builderRow.name, href: `/builders/${builderRow.slug}/` },
    )
  : undefined;

/**
 * `ProfilePage` → `Person`. Only what the page renders. The Ambassador title
 * is the job title ONLY when a verified Ambassador record claims this person.
 */
const schema = builderRow
  ? profileSchema(
      {
        name: builderRow.name,
        slug: builderRow.slug,
        city: cityName(builderRow.citySlug),
        role: ambassador ? ambassador.title : builderRow.role,
        bio: builderRow.bio,
        links: undefined,
        image: uploadedImage ?? undefined,
      },
      url,
    )
  : [];
---

{
  !builderRow ? (
    <Base title="Not found" description="That profile is not part of the index." noindex>
      <NotFound />
    </Base>
  ) : (
    <Base
      title={builderRow.name}
      noindex={!isPublic || builderRow.profileVisibility === 'unlisted'}
      seoTitle={titles.builder(builderRow.name, cityName(builderRow.citySlug))}
      description={description}
      active="/builders"
      breadcrumbs={crumbs}
      schema={schema}
    >
      {!isPublic && isModerator && (
        <div class="moderator-banner">RESTRICTED / REMOVED — not visible to the public.</div>
      )}

      <PageIntro title={builderRow.name} size="lg">
        <div class="who">
          {uploadedImage ? (
            <img
              class="portrait"
              src={uploadedImage}
              alt={builderRow.name}
              width="96"
              height="96"
              loading="eager"
              decoding="async"
            />
          ) : portrait ? (
            <Image
              class="portrait"
              src={portrait}
              alt={builderRow.name}
              widths={[96, 192]}
              sizes="96px"
              loading="eager"
              decoding="async"
            />
          ) : null}
          <p>
            {builderRow.role}
            {' · '}
            <a href={`/cities/${builderRow.citySlug}/`}>{cityName(builderRow.citySlug)}</a>
          </p>
        </div>
        {builderRow.bio && <p>{builderRow.bio}</p>}
        {(ambassador || builderRow.roles.some((role) => role !== 'ambassador')) && (
          <p class="roles">
            {ambassador ? <span class="chip chip-verified">{ambassador.title}</span> : null}
            {(builderRow.roles as string[])
              .filter((role) => role !== 'ambassador')
              .map((role) => (
                <span class="chip chip-role">{formatName(role)}</span>
              ))}
          </p>
        )}
        {ambassador && (
          <p class="intro-links">
            <a class="btn btn-sm" href={`/ambassadors/${ambassador.slug}/`}>
              Ambassador page <span aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </PageIntro>

      {/* Projects, events, practice and the claim share the paper ground: one Section, in parts. */}
      <Section id="profile">
        {allProjects.length > 0 && (
          <section id="projects" class="part" aria-labelledby="projects-heading">
            <div class="section-head">
              <h2 id="projects-heading">Projects</h2>
            </div>
            <ProjectGrid items={allProjects.map((project) => cardProps(project))} />
          </section>
        )}

        {allEvents.length > 0 && (
          <section id="events" class="part" aria-labelledby="events-heading">
            <div class="section-head">
              <h2 id="events-heading">Events</h2>
            </div>
            <EventRecord events={allEvents} />
          </section>
        )}

        {(written.length > 0 || guides.length > 0) && (
          <section id="practice" class="part" aria-labelledby="practice-heading">
            <div class="section-head">
              <h2 id="practice-heading">Practice</h2>
            </div>
            <ul class="rows">
              {written.map((useCase) => (
                <li>
                  <a class="row row-text" href={`/use-cases/${useCase.slug}/`}>
                    <span class="row-body">
                      <span class="row-title">{useCase.title}</span>
                      <span class="row-meta">{useCase.summary}</span>
                    </span>
                  </a>
                </li>
              ))}
              {guides.map((guide) => (
                <li>
                  <a class="row row-text" href={`/guides/${guide.slug}/`}>
                    <span class="row-body">
                      <span class="row-title">{guide.title}</span>
                      <span class="row-meta">{guide.standfirst}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <div id="claim" class="part">
          <ClaimProfile
            slug={builderRow.slug}
            name={builderRow.name}
            owned={Boolean(builderRow.ownerMemberId)}
          />
          <div class="foot" id="back">
            <a class="link" href="/builders/">
              All builders <span aria-hidden="true">→</span>
            </a>
            {/* The report form needs its script, so without JS it is not rendered. */}
            <div class="js-only">
              <ReportModal client:load entityType="builder" entityId={builderRow.id} />
            </div>
          </div>
          <ModeratorControls
            entityType="builders"
            entityId={builderRow.id}
            initialState={builderRow.moderationState}
            isModerator={isModerator}
          />
        </div>
      </Section>
    </Base>
  )
}

<style>
  .moderator-banner {
    padding: 1rem var(--gutter);
    background: var(--clay-deep);
    color: var(--paper);
    font-family: var(--font-title);
    font-weight: 600;
    text-align: center;
  }

  /* --- The page head: portrait, role and city, chips, links ---------------- */
  .who {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .portrait {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule-strong);
  }

  .who a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 3px;
  }

  .who a:hover {
    text-decoration-color: var(--clay);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: 18px;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: 18px;
  }

  /* --- Rows: practice ------------------------------------------------------ */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    align-items: center;
    gap: 18px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .row-text {
    grid-template-columns: minmax(0, 1fr);
  }

  .row-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .row-title {
    font-family: var(--font-title);
    font-size: var(--t-title);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.006em;
  }

  .row:hover .row-title {
    color: var(--clay-deep);
  }

  .row-meta {
    color: var(--ink-3);
    font-size: var(--t-small);
    line-height: 1.45;
  }

  /* --- Parts: blocks that share a ground, a hairline between them ---------- */
  .part + .part {
    margin-top: calc(var(--section-y) * 0.4);
    padding-top: calc(var(--section-y) * 0.4);
    border-top: 1px solid var(--rule);
  }

  /* A heading that opens a part after a hairline sits nearer its content than the joint
     above it: --s-6, the value --head-after already has on small screens. */
  .part + .part > .section-head {
    margin-bottom: var(--s-6);
  }

  /* The claim card carries its own border; a hairline right above it would double it. */
  .part + #claim {
    margin-top: var(--s-6);
    padding-top: 0;
    border-top: 0;
  }

  /* --- Claim, back, report ------------------------------------------------- */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
</style>
