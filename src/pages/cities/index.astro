---
import { titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import CityAtlas from '@/components/CityAtlas.astro';
import CityIndex from '@/components/CityIndex.astro';
import SubmitPanel from '@/components/SubmitPanel.astro';
import { citySignals, publicCities } from '@/data';
import { isLive } from '@/lib/city';
import { EXTENT } from '@/lib/geo';
import { inWordsCap } from '@/lib/words';

const signals = citySignals();
const live = signals.filter((s) => isLive(s.state));
const led = signals.filter((s) => s.state === 'ambassador-led');
---

<Base
  title="Cities"
  seoTitle={titles.cities()}
  description={`Where the Claude community meets in India. ${publicCities.length} cities plotted, ${live.length} with verified activity.`}
  active="/cities"
  breadcrumbs={trail({ name: 'Cities', href: '/cities' })}
>
  <PageIntro
    eyebrow="Cities"
    title="Find your city."
    stamp={`${EXTENT.minLon}°E — ${EXTENT.maxLon}°E · ${EXTENT.minLat}°N — ${EXTENT.maxLat}°N`}
    size="lg"
    facts={[
      { label: 'Plotted', value: String(publicCities.length).padStart(2, '0') },
      { label: 'Ambassador-led', value: String(led.length).padStart(2, '0') },
      { label: 'With activity', value: String(live.length).padStart(2, '0') },
    ]}
  >
    <p>
      {`${inWordsCap(publicCities.length)} cities at their true coordinates. `}
      A city appears as Ambassador-led because a verified Claude Community Ambassador is hosting there
      — not because anyone claimed it. Everywhere else, the page says exactly what is true.
    </p>
  </PageIntro>

  <Section id="atlas" tone="night" size="lg" labelledby="atlas-heading">
    <h2 id="atlas-heading" class="visually-hidden">The atlas</h2>
    <CityAtlas />
  </Section>

  <Section id="index" labelledby="cities-heading">
    <CityIndex heading="The index" eyebrow="Index" />
  </Section>

  <Section id="register" tone="sunk" labelledby="city-heading">
    <SubmitPanel formId="city" />
  </Section>
</Base>
