---
import { publicCache } from '@/server/http/cache';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import CityAtlas from '@/components/CityAtlas.astro';
import CityIndex from '@/components/CityIndex.astro';
---

<Base
  title="Cities"
  seoTitle={titles.cities()}
  description="Where the Claude community meets in India: events, builders and projects by city."
  active="/cities"
  breadcrumbs={trail({ name: 'Cities', href: '/cities' })}
>
  <PageIntro title="Claude Community Across Indian Cities" />

  <Section id="index" tone="sunk" labelledby="cities-heading">
    <div class="cities-layout">
      <div id="atlas" class="cities-map">
        <CityAtlas size="full" selectors={selectors} />
      </div>
      <CityIndex selectors={selectors} />
    </div>
  </Section>
</Base>

<style>
  /* Map first, then the index; side by side from 1024px. Both sit on the sunk
     ground, which the map's pin halo is drawn in. */
  .cities-layout {
    display: grid;
    gap: var(--head-after);
  }

  @media (min-width: 1024px) {
    .cities-layout {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: clamp(40px, 4vw, 72px);
      align-items: start;
    }
  }
</style>
