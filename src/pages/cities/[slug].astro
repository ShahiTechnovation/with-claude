---
import { publicCache } from '@/server/http/cache';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import EventArchive from '@/components/EventArchive.astro';
import BuilderIndex from '@/components/BuilderIndex.astro';
import ProjectGroup from '@/components/ProjectGroup.astro';
import PracticeLibrary from '@/components/PracticeLibrary.astro';
import SubmitPanel from '@/components/SubmitPanel.astro';
import { official, site } from '@/data';
import { isLive } from '@/lib/city';
import { dateParts, formatDate, formatDateLong } from '@/lib/datetime';
import { eventLabel } from '@/lib/event-display';
import { eventPlate } from '@/lib/event-plate';
import { distanceKm } from '@/lib/geo';
import { asset } from '@/lib/images';
import { cardProps } from '@/lib/project-display';
import { isCityIndexable } from '@/lib/indexable';
import { titles, trail } from '@/lib/seo';
import { plural } from '@/lib/words';

const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/not-found/');

const city = selectors.getCity(slug);
if (!city) return Astro.rewrite('/not-found/');

const signal = selectors.citySignal(city);
const live = isLive(signal.state);
const image = asset(city.image);
const nationalNext = selectors.nextEvent();

// The nearest city with activity — a real, useful fact for a quiet city.
const elsewhere = selectors.publicCities
  .filter((other) => other.slug !== city.slug && isLive(selectors.citySignal(other).state))
  .map((other) => ({ other, km: distanceKm(city, other) }))
  .sort((a, b) => a.km - b.km)[0];

// Rendered only when it exists. A "Practice" heading with an empty state
// under it on all fourteen city pages would be fourteen promises.
const practice = selectors.useCasesInCity(city.slug);

// Made in {city}: one group per public event the projects were built at, newest first. Only a public
// event resolves (eventBySlug), so a header never names a hidden one; the rest close the list.
const byEvent = new Map<string | undefined, ReturnType<typeof selectors.projectsInCity>>();
for (const p of selectors.projectsInCity(city.slug)) {
  const key =
    p.builtAtEventSlug && selectors.eventBySlug.has(p.builtAtEventSlug)
      ? p.builtAtEventSlug
      : undefined;
  byEvent.set(key, [...(byEvent.get(key) ?? []), p]);
}
const madeHere = [...byEvent]
  .map(([eventSlug, projects]) => ({
    event: eventSlug ? selectors.eventBySlug.get(eventSlug) : undefined,
    items: projects.sort((a, b) => a.title.localeCompare(b.title)).map((p) => cardProps(p)),
  }))
  .sort((a, b) => (!a.event ? 1 : !b.event ? -1 : b.event.date.localeCompare(a.event.date)));

const crumbs = trail(
  { name: 'Cities', href: '/cities' },
  { name: city.name, href: `/cities/${city.slug}` },
);

// "Delhi, Delhi" would say the name twice.
const place = city.state === city.name ? city.name : `${city.name}, ${city.state}`;

const description = live
  ? `The Claude community in ${place}. ${plural(signal.heldCount, 'event')} held${signal.next ? `, next on ${formatDate(signal.next.date)}` : ''}.`
  : `No Claude community events in ${city.name} yet. Register your city or find the nearest event.`;

// A quiet city's tab does not claim a community its H1 deliberately doesn't.
const pageTitle = live ? titles.city(city.name) : `${place} | ${site.wordmark}`;

const schema = [
  {
    '@type': 'CollectionPage',
    name: pageTitle,
    description,
    url: `${site.url}/cities/${city.slug}/`,
    contentLocation: {
      '@type': 'Place',
      name: city.name,
      geo: {
        '@type': 'GeoCoordinates',
        latitude: city.lat,
        longitude: city.lon,
      },
    },
  },
];

// Navigable always, indexable only once there is something in it. The rule
// itself lives in `src/lib/indexable.ts` because the sitemap reads it too.
const indexable = isCityIndexable(city, _rs);

// Grounds alternate over the sections that actually render, so two bands of the same tone never meet.
let ground: 'paper' | 'sunk' = 'paper'; // the page head
const next = (shown: boolean) =>
  shown ? (ground = ground === 'paper' ? 'sunk' : 'paper') : ground;
const tone = {
  status: next(!live || !!image || !!city.links?.length),
  events: next(signal.eventCount > 0),
  builders: next(signal.builderCount > 0),
  projects: next(signal.projectCount > 0),
  practice: next(practice.length > 0),
  register: next(true),
};
---

<Base
  title={place}
  seoTitle={pageTitle}
  description={description}
  active="/cities"
  breadcrumbs={crumbs}
  noindex={!indexable}
  schema={schema}
>
  <PageIntro
    title={live ? `Claude Community in ${city.name}` : city.name}
    size={live ? 'md' : 'lg'}
  />

  {
    (!live || image || (city.links && city.links.length > 0)) && (
      <Section id="status" tone={tone.status} labelledby="status-heading">
        <div class="status">
          {/* A live city's h2 is out of flow, so the photo takes the first column. */}
          {live ? (
            <h2 id="status-heading" class="visually-hidden">
              About {city.name}
            </h2>
          ) : (
            <div class="status-main">
              <h2 id="status-heading" class="status-title">
                No Claude community events in {city.name} yet.
              </h2>
              <div class="quiet">
                <div class="quiet-actions">
                  <a class="btn btn-primary" href="#register">
                    Register {city.name}
                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path
                        d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                  {nationalNext && (
                    <a class="link" href={`/events/${nationalNext.slug}/`}>
                      {`Next event: ${nationalNext.title}, ${dateParts(nationalNext.date).day} ${dateParts(nationalNext.date).monthShort}`}
                      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path
                          d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  )}
                </div>
                <p class="meta quiet-note">
                  Want to host events in {city.name}?{' '}
                  <a href={official.ambassadorProgramUrl} target="_blank" rel="noopener">
                    Apply to Anthropic’s Ambassador programme
                  </a>
                </p>
              </div>
            </div>
          )}

          <div class="status-side">
            {image && (
              <figure class="status-image">
                <Image
                  src={image}
                  alt={`${city.name}, ${city.state}`}
                  widths={[420, 800]}
                  sizes="(max-width: 61.99em) 90vw, 620px"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </figure>
            )}

            {!live && elsewhere && (
              <p>
                <a class="link" href={`/cities/${elsewhere.other.slug}/`}>
                  {`Nearest community: ${elsewhere.other.name}, ${elsewhere.km} km`}
                  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path
                      d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </p>
            )}

            {city.links && city.links.length > 0 && (
              <div class="city-links">
                <h3 class="channels-head">Local channels</h3>
                <ul>
                  {city.links.map((link) => (
                    <li>
                      <a class="btn btn-sm" href={link.url} target="_blank" rel="noopener">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </Section>
    )
  }

  {
    signal.eventCount > 0 && (
      <Section id="events" tone={tone.events} labelledby="events-heading">
        <EventArchive
          citySlug={city.slug}
          heading={`Events in ${city.name}`}
          order="chronological"
          selectors={selectors}
        />
      </Section>
    )
  }

  {
    signal.builderCount > 0 && (
      <Section id="builders" tone={tone.builders} labelledby="builders-heading">
        <BuilderIndex
          citySlug={city.slug}
          heading={`Building in ${city.name}`}
          selectors={selectors}
        />
      </Section>
    )
  }

  {
    signal.projectCount > 0 && (
      <Section id="projects" tone={tone.projects} labelledby="projects-heading">
        <div class="section-head">
          <h2 id="projects-heading">Made in {city.name}</h2>
        </div>
        {madeHere.map(({ event, items }) =>
          event ? (
            <ProjectGroup
              id={`g-${event.slug}`}
              title={eventLabel(event.title, event.shortTitle ?? null, city.name)}
              meta={`${formatDateLong(event.date)} · ${plural(items.length, 'project')}`}
              href={`/events/${event.slug}/`}
              plate={eventPlate(event)}
              items={items}
              level="h3"
            />
          ) : (
            <ProjectGroup
              id="g-independent"
              title="Independent projects"
              meta={plural(items.length, 'project')}
              items={items}
              level="h3"
            />
          ),
        )}
      </Section>
    )
  }

  {
    practice.length > 0 && (
      <Section id="practice" tone={tone.practice} labelledby="practice-library-heading">
        <PracticeLibrary
          citySlug={city.slug}
          heading={`How ${city.name} works with Claude`}
          selectors={selectors}
        />
      </Section>
    )
  }

  <Section id="register" tone={tone.register} labelledby="city-heading">
    <SubmitPanel formId="city" />
  </Section>
</Base>

<style>
  .status {
    display: grid;
    gap: var(--head-after);
  }

  .status-title {
    max-width: 18ch;
    font-size: var(--t-h2);
  }

  /* --- Quiet cities --------------------------------------------------------- */
  .quiet-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: var(--head-after);
  }

  .quiet-note {
    max-width: 60ch;
    margin-top: var(--head-after);
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .quiet-note a {
    color: var(--ink-2);
  }

  .quiet-note a:hover {
    color: var(--ink);
  }

  /* --- Side ------------------------------------------------------------------ */
  .status-side {
    display: grid;
    gap: 28px;
    align-content: start;
  }

  .status-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .channels-head {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .city-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 12px;
  }

  /* Grounds alternate here, so the events list always ends against a ground change, even on
     paper. Count the band's padding from the last plate, as EventRecord does for sunk bands. */
  :global(#events > .section-body > .archive:last-child > .erecord:last-child) {
    margin-bottom: -12px;
  }

  @media (min-width: 62em) {
    .status {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: clamp(40px, 4vw, 72px);
      align-items: start;
    }
  }
</style>
