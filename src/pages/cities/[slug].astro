---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import EventArchive from '@/components/EventArchive.astro';
import BuilderIndex from '@/components/BuilderIndex.astro';
import ProjectArchive from '@/components/ProjectArchive.astro';
import PracticeLibrary from '@/components/PracticeLibrary.astro';
import SubmitPanel from '@/components/SubmitPanel.astro';
import { citySignal, nextEvent, official, publicCities, site, useCasesInCity } from '@/data';
import { CITY_STATE_LABEL, CITY_STATE_NOTE, isLive } from '@/lib/city';
import { dateParts, formatDate } from '@/lib/datetime';
import { distanceKm, formatCoords } from '@/lib/geo';
import { asset } from '@/lib/images';
import { lifecycleLabel, lifecycleOf, lifecycleTone } from '@/lib/status';
import { isCityIndexable } from '@/lib/indexable';
import { titles, trail } from '@/lib/seo';

export const getStaticPaths = (() =>
  publicCities.map((city) => ({
    params: { slug: city.slug },
    props: { city },
  }))) satisfies GetStaticPaths;

const { city } = Astro.props;

const signal = citySignal(city);
const live = isLive(signal.state);
const ambassador = signal.ambassadors[0];
const image = asset(city.image);
const nationalNext = nextEvent();

// The nearest city with activity — a real, useful fact for a quiet city.
const elsewhere = publicCities
  .map((other) => ({ other, s: citySignal(other) }))
  .filter(({ other, s }) => other.slug !== city.slug && isLive(s.state))
  .map(({ other, s }) => ({ other, s, km: distanceKm(city, other) }))
  .sort((a, b) => a.km - b.km)[0];

// Rendered only when it exists. A "Practice" heading with an empty state
// under it on all fourteen city pages would be fourteen promises.
const practice = useCasesInCity(city.slug);

const crumbs = trail(
  { name: 'Cities', href: '/cities' },
  { name: city.name, href: `/cities/${city.slug}` },
);

// Navigable always, indexable only once there is something in it. The rule
// itself lives in `src/lib/indexable.ts` because the sitemap reads it too.
const indexable = isCityIndexable(city);

const description = live
  ? `The Claude community in ${city.name}, ${city.state}. ${signal.heldCount} events held${signal.next ? `, next on ${formatDate(signal.next.date)}` : ''}.`
  : `There is no verified Claude community activity in ${city.name} yet. Here is what is true, and what you can do about it.`;
---

<Base
  title={`${city.name}, ${city.state}`}
  seoTitle={titles.city(city.name)}
  description={description}
  active="/cities"
  breadcrumbs={crumbs}
  noindex={!indexable}
>
  <PageIntro
    eyebrow={`${city.state} · ${CITY_STATE_LABEL[signal.state]}`}
    title={city.name}
    stamp={formatCoords(city.lat, city.lon)}
    size="lg"
  >
    <p>{city.blurb}</p>
  </PageIntro>

  <Section id="status" tone="sunk" labelledby="status-heading">
    <div class="status">
      <div class="status-main">
        <span class:list={['chip', `chip-${signal.state}`]}>{CITY_STATE_LABEL[signal.state]}</span>
        <h2 id="status-heading" class="status-title">{CITY_STATE_NOTE[signal.state]}</h2>

        {
          ambassador && (
            <div class="status-amb">
              <span class="chip chip-verified">Verified</span>
              <p class="status-amb-line">
                <a href={`/builders/${ambassador.builderSlug ?? ambassador.slug}`}>
                  {ambassador.name}
                </a>{' '}
                is a {ambassador.title} here.
              </p>
              <p class="status-note">{ambassador.verifiedVia}.</p>
            </div>
          )
        }

        {
          city.organiser && (
            <p class="status-organiser">
              Community activity is organised locally by{' '}
              {city.organiser.url ? (
                <a href={city.organiser.url} target="_blank" rel="noopener">
                  {city.organiser.name}
                </a>
              ) : (
                city.organiser.name
              )}
              .
            </p>
          )
        }

        {
          city.reported && (
            <p class="status-reported">
              The organisers report {city.reported.members}+ people in the community
              {city.reported.prototypes
                ? ` and ${city.reported.prototypes}+ prototypes shipped`
                : ''}
              .
              <span class="status-note">{`Self-reported and not independently verified — ${city.reported.source}.`}</span>
            </p>
          )
        }

        {
          !live && (
            <div class="quiet">
              <p class="quiet-copy">
                No events, no Ambassador, and no waiting list. That is the whole status, and this
                page will not pretend otherwise.
              </p>
              <p class="quiet-copy">
                If you are building with Claude in {city.name}, registering your city is the useful
                thing to do. It is a signal about where people are — not an application, and it does
                not create a chapter.
              </p>
              <div class="quiet-actions">
                <a class="btn btn-solid" href="#register">
                  <span>Register {city.name}</span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
                {nationalNext && (
                  <a class="link-arrow" href={`/events/${nationalNext.slug}`}>
                    <span>{`Next anywhere: ${dateParts(nationalNext.date).dayPadded} ${dateParts(nationalNext.date).monthDisplay}`}</span>
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                )}
              </div>
              <p class="quiet-note">
                {site.ambassadorNote}{' '}
                <a href={official.ambassadorProgramUrl} target="_blank" rel="noopener">
                  Their programme
                </a>{' '}
                is the route if you want to host Claude Community events here.
              </p>
            </div>
          )
        }

        {
          signal.next && (
            <a class="status-next" href={`/events/${signal.next.slug}`}>
              <span class:list={['pip', `pip-${lifecycleTone(lifecycleOf(signal.next))}`]}>
                {lifecycleLabel(lifecycleOf(signal.next))}
              </span>
              <span class="status-next-date">
                {`${dateParts(signal.next.date).dayPadded} ${dateParts(signal.next.date).monthDisplay}`}
              </span>
              <span class="status-next-title">{signal.next.title}</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>

      <div class="status-side">
        <dl class="facts">
          <div>
            <dt>Coordinates</dt>
            <dd class="coords">{formatCoords(city.lat, city.lon)}</dd>
          </div>
          <div>
            <dt>State</dt>
            <dd>{city.state}</dd>
          </div>
          <div>
            <dt>Events held</dt>
            <dd>{String(signal.heldCount).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>On the calendar</dt>
            <dd>{String(signal.eventCount - signal.heldCount).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>Builders indexed</dt>
            <dd>{String(signal.builderCount).padStart(2, '0')}</dd>
          </div>
          <div>
            <dt>Projects archived</dt>
            <dd>{String(signal.projectCount).padStart(2, '0')}</dd>
          </div>
        </dl>

        {
          image && (
            <figure class="status-image">
              <div class="plate plate-framed">
                <Image
                  src={image}
                  alt={`${city.name}, ${city.state}`}
                  widths={[420, 800]}
                  sizes="(max-width: 61.99em) 90vw, 340px"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="plate-caption">
                <span>{city.name}</span>
                <span>{formatCoords(city.lat, city.lon, 1)}</span>
              </figcaption>
            </figure>
          )
        }

        {
          !live && elsewhere && (
            <div class="nearest">
              <h3 class="label nearest-head">Nearest activity</h3>
              <a class="nearest-link" href={`/cities/${elsewhere.other.slug}`}>
                <span class="nearest-name">{elsewhere.other.name}</span>
                <span class="nearest-km">{`${elsewhere.km} km away`}</span>
                <span class="nearest-state">{CITY_STATE_LABEL[elsewhere.s.state]}</span>
              </a>
            </div>
          )
        }

        {
          city.links && city.links.length > 0 && (
            <div class="city-links">
              <h3 class="label nearest-head">Local channels</h3>
              <ul>
                {city.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </Section>

  {
    signal.eventCount > 0 && (
      <Section id="events" labelledby="events-heading">
        <EventArchive
          citySlug={city.slug}
          heading={`Events in ${city.name}`}
          eyebrow="Events"
          order="chronological"
        />
      </Section>
    )
  }

  {
    signal.builderCount > 0 && (
      <Section id="builders" tone="sunk" labelledby="builders-heading">
        <BuilderIndex
          citySlug={city.slug}
          heading={`Building in ${city.name}`}
          eyebrow="Builders"
        />
      </Section>
    )
  }

  {
    live && (
      <Section id="projects" tone="deep" size="lg" labelledby="projects-heading">
        <ProjectArchive citySlug={city.slug} heading={`Made in ${city.name}`} eyebrow="Projects" />
      </Section>
    )
  }

  {
    practice.length > 0 && (
      <Section id="practice" labelledby="practice-library-heading">
        <PracticeLibrary
          citySlug={city.slug}
          heading={`How ${city.name} works with Claude`}
          eyebrow="Practice"
        />
      </Section>
    )
  }

  <Section id="register" tone={live ? 'sunk' : 'paper'} labelledby="city-heading">
    <SubmitPanel formId="city" />
  </Section>
</Base>

<style>
  .status {
    display: grid;
    gap: var(--s-8);
  }

  .status-title {
    margin-top: var(--s-4);
    font-size: var(--t-h2);
    max-width: 18ch;
  }

  /* --- Ambassador ---------------------------------------------------------- */
  .status-amb {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    margin-top: var(--s-6);
    padding: var(--s-5);
    border: var(--border-hair) solid var(--rule-strong);
    border-left: 2px solid var(--clay);
    background: var(--paper-raised);
  }

  .status-amb-line {
    font-size: var(--t-small);
  }

  .status-organiser {
    margin-top: var(--s-5);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .status-reported {
    margin-top: var(--s-5);
    max-width: 56ch;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .status-note {
    display: block;
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--ink-3);
  }

  /* --- Quiet cities --------------------------------------------------------- */
  .quiet {
    margin-top: var(--s-6);
  }

  .quiet-copy {
    max-width: 56ch;
    color: var(--ink-2);
  }

  .quiet-copy + .quiet-copy {
    margin-top: var(--s-4);
  }

  .quiet-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }

  .quiet-note {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
    max-width: 60ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  /* --- Next ----------------------------------------------------------------- */
  .status-next {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    margin-top: var(--s-7);
    padding: var(--s-4) var(--s-5);
    border: var(--border-hair) solid var(--clay);
    background: var(--clay-tint);
    text-decoration: none;
    color: var(--ink);
  }

  .status-next-date {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    color: var(--clay-deep);
    font-variant-numeric: tabular-nums;
  }

  .status-next-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
  }

  .status-next .arrow {
    margin-left: auto;
  }

  /* --- Side ------------------------------------------------------------------ */
  .status-side {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--border-heavy) solid var(--ink);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .facts .coords {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--ink-2);
  }

  .status-image .plate {
    aspect-ratio: 4 / 3;
  }

  .nearest-head {
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .nearest-link {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    text-decoration: none;
    color: var(--ink);
  }

  .nearest-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .nearest-link:hover .nearest-name {
    color: var(--clay-deep);
  }

  .nearest-km,
  .nearest-state {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .city-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding-top: var(--s-4);
  }

  .city-links a {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
  }

  .city-links a:hover {
    color: var(--clay-deep);
  }

  @media (min-width: 62em) {
    .status {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
      gap: var(--s-9);
      align-items: start;
    }
  }
</style>
