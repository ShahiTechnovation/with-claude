---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import { official, publicAmbassadors, site, stewardship } from '@/data';
import { titles, trail } from '@/lib/seo';

/**
 * ABOUT — what this is, who runs it, and how to get something corrected.
 *
 * It deliberately does not restate the governance model. It links to it
 * (`/community`). Two versions of the same rules on two URLs drift apart.
 */
const crumbs = trail({ name: 'About', href: '/about' });

const description =
  'Who runs WITH CLAUDE, an independent volunteer-run Claude community in India, and how to get something corrected.';

/**
 * The CC BY 2.5 IN attribution for the India map's state lines (CityAtlas.astro). The owner
 * took it off the map (7 October 2026); the licence still needs it, so it lives here. One
 * string, so no formatter can put a line break (a rendered space) before the comma. Static
 * text: safe for set:html.
 */
const MAP_CREDIT =
  'State boundary maps are provided by <a href="https://projects.datameet.org/maps/">Data&#123;Meet&#125; Community Maps Project</a>, ' +
  'made available under the <a href="https://creativecommons.org/licenses/by/2.5/in/">Creative Commons Attribution 2.5 India</a> licence. ' +
  'Simplified and reprojected.';
---

<Base
  title="About"
  seoTitle={titles.about()}
  description={description}
  active="/about"
  breadcrumbs={crumbs}
>
  <PageIntro title="About WITH CLAUDE." size="lg">
    <p>{site.descriptor}</p>
  </PageIntro>

  <Section id="what" tone="sunk" labelledby="what-heading">
    <div class="two">
      <div>
        <h2 id="what-heading">An independent community.</h2>
        <p class="lead">
          It is run by volunteers and it is free. See <a href="/community/">who runs what</a>.
        </p>
      </div>

      <div>
        <a
          class="btn btn-ghost"
          href={official.ambassadorProgramUrl}
          target="_blank"
          rel="noopener"
        >
          <span>Anthropic’s Ambassador programme</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </Section>

  <Section id="corrections" labelledby="corrections-heading">
    <div class="two">
      <div>
        <h2 id="corrections-heading">If something here is wrong.</h2>
        <p class="lead">Tell us and it gets fixed.</p>
        <a
          class="btn btn-primary corrections-cta"
          href={stewardship.corrections.url}
          target="_blank"
          rel="noopener"
        >
          <span>{`Send a correction on ${stewardship.corrections.label}`}</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <ol class="steps">
        {stewardship.correctionSteps.map((step) => <li class="step">{step}</li>)}
      </ol>
    </div>
  </Section>

  <Section id="who" tone="sunk" labelledby="who-heading">
    <div class="section-head">
      <h2 id="who-heading">Who keeps this.</h2>
      <p class="lead">Volunteers, working with the communities that run the events.</p>
    </div>

    <ul class="stewards">
      {
        stewardship.maintainers.map((maintainer) => (
          <li class="steward">
            <span class="steward-name t-title">
              {maintainer.url ? (
                <a href={maintainer.url} target="_blank" rel="noopener">
                  {maintainer.name}
                </a>
              ) : (
                maintainer.name
              )}
            </span>
            <span class="steward-role">{maintainer.role}</span>
          </li>
        ))
      }
      {
        publicAmbassadors.map((ambassador) => (
          <li class="steward">
            <span class="steward-name t-title">{ambassador.name}</span>
            <span class="steward-role">{ambassador.title}</span>
          </li>
        ))
      }
    </ul>

    <p class="small map-credit" set:html={MAP_CREDIT} />
  </Section>
</Base>

<style>
  /* minmax(0, 1fr): an auto track grows to the longest word of a 48px h2
     and pushes the page sideways at 375. */
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
  }

  .two h2 {
    max-width: 14ch;
  }

  .two .lead {
    margin-top: var(--head-gap);
    max-width: 44ch;
  }

  /* ---- corrections ---- */

  .corrections-cta {
    margin-top: var(--s-6);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .step {
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
    color: var(--ink-2);
  }

  /* ---- stewards ---- */

  .stewards {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border-hair) solid var(--rule);
  }

  .steward {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  /* The sunk band's edge closes the list; a last rule and its padding would only add a tail. */
  .steward:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  /* The last band meets the footer, whose top padding finishes the gap: like a last
     paper section (Section.astro), it gives up half its bottom padding. */
  :global(#who) {
    padding-bottom: calc(var(--section-y) / 2);
  }

  .map-credit {
    margin-top: var(--s-8);
    max-width: 64ch;
  }

  .steward-role {
    font-size: var(--t-small);
    color: var(--ink-3);
    max-width: 62ch;
  }

  /* In one column the steps end the band, so its edge closes them. */
  @media (max-width: 59.99rem) {
    .step:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }

  @media (min-width: 60rem) {
    .two {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--s-10);
      align-items: start;
    }
  }
</style>
