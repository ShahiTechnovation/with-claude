---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import Participation from '@/components/Participation.astro';
import { faq, official, partners, publicAmbassadors, site } from '@/data';
import { trail } from '@/lib/seo';

const faqSchema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

/**
 * The three kinds of thing on this site, kept apart on purpose.
 *
 * This table is the governance model in plain English. It exists because the
 * failure mode of a community site is exactly this ambiguity: a visitor
 * assuming that a listing, a dot, or a self-submission means someone was
 * appointed to something.
 */
const entities = [
  {
    kind: 'Claude Community events',
    who: 'Claude Community Ambassadors',
    granted: 'Appointed by Anthropic',
  },
  {
    kind: 'Builders and contributors',
    who: 'Anyone building with Claude',
    granted: 'Self-submitted, then reviewed',
  },
  {
    kind: 'City interest',
    who: 'People who live there',
    granted: 'Registered by anyone',
  },
];
---

<Base
  title="How this works"
  description="How the Claude community in India is organised, who runs what, and what this website is and is not."
  active="/community"
  breadcrumbs={trail({ name: 'How this works', href: '/community' })}
  schema={faqSchema}
>
  <PageIntro title="Who runs what." size="lg">
    <p>
      {site.positioning} It is organised by volunteers, it is free, and it is not an Anthropic programme.
    </p>
  </PageIntro>

  <Section id="model" tone="sunk" labelledby="model-heading">
    <div class="section-head">
      <h2 id="model-heading">Three different things.</h2>
    </div>

    <div class="entities">
      <div class="entity entity-head" aria-hidden="true">
        <span>What</span>
        <span>Who</span>
        <span>How it is granted</span>
      </div>
      <ul>
        {
          entities.map((entity) => (
            <li class="entity">
              <span class="entity-kind t-title">{entity.kind}</span>
              <span class="entity-cell">{entity.who}</span>
              <span class="entity-cell">{entity.granted}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="ambassador" labelledby="ambassador-heading">
    <div class="amb">
      <div class="amb-main">
        <h2 id="ambassador-heading" class="amb-title">
          Hosting is <em>Anthropic’s</em> to grant.
        </h2>
        <p class="prose">
          Claude Community events are hosted by Claude Community Ambassadors, who are appointed by
          Anthropic.
        </p>
        <p class="prose">
          To run Claude Community events where you live, apply to Anthropic’s programme.
        </p>
        <a
          class="btn btn-primary amb-cta"
          href={official.ambassadorProgramUrl}
          target="_blank"
          rel="noopener"
        >
          <span>Become an Ambassador</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="amb-side">
        <h3 class="amb-side-head">Ambassadors in India</h3>
        {
          publicAmbassadors.length > 0 ? (
            <ul class="amb-list">
              {publicAmbassadors.map((ambassador) => (
                <li>
                  <a class="amb-name t-title" href={`/ambassadors/${ambassador.slug}/`}>
                    {ambassador.name}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="amb-empty meta">None yet.</p>
          )
        }
      </div>
    </div>
  </Section>

  <Section id="involved" labelledby="join-heading">
    <Participation />
  </Section>

  <Section id="faq" tone="sunk" labelledby="faq-heading">
    <div class="section-head">
      <h2 id="faq-heading">Questions</h2>
    </div>

    <div class="faq-list">
      {
        faq.map((item) => (
          <details name="faq">
            <summary>
              <span class="faq-q t-title">{item.q}</span>
              <span class="faq-marker" aria-hidden="true" />
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <Section id="partners" labelledby="partners-heading">
    <div class="section-head">
      <h2 id="partners-heading">Who helps</h2>
    </div>

    <ul class="partners">
      {
        partners.map((partner) => (
          <li>
            <span class="partner-name t-title">
              {partner.url ? (
                <a href={partner.url} target="_blank" rel="noopener">
                  {partner.name}
                </a>
              ) : (
                partner.name
              )}
            </span>
            <span class="partner-role meta">{partner.role}</span>
          </li>
        ))
      }
    </ul>
  </Section>
</Base>

<style>
  /* --- The model table ---------------------------------------------------- */
  .entities {
    border-top: var(--border-hair) solid var(--rule-strong);
  }

  .entity {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .entity-head {
    padding-block: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .entity-cell {
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  /* --- Ambassadors -------------------------------------------------------- */
  .amb {
    display: grid;
    gap: var(--s-8);
  }

  .amb-title {
    margin-bottom: var(--head-gap);
    max-width: 14ch;
  }

  .amb-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--clay-deep);
  }

  .amb .prose + .prose {
    margin-top: var(--s-4);
  }

  .amb-cta {
    margin-top: var(--s-6);
  }

  .amb-side-head {
    padding-bottom: var(--s-3);
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 400;
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .amb-list li {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding-block: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .amb-empty {
    padding-block: var(--s-5);
  }

  /* Both lists end their sections: the hairline that follows closes them, so the last row
     draws none and the two lines never stack. */
  .amb-list li:last-child,
  .partners li:last-child {
    border-bottom: 0;
  }

  /* --- FAQ ----------------------------------------------------------------- */
  .faq-list {
    border-top: var(--border-hair) solid var(--rule-strong);
  }

  .faq-list details {
    border-bottom: var(--border-hair) solid var(--rule);
  }

  /* The band's edge closes the list. The last question keeps its padding as hit area;
     the list just overlaps it into the section padding instead of stacking on it. */
  .faq-list {
    margin-bottom: calc(-1 * var(--s-5));
  }

  .faq-list details:last-child {
    border-bottom: 0;
  }

  .faq-list summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-5);
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary:hover .faq-q {
    color: var(--clay-deep);
  }

  .faq-marker {
    position: relative;
    width: 14px;
    height: 14px;
    justify-self: end;
    align-self: center;
  }

  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--ink-3);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .faq-marker::after {
    transform: rotate(90deg);
  }

  details[open] .faq-marker::after {
    transform: rotate(0deg);
  }

  .faq-a {
    padding: 0 0 var(--s-6);
    max-width: 68ch;
    color: var(--ink-2);
  }

  /* --- Partners ------------------------------------------------------------ */
  .partners {
    border-top: var(--border-hair) solid var(--rule);
  }

  .partners li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .partner-name a {
    text-decoration: none;
  }

  .partner-name a:hover {
    color: var(--clay-deep);
  }

  @media (min-width: 62em) {
    .amb {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--s-9);
      align-items: start;
    }
  }

  @media (max-width: 61.99em) {
    .entity {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }

    .entity-head {
      display: none;
    }
  }
</style>
