---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import Participation from '@/components/Participation.astro';
import { faq, official, partners, publicAmbassadors, site } from '@/data';
import { CITY_STATE_LABEL, CITY_STATE_NOTE, CITY_STATE_ORDER } from '@/lib/city';
import { trail } from '@/lib/seo';

const faqSchema = [
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];

/**
 * The three kinds of thing on this site, kept apart on purpose.
 *
 * This table is the governance model in plain English. It exists because the
 * failure mode of a community site is exactly this ambiguity: a visitor
 * assuming that a listing, a dot, or a self-submission means someone was
 * appointed to something.
 */
const entities = [
  {
    kind: 'Ambassador-led activity',
    who: 'Claude Community Ambassadors',
    granted: 'Appointed by Anthropic',
    onSite: 'Verified chip on events and cities',
  },
  {
    kind: 'Builders and contributors',
    who: 'Anyone building with Claude',
    granted: 'Self-submitted, then reviewed',
    onSite: 'Listed in the builder index',
  },
  {
    kind: 'City interest',
    who: 'People who live there',
    granted: 'Registered by anyone',
    onSite: 'A signal on the map — not a chapter',
  },
];
---

<Base
  title="How this works"
  description="How the Claude community in India is organised, who runs what, and what this website is and is not."
  active="/community"
  breadcrumbs={trail({ name: 'How this works', href: '/community' })}
  schema={faqSchema}
>
  <PageIntro eyebrow="How this works" title="Who runs what." stamp="Volunteer-run">
    <p>
      {site.positioning} It is organised by volunteers, it is free, and it is not an Anthropic programme.
    </p>
  </PageIntro>

  <Section id="model" tone="sunk" labelledby="model-heading">
    <div class="section-head">
      <p class="eyebrow">The model</p>
      <h2 id="model-heading">Three different things.</h2>
      <p class="prose">
        These get mixed together on most community sites, and mixing them is how people end up
        believing something was official when it was not.
      </p>
    </div>

    <div class="entities">
      <div class="entity entity-head" aria-hidden="true">
        <span>What</span>
        <span>Who</span>
        <span>How it is granted</span>
        <span>How it appears here</span>
      </div>
      <ul>
        {
          entities.map((entity) => (
            <li class="entity">
              <span class="entity-kind">{entity.kind}</span>
              <span class="entity-cell">{entity.who}</span>
              <span class="entity-cell">{entity.granted}</span>
              <span class="entity-cell">{entity.onSite}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="ambassador" labelledby="ambassador-heading">
    <div class="amb">
      <div class="amb-main">
        <p class="eyebrow">Ambassadors</p>
        <h2 id="ambassador-heading" class="amb-title">
          Hosting is <em>Anthropic’s</em> to grant.
        </h2>
        <p class="prose">
          Claude Community events are hosted globally by Claude Community Ambassadors. Ambassadors
          are appointed by Anthropic. This website records who holds the status where we can confirm
          it — it does not confer it, apply for it on anyone's behalf, or influence it.
        </p>
        <p class="prose">
          That is why arbitrary visitors cannot create an event here, and why no city on the map can
          be claimed. If you want to run Claude Community events where you live, the route is
          Anthropic's programme.
        </p>
        <a
          class="btn btn-solid amb-cta"
          href={official.ambassadorProgramUrl}
          target="_blank"
          rel="noopener"
        >
          <span>Become an Ambassador</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="amb-side">
        <h3 class="label amb-side-head">On the record</h3>
        {
          publicAmbassadors.length > 0 ? (
            <ul class="amb-list">
              {publicAmbassadors.map((ambassador) => (
                <li>
                  <span class="chip chip-verified">Verified</span>
                  <span class="amb-name">{ambassador.name}</span>
                  <span class="amb-role">{ambassador.title}</span>
                  <span class="amb-source">{ambassador.verifiedVia}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="amb-empty">No Ambassador status has been confirmed to us yet.</p>
          )
        }
        <p class="amb-note">
          Every entry names how the status was confirmed. If we cannot say how we know, there is no
          entry.
        </p>
      </div>
    </div>
  </Section>

  <Section id="cities" tone="sunk" labelledby="citystates-heading">
    <div class="section-head">
      <p class="eyebrow">Cities</p>
      <h2 id="citystates-heading">What a dot on the map means.</h2>
      <p class="prose">
        A city's state is derived from verified records. There is no field anyone can set to make a
        chapter appear, and no city is ever presented as available to claim.
      </p>
    </div>

    <ul class="states">
      {
        CITY_STATE_ORDER.map((state) => (
          <li class="state">
            <span class:list={['chip', `chip-${state}`]}>{CITY_STATE_LABEL[state]}</span>
            <span class="state-note">{CITY_STATE_NOTE[state]}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="involved" labelledby="join-heading">
    <Participation />
  </Section>

  <Section id="faq" tone="sunk" labelledby="faq-heading">
    <div class="section-head">
      <p class="eyebrow">Good to know</p>
      <h2 id="faq-heading">Questions</h2>
    </div>

    <div class="faq-list">
      {
        faq.map((item, i) => (
          <details name="faq">
            <summary>
              <span class="faq-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{item.q}</span>
              <span class="faq-marker" aria-hidden="true" />
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <Section id="partners" labelledby="partners-heading">
    <div class="section-head">
      <p class="eyebrow">Partners</p>
      <h2 id="partners-heading">Who helps</h2>
      <p class="prose">
        The organisations that host rooms, lend venues and co-run days — listed with what they
        actually did. No logo wall, and no implied endorsements.
      </p>
    </div>

    <ul class="partners">
      {
        partners.map((partner) => (
          <li>
            <span class="partner-name">
              {partner.url ? (
                <a href={partner.url} target="_blank" rel="noopener">
                  {partner.name}
                </a>
              ) : (
                partner.name
              )}
            </span>
            <span class="partner-role">{partner.role}</span>
          </li>
        ))
      }
    </ul>

    <p class="affiliation">{site.affiliation}</p>
  </Section>
</Base>

<style>
  /* --- The model table ---------------------------------------------------- */
  .entities {
    border-top: var(--border-heavy) solid var(--ink);
  }

  .entity {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .entity-head {
    padding-block: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .entity-kind {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .entity-cell {
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  /* --- Ambassadors -------------------------------------------------------- */
  .amb {
    display: grid;
    gap: var(--s-8);
  }

  .amb-title {
    margin-top: var(--s-3);
    margin-bottom: var(--s-5);
    font-size: var(--t-h2);
    max-width: 14ch;
  }

  .amb-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--clay-deep);
  }

  .amb .prose + .prose {
    margin-top: var(--s-4);
  }

  .amb-cta {
    margin-top: var(--s-6);
  }

  .amb-side-head {
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .amb-list li {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding-block: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .amb-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .amb-role {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clay-deep);
  }

  .amb-source,
  .amb-note,
  .amb-empty {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--ink-3);
  }

  .amb-note {
    margin-top: var(--s-4);
    max-width: 40ch;
  }

  .amb-empty {
    padding-block: var(--s-5);
  }

  /* --- City states --------------------------------------------------------- */
  .states {
    display: grid;
    gap: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    padding-top: var(--s-5);
  }

  .state {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--s-5);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .state .chip {
    justify-self: start;
  }

  .state-note {
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  /* --- FAQ ----------------------------------------------------------------- */
  .faq-list {
    border-top: var(--border-heavy) solid var(--ink);
  }

  .faq-list details {
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .faq-list summary {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-5);
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-num {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    color: var(--ink-3);
  }

  .faq-q {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .faq-list summary:hover .faq-q {
    color: var(--clay-deep);
  }

  .faq-marker {
    position: relative;
    width: 14px;
    height: 14px;
    justify-self: end;
    align-self: center;
  }

  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--ink-3);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .faq-marker::after {
    transform: rotate(90deg);
  }

  details[open] .faq-marker::after {
    transform: rotate(0deg);
  }

  .faq-a {
    padding: 0 0 var(--s-6) calc(4ch + var(--s-4));
    max-width: 68ch;
    color: var(--ink-2);
  }

  /* --- Partners ------------------------------------------------------------ */
  .partners {
    border-top: var(--border-hair) solid var(--rule);
  }

  .partners li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .partner-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
  }

  .partner-name a {
    text-decoration: none;
  }

  .partner-name a:hover {
    color: var(--clay-deep);
  }

  .partner-role {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .affiliation {
    margin-top: var(--s-6);
    max-width: 70ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
  }

  @media (min-width: 62em) {
    .amb {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--s-9);
      align-items: start;
    }
  }

  @media (max-width: 61.99em) {
    .entity {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }

    .entity-head {
      display: none;
    }

    .state {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>
