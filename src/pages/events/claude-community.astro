---
import { trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import EventRecord from '@/components/EventRecord.astro';
import { site } from '@/data';

/**
 * ANIKET SAHU'S CLAUDE EVENT HISTORY.
 *
 * This page used to carry its own inline copy of the event list, which had
 * already drifted from `src/data/events.ts`. It now renders `EventRecord`, the
 * same rows as /events/, read from the same selectors, so there is one event
 * record and one place to correct it.
 */
---

<Base
  title="Claude Event History"
  seoTitle={`Aniket Sahu | Claude Event History | ${site.wordmark}`}
  description="From community conversations and code workshops to builder-focused sessions and impact labs, Claude is being explored, built with, and shared across India's growing builder community."
  active="/events"
  breadcrumbs={trail(
    { name: 'Events', href: '/events' },
    { name: 'Claude Event History', href: '/events/claude-community' },
  )}
>
  <PageIntro title="Aniket Sahu's Claude Event History.">
    <p>
      From community conversations and code workshops to builder-focused sessions and impact labs,
      Claude is being explored, built with, and shared across India's growing builder community.
    </p>
  </PageIntro>

  <Section id="record">
    <EventRecord />
  </Section>
</Base>
