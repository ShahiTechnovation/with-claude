---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import {
  cityBySlug,
  cityName,
  eventsChronological,
  hostAmbassador,
  guidesForEvent,
  projectsFromEvent,
  publicEvents,
  site,
  coHostsOf,
  speakersOf,
  storiesForEvent,
  useCasesForEvent,
} from '@/data';
import {
  dateParts,
  formatDate,
  formatTime,
  formatTimeRange,
  isoDateTime,
  relativeDay,
} from '@/lib/datetime';
import { formatCoords } from '@/lib/geo';
import { asset, requireAsset } from '@/lib/images';
import { titles, trail } from '@/lib/seo';
import {
  formatName,
  isRegistrationOpen,
  lifecycleLabel,
  lifecycleOf,
  lifecycleTone,
} from '@/lib/status';

export const getStaticPaths = (() =>
  publicEvents.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }))) satisfies GetStaticPaths;

const { event } = Astro.props;

const lifecycle = lifecycleOf(event);
const parts = dateParts(event.date);
const city = cityBySlug.get(event.citySlug);
const speakers = speakersOf(event);
const coHosts = coHostsOf(event);
const ambassador = hostAmbassador(event);
const canRegister = isRegistrationOpen(event);
const cover = asset(event.coverImage);
const outputs = projectsFromEvent(event.slug);
const recaps = storiesForEvent(event.slug);
const isPast = lifecycle === 'past';

// An event with neither a cover nor photographs should not leave half the page
// empty — the record simply runs full width.
const hasAside = Boolean(cover || event.photos?.length);

const position = eventsChronological.findIndex((e) => e.slug === event.slug);
const previous = eventsChronological[position - 1];
const upNext = eventsChronological[position + 1];

const metaDescription = lifecycle === 'upcoming' && canRegister && event.registrationUrl
  ? `Register for ${event.title}: ${event.description ?? event.summary}`
  : (event.description ?? event.summary);

const schema = [
  {
    '@type': 'Event',
    name: `${event.title} · ${cityName(event.citySlug)}`,
    description: event.description ?? event.summary,
    url: `${site.url}/events/${event.slug}`,
    startDate: isoDateTime(event.date, event.startTime),
    ...(event.endTime ? { endDate: isoDateTime(event.date, event.endTime) } : {}),
    eventStatus:
      lifecycle === 'cancelled'
        ? 'https://schema.org/EventCancelled'
        : 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    isAccessibleForFree: event.free,
    location: {
      '@type': 'Place',
      name: event.venue.name,
      address: {
        '@type': 'PostalAddress',
        addressLocality: cityName(event.citySlug),
        addressCountry: 'IN',
      },
    },
    ...(event.registrationUrl
      ? {
          offers: {
            '@type': 'Offer',
            price: event.free ? '0' : undefined,
            priceCurrency: 'INR',
            url: event.registrationUrl,
            availability:
              lifecycle === 'sold-out'
                ? 'https://schema.org/SoldOut'
                : 'https://schema.org/InStock',
          },
        }
      : {}),
    organizer: { '@id': `${site.url}/#organization` },
  },
];

// What this room produced in writing. Part of the event content flywheel:
// one real event should be able to become a recap, a project and a workflow,
// each with its own page and its own value.
const practice = useCasesForEvent(event.slug);
const eventGuides = guidesForEvent(event.slug);

/**
 * Home → Events → Bhopal → Claude Conversation.
 *
 * The city sits in the trail because it is a real page one level up in how
 * people actually navigate: someone reading about an event in Pune wants
 * Pune next, not the national archive.
 */
const crumbs = trail(
  { name: 'Events', href: '/events' },
  { name: cityName(event.citySlug), href: `/cities/${event.citySlug}` },
  { name: event.title, href: `/events/${event.slug}` },
);
---

<Base
  title={`${event.title} · ${cityName(event.citySlug)}`}
  seoTitle={titles.event(event.title, cityName(event.citySlug))}
  description={metaDescription}
  active="/events"
  breadcrumbs={crumbs}
  schema={schema}
  image={event.coverImage}
  ogImageAlt={`Poster for ${event.title} in ${cityName(event.citySlug)}`}
>
  <PageIntro
    eyebrow={`${cityName(event.citySlug)} · ${formatName(event.format)}${event.volume ? ` · vol. ${String(event.volume).padStart(2, '0')}` : ''}`}
    title={event.title}
    stamp={city ? formatCoords(city.lat, city.lon) : undefined}
  >
    <p>{event.description ?? event.summary}</p>
    
    <div class="intro-facts">
      <p><strong>Date:</strong> <time datetime={isoDateTime(event.date, event.startTime)}>{formatDate(event.date)}</time></p>
      <p><strong>Location:</strong> <a href={`/cities/${event.citySlug}`}>{cityName(event.citySlug)}</a></p>
      {ambassador && (
        <p><strong>Host:</strong> <a href={`/builders/${ambassador.builderSlug ?? ambassador.slug}`}>{ambassador.name}</a></p>
      )}
    </div>
  </PageIntro>

  <Section id="detail" tone="sunk" labelledby="detail-heading">
    <h2 id="detail-heading" class="visually-hidden">Details</h2>
    <div class:list={['detail', { 'has-aside': hasAside }]}>
      <div class="detail-main">
        <div class="detail-status">
          <span class:list={['pip', `pip-${lifecycleTone(lifecycle)}`]}>
            {lifecycleLabel(lifecycle)}
          </span>
          <span class="detail-when">{relativeDay(event.date)}</span>
        </div>

        <p class="detail-date">
          <time datetime={isoDateTime(event.date, event.startTime)}>{formatDate(event.date)}</time>
        </p>
        <p class="detail-time">{formatTimeRange(event.startTime, event.endTime)}</p>

        {
          ambassador && (
            <div class="detail-host">
              <span class="chip chip-verified">Ambassador-led</span>
              <p class="detail-host-line">
                Hosted by{' '}
                <a href={`/builders/${ambassador.builderSlug ?? ambassador.slug}`}>
                  {ambassador.name}
                </a>
                , {ambassador.title}.
              </p>
              <p class="detail-host-note">
                Claude Community Ambassadors are appointed by Anthropic. This site records the
                status, it does not grant it.
              </p>
            </div>
          )
        }

        <dl class="detail-meta">
          <div>
            <dt class="label">Venue</dt>
            <dd>
              {event.venue.name}
              {event.venue.address && <span class="detail-sub">{event.venue.address}</span>}
              {
                event.venue.private && (
                  <span class="detail-sub">Shared with confirmed registrants</span>
                )
              }
            </dd>
          </div>
          <div>
            <dt class="label">City</dt>
            <dd><a href={`/cities/${event.citySlug}`}>{cityName(event.citySlug)}</a></dd>
          </div>
          <div>
            <dt class="label">Entry</dt>
            <dd>{event.free ? 'Free · approval required' : 'Ticketed'}</dd>
          </div>
          {
            coHosts.length > 0 && (
              <div>
                <dt class="label">Co-hosted by</dt>
                <dd>
                  {coHosts.map((person, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`/builders/${person.slug}`}>{person.name}</a>
                    </>
                  ))}
                </dd>
              </div>
            )
          }
          {
            event.host.organisations && event.host.organisations.length > 0 && (
              <div>
                <dt class="label">With</dt>
                <dd>{event.host.organisations.join(', ')}</dd>
              </div>
            )
          }
        </dl>

        {
          event.agenda && event.agenda.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">What happens</h3>
              <ol class="detail-agenda">
                {event.agenda.map((item) => (
                  <li>
                    {item.time && <span class="agenda-time">{formatTime(item.time)}</span>}
                    <span class="agenda-title">{item.title}</span>
                    {item.detail && <span class="detail-sub">{item.detail}</span>}
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        {
          speakers.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Led by</h3>
              <ul class="detail-people">
                {speakers.map((person) => (
                  <li>
                    <a href={`/builders/${person.slug}`}>{person.name}</a>
                    <span class="detail-sub">{person.role}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          event.outcomes && (
            <div class="detail-block">
              <h3 class="label detail-block-head">What happened</h3>
              <ul class="detail-outcomes">
                {event.outcomes.map((outcome) => (
                  <li>{outcome}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          outputs.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Built here</h3>
              <ul class="detail-people">
                {outputs.map((project) => (
                  <li>
                    <a href={`/projects/${project.slug}`}>{project.title}</a>
                    <span class="detail-sub">{project.summary}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          recaps.length > 0 && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Written up</h3>
              <ul class="detail-people">
                {recaps.map((story) => (
                  <li>
                    <a href={`/stories/${story.slug}`}>{story.title}</a>
                    <span class="detail-sub">{story.standfirst}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          (practice.length > 0 || eventGuides.length > 0) && (
            <div class="detail-block">
              <h3 class="label detail-block-head">Practice from this room</h3>
              <ul class="detail-people">
                {practice.map((useCase) => (
                  <li>
                    <a href={`/use-cases/${useCase.slug}`}>{useCase.title}</a>
                    <span class="detail-sub">{useCase.summary}</span>
                  </li>
                ))}
                {eventGuides.map((guide) => (
                  <li>
                    <a href={`/guides/${guide.slug}`}>{guide.title}</a>
                    <span class="detail-sub">{guide.standfirst}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          isPast && outputs.length === 0 && (
            <div class="detail-block detail-open">
              <h3 class="label detail-block-head">Build something here?</h3>
              <p class="detail-open-copy">
                Nothing from this room is in the archive yet. If you made something, it belongs on
                the record.
              </p>
              <a class="link-arrow" href="/join#build">
                <span>Submit your build</span>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          )
        }

        <div class="detail-actions">
          {
            canRegister && event.registrationUrl ? (
              <a class="btn btn-clay" href={event.registrationUrl} target="_blank" rel="noopener">
                <span>Register</span>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ) : (
              <span class="btn btn-quiet" aria-disabled="true">
                {lifecycleLabel(lifecycle)}
              </span>
            )
          }
          <a class="link-arrow" href="/events">
            <span>All events</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {
        hasAside && (
          <aside class="detail-aside">
            {cover && (
              <figure class="detail-cover">
                <div class="plate plate-framed">
                  <Image
                    src={cover}
                    alt={`Poster for ${event.title} in ${cityName(event.citySlug)}`}
                    widths={[360, 640]}
                    sizes="(max-width: 61.99em) 90vw, 340px"
                    loading="eager"
                    decoding="async"
                  />
                </div>
                <figcaption class="plate-caption">
                  <span>{`vol. ${String(event.volume ?? 0).padStart(2, '0')}`}</span>
                  <span>{`${parts.monthShort} ${parts.year}`}</span>
                </figcaption>
              </figure>
            )}

            {event.photos && event.photos.length > 0 && (
              <div class="detail-photos">
                <h3 class="label detail-block-head">From the room</h3>
                <ul>
                  {event.photos.map((photo, i) => (
                    <li>
                      <figure>
                        <div class="plate plate-framed plate-zoom">
                          <Image
                            src={requireAsset(photo.src)}
                            alt={photo.alt}
                            widths={[400, 700]}
                            sizes="(max-width: 61.99em) 90vw, 340px"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        <figcaption class="plate-caption">
                          <span>
                            {`Pl. ${String(event.volume ?? 0).padStart(2, '0')}/${String(i + 1).padStart(2, '0')}`}
                          </span>
                        </figcaption>
                      </figure>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        )
      }
    </div>
  </Section>

  <Section id="around" size="sm">
    <nav class="around" aria-label="Other events">
      {
        previous ? (
          <a class="around-link" href={`/events/${previous.slug}`}>
            <span class="around-dir">← Before</span>
            <span class="around-title">{previous.title}</span>
            <span class="around-meta">{formatDate(previous.date)}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        upNext && (
          <a class="around-link is-next" href={`/events/${upNext.slug}`}>
            <span class="around-dir">After →</span>
            <span class="around-title">{upNext.title}</span>
            <span class="around-meta">{formatDate(upNext.date)}</span>
          </a>
        )
      }
    </nav>
  </Section>
</Base>

<style>
  .intro-facts {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .intro-facts p + p {
    margin-top: var(--s-2);
  }

  .intro-facts a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .detail {
    display: grid;
    gap: var(--s-8);
  }

  .detail-status {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  .detail-when {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .detail-date {
    margin-top: var(--s-6);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .detail-time {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    letter-spacing: 0.05em;
    color: var(--clay-deep);
  }

  /* --- Host ---------------------------------------------------------------- */
  .detail-host {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    margin-top: var(--s-6);
    padding: var(--s-5);
    border: var(--border-hair) solid var(--rule-strong);
    border-left: 2px solid var(--clay);
    background: var(--paper-raised);
  }

  .detail-host-line {
    font-size: var(--t-small);
  }

  .detail-host-note {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--ink-3);
    max-width: 52ch;
  }

  /* --- Meta ---------------------------------------------------------------- */
  .detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .detail-meta dt {
    color: var(--ink-3);
    margin-bottom: var(--s-2);
  }

  .detail-meta dd {
    font-size: var(--t-small);
    line-height: 1.45;
  }

  .detail-sub {
    display: block;
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: var(--ink-3);
  }

  /* --- Blocks --------------------------------------------------------------- */
  .detail-block {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .detail-block-head {
    color: var(--ink-3);
    margin-bottom: var(--s-4);
  }

  .detail-agenda li,
  .detail-people li {
    padding-block: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .detail-agenda li:last-child,
  .detail-people li:last-child {
    border-bottom: 0;
  }

  .agenda-time {
    display: inline-block;
    min-width: 6ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.05em;
    color: var(--clay-deep);
  }

  .agenda-title,
  .detail-people a {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    text-decoration: none;
  }

  .detail-people a:hover {
    color: var(--clay-deep);
  }

  .detail-outcomes li {
    display: flex;
    gap: var(--s-3);
    padding-block: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .detail-outcomes li::before {
    content: '·';
    color: var(--clay-deep);
  }

  .detail-open-copy {
    max-width: 52ch;
    font-size: var(--t-small);
    color: var(--ink-2);
    margin-bottom: var(--s-4);
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-8);
  }

  /* --- Aside ---------------------------------------------------------------- */
  .detail-aside {
    display: grid;
    gap: var(--s-6);
    align-content: start;
  }

  .detail-cover .plate {
    aspect-ratio: 4 / 5;
  }

  .detail-photos ul {
    display: grid;
    gap: var(--s-5);
  }

  .detail-photos .plate {
    aspect-ratio: 3 / 2;
  }

  /* --- Around ---------------------------------------------------------------- */
  .around {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-5);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .around-link {
    display: grid;
    gap: var(--s-1);
    text-decoration: none;
    color: var(--ink);
    max-width: 22rem;
  }

  .is-next {
    text-align: right;
    justify-items: end;
  }

  .around-dir {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--clay-deep);
  }

  .around-title {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .around-link:hover .around-title {
    color: var(--clay-deep);
  }

  .around-meta {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  @media (min-width: 62em) {
    .detail.has-aside {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
      gap: var(--s-9);
      align-items: start;
    }
  }
</style>
