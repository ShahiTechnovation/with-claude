---
import { privateCache, publicCache } from '@/server/http/cache';
import { eventProjects } from '@/server/public/pages';
import { logReadFailure } from '@/server/public/read-failure';
import { directoryHref } from '@/server/public/projects';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import { site } from '@/data';
import {
  formatDate,
  formatDayLong,
  formatHours,
  formatTime,
  isoDateTime,
  relativeDay,
  istInstant,
  formatDateLong,
} from '@/lib/datetime';
import { eventPlate } from '@/lib/event-plate';
import { cardProps } from '@/lib/project-display';
import { listJoin } from '@/lib/words';
import { registrationLink } from '@/lib/attribution';
import { CREDIT_ROLE_LABEL } from '@/lib/credits';
import { requireAsset } from '@/lib/images';
import { titles, trail } from '@/lib/seo';
import {
  isForthcoming,
  isRegistrationOpen,
  lifecycleLabel,
  lifecycleOf,
  lifecycleTone,
} from '@/lib/status';

const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/not-found/');

const event = selectors.eventBySlug.get(slug);
if (!event) return Astro.rewrite('/not-found/');

const lifecycle = lifecycleOf(event);
const speakers = selectors.speakersOf(event);
const coHosts = selectors.coHostsOf(event);
const ambassador = selectors.hostAmbassador(event);
// The one venue rule (README rule 2): no private address, no venue that is only the city.
const venue = selectors.venueLabel(event);

/**
 * The credited ambassadors other than the headline host.
 *
 * `primary_host` is excluded because it is `ambassador` above and printing it
 * twice would read as two hosts. `speaker` is excluded because the page
 * already has a speakers block sourced from `event_speakers` — the curated
 * archive's record of who talked — and listing the same person under both
 * would imply two separate contributions.
 */
const otherCredits = selectors
  .eventCredits(event)
  .filter((entry) => entry.credit.role !== 'primary_host' && entry.credit.role !== 'speaker');
const canRegister = isRegistrationOpen(event);
/**
 * The registration href, with WITH CLAUDE attribution merged in. §26.
 *
 * The undecorated `event.registrationUrl` is still what goes into the JSON-LD
 * below — see `registrationLink()` for why a structured-data offer URL should
 * stay canonical.
 */
const registerHref = registrationLink(event.registrationUrl);
// Its cover, else the official Claude Community plate for this event (src/assets/plates/<slug>.jpg).
// The head draws it and the share card declares it, through the one helper, so they never disagree.
const plate = eventPlate(event);
/**
 * The URL to publish as this page's `og:image`.
 *
 * `event.coverImage` is a data-layer KEY, not a URL: `covers/cover-vol01.jpg`,
 * resolved against `src/assets/` by `asset()`. Passing the key itself to
 * `Base` — which this page did — had the layout turn it into
 * `https://www.withclaude.in/covers/cover-vol01.jpg` via `new URL(image,
 * site.url)`. The site has never served that path, so the eight events WITH a
 * cover advertised a 404 to every link unfurler while the nine without one
 * fell back to `/og-card.jpg` and worked.
 *
 * `plate.src` is the URL the image pipeline actually emits, so this declares
 * the same picture the page draws rather than a second, invented path. The
 * alternative was to `git mv` the covers into `public/` and declare a
 * root-relative path; the asset route is taken because it keeps content
 * hashing (a corrected picture is a NEW url, which is the only thing that
 * dislodges a card an unfurler has already cached) and because `/_astro/*` is
 * already served `immutable` by `vercel.json`, so it needs no deploy change.
 *
 * `undefined` for an event with no cover, which lets `Base`'s own
 * `/og-card.jpg` default apply — a generic card, never a broken one.
 */
const shareImage = plate?.src;
/**
 * Projects built here: the SAME query and visibility predicate as the
 * Project Directory (`publicProjectsForEvent`), joined on this event's UUID —
 * so the event page, its directory filter and every project's "Built at"
 * badge can never disagree about which projects, or how many.
 */
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
let projectsFailed = false;
const built = UUID.test(event.id)
  ? await eventProjects(event.id, 12).catch((error: unknown) => {
      // Unknown is not "none": the empty-room invitation below must not claim
      // there are no projects when we simply could not read them. The event
      // itself rendered, so this stays a 200 — but one the CDN never stores
      // (and still indexable): the next request should try again.
      logReadFailure('event-projects', error);
      privateCache(Astro, false);
      projectsFailed = true;
      return { items: [], total: 0 };
    })
  : { items: [], total: 0 };
const outputs = built.items;
const recaps = selectors.storiesForEvent(event.slug);
const isPast = lifecycle === 'past';

const position = selectors.eventsChronological.findIndex((e) => e.slug === event.slug);
const previous = selectors.eventsChronological[position - 1];
const upNext = selectors.eventsChronological[position + 1];

const metaDescription =
  lifecycle === 'upcoming' && canRegister && event.registrationUrl
    ? `Register for ${event.title}: ${event.description ?? event.summary}`
    : (event.description ?? event.summary);

const schema = [
  {
    '@type': 'Event',
    name: `${event.title} · ${selectors.cityName(event.citySlug)}`,
    description: event.description ?? event.summary,
    url: `${site.url}/events/${event.slug}/`,
    startDate: isoDateTime(event.date, event.startTime),
    ...(event.endTime ? { endDate: isoDateTime(event.date, event.endTime) } : {}),
    eventStatus:
      lifecycle === 'cancelled'
        ? 'https://schema.org/EventCancelled'
        : event.rescheduledFrom
          ? 'https://schema.org/EventRescheduled'
          : 'https://schema.org/EventScheduled',
    // schema.org's own field for a moved event: the date it was announced for.
    ...(event.rescheduledFrom ? { previousStartDate: event.rescheduledFrom } : {}),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    isAccessibleForFree: event.free,
    location: {
      '@type': 'Place',
      name: event.venue.name,
      address: {
        '@type': 'PostalAddress',
        addressLocality: selectors.cityName(event.citySlug),
        addressCountry: 'IN',
      },
    },
    ...(event.registrationUrl
      ? {
          offers: {
            '@type': 'Offer',
            price: event.free ? '0' : undefined,
            priceCurrency: 'INR',
            url: event.registrationUrl,
            availability:
              lifecycle === 'sold-out'
                ? 'https://schema.org/SoldOut'
                : 'https://schema.org/InStock',
          },
        }
      : {}),
    organizer: { '@id': `${site.url}/#organization` },
  },
];

// What this room produced in writing. Part of the event content flywheel:
// one real event should be able to become a recap, a project and a workflow,
// each with its own page and its own value.
const practice = selectors.useCasesForEvent(event.slug);
const eventGuides = selectors.guidesForEvent(event.slug);

/**
 * Home → Events → Bhopal → Claude Conversation.
 *
 * The city sits in the trail because it is a real page one level up in how
 * people actually navigate: someone reading about an event in Pune wants
 * Pune next, not the national archive.
 */
const crumbs = trail(
  { name: 'Events', href: '/events' },
  { name: selectors.cityName(event.citySlug), href: `/cities/${event.citySlug}` },
  { name: event.title, href: `/events/${event.slug}` },
);
// The head's one sentence. Short names keep the template line short, so prettier never breaks it
// and Astro never renders that break as a space before a comma.
const city = selectors.cityName(event.citySlug);
const cityHref = `/cities/${event.citySlug}/`;
const startsAt = isoDateTime(event.date, event.startTime);
const day = formatDayLong(event.date, true);
const hours = formatHours(event.startTime, event.endTime);
// Free entry needs approval: the same words as EventFeature ("free, with approval").
// Entry terms are for people still deciding to come: a room that is over keeps only where it was.
const entry = isForthcoming(event)
  ? `${event.free ? 'Free, with approval' : 'Ticketed'}${
      event.venue.private
        ? '; the venue is shared with confirmed registrants'
        : venue
          ? `, at ${venue}`
          : ''
    }.`
  : venue
    ? `At ${venue}.`
    : '';
// Only a room still ahead can go stale; a cancelled one must never flip to "Past".
const endsAt = !isForthcoming(event)
  ? undefined
  : event.endTime
    ? isoDateTime(event.date, event.endTime)
    : new Date(istInstant(event.date, event.startTime).getTime() + 2 * 3600000).toISOString();
// A regex, not a URL parse that can throw: registrationLink() passes a non-URL through unchanged.
const onLuma = /^https?:\/\/([^/?#]+\.)?(luma\.com|lu\.ma)([/?#:]|$)/i.test(registerHref ?? '');
const organisations = listJoin(event.host.organisations ?? []);
const hostHref = ambassador ? `/ambassadors/${ambassador.slug}/` : '';
const hostTail = organisations ? `, with ${organisations}.` : '.';
const hasHosts = Boolean(ambassador || organisations || coHosts.length || speakers.length);
const shown = outputs.slice(0, 6);
// The first photo spans both columns (a pair stays side by side); with an even count the last one
// does too, so none sits alone.
const wide = (i: number, n: number) => (i === 0 ? n !== 2 : n > 2 && n % 2 === 0 && i === n - 1);
const written = [
  ...recaps.map((story) => ({
    href: `/stories/${story.slug}/`,
    title: story.title,
    sub: story.standfirst,
  })),
  ...practice.map((useCase) => ({
    href: `/use-cases/${useCase.slug}/`,
    title: useCase.title,
    sub: useCase.summary,
  })),
  ...eventGuides.map((guide) => ({
    href: `/guides/${guide.slug}/`,
    title: guide.title,
    sub: guide.standfirst,
  })),
];
---

<Base
  title={`${event.title} · ${city}`}
  seoTitle={titles.event(event.title, city)}
  description={metaDescription}
  active="/events"
  breadcrumbs={crumbs}
  schema={schema}
  image={shareImage}
  ogImageAlt={`Poster for ${event.title} in ${city}`}
>
  <header class:list={['event-head', { 'has-plate': plate }]}>
    <i class="sunrise is-corner" aria-hidden="true"></i>
    <div class="container event-head-inner">
      {
        plate && (
          <Image
            class="event-plate"
            src={plate}
            alt={`Poster for ${event.title} in ${city}`}
            widths={[360, 720]}
            sizes="(min-width: 900px) 360px, min(360px, 100vw)"
            loading="eager"
            decoding="async"
          />
        )
      }
      <div class="event-copy">
        {
          lifecycle !== 'past' && (
            <p class="event-status" data-event-end={endsAt}>
              <span class:list={['pip', `pip-${lifecycleTone(lifecycle)}`]}>
                {lifecycleLabel(lifecycle)}
              </span>
              {lifecycle !== 'cancelled' && (
                <span class="event-when">{relativeDay(event.date)}</span>
              )}
            </p>
          )
        }
        <h1 class="t-h1 event-title">{event.title}</h1>
        <p class="lead event-lead">
          <time datetime={startsAt}>{day}</time>, {hours}, in <a href={cityHref}>{city}</a>. {entry}
        </p>
        {
          event.rescheduledFrom && (
            <p class="event-note">
              {lifecycle === 'cancelled'
                ? `Moved to ${formatDateLong(event.date)} from ${formatDateLong(event.rescheduledFrom).replace(/ \d{4}$/, '')}.`
                : `${isPast ? 'Held on' : 'Now on'} ${formatDateLong(event.date)}, rescheduled from ${formatDateLong(event.rescheduledFrom).replace(/ \d{4}$/, '')}.`}
            </p>
          )
        }
        {
          canRegister && registerHref && (
            <p class="event-actions">
              <a
                class="btn btn-primary event-register"
                href={registerHref}
                target="_blank"
                rel="noopener"
              >
                {onLuma ? 'Register on Luma' : 'Register'}
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M7 13l6.5-6.5M8 6.5h5.5V12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </p>
          )
        }
      </div>
    </div>
  </header>

  {/* One paper ground for About and Hosted by: one Section, each block a part under a hairline. */}
  <Section id="details">
    <section id="about" class="part" aria-labelledby="about-heading">
      <div class="event-body">
        <h2 id="about-heading" class="event-h2">About</h2>
        <p class="event-text">{event.description ?? event.summary}</p>
        {
          event.agenda && event.agenda.length > 0 && (
            <>
              <h3 class="event-h3">What happens</h3>
              <ol class="event-list">
                {event.agenda.map((item) => (
                  <li>
                    {item.time && <span class="event-sub">{formatTime(item.time)}</span>}
                    <span class="event-item">{item.title}</span>
                    {item.detail && <span class="event-sub">{item.detail}</span>}
                  </li>
                ))}
              </ol>
            </>
          )
        }
        {
          event.outcomes && event.outcomes.length > 0 && (
            <>
              <h3 class="event-h3">What happened</h3>
              <ul class="event-list">
                {event.outcomes.map((outcome) => (
                  <li class="event-text">{outcome}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </section>

    {
      hasHosts && (
        <section id="hosts" class="part" aria-labelledby="hosts-heading">
          <div class="event-body">
            <h2 id="hosts-heading" class="event-h2">
              Hosted by
            </h2>
            {ambassador ? (
              <p class="event-text">
                {/* One expression: a line break between </a> and the tail would render as a space. */}
                {['Hosted by ', <a href={hostHref}>{ambassador.name}</a>, hostTail]}
              </p>
            ) : (
              organisations && <p class="event-text">{`With ${organisations}.`}</p>
            )}
            {/*
            Everyone else credited on this room, if anyone is. Reads `event_hosts` through the
            selector, so a co-host or organiser credit added in the admin appears here without this
            page learning anything new about roles.
          */}
            {ambassador && otherCredits.length > 0 && (
              <p class="event-text">
                {[
                  'With ',
                  ...otherCredits.flatMap((credit, i) => [
                    i === 0 ? '' : i === otherCredits.length - 1 ? ' & ' : ', ',
                    <a href={`/ambassadors/${credit.ambassador.slug}/`}>
                      {credit.ambassador.name}
                    </a>,
                    ` (${CREDIT_ROLE_LABEL[credit.credit.role]})`,
                  ]),
                  '.',
                ]}
              </p>
            )}
            {coHosts.length > 0 && (
              <p class="event-text">
                {[
                  'Co-hosted by ',
                  ...coHosts.flatMap((person, i) => [
                    i === 0 ? '' : ', ',
                    <a href={`/builders/${person.slug}/`}>{person.name}</a>,
                  ]),
                  '.',
                ]}
              </p>
            )}
            {speakers.length > 0 && (
              <>
                <h3 class="event-h3">Led by</h3>
                <ul class="event-list">
                  {speakers.map((person) => (
                    <li>
                      <a class="event-item" href={`/builders/${person.slug}/`}>
                        {person.name}
                      </a>
                      <span class="event-sub">{person.role}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </section>
      )
    }
  </Section>

  {
    built.total > 0 && (
      <Section id="projects" tone="sunk" labelledby="projects-heading">
        <div class="section-head">
          <h2 id="projects-heading">Projects built here</h2>
          {built.total > shown.length && (
            <a class="link section-more" href={directoryHref({ events: [event.slug] })}>
              {`All ${built.total} projects`}
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path
                  d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          )}
        </div>
        <ProjectGrid items={shown.map((project) => cardProps(project))} />
      </Section>
    )
  }

  {
    projectsFailed && (
      <Section id="projects" tone="sunk" labelledby="projects-heading">
        <div class="section-head">
          <h2 id="projects-heading">Projects built here</h2>
        </div>
        <p class="event-text" role="status">
          The projects from this event could not be loaded right now.{' '}
          <a href="/projects/">See all projects</a>
        </p>
      </Section>
    )
  }

  {
    isPast && built.total === 0 && !projectsFailed && (
      <Section id="projects" tone="sunk" labelledby="projects-heading">
        <div class="event-body">
          <h2 id="projects-heading" class="event-h2">
            Build something here?
          </h2>
          <a class="link" href="/me/projects/new/">
            Submit your build
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </Section>
    )
  }

  {/* Photos, Written up and the neighbours share the paper ground too: one Section. */}
  {
    Boolean(event.photos?.length || written.length || previous || upNext) && (
      <Section id="more">
        {event.photos && event.photos.length > 0 && (
          <section id="photos" class="part" aria-labelledby="photos-heading">
            <div class="section-head">
              <h2 id="photos-heading">Photos</h2>
            </div>
            <ul class="event-photos">
              {event.photos.map((photo, i) => (
                <li class:list={{ 'is-wide': wide(i, event.photos!.length) }}>
                  <figure>
                    <Image
                      src={requireAsset(photo.src)}
                      alt={photo.alt}
                      widths={wide(i, event.photos!.length) ? [640, 1280, 1600] : [400, 800, 1280]}
                      sizes={
                        wide(i, event.photos!.length)
                          ? '(min-width: 1421px) 1296px, 92vw'
                          : '(min-width: 1421px) 638px, (min-width: 700px) 46vw, 92vw'
                      }
                      loading="lazy"
                      decoding="async"
                    />
                    {/* The caption is the alt text, shown; hidden from screen readers so it is not read twice. */}
                    <figcaption class="meta" aria-hidden="true">
                      {photo.alt}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )}

        {written.length > 0 && (
          <section id="written" class="part" aria-labelledby="written-heading">
            <div class="event-body">
              <h2 id="written-heading" class="event-h2">
                Written up
              </h2>
              <ul class="event-list">
                {written.map((item) => (
                  <li>
                    <a class="event-item" href={item.href}>
                      {item.title}
                    </a>
                    {item.sub && <span class="event-sub">{item.sub}</span>}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {(previous || upNext) && (
          <div id="around" class="part">
            <nav class="around" aria-label="Other events">
              {previous ? (
                <a class="around-link" href={`/events/${previous.slug}/`}>
                  <span class="around-dir">← Before</span>
                  <span class="around-title">{previous.title}</span>
                  <span class="around-meta">{formatDate(previous.date)}</span>
                </a>
              ) : (
                <span />
              )}
              {upNext && (
                <a class="around-link is-next" href={`/events/${upNext.slug}/`}>
                  <span class="around-dir">After →</span>
                  <span class="around-title">{upNext.title}</span>
                  <span class="around-meta">{formatDate(upNext.date)}</span>
                </a>
              )}
            </nav>
          </div>
        )}
      </Section>
    )
  }

  <script>
    // A stale CDN copy can outlive the event: once it has ended, say so and drop the Register button.
    const status = document.querySelector('.event-status[data-event-end]');
    const end = status?.getAttribute('data-event-end');
    if (status && end && Date.now() >= new Date(end).getTime()) {
      const pip = status.querySelector('.pip');
      if (pip) {
        pip.className = 'pip pip-archive';
        pip.textContent = 'Past';
      }
      status.querySelector('.event-when')?.remove();
      document.querySelector('.event-actions')?.remove();
    }
  </script>
</Base>

<style>
  .event-head {
    position: relative;
    /* clip, as in PageIntro: the corner sun must not be pannable on iOS. */
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    padding-block: clamp(40px, 5vw, 72px) clamp(20px, 2.2vw, 32px); /* PageIntro's */
  }

  .event-head-inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }

  .event-plate {
    display: block;
    width: 100%;
    max-width: 360px;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--glow-tile);
  }

  .event-copy {
    display: grid;
    gap: var(--head-gap);
    justify-items: start;
    min-width: 0;
  }

  .event-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .event-when {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .event-title {
    color: var(--ink);
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .event-lead {
    max-width: 48ch;
    color: var(--ink-2);
  }

  .event-lead a,
  .event-text a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 3px;
  }

  .event-lead a:hover,
  .event-text a:hover {
    text-decoration-color: var(--clay);
  }

  .event-note {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .event-actions {
    margin-top: var(--s-3);
  }

  @media (min-width: 900px) {
    .event-head.has-plate .event-head-inner {
      grid-template-columns: minmax(0, 1fr) 360px;
    }

    .event-plate {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* As after a PageIntro: the head's own padding already opens the gap. */
  .event-head + :global(#details) {
    padding-top: calc(var(--section-y) / 2);
  }

  /* --- Parts: blocks that share a ground, one Section with a hairline between. */
  .part + .part {
    margin-top: calc(var(--section-y) * 0.4);
    padding-top: calc(var(--section-y) * 0.4);
    border-top: 1px solid var(--rule);
  }

  /* With no projects band between them the two paper Sections meet like parts. */
  :global(#details:has(+ #more)) {
    padding-bottom: calc(var(--section-y) * 0.4);
  }

  :global(#details + #more) {
    padding-top: calc(var(--section-y) * 0.4);
  }

  /* The projects band ends on cards whose own bottom padding already opens the joint,
     so both sides of it give up a quarter of theirs. */
  :global(#projects:has(.pgrid):has(+ #more)) {
