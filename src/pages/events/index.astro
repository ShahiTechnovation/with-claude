---
import { publicCache } from '@/server/http/cache';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import EventRecord from '@/components/EventRecord.astro';
import EventFeature from '@/components/EventFeature.astro';
import { formatDate } from '@/lib/datetime';

/**
 * THE EVENT RECORD.
 *
 * What is coming next, the Luma calendar, then every other event by year, newest first.
 */
const next = selectors.nextEvent();

const description = next
  ? `Every Claude community event in India, past and upcoming. Next: ${next.title} in ${selectors.cityName(next.citySlug)}, ${formatDate(next.date)}.`
  : 'Every Claude community event in India, past and upcoming.';
---

<Base
  title="Events"
  seoTitle={titles.events()}
  description={description}
  active="/events"
  breadcrumbs={trail({ name: 'Events', href: '/events' })}
>
  <PageIntro title="Claude Events in India" size="lg">
    <p>
      Claude community events, meetups and workshops across India. Free, open and run by volunteers.
    </p>
  </PageIntro>

  {
    next && (
      <Section id="next" labelledby="next-heading">
        <EventFeature event={next} selectors={selectors} allEvents={false} priority />
      </Section>
    )
  }

  <Section id="calendar" tone="sunk" labelledby="calendar-heading">
    <h2 id="calendar-heading" class="visually-hidden">Event calendar</h2>
    <div class="calendar">
      <iframe
        id="luma-calendar"
        src="https://luma.com/embed/calendar/cal-Rmfu84P0S7JWiHl/events?lt=dark&tag=Claude"
        width="100%"
        height="450"
        title="Upcoming Claude events on Luma"
        allowfullscreen=""></iframe>
    </div>
    <!-- Luma's `lt` follows the page theme: the saved theme is already applied by the time
         this runs, and the masthead toggle flips `data-theme` on <html>. -->
    <script is:inline>
      (function (frame, root) {
        function wanted() {
          var lt = 'lt=' + (root.dataset.theme === 'light' ? 'light' : 'dark');
          return frame.src.replace(/lt=(light|dark)/, lt);
        }
        // Always set it once: a page rebuilt by Back restores the frame's last URL whatever
        // the attribute says. The frame is still loading, so this adds no history entry.
        frame.src = wanted();
        // A theme flip swaps in a fresh frame: re-pointing a loaded one adds a Back entry.
        new MutationObserver(function () {
          var src = wanted();
          if (src === frame.src) return;
          var next = frame.cloneNode();
          next.src = src;
          frame.replaceWith(next);
          frame = next;
        }).observe(root, { attributeFilter: ['data-theme'] });
      })(document.getElementById('luma-calendar'), document.documentElement);
    </script>
  </Section>

  <Section id="record">
    <EventRecord selectors={selectors} exclude={next?.slug} />
  </Section>
</Base>

<style>
  /* The panel's grey is the official one closest to the embed's own ground in either theme. */
  .calendar {
    max-width: 800px;
    margin-inline: auto;
    padding: 16px;
    background: var(--paper-raised-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }

  :global([data-theme='light']) .calendar {
    background: var(--paper);
  }

  .calendar iframe {
    display: block;
    border: 0;
    border-radius: var(--radius-md);
  }

  /* Print is light and drops backgrounds: a dark-theme embed would print white on white.
     The event record below still prints. */
  @media print {
    :global(#calendar) {
      display: none;
    }
  }
</style>
