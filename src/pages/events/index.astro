---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import NextEvent from '@/components/NextEvent.astro';
import EventArchive from '@/components/EventArchive.astro';
import { cityName, nextEvent, pastEvents, publicEvents, upcomingEvents } from '@/data';
import { formatDate } from '@/lib/datetime';

const next = nextEvent();
const upcoming = upcomingEvents();
const past = pastEvents();

const description = next
  ? `Every Claude community event in India, past and upcoming. Next: ${next.title} in ${cityName(next.citySlug)}, ${formatDate(next.date)}.`
  : 'Every Claude community event in India, past and upcoming.';
---

<Base title="Events" description={description} active="/events">
  <PageIntro
    eyebrow="Events"
    title="Every room, on the record."
    stamp={`${publicEvents.length} events`}
    facts={[
      { label: 'Held', value: String(past.length).padStart(2, '0') },
      { label: 'Ahead', value: String(upcoming.length).padStart(2, '0') },
      {
        label: 'Cities',
        value: String(new Set(publicEvents.map((e) => e.citySlug)).size).padStart(2, '0'),
      },
    ]}
  >
    <p>
      Free, open, and run by volunteers. Status below is computed from the calendar every time this
      site builds — never from a badge someone forgot to change.
    </p>
  </PageIntro>

  {
    next && (
      <Section id="next" tone="sunk" labelledby="next-heading">
        <NextEvent />
      </Section>
    )
  }

  <Section id="record" labelledby="events-heading">
    <EventArchive heading="The full record" eyebrow="Archive" showLink={false} filters />
  </Section>
</Base>
