---
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import Section from '@/components/Section.astro';
import { trail } from '@/lib/seo';
---

<Base
  title="Share a practice"
  description="Share a Claude practice with the community."
  breadcrumbs={trail({ name: 'Share a practice', href: '/practice' })}
>
  <PageIntro title="Share a practice" size="lg">
    <p>
      Found a prompting technique or workflow that consistently delivers? Share it. Practices are
      attributed to your Builder Passport.
    </p>
  </PageIntro>

  <Section id="auth" labelledby="auth-heading" tone="sunk">
    <h2 id="auth-heading" class="visually-hidden">Coming soon</h2>
    <div class="auth-panel">
      <p>
        The story and practice creation flow is coming soon. For now, create your Builder Passport
        so your profile is ready.
      </p>
      <div class="auth-action">
        <a href="/me/" class="btn btn-primary">
          <span>Continue to profile</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .auth-panel {
    max-width: 36rem;
    padding: clamp(24px, 3vw, 40px);
    background: var(--paper-raised);
    border: var(--border-hair) solid var(--rule);
    border-radius: var(--radius-lg);
  }
  .auth-panel p {
    margin-bottom: var(--s-5);
    color: var(--ink-2);
  }
  .auth-action {
    display: flex;
  }
</style>
