---
/**
 * PROJECT DETAIL — server-rendered from four bounded queries.
 *
 * What changed, and why:
 *
 *   · "Built at" resolves through the project's event UUID. It used to look
 *     the UUID up in a map keyed by SLUG, so it never resolved.
 *   · Public means `published` + `clean` + not deleted — the same predicate as
 *     every list (`publicProjectWhere()`). `reported` used to be admitted here
 *     and excluded from the listing.
 *   · A missing or non-public project answers a real 404, not a redirect to a
 *     page that answers 200.
 *   · A moderator's render (controls, banner, possibly non-public content) is
 *     `private, no-store`. It used to carry the public CDN header, so the first
 *     moderator to view a restricted project could seed the CDN with it.
 *   · Public renders use the bounded TTL in `src/server/http/cache.ts`.
 */
export const prerender = false;

import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import NotFound from '@/components/NotFound.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ModeratorControls from '@/components/ModeratorControls.astro';
import { ReportModal } from '@/components/react/ReportModal';
import { site } from '@/data';
import { formatDate } from '@/lib/datetime';
import { resolveProjectCover } from '@/lib/project-cover';
import { formatName } from '@/lib/status';
import { titles, trail } from '@/lib/seo';
import { projectPage } from '@/server/public/pages';
import { isRequestModerator } from '@/server/moderation';
import { privateCache, publicCache } from '@/server/http/cache';

const slug = Astro.params.slug ?? '';
const loaded = await projectPage(slug);
/**
 * Who is asking matters only for a moderator, and only when they ask: on a
 * non-public record, or with `?moderate=1`. The query string is part of the
 * CDN cache key, so the plain public URL is never rendered per viewer and a
 * moderator's private render can never be cached under it.
 */
const wantsModeration = Astro.url.searchParams.has('moderate');
const isModerator =
  loaded && (!loaded.project.isPublic || wantsModeration)
    ? await isRequestModerator(Astro.request)
    : false;
const visible = loaded && (loaded.project.isPublic || isModerator);

if (!visible) {
  Astro.response.status = 404;
  publicCache(Astro);
} else if (isModerator || !loaded.project.isPublic) {
  privateCache(Astro);
} else {
  publicCache(Astro);
}

const project = loaded?.project;
const related = loaded?.related ?? [];
const cover = resolveProjectCover(project?.image);
const shareImage =
  cover.kind === 'blob' ? cover.blobUrl : cover.kind === 'asset' ? cover.imageMetadata!.src : undefined;

const documented = (text: string | null | undefined) => Boolean(text && text.trim());
/** Blank-line-separated paragraphs. Rendered as text, so nothing is markup. */
const paragraphs = (text: string | null | undefined) =>
  (text ?? '').split(/\r?\n\s*\r?\n/).map((p) => p.trim()).filter(Boolean);

const schema = project
  ? [
      {
        '@type': 'CreativeWork',
        name: project.title,
        description: project.summary ?? project.title,
        url: `${site.url}/projects/${project.slug}/`,
        ...(project.url ? { sameAs: [project.url] } : {}),
        ...(project.credits.length > 0
          ? { creator: project.credits.map((c) => ({ '@type': 'Person', name: c.name })) }
          : {}),
        ...(project.city ? { locationCreated: { '@type': 'Place', name: project.city.name } } : {}),
        ...(project.event ? { dateCreated: project.event.date } : {}),
        ...(project.tags.length > 0 ? { keywords: project.tags.join(', ') } : {}),
      },
    ]
  : [];

const crumbs = project
  ? trail(
      { name: 'Projects', href: '/projects/' },
      { name: project.title, href: `/projects/${project.slug}/` },
    )
  : undefined;
---

{
  !project || !visible ? (
    <Base title="Not found" description="That project is not part of the archive." noindex>
      <NotFound />
    </Base>
  ) : (
    <Base
      title={project.title}
      seoTitle={titles.project(project.title, project.city?.name ?? 'India')}
      description={project.summary ?? `${project.title} — made with Claude.`}
      active="/projects"
      breadcrumbs={crumbs}
      image={shareImage}
      ogImageAlt={`${project.title} — ${shareImage ? 'screenshot' : 'WITH CLAUDE'}`}
      schema={schema}
      noindex={!project.isPublic}
    >
      {!project.isPublic && (
        <div class="mod-banner" role="status">
          Not visible to the public — {project.publicationStatus} · {project.moderationState}.
          You are seeing it because you are a moderator.
        </div>
      )}

      <PageIntro
        eyebrow={[formatName(project.category), project.city?.name].filter(Boolean).join(' · ')}
        title={project.title}
        size="lg"
      >
        {project.summary && <p>{project.summary}</p>}
      </PageIntro>

      <Section id="detail" tone="sunk" labelledby="detail-heading">
        <h2 id="detail-heading" class="visually-hidden">About {project.title}</h2>

        <div class="project">
          <div class="project-main">
            <ProjectCover
              image={project.image}
              title={project.title}
              category={project.category}
              ratio="16/10"
              eager
              sizes="(max-width: 61.99em) 92vw, 760px"
            />

            {(project.url || project.repoUrl || project.videoUrl) && (
              <div class="project-actions">
                {project.url && (
                  <a class="btn btn-clay" href={project.url} target="_blank" rel="noopener noreferrer">
                    <span>Open the project</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                )}
                {project.repoUrl && (
                  <a class="btn" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                    <span>Source code</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                )}
                {project.videoUrl && (
                  <a class="btn btn-quiet" href={project.videoUrl} target="_blank" rel="noopener noreferrer">
                    <span>Watch the demo</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}

            <section class="block" aria-labelledby="about-heading">
              <h3 id="about-heading" class="label block-head">About the project</h3>
              {documented(project.description) ? (
                <div class="project-body">
                  {paragraphs(project.description).map((para) => <p>{para}</p>)}
                </div>
              ) : (
                <p class="not-documented">
                  {project.imported
                    ? 'The archive entry has a summary only. A longer description has not been documented.'
                    : 'A longer description has not been added yet.'}
                </p>
              )}
            </section>

            <section class="block usage" aria-labelledby="usage-heading">
              <h3 id="usage-heading" class="label block-head">How Claude was used</h3>
              {documented(project.claudeUsage) ? (
                <div class="usage-body">
                  {paragraphs(project.claudeUsage).map((para) => <p>{para}</p>)}
                </div>
              ) : (
                <p class="not-documented">Not documented.</p>
              )}
            </section>
          </div>

          <aside class="project-side" aria-label="Project facts">
            <dl class="facts">
              {project.event && (
                <div>
                  <dt>Built at</dt>
                  <dd>
                    <a href={`/events/${project.event.slug}/`}>{project.event.title}</a>
                    <span class="fact-sub">
                      <time datetime={project.event.date}>{formatDate(project.event.date)}</time>
                    </span>
                  </dd>
                </div>
              )}
              <div>
                <dt>{project.credits.length === 1 ? 'Made by' : 'Team'}</dt>
                <dd>
                  {project.credits.length > 0 ? (
                    <ul class="makers">
                      {project.credits.map((credit) => (
                        <li>
                          {credit.href ? <a href={credit.href}>{credit.name}</a> : <span>{credit.name}</span>}
                          {credit.role && <span class="fact-sub">{credit.role}</span>}
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <span class="quiet">Not credited</span>
                  )}
                </dd>
              </div>
              {project.city && (
                <div>
                  <dt>City</dt>
                  <dd>
                    <a href={`/cities/${project.city.slug}/`}>{project.city.name}</a>
                  </dd>
                </div>
              )}
              <div>
                <dt>Category</dt>
                <dd>
                  <a href={`/projects/?category=${project.category}`}>{formatName(project.category)}</a>
                </dd>
              </div>
              {project.useCases.length > 0 && (
                <div>
                  <dt>Written up</dt>
                  <dd>
                    {project.useCases.map((useCase) => (
                      <a href={`/use-cases/${useCase.slug}/`}>{useCase.title}</a>
                    ))}
                  </dd>
                </div>
              )}
            </dl>

            {project.tags.length > 0 && (
              <ul class="tags" aria-label="Tools and tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}

            {project.imported && (
              <p class="provenance">
                From an event archive, as the organisers recorded it. Not yet claimed by its team.{' '}
                <a href={`/me/projects/claim/?project=${project.slug}`}>Is this your project?</a>
              </p>
            )}

            <div class="side-actions">
              <ReportModal client:load entityType="project" entityId={project.id} />
              <ModeratorControls
                entityType="projects"
                entityId={project.id}
                initialState={project.moderationState}
                isModerator={isModerator}
              />
            </div>
          </aside>
        </div>
      </Section>

      {related.length > 0 && (
        <Section id="related" labelledby="related-heading">
          <div class="section-head">
            <p class="eyebrow">Keep exploring</p>
            <h2 id="related-heading">
              {project.event ? `More from ${project.event.title}` : `More from ${project.city?.name ?? 'the archive'}`}
            </h2>
          </div>
          <div class="related">
            {related.map((item) => (
              <ProjectCard project={item} />
            ))}
          </div>
        </Section>
      )}

      <Section id="back" size="sm">
        <a class="link-arrow" href="/projects/">
          <span>All projects</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </Section>
    </Base>
  )
}

<style>
  .mod-banner {
    padding: var(--s-3) var(--gutter);
    background: var(--clay-deep);
    color: var(--paper-raised);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    text-align: center;
  }

  .project {
    display: grid;
    gap: var(--s-8);
  }

  .project-main {
    display: grid;
    gap: var(--s-6);
    align-content: start;
    min-width: 0;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .block-head {
    margin-bottom: var(--s-3);
    color: var(--clay-deep);
  }

  .project-body,
  .usage-body {
    display: grid;
    gap: var(--s-4);
    max-width: 64ch;
    color: var(--ink-2);
  }

  .project-body {
    font-size: var(--t-lead);
  }

  .usage {
    padding: var(--s-5);
    border: var(--border-hair) solid var(--rule-strong);
    border-left: 2px solid var(--clay);
    background: var(--paper-raised);
  }

  .not-documented {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .facts {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--border-heavy) solid var(--ink);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .facts dd {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .facts a {
    text-decoration: none;
  }

  .facts a:hover,
  .facts a:focus-visible {
    color: var(--clay-deep);
    text-decoration: underline;
  }

  .makers {
    display: grid;
    gap: var(--s-2);
  }

  .fact-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 400;
    color: var(--ink-3);
  }

  .quiet {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-3);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }

  .tags li {
    padding: 0.2rem 0.55rem;
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }

  .provenance {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .side-actions {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--s-7) var(--s-6);
    margin-top: var(--s-6);
  }

  @media (min-width: 62em) {
    .project {
      grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.6fr);
      gap: var(--s-9);
      align-items: start;
    }
  }
</style>
