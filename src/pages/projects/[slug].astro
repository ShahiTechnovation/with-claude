---
/**
 * A PROJECT PAGE — /projects/[slug]/
 *
 * The project's icon tile beside its name, one sentence saying where and when
 * it was built, and its links (Live demo, Code, Video). Then the team's own
 * words, "How Claude was used" when there is any, the team, and a short list
 * of details. Then three more projects from the same event.
 *
 * What is on the page is what the record actually holds. A section with no
 * content is not rendered, "How Claude was used" included (never inferred
 * from the event); links are typed (live / repository / demo / download /
 * artifact) and an absent one has no button. No cover image and no placeholder
 * art: a member's uploaded image stays the share image only.
 *
 * Serving rules (unchanged): public means `published` + `clean` + not deleted
 * (`publicProjectWhere()`); anything else is a real 404 for the public; a
 * moderator's render is `private, no-store`; public renders use the bounded
 * TTL in `src/server/http/cache.ts`. User text is rendered as text; JSON-LD
 * goes through `safeJsonLd()` in the layout.
 */
export const prerender = false;

import Base from '@/layouts/Base.astro';
import NotFound from '@/components/NotFound.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import Narrative from '@/components/directory/Narrative.astro';
import Icon from '@/components/directory/Icon.astro';
import ModeratorControls from '@/components/ModeratorControls.astro';
import { ReportModal } from '@/components/react/ReportModal';
import { isDirectoryHost, MAIN_ORIGIN } from '@/lib/directory-host';
import { site } from '@/data';
import { formatDateLong } from '@/lib/datetime';
import { resolveProjectCover } from '@/lib/project-cover';
import { projectIcon } from '@/lib/project-icon';
import {
  artifactActions,
  buildStatusLabel,
  cardProps,
  cardText,
  categoryLabel,
  excerpt,
  ownSummary,
  type ArtifactAction,
} from '@/lib/project-display';
import { titles, trail } from '@/lib/seo';
import { plural } from '@/lib/words';
import { directoryHref } from '@/server/public/projects';
import { projectPage } from '@/server/public/pages';
import { isRequestModerator } from '@/server/moderation';
import { privateCache, publicCache } from '@/server/http/cache';
import { logReadFailure, type ReadFailure } from '@/server/public/read-failure';

const slug = Astro.params.slug ?? '';
/** A failed read is a 503 with an honest message, not a raw 500 (see `read-failure.ts`). */
let failure: ReadFailure | null = null;
const loaded = await projectPage(slug).catch((error: unknown) => {
  failure = logReadFailure('project', error);
  return null;
});
/**
 * Who is asking matters only for a moderator, and only when they ask: on a
 * non-public record, or with `?moderate=1`. The query string is part of the
 * CDN cache key, so the plain public URL is never rendered per viewer and a
 * moderator's private render can never be cached under it.
 */
const wantsModeration = Astro.url.searchParams.has('moderate');
const isModerator =
  loaded && (!loaded.project.isPublic || wantsModeration)
    ? await isRequestModerator(Astro.request)
    : false;
const visible = loaded && (loaded.project.isPublic || isModerator);

if (failure) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
  privateCache(Astro);
} else if (!visible) {
  Astro.response.status = 404;
  publicCache(Astro);
} else if (isModerator || !loaded.project.isPublic) {
  privateCache(Astro);
} else {
  publicCache(Astro);
}

const project = loaded?.project;
const related = loaded?.related ?? [];
const eventTotal = loaded?.eventTotal ?? 0;
const cover = resolveProjectCover(project?.image);
const shareImage =
  cover.kind === 'blob'
    ? cover.blobUrl
    : cover.kind === 'asset'
      ? cover.imageMetadata!.src
      : undefined;
const icon = project ? projectIcon(project.slug) : undefined;
// Short names so the "From …" sentence stays on one line in the template: a line break
// between </a> and the comma would render as a space before it.
const eventHref = project?.event ? `/events/${project.event.slug}/` : '';
const eventName = project?.event?.name;
const eventTail = project?.event
  ? `${project.event.city ? `, ${project.event.city.name}` : ''}, ${formatDateLong(project.event.date)}.`
  : '';

const has = (text: string | null | undefined) => Boolean(text && text.trim());
const tagline = ownSummary(project?.summary);
const status = buildStatusLabel(project?.buildStatus);
const hasTeam = Boolean(project && (project.team || project.credits.length));

/**
 * The buttons: "Live demo" first and filled, then "Code" and the video's own
 * short word ("Video", or "Demo" for a Drive folder); anything rarer keeps
 * its full label. The accessible name starts with the visible words.
 */
const shownFor = (a: ArtifactAction) =>
  a.kind === 'live'
    ? 'Live demo'
    : a.kind === 'repo'
      ? 'Code'
      : a.kind === 'video'
        ? a.short
        : a.label;
const actions = (project ? artifactActions(project) : []).map((a) => {
  const shown = shownFor(a);
  const named = a.label.toLowerCase().includes(shown.toLowerCase())
    ? a.label
    : `${shown}: ${a.label}`;
  return { ...a, shown, name: `${named}, opens in a new tab` };
});
const iconFor = (kind: string) =>
  kind === 'live'
    ? 'live'
    : kind === 'repo'
      ? 'repo'
      : kind === 'download'
        ? 'download'
        : kind === 'artifact'
          ? 'artifact'
          : 'video';

const description = project
  ? excerpt(
      tagline ??
        cardText(project) ??
        project.solution ??
        `${project.title} — a WITH CLAUDE project.`,
    )
  : '';

const schema = project
  ? [
      {
        '@type': 'CreativeWork',
        name: project.title,
        description: tagline ?? cardText(project) ?? project.title,
        url: `${site.url}/projects/${project.slug}/`,
        ...(project.url ? { sameAs: [project.url] } : {}),
        ...(project.team ? { creator: { '@type': 'Organization', name: project.team } } : {}),
        ...(project.credits.length > 0 && !project.team
          ? { creator: project.credits.map((c) => ({ '@type': 'Person', name: c.name })) }
          : {}),
        ...(project.event
          ? {
              dateCreated: project.event.date,
              ...(project.event.city
                ? { locationCreated: { '@type': 'Place', name: project.event.city.name } }
                : {}),
              isPartOf: {
                '@type': 'Event',
                name: project.event.title,
                startDate: project.event.date,
                url: `${site.url}/events/${project.event.slug}/`,
              },
            }
          : project.city
            ? { locationCreated: { '@type': 'Place', name: project.city.name } }
            : {}),
      },
    ]
  : [];

const crumbs = project
  ? trail(
      { name: 'Projects', href: '/projects/' },
      ...(project.event
        ? [{ name: project.event.label, href: `/events/${project.event.slug}/` }]
        : []),
      { name: project.title, href: `/projects/${project.slug}/` },
    )
  : undefined;
---

{
  failure ? (
    <Base title="Could not load" description="This project could not be loaded right now." noindex>
      <div class="container pd pd-failed" role="alert">
        <h1 class="t-h3">This project could not be loaded</h1>
        <p>Something went wrong on our side. Please try again in a moment.</p>
        {import.meta.env.DEV && failure === 'schema-behind' && (
          <p>
            <strong>Development:</strong> the database behind <code>DATABASE_URL</code> is missing
            migrations. Run <code>npm run db:migrate</code> against it, or use a migrated database.
          </p>
        )}
        <a class="btn" href={Astro.url.pathname}>
          Try again
        </a>
      </div>
    </Base>
  ) : !project || !visible ? (
    <Base title="Not found" description="That project is not part of the directory." noindex>
      <NotFound />
    </Base>
  ) : (
    <Base
      title={project.title}
      seoTitle={titles.project(
        project.title,
        project.event?.city?.name ?? project.city?.name ?? 'India',
      )}
      description={description}
      active="/projects"
      breadcrumbs={crumbs}
      image={shareImage}
      ogImageAlt={`${project.title} — ${shareImage ? 'project image' : 'WITH CLAUDE'}`}
      schema={schema}
      noindex={!project.isPublic}
    >
      {!project.isPublic && (
        <div class="mod-banner" role="status">
          Not visible to the public — {project.publicationStatus} · {project.moderationState}. You
          are seeing it because you are a moderator.
        </div>
      )}

      <article class="container pd">
        <header class="pd-head">
          {icon ? (
            <span class="pd-icon" aria-hidden="true" set:html={icon} />
          ) : (
            <span class="pd-icon is-empty" aria-hidden="true" />
          )}
          <div class="pd-head-body">
            <h1 class="t-h1 pd-title">{project.title}</h1>
            {project.event && (
              <p class="lead pd-from">
                From <a href={eventHref}>{eventName}</a>
                {eventTail}
              </p>
            )}
            {actions.length > 0 && (
              <ul class="pd-actions" aria-label="Project links">
                {actions.map((a, i) => (
                  <li>
                    <a
                      class:list={['btn', i === 0 && a.kind === 'live' && 'btn-primary']}
                      href={a.href}
                      target="_blank"
                      rel="noopener noreferrer nofollow ugc"
                      aria-label={a.name}
                    >
                      <Icon name={iconFor(a.kind)} size={18} />
                      {a.shown}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </header>

        <div class="pd-grid">
          <div class="pd-main">
            {tagline && <p class="pd-tagline">{tagline}</p>}
            {has(project.description) && <Narrative text={project.description} />}

            {has(project.problem) && (
              <section class="pd-section" aria-labelledby="problem-h">
                <h2 id="problem-h" class="t-h3">
                  The problem
                </h2>
                <Narrative text={project.problem} />
              </section>
            )}

            {has(project.solution) && (
              <section class="pd-section" aria-labelledby="solution-h">
                <h2 id="solution-h" class="t-h3">
                  How it works
                </h2>
                <Narrative text={project.solution} />
              </section>
            )}

            {has(project.claudeUsage) && (
              <section id="claude" class="pd-section" aria-labelledby="claude-h">
                <h2 id="claude-h" class="t-h3">
                  How Claude was used
                </h2>
                <Narrative text={project.claudeUsage} />
              </section>
            )}

            {hasTeam && (
              <section id="team" class="pd-section" aria-labelledby="team-h">
                <h2 id="team-h" class="t-h3">
                  Team
                </h2>
                {project.team && <p class="pd-team-name">{project.team}</p>}
                {project.credits.length > 0 && (
                  <ul class="pd-people">
                    {project.credits.map((c) => (
                      <li>
                        {c.href ? <a href={c.href}>{c.name}</a> : <span>{c.name}</span>}
                        {c.role && <span class="pd-role"> · {c.role}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            )}
          </div>

          <aside class="pd-side" aria-label="Project facts">
            <dl class="pd-facts">
              <div>
                <dt>Kind</dt>
                <dd>
                  <a href={directoryHref({ categories: [project.category] })}>
                    {categoryLabel(project.category)}
                  </a>
                </dd>
              </div>
              {status && (
                <div>
                  <dt>Status</dt>
                  <dd>{status}</dd>
                </div>
              )}
              {has(project.builtWith) && (
                <div>
                  <dt>Built with</dt>
                  <dd class="pd-built-with">{project.builtWith}</dd>
                </div>
              )}
              {!project.event && project.city && (
                <div>
                  <dt>City</dt>
                  <dd>
                    <a href={`/cities/${project.city.slug}/`}>{project.city.name}</a>
                  </dd>
                </div>
              )}
              {project.useCases.length > 0 && (
                <div>
                  <dt>Written up</dt>
                  <dd>
                    {project.useCases.map((u) => (
                      <a href={`/use-cases/${u.slug}/`}>{u.title}</a>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
            {project.imported && (
              <p class="pd-claim">
                <a class="link" href={`/me/projects/claim/?project=${project.slug}`}>
                  Is this your project? Claim it
                </a>
              </p>
            )}
            <div class="pd-side-actions">
              {/* Reporting needs the www session, which projects.withclaude.in never has. */}
              {isDirectoryHost(Astro.url.hostname) ? (
                <a
                  class="button button--quiet"
                  href={`${MAIN_ORIGIN}/projects/${project.slug}/`}
                  title="Report this content on www.withclaude.in, where you are signed in"
                >
                  Report
                </a>
              ) : (
                <div class="js-only">
                  <ReportModal client:visible entityType="project" entityId={project.id} />
                </div>
              )}
              <ModeratorControls
                entityType="projects"
                entityId={project.id}
                initialState={project.moderationState}
                isModerator={isModerator}
              />
            </div>
          </aside>
        </div>
      </article>

      {related.length > 0 && (
        <section class="container pd-related" aria-labelledby="related-h">
          <h2 id="related-h" class="t-h2">
            {project.event ? `More from ${project.event.label}` : 'More projects'}
          </h2>
          <ProjectGrid items={related.map((p) => cardProps(p))} level="h3" />
          {project.event && (
            <p class="pd-more">
              <a class="link" href={directoryHref({ events: [project.event.slug] })}>
                All {plural(eventTotal, 'project')} from {project.event.label}
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path
                    d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </p>
          )}
        </section>
      )}
    </Base>
  )
}

<style>
  .mod-banner {
    padding: 12px var(--gutter);
    background: var(--clay-deep);
    color: var(--paper);
    font-size: var(--t-small);
    text-align: center;
  }

  .pd-failed {
    display: grid;
    justify-items: start;
    gap: 18px;
    padding-block: var(--section-y);
  }

  .pd-failed :is(h1, p) {
    margin: 0;
  }

  .pd-head {
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: clamp(28px, 4vw, 56px) clamp(32px, 4vw, 56px);
  }

  .pd-icon {
    display: block;
    width: 80px;
    height: 80px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--clay);
    box-shadow: var(--glow-tile);
  }

  .pd-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pd-head-body {
    display: grid;
    gap: 18px;
    min-width: 0;
  }

  .pd-title {
    margin: 0;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .pd-from {
    margin: 0;
    max-width: 48ch;
    color: var(--ink-2);
  }

  .pd-from a,
  .pd-facts a,
  .pd-people a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .pd-from a:hover,
  .pd-facts a:hover,
  .pd-people a:hover {
    text-decoration-color: var(--clay);
  }

  .pd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .pd-actions .btn {
    white-space: normal;
  }

  @media (min-width: 700px) {
    .pd-head {
      grid-template-columns: 120px minmax(0, 1fr);
      align-items: start;
      gap: clamp(24px, 3vw, 40px);
    }

    .pd-icon {
      width: 120px;
      height: 120px;
      border-radius: 22px;
    }
  }

  .pd-grid {
    display: grid;
    gap: clamp(36px, 4vw, 56px);
    padding-block: clamp(32px, 4vw, 48px) var(--section-y);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 1100px) {
    .pd-grid {
      grid-template-columns: minmax(0, 64ch) minmax(18rem, 24rem);
      justify-content: space-between;
      align-items: start;
    }
  }

  .pd-main {
    display: grid;
    gap: clamp(32px, 3vw, 44px);
    min-width: 0;
  }

  /* The team's words at body size, 64ch. */
  .pd-main :global(.narrative) {
    max-width: 64ch;
    font-size: var(--t-body);
  }

  .pd-tagline {
    margin: 0;
    max-width: 64ch;
  }

  .pd-section {
    display: grid;
    gap: 14px;
  }

  .pd-section h2 {
    margin: 0;
  }

  .pd-team-name {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--t-title);
    font-weight: 600;
    color: var(--ink);
  }

  .pd-people {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pd-role {
    color: var(--ink-3);
  }

  .pd-side {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .pd-facts {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .pd-facts > div {
    display: grid;
    grid-template-columns: minmax(7rem, auto) minmax(0, 1fr);
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-body);
  }

  .pd-facts dt {
    color: var(--ink-3);
  }

  .pd-facts dd {
    display: grid;
    gap: 4px;
    margin: 0;
    color: var(--ink);
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* Long text from the form: keep the team's own line breaks and list lines. */
  .pd-built-with {
    white-space: pre-line;
  }

  .pd-claim {
    margin: 0;
  }

  .pd-side-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  /* Same ground as the article above: one --section-y between them, split at the hairline
     (as Section does). The full one before the footer keeps a wrapped link's underline clear of its rule. */
  .pd:has(+ .pd-related) .pd-grid {
    padding-bottom: calc(var(--section-y) / 2);
  }

  .pd-related {
    display: grid;
    gap: var(--head-after);
    padding-block: calc(var(--section-y) / 2) var(--section-y);
    border-top: 1px solid var(--rule);
  }

  .pd-related h2 {
    margin: 0;
    text-wrap: balance;
  }

  .pd-more {
    margin: 0;
  }
</style>
