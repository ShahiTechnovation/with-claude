---
/**
 * MADE WITH CLAUDE — /projects/
 *
 * Every public project. The default view (no filter, no search, page 1, the
 * default sort) is one group per event, newest first: the event's plate and
 * name, six cards, the rest behind "Show N more". Anything else is the
 * filtered view: one line saying how many match, the active filters as
 * removable pills, and a flat grid of the page's cards with a pager.
 *
 * The URL is the state: `?q=…&event=…&category=…` from the toolbar, and the
 * older `city`, `status`, `has`, `sort` and `page` parameters, which still
 * work (`normaliseDirectoryQuery`) and show as pills. The toolbar is a plain
 * GET form, so it works without JavaScript (Apply). `src/scripts/directory.ts`
 * only makes it faster: it fetches the same URL, swaps the results in place,
 * keeps focus, and ignores stale responses.
 *
 * Counts, pills and the lead come from `listPublicProjects()`, which uses the
 * one public predicate, so a hidden or draft project can never be counted.
 */
export const prerender = false;

import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import ProjectGroup from '@/components/ProjectGroup.astro';
import Icon from '@/components/directory/Icon.astro';
import { itemListSchema, titles, trail } from '@/lib/seo';
import { formatDateLong, formatMonthYear } from '@/lib/datetime';
import { eventPlate } from '@/lib/event-plate';
import {
  buildStatusLabel,
  cardProps,
  categoryLabel,
  type BuildStatusValue,
} from '@/lib/project-display';
import { listJoin, plural } from '@/lib/words';
import {
  directoryHref,
  INDEPENDENT,
  type DirectoryQuery,
  type PublicEventRef,
} from '@/server/public/projects';
import { projectArchive, projectGroups, type ProjectListResult } from '@/server/public/pages';
import { privateCache, publicCache } from '@/server/http/cache';
import { logReadFailure, type ReadFailure } from '@/server/public/read-failure';
import '@/styles/directory.css';

/**
 * A failed read is a 503 with an honest message — never a raw 500, and never
 * cached (the next request should try again). See `read-failure.ts`.
 */
let failure: ReadFailure | null = null;
let result: ProjectListResult;
let groups: Awaited<ReturnType<typeof projectGroups>> = [];
const empty: ProjectListResult = {
  items: [],
  total: 0,
  totalPublic: 0,
  atEvents: 0,
  page: 1,
  pageCount: 1,
  pageSize: 60,
  query: { events: [], categories: [], cities: [], statuses: [], has: [], sort: 'event', page: 1 },
  facets: { events: [], categories: [], cities: [], statuses: [], has: [] },
  featuredAvailable: false,
};
try {
  result = await projectArchive(Astro.url.searchParams);
  const { query } = result;
  const unfiltered =
    !query.q &&
    query.events.length +
      query.categories.length +
      query.cities.length +
      query.statuses.length +
      query.has.length ===
      0;
  if (unfiltered && query.page === 1 && query.sort === 'event' && result.totalPublic > 0)
    groups = await projectGroups();
  publicCache(Astro);
} catch (error) {
  failure = logReadFailure('projects', error);
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
  privateCache(Astro);
  result = empty;
  groups = [];
}
const devHint = import.meta.env.DEV && failure === 'schema-behind';

const { items, total, totalPublic, atEvents, page, pageCount, query, facets } = result;
const filterCount =
  query.events.length +
  query.categories.length +
  query.cities.length +
  query.statuses.length +
  query.has.length;
const filtered = Boolean(query.q) || filterCount > 0;
const grouped = groups.length > 0;
const nothingPublished = totalPublic === 0;

// The lead: "122 projects built at 3 events in Bhopal." Projects with a public event only,
// counted the same way as the homepage, so the sentence stays true on both.
const eventCount = facets.events.filter((e) => e.value !== INDEPENDENT).length;
const cityNames = facets.cities.map((c) => c.label);
const lead =
  eventCount > 0
    ? `${plural(atEvents, 'project')} built at ${plural(eventCount, 'event')}${cityNames.length ? ` in ${listJoin(cityNames)}` : ''}.`
    : `${plural(totalPublic, 'project')}.`;

// Two events with the same label (two "Claude Code Impact Lab"s) get the month.
const labelOf = new Map(
  facets.events.map((f) => {
    const twin = facets.events.some((o) => o !== f && o.label === f.label);
    return [f.value, twin && f.date ? `${f.label}, ${formatMonthYear(f.date)}` : f.label];
  }),
);
const eventName = (slug: string) => labelOf.get(slug) ?? slug;
const allCount = facets.events.reduce((n, f) => n + f.count, 0);
const oneEvent = query.events.length === 1 ? query.events[0]! : undefined;

const without = (group: keyof DirectoryQuery, value?: string): string =>
  directoryHref({
    ...query,
    page: 1,
    ...(group === 'q'
      ? { q: undefined }
      : {
          [group]: value === undefined ? [] : (query[group] as string[]).filter((v) => v !== value),
        }),
  });
const pageHref = (n: number) => directoryHref({ ...query, page: n });
const pageNumbers = [...new Set([1, page - 1, page, page + 1, pageCount])]
  .filter((n) => n >= 1 && n <= pageCount)
  .sort((a, b) => a - b);

const labelFor: Record<string, (v: string) => string> = {
  events: eventName,
  categories: (v) => categoryLabel(v),
  cities: (v) => facets.cities.find((c) => c.value === v)?.label ?? v,
  statuses: (v) =>
    facets.statuses.find((s) => s.value === v)?.label ??
    buildStatusLabel(v as BuildStatusValue) ??
    v,
  has: (v) => facets.has.find((h) => h.value === v)?.label ?? v,
};
const activeChips = [
  ...(query.q ? [{ label: `“${query.q}”`, href: without('q') }] : []),
  ...(['events', 'categories', 'cities', 'statuses', 'has'] as const).flatMap((group) =>
    (query[group] as string[]).map((v) => ({
      label: labelFor[group]!(v),
      href: without(group, v),
    })),
  ),
];

/**
 * Filters the toolbar has no control for (city, status, links, sort) ride along
 * as hidden fields, so changing the event or type keeps them. They sit in the
 * swapped region, so removing a pill removes its field too.
 * ponytail: an old link with several events shows them as pills, but the radios hold one; the
 * next toolbar change keeps only the chosen event.
 */
const carried: [string, string][] = [
  ...query.cities.map((v): [string, string] => ['city', v]),
  ...query.statuses.map((v): [string, string] => ['status', v]),
  ...query.has.map((v): [string, string] => ['has', v]),
  ...(query.sort !== 'event' ? [['sort', query.sort] as [string, string]] : []),
];

const groupMeta = (event: PublicEventRef, n?: number) =>
  [formatDateLong(event.date), event.city?.name, n === undefined ? undefined : plural(n, 'project')]
    .filter(Boolean)
    .join(' · ');
const oneEventRef = oneEvent ? items.find((p) => p.event?.slug === oneEvent)?.event : undefined;

// The ItemList describes what is on screen: every group in the grouped view, else the page.
const listed = grouped ? groups.flatMap((g) => g.items) : items;
const schema = listed.length
  ? [
      itemListSchema(
        listed.map((p) => ({ name: p.title, href: `/projects/${p.slug}/` })),
        'WITH CLAUDE Project Directory',
      ),
    ]
  : [];
const description =
  'Explore projects built at WITH CLAUDE events and by our builder community — filter by the event, category, city and status.';
---

<Base
  title="Project Directory"
  seoTitle={titles.projects()}
  description={description}
  active="/projects"
  breadcrumbs={trail({ name: 'Projects', href: '/projects/' })}
  schema={schema}
  noindex={filtered || page > 1}
>
  <PageIntro title="Made with Claude." size="lg">{!failure && !nothingPublished && lead}</PageIntro>

  <div class="dir-page" data-directory>
    {
      failure ? (
        <div class="container dir-empty" role="alert">
          <h2 class="t-h3">The directory could not be loaded</h2>
          <p>
            Something went wrong on our side while reading the projects. Please try again in a
            moment.
          </p>
          {devHint && (
            <p>
              <strong>Development:</strong> the database behind <code>DATABASE_URL</code> is missing
              migrations this code needs. Run <code>npm run db:migrate</code> against it, or point
              the dev server at a migrated database.
            </p>
          )}
          <a class="btn" href={Astro.url.pathname + Astro.url.search}>
            Try again
          </a>
        </div>
      ) : nothingPublished ? (
        <div class="container dir-empty">
          <h2 class="t-h3">No projects are published yet</h2>
          <a class="btn btn-primary" href="/me/projects/new/">
            Submit a project
          </a>
        </div>
      ) : (
        <>
          <div class="dir-bar">
            <form
              class="container dir-tools"
              id="dir-form"
              method="get"
              action="/projects/"
              role="search"
              aria-label="Filter projects"
            >
              <label class="dir-search">
                <span class="visually-hidden">Search projects</span>
                <Icon name="search" size={19} />
                <input
                  type="search"
                  name="q"
                  value={query.q ?? ''}
                  maxlength="80"
                  placeholder="Search projects"
                  autocomplete="off"
                  enterkeyhint="search"
                  data-dir-q
                />
              </label>
              <fieldset class="dir-events">
                <legend class="visually-hidden">Built at</legend>
                <label class="chip dir-pill">
                  <input
                    class="visually-hidden"
                    type="radio"
                    name="event"
                    value=""
                    checked={query.events.length === 0}
                    data-facet="events:*"
                  />
                  All<span class="visually-hidden">,</span>{' '}
                  <span class="dir-n" data-count="events:*" set:text={allCount || ''} />
                </label>
                {facets.events.map((f) => (
                  <label class="chip dir-pill">
                    <input
                      class="visually-hidden"
                      type="radio"
                      name="event"
                      value={f.value}
                      checked={oneEvent === f.value}
                      data-facet={`events:${f.value}`}
                    />
                    {eventName(f.value)}
                    <span class="visually-hidden">,</span>{' '}
                    <span class="dir-n" data-count={`events:${f.value}`} set:text={f.count || ''} />
                  </label>
                ))}
              </fieldset>
              <label class="dir-type">
                <span class="visually-hidden">Type of project</span>
                <select name="category" data-dir-category>
                  <option value="">All types</option>
                  {facets.categories.map((f) => (
                    <option value={f.value} selected={query.categories[0] === f.value}>
                      {f.count > 0
                        ? `${categoryLabel(f.value)} (${f.count})`
                        : categoryLabel(f.value)}
                    </option>
                  ))}
                </select>
              </label>
              <button class="btn btn-sm no-js-only" type="submit">
                Apply
              </button>
            </form>
          </div>

          <section
            class="container dir-results"
            aria-labelledby="dir-results-title"
            data-dir-results
          >
            <h2 id="dir-results-title" class="visually-hidden">
              Projects
            </h2>
            {/* Persistent: announced on every update, and never under aria-busy. */}
            {/* Always has text, so focus after Clear all lands on something said aloud;
                the grouped view hides it visually. */}
            <p
              class:list={[
                'dir-count',
                ((grouped && !filtered) || total === 0) && 'visually-hidden',
              ]}
              aria-live="polite"
              tabindex="-1"
              data-dir-count
            >
              {`${plural(total, 'project')} ${total === 1 ? 'matches' : 'match'}.`}
            </p>
            <p class="dir-status" role="status" data-dir-status />

            {/* Only this region is replaced when the results change. */}
            <div class="dir-swap" data-dir-swap>
              {carried.map(([name, value]) => (
                <input type="hidden" form="dir-form" name={name} value={value} />
              ))}
              {activeChips.length > 0 && (
                <ul class="dir-chips" aria-label="Active filters">
                  {activeChips.map((chip) => (
                    <li>
                      <a class="chip dir-chip" href={chip.href}>
                        <span>{chip.label}</span>
                        <Icon name="close" size={15} />
                        <span class="visually-hidden">Remove filter</span>
                      </a>
                    </li>
                  ))}
                  <li>
                    <a class="link" href="/projects/">
                      Clear all
                    </a>
                  </li>
                </ul>
              )}

              {grouped ? (
                <div class="dir-groups">
                  {groups.map((g) =>
                    g.event ? (
                      <ProjectGroup
                        id={`g-${g.event.slug}`}
                        title={eventName(g.event.slug)}
                        meta={groupMeta(g.event, g.items.length)}
                        href={`/events/${g.event.slug}/`}
                        plate={eventPlate(g.event)}
                        items={g.items.map((p) => cardProps(p))}
                      />
                    ) : (
                      <ProjectGroup
                        id="g-independent"
                        title={eventName(INDEPENDENT)}
                        meta={plural(g.items.length, 'project')}
                        items={g.items.map((p) => cardProps(p))}
                      />
                    ),
                  )}
                </div>
              ) : items.length === 0 ? (
                <div class="dir-empty">
                  <p class="t-h3">Nothing matches that yet.</p>
                  <a class="btn" href="/projects/">
                    Show all {totalPublic} projects
                  </a>
                </div>
              ) : oneEvent ? (
                <ProjectGroup
                  id={`g-${oneEvent}`}
                  title={eventName(oneEvent)}
                  meta={oneEventRef ? groupMeta(oneEventRef) : undefined}
                  href={oneEventRef ? `/events/${oneEvent}/` : undefined}
                  plate={oneEventRef ? eventPlate(oneEventRef) : undefined}
                  items={items.map((p) => cardProps(p))}
                  visible={items.length}
                />
              ) : (
                <>
                  <h2 class="visually-hidden">Results</h2>
                  <ProjectGrid items={items.map((p) => cardProps(p))} level="h3" />
                </>
              )}

              {!grouped && pageCount > 1 && (
                <nav class="dir-pager" aria-label="Pages of projects">
                  {page > 1 ? (
                    <a href={pageHref(page - 1)} rel="prev">
                      ← Previous
                    </a>
                  ) : (
                    <span class="is-off" aria-hidden="true">
                      ← Previous
                    </span>
                  )}
                  <ol>
                    {pageNumbers.map((n, i) => (
                      <>
                        {i > 0 && n - pageNumbers[i - 1]! > 1 && (
                          <li aria-hidden="true">
                            <span>…</span>
                          </li>
                        )}
                        <li>
                          {n === page ? (
                            <span aria-current="page">
                              <span class="visually-hidden">Page </span>
                              {n}
                            </span>
                          ) : (
                            <a href={pageHref(n)}>
                              <span class="visually-hidden">Page </span>
                              {n}
                            </a>
                          )}
                        </li>
                      </>
                    ))}
                  </ol>
                  {page < pageCount ? (
                    <a href={pageHref(page + 1)} rel="next">
                      Next →
                    </a>
                  ) : (
                    <span class="is-off" aria-hidden="true">
                      Next →
                    </span>
                  )}
                </nav>
              )}
            </div>

            <aside class="dir-submit" aria-labelledby="dir-submit-title">
              <h2 id="dir-submit-title" class="dir-submit-title">
                Built something with Claude?
              </h2>
              <a class="btn btn-primary" href="/me/projects/new/">
                Add your build
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path
                    d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </aside>
          </section>
        </>
      )
    }
  </div>
</Base>

<script>
  import '@/scripts/directory';
</script>
