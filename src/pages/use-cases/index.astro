---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import PracticeLibrary from '@/components/PracticeLibrary.astro';
import SubmitPanel from '@/components/SubmitPanel.astro';
import { publicUseCases } from '@/data';
import { itemListSchema, titles, trail } from '@/lib/seo';

const crumbs = trail({ name: 'Use cases', href: '/use-cases' });

const description =
  'How people across India actually use Claude — first-hand workflows written by the person who ran them, with what Claude did and what they did kept separate.';

// An ItemList is only emitted once there is a list. Marking up an empty
// collection would be describing a page that is not there.
const schema = publicUseCases.length
  ? [
      itemListSchema(
        publicUseCases.map((useCase) => ({
          name: useCase.title,
          href: `/use-cases/${useCase.slug}`,
        })),
        'Claude in practice',
      ),
    ]
  : [];
---

<Base
  title="Use cases"
  seoTitle={titles.useCases()}
  description={description}
  active="/use-cases"
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageIntro title="Claude in practice." size="lg">
    <p>First-hand accounts of how builders in India use Claude.</p>
  </PageIntro>

  <Section id="library" tone="sunk" labelledby="practice-library-heading">
    {/* The intro already says "Claude in practice"; the library's own head repeated it. */}
    <h2 id="practice-library-heading" class="visually-hidden">Published use cases</h2>
    <PracticeLibrary filters showHead={false} />
  </Section>

  <Section id="submit" labelledby="practice-heading">
    <SubmitPanel formId="practice" />
  </Section>
</Base>
