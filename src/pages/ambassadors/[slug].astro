---
import { publicCache } from '@/server/http/cache';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { profileSchema, titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import EventArchive from '@/components/EventArchive.astro';
import { site } from '@/data/site';
import { formatDate } from '@/lib/datetime';
import { plural } from '@/lib/words';

/**
 * AN AMBASSADOR'S PUBLIC PAGE. §23, §24.
 *
 * ── WHAT THIS PAGE DOES NOT OWN ──────────────────────────────────────────
 *
 * Any of its content. §24 is explicit that an ambassador page must not
 * duplicate profile content, so:
 *
 *   the bio, city, role      the `ambassadors` record, or the linked builder
 *   the events               `events` + `event_hosts`, via `ambassadorStanding`
 *   the projects             the linked builder's projects
 *   the score                `src/lib/leaderboard.ts`, same function as the index
 *
 * Nothing is recomputed here and nothing is restated. That is what makes §50's
 * "one canonical ambassador" true across `/ambassadors`, this page,
 * `/cities/[slug]` and `/events/[slug]` — they are four renderings of one
 * record, not four records.
 *
 * ── PROVENANCE IS NOT OPTIONAL ───────────────────────────────────────────
 *
 * §54: the page may not claim someone is an official Anthropic ambassador
 * unless that is actually verified. `verifiedVia` is NOT NULL in the database
 * for exactly this reason, and it is rendered on the page rather than kept as
 * an internal note — a title with its source next to it is a claim a reader
 * can check, and a title on its own is one they have to take on trust.
 */
const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/not-found/');

const standing = selectors.ambassadorStanding(String(slug));
// `getStaticPaths` only ever emits published ambassadors, so this is a guard
// against a build-order surprise rather than a reachable state.
if (!standing) return Astro.rewrite('/not-found/');

const { allTime, year } = standing;
const ambassador = allTime.ambassador;
const home = selectors.cityName(ambassador.citySlug);
const builder = selectors.builderForAmbassador(ambassador);
const projects = builder ? selectors.projectsOf(builder) : [];

const url = `${site.url}/ambassadors/${ambassador.slug}/`;
const description =
  allTime.events.length > 0
    ? `${ambassador.name} is a Claude Community Ambassador in ${home}, with ` +
      `${plural(allTime.events.length, 'Claude community event')} across ` +
      `${plural(allTime.cities.length || 1, 'city', 'cities')}.`
    : `${ambassador.name} is a Claude Community Ambassador in ${home}.`;

/**
 * The activity figures, non-zero ones only. §21: the year's score sits beside
 * the all-time one, never instead of it, and only when the two differ.
 */
const figures = [
  { label: 'Events hosted', value: allTime.roleCounts.primary_host },
  { label: 'Co-hosted', value: allTime.roleCounts.co_host },
  { label: 'Organised', value: allTime.roleCounts.organizer },
  { label: 'Cities', value: allTime.cities.length },
  { label: 'Activity score', value: allTime.score, score: true },
  ...(year.score !== allTime.score ? [{ label: 'This year', value: year.score, score: true }] : []),
].filter((figure) => figure.value > 0);

/**
 * The links the page renders — and therefore the only ones `sameAs` may carry.
 *
 * `profileSchema` documents that rule; honouring it means building one list
 * and using it for both the markup and the structured data.
 */
const links = [
  ...(ambassador.links ?? []).map((link) => ({ label: link.label, url: link.url })),
  ...(ambassador.lumaProfileUrl ? [{ label: 'Luma', url: ambassador.lumaProfileUrl }] : []),
];
const hasOverview =
  Boolean(builder) ||
  links.length > 0 ||
  allTime.upcoming.length > 0 ||
  allTime.events.length === 0;
---

<Base
  title={ambassador.name}
  seoTitle={titles.ambassador(ambassador.name, home)}
  description={description}
  active="/ambassadors"
  image={ambassador.image}
  breadcrumbs={trail(
    { name: 'Ambassadors', href: '/ambassadors' },
    { name: ambassador.name, href: `/ambassadors/${ambassador.slug}` },
  )}
  schema={profileSchema(
    {
      name: ambassador.name,
      slug: ambassador.slug,
      city: home,
      // The programme title, verbatim, because it is what the page prints.
      role: ambassador.title,
      bio: ambassador.bio,
      links,
      image: ambassador.image,
    },
    url,
  )}
>
  <PageIntro title={ambassador.name} size="lg">
    <p>
      <strong>{ambassador.title}</strong> in {home}.
      {ambassador.since && ` Since ${formatDate(ambassador.since)}.`}
    </p>
    {ambassador.bio && <p>{ambassador.bio}</p>}
    <p class="provenance">
      <span class="provenance-label">How this is verified</span>
      {ambassador.verifiedVia}
    </p>
  </PageIntro>

  {/* Everything here shares the paper ground: one Section, in parts. */}
  {
    hasOverview && (
      <Section id="overview">
        {(builder || links.length > 0) && (
          <section id="elsewhere" class="part" aria-labelledby="elsewhere-heading">
            <h2 id="elsewhere-heading" class="t-title">
              Links
            </h2>
            <ul class="links">
              {builder && (
                <li>
                  <a class="btn btn-sm" href={`/builders/${builder.slug}/`}>
                    Builder profile
                  </a>
                </li>
              )}
              {projects.length > 0 && (
                <li>
                  <a class="btn btn-sm" href={`/builders/${builder!.slug}/#projects`}>
                    {plural(projects.length, 'project')}
                  </a>
                </li>
              )}
              {links.map((link) => (
                <li>
                  <a class="btn btn-sm" href={link.url} rel="me noopener" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/*
          §23's two lists. `EventArchive` is the same component the events index and
          the city pages use, so a room reads identically wherever it appears —
          which is what §50 asks for and what a second bespoke event list here
          would quietly break.
        */}
        {allTime.upcoming.length > 0 && (
          <section id="upcoming" class="part" aria-labelledby="upcoming-heading">
            <div class="section-head">
              <h2 id="upcoming-heading">Upcoming events</h2>
            </div>
            <EventArchive events={allTime.upcoming} showHead={false} selectors={selectors} />
          </section>
        )}

        {allTime.events.length === 0 && (
          <section id="no-events" class="part" aria-labelledby="no-events-heading">
            <h2 id="no-events-heading" class="t-title">
              Events
            </h2>
            <p class="note">No events yet.</p>
          </section>
        )}
      </Section>
    )
  }

  {
    allTime.past.length > 0 && (
      <Section id="past" tone="sunk" labelledby="past-heading">
        <div class="section-head">
          <h2 id="past-heading">Past events</h2>
        </div>
        <EventArchive events={allTime.past} showHead={false} selectors={selectors} />
      </Section>
    )
  }

  <Section id="activity" labelledby="activity-heading">
    <div>
      <div class="section-head">
        <h2 id="activity-heading">Activity</h2>
      </div>

      {
        figures.length > 0 && (
          <dl class="activity">
            {figures.map((figure) => (
              <div>
                <dt>{figure.label}</dt>
                <dd>{figure.score ? figure.value.toFixed(2) : figure.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <p class="note">
        {
          allTime.unscoredCredits > 0 &&
            `${plural(allTime.unscoredCredits, 'further attribution')} ${allTime.unscoredCredits === 1 ? 'is' : 'are'} awaiting confirmation and not counted here. `
        }
        <a class="link" href="/ambassadors/#method">
          How the score works <span aria-hidden="true">→</span>
        </a>
      </p>

      <p class="more">
        <a class="link" href="/ambassadors/">All ambassadors</a>
        <a class="link" href={`/cities/${ambassador.citySlug}/`}>{`Claude community in ${home}`}</a>
      </p>
    </div>
  </Section>
</Base>

<style>
  /* Blocks that share a ground: one Section, a hairline between them. */
  .part + .part {
    margin-top: calc(var(--section-y) * 0.4);
    padding-top: calc(var(--section-y) * 0.4);
    border-top: 1px solid var(--rule);
  }

  /* With no past-events band between them the two paper Sections meet like parts. */
  :global(#overview:has(+ #activity)) {
    padding-bottom: calc(var(--section-y) * 0.4);
  }

  :global(#overview + #activity) {
    padding-top: calc(var(--section-y) * 0.4);
  }

  /* A heading that opens a part after a hairline sits nearer its content than the joint
     above it: --s-6, the value --head-after already has on small screens. */
  .part + .part > .section-head,
  :global(#overview + #activity) .section-head {
    margin-bottom: var(--s-6);
  }

  .provenance {
    display: grid;
    gap: 2px;
    margin-top: 18px;
    color: var(--ink-2);
    font-size: var(--t-small);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .activity {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: var(--s-5);
    margin: 0 0 var(--s-6);
  }

  .activity dt {
    color: var(--ink-3);
    font-size: var(--t-small);
  }

  .activity dd {
    margin: 4px 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 300;
    font-variant-numeric: tabular-nums;
  }

  .note {
    max-width: 66ch;
    margin: 0 0 var(--s-5);
    color: var(--ink-2);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
  }
</style>
