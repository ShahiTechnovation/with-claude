---
import { publicCache } from '@/server/http/cache';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import { itemListSchema, titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import AmbassadorLeaderboard from '@/components/AmbassadorLeaderboard.astro';

import { CREDIT_WEIGHT_LABELS } from '@/lib/credits';
import { plural } from '@/lib/words';

/**
 * AMBASSADORS — a directory that happens to be ranked.
 *
 * §22 asks for ranked entries and §53 asks that the ranking not be presented
 * as an official Anthropic standing. This is a directory of people first; the
 * number beside each name is explained, with its formula, under the list.
 *
 * ── WHY THE FORMULA IS PRINTED ───────────────────────────────────────────
 *
 * §20: "Do not hide the formula." A ranking whose inputs are secret invites
 * exactly one question — why is that person above me — and has no answer. The
 * weights are rendered from `CREDIT_WEIGHT_LABELS`, so the printed formula and
 * the computed score cannot drift; there is no second copy of the numbers.
 */
const board = selectors.activityLeaderboard({ window: 'all' });

// A ranked page needs somebody on it. Everyone verified appears, including
// people with nothing scored yet — §22 is a directory before it is a table.
const active = board.filter((entry) => entry.events.length > 0);
const upcomingTotal = board.reduce((sum, entry) => sum + entry.upcoming.length, 0);

const description =
  `Claude Community Ambassadors running events across India — ${board.length} listed, ` +
  `${active.length} with events, ${plural(upcomingTotal, 'room')} coming up.`;

const formula = CREDIT_WEIGHT_LABELS.map((w) => `${w.label} ×${w.weight}`).join(' · ');
---

<Base
  title="Ambassadors"
  seoTitle={titles.ambassadors()}
  description={description}
  active="/ambassadors"
  breadcrumbs={trail({ name: 'Ambassadors', href: '/ambassadors' })}
  schema={[
    itemListSchema(
      board.map((entry) => ({
        name: entry.ambassador.name,
        href: `/ambassadors/${entry.ambassador.slug}`,
      })),
      'Claude Community Ambassadors in India',
    ),
  ]}
>
  <PageIntro title="Claude Community Ambassadors">
    <p>The people growing Claude community activity across India.</p>
  </PageIntro>

  <Section id="activity" labelledby="activity-heading">
    <AmbassadorLeaderboard entries={board} heading="Community activity" selectors={selectors} />
  </Section>

  <Section id="method" tone="sunk" labelledby="method-heading">
    <div class="section-head method">
      <h2 id="method-heading">How the score works</h2>
      <p class="lead">
        Score per event: <strong>{formula}</strong>. The score is the sum, calculated by this site
        from event records. It is not an Anthropic ranking.
      </p>
    </div>
  </Section>
</Base>

<style>
  /* The one method paragraph: no content follows it, so no gap after it. */
  .method {
    margin-bottom: 0;
  }

  .lead strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
