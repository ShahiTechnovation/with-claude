---
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/PageIntro.astro';
import Section from '@/components/Section.astro';
---

<Base
  title="City Management"
  description="Manage your city affiliation on WITH CLAUDE."
>
  <PageIntro eyebrow="Profile" title="City Management" size="md">
    <p>
      Your city affiliation determines which local community you appear in. 
      You can update your city directly from your Builder Passport.
    </p>
  </PageIntro>

  <Section id="auth" labelledby="auth-heading" tone="sunk">
    <h2 id="auth-heading" class="sr-only">Sign In</h2>
    <div class="auth-panel">
      <p>
        Sign in to update your city affiliation and edit your passport.
      </p>
      <div class="auth-action">
        <!-- PrivyRoot (mounted once, sitewide) portals its login button here. -->
        <div id="join-cta-root" data-next="/me/profile/edit#citySlug">
          <p class="signin-status js-hydrate-hide">Checking…</p>
        </div>
      </div>
    </div>
  </Section>
</Base>

<script>
  if (document.cookie.includes('privy-token=')) {
    window.location.href = '/me/profile/edit#citySlug';
  }
</script>

<style>
  .auth-panel {
    max-width: 32rem;
    padding: var(--s-6);
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .auth-panel p {
    margin-bottom: var(--s-5);
    color: var(--ink-2);
  }
  .auth-action {
    display: flex;
  }
</style>
