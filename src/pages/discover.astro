---
import { publicCache } from '@/server/http/cache';
import { loadLiveRecords } from '@/server/directory';
import { RecordSelectors } from '@/data/selectors';
export const prerender = false;
const _rs = await loadLiveRecords();
const selectors = new RecordSelectors(_rs);

publicCache(Astro);

import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import CommunitySearch from '@/components/CommunitySearch.astro';
import { searchVocabulary, buildSearchIndex } from '@/lib/search';
import { titles, trail } from '@/lib/seo';

const index = buildSearchIndex(selectors);
const vocab = searchVocabulary(selectors);

const crumbs = trail({ name: 'Discover', href: '/discover' });

// The search page is indexable on purpose: it is a complete, ranked directory
// of the community, which is a genuine page. What is NOT indexable is a query
// — `/discover?q=x` is the same static document, and the canonical tag points
// at the bare path, so no result set can become its own thin page.
const description =
  'Search everything — people, projects, events, cities, use cases and stories from the community building with Claude in India.';
---

<Base
  title="Discover"
  seoTitle={titles.discover()}
  description={description}
  active="/discover"
  breadcrumbs={crumbs}
>
  <PageIntro title="Search the community." size="lg">
    <p>Type a name, a city or a question, like <em>Claude Code builders in Bhopal</em>.</p>
  </PageIntro>

  <Section id="search" tone="sunk" labelledby="search-results-heading">
    <h2 class="visually-hidden" id="search-results-heading">Search results</h2>
    <CommunitySearch index={index} vocab={vocab} />
  </Section>
</Base>
