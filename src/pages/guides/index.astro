---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import { authorName, authorOf, guidesChronological } from '@/data';
import { formatDate } from '@/lib/datetime';
import { itemListSchema, titles, trail } from '@/lib/seo';

/**
 * GUIDES.
 *
 * Empty, and the empty state says why rather than apologising: a guide gets
 * written because somebody asked a question, and commissioning one against a
 * keyword instead is exactly the failure mode this section exists to avoid.
 */
const guides = guidesChronological();
const crumbs = trail({ name: 'Guides', href: '/guides' });

const description =
  'Practical guides to building with Claude, written by people in the community who have actually done the thing — with their name, their credentials and when it was last checked.';

const schema = guides.length
  ? [
      itemListSchema(
        guides.map((guide) => ({ name: guide.title, href: `/guides/${guide.slug}` })),
        'Guides',
      ),
    ]
  : [];
---

<Base
  title="Guides"
  seoTitle={titles.guides()}
  description={description}
  active="/guides"
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageIntro title="Written by people who did it.">
    <p>Practical writing from the community.</p>
  </PageIntro>

  <Section id="guides" tone="sunk" labelledby="guides-heading">
    {
      guides.length === 0 ? (
        <div>
          <h2 id="guides-heading">No guides yet.</h2>
          <p class="lead empty-lede">
            Two guides people have asked for: what to bring to a build day, and how to turn a Claude
            Code prototype into something you can show.
          </p>
          <a class="btn btn-primary empty-cta" href="/me/profile/edit/">
            <span>Offer to write one</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      ) : (
        <>
          <h2 id="guides-heading" class="visually-hidden">
            Published guides
          </h2>
          <ul class="guide-list">
            {guides.map((guide) => {
              const author = authorOf(guide);
              return (
                <li class="guide-item">
                  <a class="guide-row" href={`/guides/${guide.slug}/`}>
                    <h3 class="guide-title t-h3">{guide.title}</h3>
                    <p class="guide-question">{guide.question}</p>
                    <p class="guide-standfirst">{guide.standfirst}</p>
                    <p class="guide-meta">
                      <span class="guide-by">{authorName(guide)}</span>
                      <span>{guide.author.credential}</span>
                      <span class="guide-date">
                        {guide.modified
                          ? `Updated ${formatDate(guide.modified)}`
                          : formatDate(guide.published)}
                      </span>
                    </p>
                    {author && <span class="visually-hidden">Profile: {author.name}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
  </Section>
</Base>

<style>
  .empty-lede {
    margin-top: var(--head-gap);
    max-width: 50ch;
  }

  .empty-cta {
    margin-top: var(--s-6);
  }

  .guide-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border-hair) solid var(--rule-strong);
  }

  .guide-item {
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .guide-row {
    display: block;
    padding: var(--s-6) var(--s-2);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-1) var(--ease-out);
  }

  .guide-row:hover,
  .guide-row:focus-visible {
    background: var(--paper-raised);
  }

  .guide-title {
    max-width: 32ch;
  }

  .guide-question {
    margin-top: var(--s-3);
    font-family: var(--font-body);
    color: var(--clay-deep);
    max-width: 52ch;
  }

  .guide-standfirst {
    margin-top: var(--s-3);
    max-width: 62ch;
    color: var(--ink-2);
  }

  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .guide-by {
    color: var(--ink);
  }
</style>
