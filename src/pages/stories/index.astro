---
import { titles, trail } from '@/lib/seo';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import StoryStrip from '@/components/StoryStrip.astro';
import { communityChannel, publicStories } from '@/data';
---

<Base
  title="Stories"
  seoTitle={titles.stories()}
  description="From the community — the photographic and written record of people building with Claude in India."
  active="/stories"
  breadcrumbs={trail({ name: 'Stories', href: '/stories' })}
>
  <PageIntro title="Stories from the Claude Community">
    <p>Photos from community events. Written recaps are welcome.</p>
  </PageIntro>

  <Section id="plates" bleed labelledby="stories-heading">
    <StoryStrip heading="Photos" />
  </Section>

  {
    publicStories.length === 0 && (
      <Section id="write" tone="sunk" labelledby="write-heading">
        <div class="write">
          <div class="write-main">
            <h2 id="write-heading" class="t-h2">
              No written pieces yet.
            </h2>
            <p class="lead write-lead">
              Were you at an event? A recap, or a photo nobody else has, is the most useful thing
              you can send.
            </p>
            <a
              class="btn btn-primary write-cta"
              href={communityChannel.url}
              target="_blank"
              rel="noopener"
            >
              Write one
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path
                  d="M7 13l6.5-6.5M8 6.5h5.5V12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>

          <ul class="meta write-kinds">
            <li>Event recaps</li>
            <li>Builder profiles</li>
            <li>Project stories</li>
            <li>City stories</li>
            <li>Photo essays</li>
            <li>What you learned</li>
          </ul>
        </div>
      </Section>
    )
  }
</Base>

<style>
  .write {
    display: grid;
    gap: var(--head-after);
  }

  .write-main {
    display: grid;
    gap: var(--head-gap);
    justify-items: start;
  }

  .write-lead {
    max-width: 48ch;
  }

  .write-cta {
    margin-top: 12px;
  }

  .write-kinds {
    border-top: 1px solid var(--rule-strong);
  }

  .write-kinds li {
    padding-block: 12px;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 900px) {
    .write {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.55fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: start;
    }
  }
</style>
