---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageIntro from '@/components/PageIntro.astro';
import { builderBySlug, cityName, eventBySlug, publicStories, site } from '@/data';
import { formatDate, isoDateTime } from '@/lib/datetime';
import { asset } from '@/lib/images';
import { formatName } from '@/lib/status';
import { articleSchema, titles, trail } from '@/lib/seo';

/**
 * A story page.
 *
 * No stories exist yet, so this route generates nothing. It is here so the
 * first person to write a recap has a finished place to publish it, wired into
 * the same graph as everything else — the event it covers, the city it was in,
 * and the people it is about.
 */
export const getStaticPaths = (() =>
  publicStories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }))) satisfies GetStaticPaths;

const { story } = Astro.props;

const event = story.eventSlug ? eventBySlug.get(story.eventSlug) : undefined;
const people = (story.builderSlugs ?? [])
  .map((slug) => builderBySlug.get(slug))
  .filter((b) => Boolean(b));
const image = asset(story.image);

const url = `${site.url}/stories/${story.slug}/`;

// `author` is omitted entirely rather than defaulted to the organisation when
// a piece carries no byline. "The site wrote it" is not an author.
const schema = [
  articleSchema(
    {
      headline: story.title,
      description: story.standfirst,
      published: isoDateTime(story.date),
      modified: story.updatedAt,
      authorName: story.author,
      image: image ? new URL(image.src, site.url).href : undefined,
    },
    url,
  ),
];

const crumbs = trail(
  { name: 'Stories', href: '/stories' },
  { name: story.title, href: `/stories/${story.slug}` },
);
---

<Base
  title={story.title}
  seoTitle={titles.story(story.title)}
  description={story.standfirst}
  active="/stories"
  breadcrumbs={crumbs}
  schema={schema}
  ogType="article"
>
  <PageIntro title={story.title} size={story.title.length <= 24 ? 'lg' : 'md'}>
    <p>{story.standfirst}</p>
  </PageIntro>

  <Section id="story" labelledby="story-heading">
    <h2 id="story-heading" class="visually-hidden">{story.title}</h2>

    <article class="story">
      {
        image && (
          <div class="story-image">
            <Image
              src={image}
              alt=""
              widths={[700, 1300]}
              sizes="(max-width: 61.99em) 92vw, 760px"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }

      <div class="meta story-meta">
        <span>
          {`${formatName(story.kind)}${story.citySlug ? ` · ${cityName(story.citySlug)}` : ''}`}
        </span>
        {story.author && <span>{story.author}</span>}
        <span>{formatDate(story.date)}</span>
        {story.readingMinutes && <span>{`${story.readingMinutes} min read`}</span>}
      </div>

      {
        story.body && story.body.length > 0 ? (
          <div class="story-body">
            {story.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        ) : null
      }

      {
        (event || people.length > 0) && (
          <footer class="story-links">
            {event && (
              <a class="story-link" href={`/events/${event.slug}/`}>
                <span class="meta">The event</span>
                <span class="t-h3 story-link-title">{event.title}</span>
                <span class="meta">
                  {`${formatDate(event.date)} · ${cityName(event.citySlug)}`}
                </span>
              </a>
            )}
            {people.map((person) => (
              <a class="story-link" href={`/builders/${person!.slug}/`}>
                <span class="meta">Builder</span>
                <span class="t-h3 story-link-title">{person!.name}</span>
                <span class="meta">{cityName(person!.citySlug)}</span>
              </a>
            ))}
          </footer>
        )
      }
    </article>
  </Section>

  <Section id="back">
    <a class="link" href="/stories/">
      All stories
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path
          d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </Section>
</Base>

<style>
  .story {
    max-width: 68ch;
  }

  .story-image {
    aspect-ratio: 16 / 9;
    margin-bottom: 32px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--paper-raised);
  }

  .story-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }

  .story-body {
    margin-top: 32px;
    font-size: var(--t-lead);
    line-height: 1.6;
  }

  .story-body p + p {
    margin-top: 1.1em;
  }

  .story-links {
    display: grid;
    gap: 16px;
    margin-top: clamp(48px, 5vw, 72px);
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .story-link {
    display: grid;
    gap: 4px;
    padding-block: 12px;
    text-decoration: none;
  }

  .story-link:hover .story-link-title {
    color: var(--clay-deep);
  }
</style>
