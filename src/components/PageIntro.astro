---
/**
 * Interior page opening.
 *
 * Replaces the old header, which stamped "Field record № NN" across every
 * page on the site. One archival device applied everywhere stops being a
 * device and becomes a template — so the eyebrow is now whatever the page is
 * actually about, and the stamp is optional data rather than a serial number.
 */
interface Props {
  eyebrow: string;
  title: string;
  /** Right-hand slug: coordinates, a count, a date. Real data only. */
  stamp?: string;
  size?: 'md' | 'lg';
  /** Facts worth putting under the lede, e.g. `[{ label, value }]`. */
  facts?: { label: string; value: string }[];
}

const { eyebrow, title, stamp, size = 'md', facts = [] } = Astro.props;
---

<header class:list={['page-intro', `is-${size}`]}>
  <div class="container-wide page-intro-inner">
    <div class="page-slug">
      <p class="eyebrow">{eyebrow}</p>
      {stamp && <p class="coords">{stamp}</p>}
    </div>
    <hr class="rule-line" />

    <h1 class="page-title">{title}</h1>

    <div class="page-lede">
      <slot />
    </div>

    {
      facts.length > 0 && (
        <dl class="page-facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</header>

<style>
  .page-intro {
    padding-top: clamp(1.25rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(2.2rem, 4.5vw, 4rem);
  }

  .page-slug {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
  }

  .page-title {
    margin-top: clamp(var(--s-6), 5vw, var(--s-9));
    font-size: var(--t-display);
    font-weight: 600;
    line-height: var(--lh-display);
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .is-lg .page-title {
    font-size: clamp(2.6rem, 8vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.042em;
  }

  .page-lede {
    margin-top: var(--s-5);
    max-width: 58ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .page-lede:empty {
    display: none;
  }

  .page-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .page-facts dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .page-facts dd {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
