---
/**
 * Interior page opening: the title, one sentence, and at most one action, under a
 * static corner sunrise.
 */
interface Props {
  /** A trailing "." renders as the clay full stop. */
  title: string;
  /** md (default): `.t-h1`. lg: `.t-display`, for titles of 24 characters or fewer. */
  size?: 'md' | 'lg';
  action?: { href: string; label: string };
  /** The corner sunrise. */
  glow?: boolean;
}

const { title, size = 'md', action, glow = true } = Astro.props;
const stop = title.endsWith('.');
const words = stop ? title.slice(0, -1) : title;
---

<header class="page-intro">
  {glow && <i class="sunrise is-corner" aria-hidden="true" />}
  <div class="container page-intro-inner">
    <h1 class:list={['page-title', size === 'lg' ? 't-display' : 't-h1']}>
      {words}{stop && <span class="dot">.</span>}
    </h1>

    {
      Astro.slots.has('default') && (
        <div class="lead page-lede">
          <slot />
        </div>
      )
    }

    {
      action && (
        <p class="page-action">
          <a class="btn btn-primary" href={action.href}>
            {action.label}
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </p>
      )
    }
  </div>
</header>

<style>
  .page-intro {
    position: relative;
    /* clip, not just hidden: a hidden box can still be scrolled, and iOS pans to the sun. */
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    padding-block: clamp(40px, 5vw, 72px) clamp(20px, 2.2vw, 32px);
  }

  .page-intro-inner {
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .page-title {
    max-width: 18ch;
    text-wrap: balance;
  }

  .page-lede {
    max-width: 48ch;
    color: var(--ink-2);
  }

  .page-lede:empty {
    display: none;
  }

  .page-action {
    margin-top: 6px;
  }
</style>
