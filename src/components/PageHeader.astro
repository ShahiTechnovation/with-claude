---
/**
 * Interior page masthead. Carries the same slug line and rule as the homepage
 * hero so every page reads as a leaf of the same record.
 */
interface Props {
  /** Archive number, e.g. `02`. Omit where there is nothing to number yet. */
  record?: string;
  kicker: string;
  title: string;
  /** Right-hand slug: coordinates, a date, a count. */
  stamp?: string;
  size?: 'md' | 'lg';
}

const { record, kicker, title, stamp, size = 'md' } = Astro.props;
---

<header class:list={['page-header', `is-${size}`]}>
  <div class="container-wide page-header-inner">
    <div class="page-slug">
      <span class="label">
        {record ? `Field record № ${record} — ${kicker}` : `Field record — ${kicker}`}
      </span>
      {stamp && <span class="coords">{stamp}</span>}
    </div>
    <hr class="rule-line" />
    <h1 class="page-title">{title}</h1>
    <div class="page-lede">
      <slot />
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .page-slug {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
  }

  .page-title {
    margin-top: clamp(var(--s-7), 6vw, var(--s-10));
    font-size: var(--t-display);
    font-weight: 600;
    line-height: var(--lh-display);
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .is-lg .page-title {
    font-size: clamp(2.8rem, 9vw, 7rem);
    line-height: 0.92;
  }

  .page-lede {
    margin-top: var(--s-5);
    max-width: 56ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .page-lede:empty {
    display: none;
  }

  @media (min-width: 64em) {
    .page-header-inner {
      padding-left: calc(var(--gutter) + var(--rail));
    }
  }
</style>
