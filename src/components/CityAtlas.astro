---
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import { INDIA_MAP } from '@/data/india-map';
import { projectIndia } from '@/lib/geo';
import { listJoin } from '@/lib/words';

/**
 * THE INDIA MAP: where the community meets.
 *
 * The owner chose a drawn map of India with its state lines (7 October 2026). The outline
 * is DataMeet's Admin2 states, which follow the Survey of India boundary, simplified and
 * reprojected by scripts/map/build.sh into src/data/india-map.ts. Publishing an outline
 * that differs from the official one is a regulated matter in India, so the source is
 * pinned by tests/india-map.test.ts. The CC BY 2.5 IN credit lives on /about/ (the owner
 * took it off the map, 7 October 2026).
 *
 * City dots are not in the generated data: they are placed from each city's latitude and
 * longitude with projectIndia(), in the same frame. Three kinds of city, one look each:
 * the lead city (an Ambassador's home city) glows, cities that have had an event are lit, every
 * other city is a quiet dot. An interest count is not an event, so it earns no more.
 *
 * The map is a picture (role="img"), not a control: nothing in it is focusable. The
 * city links live beside it (the homepage list, the /cities/ index).
 */
interface Props {
  selectors?: RecordSelectors;
  size?: 'compact' | 'full';
  class?: string;
}

const { selectors, size = 'full', class: className } = Astro.props;
const data = selectors ?? staticData;
const signals = data.citySignalsRanked();

const { width: W, height: H } = INDIA_MAP;

/**
 * Label side per city: right unless listed (l left, t above, d below). Kochi stays right:
 * on its left, Lakshadweep's islands run through the label at phone widths.
 */
const SIDE: Record<string, 'l' | 't' | 'd'> = {
  mumbai: 'l',
  bengaluru: 'l',
  jaipur: 'l',
  guwahati: 'l',
  ahmedabad: 't',
  indore: 'd',
};

const pins = signals.map((s) => {
  const { x, y } = projectIndia(s.city.lat, s.city.lon);
  const kind = s.state === 'ambassador-led' ? 'lead' : s.eventCount > 0 ? 'active' : 'quiet';
  return { slug: s.city.slug, name: s.city.name, kind, side: SIDE[s.city.slug] ?? 'r', x, y };
});

const lead = pins.find((p) => p.kind === 'lead');

/**
 * A route from the lead city to each lit city: a quadratic bowed 20 to 26 units to the
 * side, as the mockup draws them, so it reads as a thread rather than a network line.
 */
const routes = lead
  ? pins
      .filter((p) => p.kind === 'active')
      .map((p) => {
        const dx = p.x - lead.x;
        const dy = p.y - lead.y;
        const len = Math.hypot(dx, dy) || 1;
        const bend = Math.min(26, Math.max(20, len * 0.13));
        const cx = lead.x + dx / 2 - (dy / len) * bend;
        const cy = lead.y + dy / 2 + (dx / len) * bend;
        const f = (n: number) => n.toFixed(1);
        return `M${f(lead.x)} ${f(lead.y)}Q${f(cx)} ${f(cy)} ${f(p.x)} ${f(p.y)}`;
      })
  : [];

// The land's warm centre sits on the lead city, or the middle of the frame without one.
const hot = lead ?? { x: W / 2, y: H / 2 };

const held = signals.filter((s) => s.heldCount > 0).map((s) => s.city.name);
const label = [
  'Map of Claude community cities in India.',
  held.length ? `${listJoin(held)} ${held.length === 1 ? 'has' : 'have'} held events.` : '',
]
  .filter(Boolean)
  .join(' ');

const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(2)}%`;
---

<figure class:list={['map-figure', `is-${size}`, className]}>
  <div class="map" role="img" aria-label={label}>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false">
      <defs>
        <radialGradient
          id="in-land-fill"
          gradientUnits="userSpaceOnUse"
          cx={hot.x.toFixed(1)}
          cy={hot.y.toFixed(1)}
          r="700"
        >
          <stop class="lf-0" offset="0"></stop>
          <stop class="lf-1" offset=".55"></stop>
        </radialGradient>
        <filter id="in-land-glow" x="-5%" y="-5%" width="110%" height="110%">
          <feGaussianBlur stdDeviation="9"></feGaussianBlur>
        </filter>
        <path id="in-land" d={INDIA_MAP.india} vector-effect="non-scaling-stroke"></path>
      </defs>
      <use class="land-glow" href="#in-land" filter="url(#in-land-glow)"></use>
      <use class="land" href="#in-land"></use>
      <path class="states" d={INDIA_MAP.states} vector-effect="non-scaling-stroke"></path>
      <use class="rim" href="#in-land"></use>
      <path class="islands" d={INDIA_MAP.islands} vector-effect="non-scaling-stroke"></path>
      {routes.map((d) => <path class="route" d={d} vector-effect="non-scaling-stroke" />)}
    </svg>
    {
      pins.map((p) => (
        <span
          class:list={['pin', p.kind, p.side]}
          data-pin={p.slug}
          style={`--x:${pct(p.x, W)};--y:${pct(p.y, H)}`}
        >
          <b>{p.name}</b>
        </span>
      ))
    }
  </div>
</figure>

<style>
  .map-figure {
    margin: 0 auto;
    width: 100%;
  }

  .is-compact {
    max-width: 640px;
  }

  /* Beside the homepage's city list the map is sized to the list, not to its column,
     so the two columns end together instead of leaving a dead zone under the list. */
  @media (min-width: 900px) {
    .is-compact {
      max-width: 480px;
    }
  }

  .is-full {
    max-width: 760px;
  }

  /* The SVG scales; the pins are HTML at fixed sizes, so labels stay legible. */
  .map {
    position: relative;
  }

  .map svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .lf-0 {
    stop-color: var(--map-land-hot);
  }

  .lf-1 {
    stop-color: var(--map-land);
  }

  .land {
    fill: url(#in-land-fill);
  }

  .land-glow {
    fill: none;
    stroke: var(--clay);
    stroke-width: 6px;
    opacity: 0.3;
  }

  .states {
    fill: none;
    stroke: var(--map-state);
    stroke-width: 0.75px;
  }

  .rim {
    fill: none;
    stroke: var(--clay);
    stroke-width: 1px;
    opacity: 0.5;
  }

  /* Islands in the pin colour, never thinner than 2.5px on screen, so Lakshadweep and
     the Andamans show at any width on either ground. */
  .islands {
    fill: var(--map-pin);
    stroke: var(--map-pin);
    stroke-width: 2.5px;
    stroke-linejoin: round;
  }

  .route {
    fill: none;
    stroke: var(--clay);
    stroke-width: 1.75px;
    stroke-linecap: round;
    opacity: 0.85;
  }

  /* --- Pins ---------------------------------------------------------------- */
  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
  }

  .pin::before {
    content: '';
    position: absolute;
    left: -3px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--map-pin);
  }

  .pin b {
    position: absolute;
    white-space: nowrap;
    font: 400 var(--t-small) / 1 var(--font-body);
    color: var(--map-label);
    /* The tight layers keep the glyphs off the coastline and border rim. */
    text-shadow:
      0 0 1px var(--paper-sunk),
      0 0 2px var(--paper-sunk),
      0 0 3px var(--paper-sunk),
      0 0 10px var(--paper-sunk);
  }

  .pin.r b {
    left: 11px;
    top: 0;
    transform: translateY(-50%);
  }

  .pin.l b {
    right: 11px;
    top: 0;
    transform: translateY(-50%);
  }

  .pin.t b {
    left: 0;
    bottom: 10px;
    transform: translateX(-50%);
  }

  .pin.d b {
    left: 0;
    top: 12px;
    transform: translateX(-50%);
  }

  .pin.active::before {
    left: -4.5px;
    top: -4.5px;
    width: 9px;
    height: 9px;
    background: var(--clay);
    box-shadow:
      0 0 0 3px rgb(var(--glow) / 0.22),
      0 0 22px 6px rgb(var(--glow) / 0.55);
  }

  /* Light (and print, which is light): a clay-deep ring keeps the lit dot at 3:1 against
     the pale land. An outline, so it survives print's box-shadow reset. */
  :global([data-theme='light']) .pin.active::before {
    outline: 1.5px solid var(--clay-deep);
  }

  .pin.active b {
    font: 600 1.0625rem / 1 var(--font-title);
    color: var(--ink);
  }

  .pin.lead::before {
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    background: var(--map-pin-lead);
    box-shadow:
      0 0 0 4px rgb(var(--glow) / 0.35),
      0 0 30px 10px rgb(var(--glow) / 0.7),
      0 0 140px 50px rgb(var(--glow) / 0.26);
  }

  /* Light: a ring of hot land between the dot and its clay glow keeps the dot at 3:1. */
  :global([data-theme='light']) .pin.lead::before {
    box-shadow:
      0 0 0 3px var(--map-land-hot),
      0 0 0 6px rgb(var(--glow) / 0.35),
      0 0 30px 10px rgb(var(--glow) / 0.7),
      0 0 140px 50px rgb(var(--glow) / 0.26);
  }

  .pin.lead::after {
    content: '';
    position: absolute;
    left: -16px;
    top: -16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1.5px solid var(--clay);
    opacity: 0.55;
  }

  .pin.lead b {
    font: 300 clamp(28px, 2.7vw, 40px) / 1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .pin.lead.r b {
    left: 20px;
  }

  @media (max-width: 640px) {
    .pin.r b {
      left: 9px;
    }

    .pin.l b {
      right: 9px;
    }

    .pin.lead b {
      font-size: clamp(22px, 7.2vw, 28px);
    }

    .pin.lead.r b {
      left: 16px;
    }
  }

  /* Printers drop background colours by default, which would print the HTML dots white. */
  @media print {
    .map-figure {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .pin.active::before {
      outline: 1.5px solid var(--clay-deep);
    }
  }

  /* --- Motion: the ring runs twice; pins and routes follow the scroll ----- */
  @media (prefers-reduced-motion: no-preference) {
    .pin.lead::after {
      animation: ring 2.2s var(--ease-cine) 2;
    }

    @supports (animation-timeline: view()) {
      /* Both effects run on the figure's entry and finish by 40% of it, so a map that is
         already on screen at load (the /cities/ page) shows complete, and one scrolled
         into view lights up and draws as it arrives. */
      .map-figure {
        view-timeline: --plot block;
      }

      .pin {
        animation: lit linear both;
        animation-timeline: --plot;
        animation-range: entry 0% entry 30%;
      }

      .route {
        animation: draw linear both;
        animation-timeline: --plot;
        animation-range: entry 10% entry 40%;
      }
    }
  }

  /* No `to` frame: each run eases back to the resting ring instead of jumping to it. */
  @keyframes ring {
    from {
      transform: scale(0.5);
      opacity: 0.9;
    }
    55% {
      transform: scale(2.4);
      opacity: 0;
    }
    56% {
      transform: none;
      opacity: 0;
    }
  }

  @keyframes lit {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  @keyframes draw {
    from {
      stroke-dasharray: 0 1200;
    }
    to {
      stroke-dasharray: 1200 0;
    }
  }
</style>
