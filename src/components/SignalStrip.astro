---
import { nationalSignal, nextEvent } from '@/data';
import { dateParts } from '@/lib/datetime';

/**
 * LIVE ACROSS INDIA.
 *
 * Every figure here is counted from the event record, except the ones a
 * chapter reported about itself — those are labelled and attributed. That
 * footnote is not an apology; it is the point. Community sites invent numbers,
 * and this one does not.
 */
const signal = nationalSignal();
const next = nextEvent();
const nextParts = next ? dateParts(next.date) : undefined;

const cells = [
  {
    value: String(signal.eventsHeld).padStart(2, '0'),
    label: 'Events held',
    note: 'since March 2026',
  },
  {
    value: nextParts ? `${nextParts.dayPadded} ${nextParts.monthShort}` : '—',
    label: 'Next up',
    note: next ? next.title : 'nothing scheduled',
    accent: true,
  },
  {
    value: String(signal.citiesActive).padStart(2, '0'),
    label: 'Cities active',
    note: 'chapters running',
  },
  {
    value: String(signal.citiesOpen).padStart(2, '0'),
    label: 'Cities open',
    note: 'no chapter yet',
  },
  {
    value: signal.reportedMembers ? `${signal.reportedMembers}+` : '—',
    label: 'Community',
    note: 'reported',
    footnoted: true,
  },
];
---

<div class="signal">
  <div class="signal-head">
    <h2 id="signal-heading" class="label label-strong">
      <span class="pip pip-live" aria-hidden="true"></span>
      Live across India
    </h2>
    <p class="label signal-updated">
      Record current · {new Date().toISOString().slice(0, 10)}
    </p>
  </div>

  <dl class="signal-grid">
    {
      cells.map((cell) => (
        <div class:list={['signal-cell', { 'is-accent': cell.accent }]} data-reveal>
          <dd class="signal-value">
            {cell.value}
            {cell.footnoted && (
              <a href="#signal-note" class="signal-fn" aria-label="See note on reported figures">
                *
              </a>
            )}
          </dd>
          <dt class="signal-label">{cell.label}</dt>
          <p class="signal-note">{cell.note}</p>
        </div>
      ))
    }
  </dl>

  {
    signal.reportedSources.length > 0 && (
      <p class="signal-footnote" id="signal-note">
        <span aria-hidden="true">*</span> Counts are derived from the event record. Community size
        is self-reported and not independently verified — {signal.reportedSources.join('; ')}.
      </p>
    )
  }
</div>

<style>
  .signal-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-3);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule-strong);
  }

  .signal-updated {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  }

  .signal-cell {
    padding: var(--s-6) var(--s-4) var(--s-5) 0;
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .signal-value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .is-accent .signal-value {
    color: var(--clay-deep);
    font-style: italic;
    font-weight: 400;
  }

  .signal-fn {
    font-family: var(--font-mono);
    font-size: 0.42em;
    vertical-align: super;
    color: var(--ink-3);
    text-decoration: none;
  }

  .signal-label {
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    font-weight: 500;
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
  }

  .signal-note {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    color: var(--ink-3);
    max-width: 22ch;
  }

  .signal-footnote {
    margin-top: var(--s-4);
    max-width: 68ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--ink-3);
  }

  /* Vertical hairlines between cells, but never a trailing one. */
  @media (min-width: 42em) {
    .signal-cell {
      padding-left: var(--s-5);
      border-left: var(--border-hair) solid var(--rule);
    }

    .signal-cell:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
