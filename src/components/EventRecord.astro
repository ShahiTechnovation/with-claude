---
import {
  cityName,
  creditsFor,
  isAmbassadorLed,
  pastEvents,
  upcomingEvents,
  venueLabel,
} from '@/data';
import type { CommunityEvent } from '@/data';
import { dateParts, formatTime, isoDateTime } from '@/lib/datetime';
import { formatName, lifecycleLabel, lifecycleOf, lifecycleTone } from '@/lib/status';

/**
 * THE EVENT RECORD — the editorial archive.
 *
 * A different object from `EventArchive.astro`, which is the dense six-column
 * table the homepage and the city pages use to summarise. This one is the
 * archive as a piece of writing: what is coming, then everything that has
 * happened, in the order it happened.
 *
 * Three decisions worth keeping:
 *
 *  · The next event is set at poster scale and everything after it steps down.
 *    A row of three equal cards makes a visitor compare them; one lead makes
 *    them read the one they can actually still attend.
 *  · The past archive is grouped by year and carries the city on every line,
 *    because the interesting thing about this record is its *rhythm* — eleven
 *    rooms in seven months across three cities — and a flat list hides that.
 *  · A venue is printed when the record has one and omitted when it does not.
 *    There is no "location TBC" and no invented address; a line that is not
 *    there reads as unknown, which is the truth.
 *
 * Numbering is section-relative (01–03 upcoming, 01–11 past). It is not the
 * `volume`, which counts a city's own series and is shown on the event page.
 */
const upcoming = upcomingEvents();
const past = pastEvents();

interface Entry {
  event: CommunityEvent;
  n: string;
  parts: ReturnType<typeof dateParts>;
  city: string;
  /** The printable venue, or undefined when the record does not have one. */
  venue?: string;
  hosts: string[];
  verified: boolean;
  lifecycle: ReturnType<typeof lifecycleOf>;
}

const toEntry = (event: CommunityEvent, i: number): Entry => ({
  event,
  n: String(i + 1).padStart(2, '0'),
  parts: dateParts(event.date),
  city: cityName(event.citySlug),
  venue: venueLabel(event),
  hosts: creditsFor(event),
  verified: isAmbassadorLed(event),
  lifecycle: lifecycleOf(event),
});

const ahead = upcoming.map(toEntry);
const [lead, ...rest] = ahead;

// Newest first, then bucketed by year so the rail can label each once.
const archive = past.map(toEntry);
const years = [...new Set(archive.map((entry) => entry.parts.year))].sort((a, b) => b - a);
---

{
  ahead.length > 0 && (
    <section class="ahead" aria-labelledby="ahead-heading">
      <div class="block-head">
        <h2 class="label" id="ahead-heading">
          Upcoming events
        </h2>
        <span class="coords">{String(ahead.length).padStart(2, '0')}</span>
      </div>

      {/* The lead. The one room you can still walk into next. */}
      <article class="lead">
        <p class="lead-index">
          <span class="lead-n">{lead.n}</span>
          <span class:list={['pip', `pip-${lifecycleTone(lead.lifecycle)}`]}>
            {lifecycleLabel(lead.lifecycle)}
          </span>
        </p>

        <h3 class="lead-title">
          <a href={`/events/${lead.event.slug}`}>
            <span class="lead-city">{lead.city}</span>
            <span class="lead-name">{lead.event.title}</span>
          </a>
        </h3>

        <p class="lead-when">
          <time datetime={isoDateTime(lead.event.date, lead.event.startTime)}>
            {`${lead.parts.monthDisplay} ${lead.parts.dayPadded}, ${lead.parts.year}`}
            <span class="dot" aria-hidden="true">
              ·
            </span>
            {formatTime(lead.event.startTime)}
          </time>
        </p>

        {lead.venue && <p class="lead-venue">{lead.venue}</p>}

        <p class="lead-summary">{lead.event.summary}</p>

        <p class="lead-hosts">{`Hosted by ${lead.hosts.join(', ')}`}</p>

        <div class="lead-actions">
          {lead.event.registrationUrl && (
            <a
              class="btn btn-clay"
              href={lead.event.registrationUrl}
              target="_blank"
              rel="noopener"
            >
              <span>View on Luma</span>
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          )}
          <a class="link-arrow" href={`/events/${lead.event.slug}`}>
            <span>Event details</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </article>

      {rest.length > 0 && (
        <ul class="next-list">
          {rest.map((entry) => (
            <li class="next-item">
              <a class="next-row" href={`/events/${entry.event.slug}`}>
                <span class="next-n">{entry.n}</span>

                <span class="next-body">
                  <span class="next-title">
                    <span class="next-city">{entry.city}</span>
                    <span class="next-name">{entry.event.title}</span>
                  </span>
                  <time
                    class="next-when"
                    datetime={isoDateTime(entry.event.date, entry.event.startTime)}
                  >
                    {`${entry.parts.monthDisplay} ${entry.parts.dayPadded}`}
                    <span class="dot" aria-hidden="true">
                      ·
                    </span>
                    {formatTime(entry.event.startTime)}
                  </time>
                  {entry.venue && <span class="next-venue">{entry.venue}</span>}
                  <span class="next-hosts">{entry.hosts.join(', ')}</span>
                </span>

                <span class:list={['pip', `pip-${lifecycleTone(entry.lifecycle)}`, 'next-pip']}>
                  {lifecycleLabel(entry.lifecycle)}
                </span>
              </a>

              {entry.event.registrationUrl && (
                <a
                  class="next-luma"
                  href={entry.event.registrationUrl}
                  target="_blank"
                  rel="noopener"
                >
                  <span>View on Luma</span>
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

{
  archive.length > 0 && (
    <section class="archive" aria-labelledby="archive-heading">
      <div class="block-head">
        <h2 class="label" id="archive-heading">
          The archive
        </h2>
        <span class="coords">{String(archive.length).padStart(2, '0')}</span>
      </div>

      {years.map((year) => (
        <div class="year">
          <p class="year-mark" aria-hidden="true">
            {year}
          </p>

          <ul class="year-list">
            {archive
              .filter((entry) => entry.parts.year === year)
              .map((entry) => (
                <li class="past-item">
                  <a class="past-row" href={`/events/${entry.event.slug}`}>
                    <span class="past-n">{entry.n}</span>

                    <time
                      class="past-when"
                      datetime={isoDateTime(entry.event.date, entry.event.startTime)}
                    >
                      <span class="past-date">
                        {`${entry.parts.monthDisplay} ${entry.parts.dayPadded}`}
                      </span>
                      <span class="past-time">{formatTime(entry.event.startTime)}</span>
                    </time>

                    <span class="past-body">
                      <span class="past-title">
                        <span class="past-city">{entry.city}</span>
                        <span class="past-name">{entry.event.title}</span>
                        {entry.verified && (
                          <span class="past-mark" title="Hosted by a Claude Community Ambassador">
                            <span class="visually-hidden">
                              Hosted by a Claude Community Ambassador
                            </span>
                            <span aria-hidden="true">✳</span>
                          </span>
                        )}
                      </span>
                      {entry.venue && <span class="past-venue">{entry.venue}</span>}
                      <span class="past-hosts">{entry.hosts.join(', ')}</span>
                    </span>

                    <span class="past-format">{formatName(entry.event.format)}</span>
                  </a>

                  {/* Past rooms keep the link where one exists, set quietly —
                      it is a reference now, not an invitation. */}
                  {entry.event.registrationUrl && (
                    <a
                      class="past-luma"
                      href={entry.event.registrationUrl}
                      target="_blank"
                      rel="noopener"
                    >
                      <span class="visually-hidden">{`View ${entry.event.title} on Luma`}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </li>
              ))}
          </ul>
        </div>
      ))}

      <p class="archive-note">
        <span aria-hidden="true">✳</span> Hosted by a Claude Community Ambassador — a programme
        Anthropic runs. Events without the mark are community activity on the record.
      </p>
    </section>
  )
}

<style>
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  .block-head .label {
    color: var(--ink);
  }

  .dot {
    padding-inline: 0.5em;
    color: var(--rule-strong);
  }

  /* ===== UPCOMING ======================================================= */

  .ahead {
    margin-bottom: var(--s-11);
  }

  .lead {
    padding-block: var(--s-8) var(--s-9);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .lead-index {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .lead-n {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .lead-title {
    margin-top: var(--s-5);
    max-width: 20ch;
  }

  .lead-title a {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .lead-city {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--clay-deep);
    margin-bottom: var(--s-3);
  }

  .lead-name {
    display: block;
    font-size: clamp(2.1rem, 5.5vw, 4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .lead-title a:hover .lead-name,
  .lead-title a:focus-visible .lead-name {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.12em;
  }

  .lead-when {
    margin-top: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink);
  }

  .lead-venue {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .lead-summary {
    margin-top: var(--s-5);
    max-width: 52ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .lead-hosts {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .lead-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-7);
  }

  /* ---- the other upcoming rooms ---- */

  .next-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .next-item {
    position: relative;
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .next-row {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr) auto;
    gap: var(--s-5);
    align-items: baseline;
    padding: var(--s-6) 0;
    text-decoration: none;
    color: inherit;
  }

  .next-item:hover,
  .next-item:focus-within {
    background: var(--paper-raised);
  }

  .next-n {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .next-body {
    display: grid;
    gap: var(--s-2);
  }

  .next-city {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--clay-deep);
    margin-right: var(--s-3);
  }

  .next-name {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.022em;
  }

  .next-row:hover .next-name,
  .next-row:focus-visible .next-name {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .next-when,
  .next-venue,
  .next-hosts {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .next-when {
    color: var(--ink-2);
  }

  .next-pip {
    align-self: center;
  }

  .next-luma {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-6);
    padding: var(--s-2) var(--s-3);
    margin-left: calc(4ch + var(--s-5));
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .next-luma:hover,
  .next-luma:focus-visible {
    border-color: var(--ink);
    color: var(--ink);
  }

  /* ===== ARCHIVE ======================================================== */

  .year {
    display: grid;
    grid-template-columns: 7ch minmax(0, 1fr);
    gap: var(--s-6);
    padding-top: var(--s-6);
  }

  .year-mark {
    position: sticky;
    top: var(--s-9);
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .year-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .past-item {
    position: relative;
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .past-row {
    display: grid;
    grid-template-columns: 4ch 10ch minmax(0, 1fr) auto;
    gap: var(--s-5);
    align-items: baseline;
    padding: var(--s-5) 0;
    padding-right: var(--s-8);
    text-decoration: none;
    color: inherit;
  }

  .past-item:hover,
  .past-item:focus-within {
    background: var(--paper-raised);
  }

  .past-n,
  .past-when,
  .past-format {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .past-date {
    display: block;
    color: var(--ink-2);
  }

  .past-time {
    display: block;
    margin-top: var(--s-1);
  }

  .past-body {
    display: grid;
    gap: var(--s-2);
  }

  .past-city {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
    margin-right: var(--s-3);
  }

  .past-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .past-row:hover .past-name,
  .past-row:focus-visible .past-name {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .past-mark {
    margin-left: var(--s-2);
    color: var(--clay-deep);
    font-size: 0.7em;
    vertical-align: 0.35em;
  }

  .past-venue,
  .past-hosts {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Sits over the row rather than inside it: a link cannot nest in a link,
     and the row is the primary target. */
  .past-luma {
    position: absolute;
    top: var(--s-5);
    right: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: var(--border-hair) solid transparent;
    border-radius: var(--radius-xs);
    color: var(--ink-3);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .past-luma:hover,
  .past-luma:focus-visible {
    border-color: var(--rule-strong);
    color: var(--clay-deep);
  }

  .archive-note {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.8;
    color: var(--ink-3);
    max-width: 64ch;
  }

  /* ===== RESPONSIVE ===================================================== */

  @media (max-width: 60rem) {
    .past-row {
      grid-template-columns: 4ch 10ch minmax(0, 1fr);
    }

    .past-format {
      grid-column: 3;
    }
  }

  @media (max-width: 44rem) {
    .year {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }

    .year-mark {
      position: static;
    }

    .next-row {
      grid-template-columns: 4ch minmax(0, 1fr);
    }

    .next-pip {
      grid-column: 2;
      justify-self: start;
    }

    .past-row {
      grid-template-columns: 4ch minmax(0, 1fr);
      gap: var(--s-2) var(--s-4);
      padding-right: var(--s-7);
    }

    .past-when {
      grid-column: 2;
      display: flex;
      gap: var(--s-3);
    }

    .past-date,
    .past-time {
      display: inline;
      margin-top: 0;
    }

    .past-body,
    .past-format {
      grid-column: 2;
    }

    .lead-actions {
      gap: var(--s-4);
    }

    .lead-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .next-luma {
      margin-left: calc(4ch + var(--s-5));
    }
  }
</style>
