---
import { Image } from 'astro:assets';
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import type { CommunityEvent } from '@/data';
import { formatDayShort, isoDateTime } from '@/lib/datetime';
import { eventPlate } from '@/lib/event-plate';
import { lifecycleLabel, lifecycleOf, lifecycleTone } from '@/lib/status';

/**
 * Events as rows: the plate, the title, then the day and the city. An event with no plate
 * draws no tile; its row drops the plate column and the title starts at the row's edge.
 *
 * With no `events`, it is the whole record (upcoming and past, newest first) under one `h2` per
 * year; `exclude` drops the event the page already features. With `events`, it is a flat list in
 * the order given, for `EventArchive`. A status word shows only while the event is not over, and
 * plain "Upcoming" only when the list also holds past events.
 */
interface Props {
  selectors?: RecordSelectors;
  /** The slug of an event the page already shows. */
  exclude?: string;
  /** An explicit list, rendered flat in this order. */
  events?: CommunityEvent[];
  /** Off on a city's own page, where every row would repeat the city. */
  showCity?: boolean;
}

const { selectors, exclude, events, showCity = true } = Astro.props;
const data = selectors ?? staticData;
const now = new Date();

const list = events ?? [...data.upcomingEvents()].reverse().concat(data.pastEvents());
const rows = list
  .filter((event) => event.slug !== exclude)
  .map((event) => {
    const lifecycle = lifecycleOf(event, now);
    return {
      event,
      lifecycle,
      plate: eventPlate(event),
      year: event.date.slice(0, 4),
      // A flat list has no year headings, so each row carries its own year.
      meta: [
        events
          ? `${formatDayShort(event.date)} ${event.date.slice(0, 4)}`
          : formatDayShort(event.date),
        showCity && data.cityName(event.citySlug),
      ]
        .filter(Boolean)
        .join(' · '),
    };
  });
type Row = (typeof rows)[number];
// "Upcoming" says nothing in a list with no past events (the ambassador page's "Upcoming events").
const mixed = rows.some((row) => row.lifecycle === 'past');
const status = (row: Row) => row.lifecycle !== 'past' && (mixed || row.lifecycle !== 'upcoming');
const years = events ? [] : [...new Set(rows.map((row) => row.year))];
const groups: { year?: string; rows: Row[] }[] = events
  ? [{ rows }]
  : years.map((year) => ({ year, rows: rows.filter((row) => row.year === year) }));
---

{
  groups.map((group) => (
    <div class:list={['erecord', group.year && 'is-year']}>
      {group.year && (
        <h2 class="t-h3 erecord-year" id={`year-${group.year}`}>
          {group.year}
        </h2>
      )}
      <ul class="erows spotlight">
        {group.rows.map((row) => (
          <li>
            <a class:list={['erow', !row.plate && 'no-plate']} href={`/events/${row.event.slug}/`}>
              {row.plate && (
                <Image
                  class="erow-plate"
                  src={row.plate}
                  alt=""
                  widths={[56, 112]}
                  sizes="56px"
                  loading="lazy"
                />
              )}
              <span class="erow-text">
                <span class="erow-title">{row.event.title}</span>
                <time class="erow-meta" datetime={isoDateTime(row.event.date, row.event.startTime)}>
                  {row.meta}
                </time>
              </span>
              {status(row) && (
                <span class:list={['pip', `pip-${lifecycleTone(row.lifecycle)}`, 'erow-pip']}>
                  {lifecycleLabel(row.lifecycle)}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))
}

<style>
  .erecord.is-year + .erecord.is-year {
    margin-top: var(--head-after);
  }

  .erecord-year {
    margin-bottom: var(--s-4);
  }

  .erows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .erows li {
    border-bottom: 1px solid var(--rule);
  }

  /* A list that ends its section: the hairline that follows (the next section's or the
     footer's) closes it, so the last row draws none and the two lines never stack. */
  :global(.section-body) > .erecord:last-child .erows li:last-child,
  :global(.section-body > .archive:last-child) > .erecord:last-child .erows li:last-child {
    border-bottom: 0;
  }

  /* A list that ends a band (sunk or raised): the last row's 12px hover padding already sits
     below the plate, so the band's padding is counted from the plate, not from the hairline.
     Not on paper: there the next hairline (a Section's or the footer's) needs the full gap. */
  :global(:is(.is-sunk, .is-raised) > .section-body) > .erecord:last-child,
  :global(:is(.is-sunk, .is-raised) > .section-body > .archive:last-child) > .erecord:last-child {
    margin-bottom: -12px;
  }

  .erow {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 12px;
    margin-inline: -12px;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background var(--dur-1) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .erow.no-plate {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .erow:hover {
    background: var(--paper-raised);
  }

  .erow-plate {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    background: var(--paper-raised-2);
  }

  .erow-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .erow-title {
    font-family: var(--font-title);
    font-size: var(--t-title);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.006em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .erow:hover .erow-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .erow-meta {
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  @media (max-width: 639px) {
    .erow {
      grid-template-columns: 56px minmax(0, 1fr);
      row-gap: 6px;
    }

    .erow.no-plate {
      grid-template-columns: minmax(0, 1fr);
    }

    .erow-pip {
      grid-column: 2;
    }

    .erow.no-plate .erow-pip {
      grid-column: 1;
    }
  }

  @media (min-width: 900px) {
    .erecord.is-year {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--s-6);
      align-items: start;
    }

    .erecord-year {
      margin: 0;
      padding-top: 12px;
    }
  }
</style>
