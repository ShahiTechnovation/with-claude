---
import { Image } from 'astro:assets';
import * as staticData from '@/data';
import { communityChannel } from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import { formatMonthYear } from '@/lib/datetime';
import { eventLabel } from '@/lib/event-display';
import { requireAsset } from '@/lib/images';
import { formatName } from '@/lib/status';

/**
 * FROM THE COMMUNITY.
 *
 * The photographic record is the archive, not a stand-in for one. Written
 * pieces join it when they are written; until then this section makes no
 * excuses for being pictures, because pictures of real rooms are the strongest
 * evidence on the site.
 *
 * A horizontal set of plates you scroll, not an autoplaying carousel: no
 * timers, no hover-only affordances, and it works with a trackpad, a finger,
 * or the Tab key. Frames and captions match the homepage photo strip.
 */
interface Props {
  showHead?: boolean;
  heading?: string;
  selectors?: RecordSelectors;
}

const { showHead = true, heading = 'From the community', selectors } = Astro.props;

const data = selectors ?? staticData;
const plates = data.photoRecord();
const written = data.storiesChronological();
---

<div class="floor">
  {
    showHead && (
      <div class="container section-head">
        <h2 id="stories-heading">{heading}</h2>
      </div>
    )
  }

  {
    written.length > 0 && (
      <div class="container floor-written">
        <ul class="dispatches">
          {written.slice(0, 3).map((story) => (
            <li>
              <a href={`/stories/${story.slug}/`}>
                <span class="meta">{formatName(story.kind)}</span>
                <span class="t-h3 dispatch-title">{story.title}</span>
                <span class="dispatch-standfirst">{story.standfirst}</span>
                <span class="meta">
                  {formatMonthYear(story.date)}
                  {story.citySlug ? ` · ${data.cityName(story.citySlug)}` : ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <ul class="floor-track" tabindex="0" aria-label="Photographs from past events, scrollable">
    {
      plates.map((plate, i) => {
        const city = data.cityName(plate.event.citySlug);
        const when = formatMonthYear(plate.event.date);
        // Most events have several plates. Only the first is a tab stop, so the
        // keyboard path is one stop per room; the rest stay clickable.
        const repeat = plates.findIndex((p) => p.event.slug === plate.event.slug) < i;
        return (
          <li class="floor-item">
            <figure>
              <a
                class="frame"
                href={`/events/${plate.event.slug}/`}
                tabindex={repeat ? -1 : undefined}
              >
                <Image
                  src={requireAsset(plate.src)}
                  alt={plate.alt}
                  widths={[400, 800]}
                  sizes="400px"
                  loading="lazy"
                  decoding="async"
                />
                {/* The photograph's alt describes the picture; the link also
                    has to say where it goes. The caption below is a sibling of
                    the anchor, so it cannot name it. */}
                <span class="visually-hidden">{`${plate.event.title}, ${city}, ${when}`}</span>
              </a>
              <figcaption class="meta">
                {`${eventLabel(plate.event.title, plate.event.shortTitle ?? null, city)} · ${when}`}
              </figcaption>
            </figure>
          </li>
        );
      })
    }

    <li class="floor-item floor-end">
      <p class="t-title">Were you in one of these rooms?</p>
      <p class="meta">Send photos, write-ups or recaps from any event.</p>
      <a class="link" href={communityChannel.url} target="_blank" rel="noopener">
        Send them in
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path
            d="M7 13l6.5-6.5M8 6.5h5.5V12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </li>
  </ul>
</div>

<script>
  // Chrome leaves a tab stop that is already partly on screen where it is, so a frame
  // peeking in at the edge would take focus mostly hidden. Bring the whole item in.
  document.addEventListener('focusin', (e) => {
    const target = e.target as Element;
    if (!target.parentElement?.closest('.floor-track')) return;
    (target.closest('li') ?? target).scrollIntoView({ block: 'nearest', inline: 'nearest' });
  });
</script>

<style>
  /* --- Written dispatches, when they exist -------------------------------- */
  .floor-written {
    margin-bottom: var(--head-after);
  }

  .dispatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
  }

  .dispatches a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
  }

  .dispatches a:hover {
    border-color: var(--rule-strong);
  }

  .dispatch-standfirst {
    color: var(--ink-2);
  }

  /* --- The strip: native sideways scroll, aligned to the content edge ------ */
  .floor-track {
    --edge: max(var(--gutter), calc((100% - var(--measure)) / 2));
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 4px var(--edge);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    overscroll-behavior-x: contain;
  }

  .floor-item {
    flex: none;
    width: clamp(260px, 27vw, 400px);
    scroll-snap-align: start;
  }

  .floor-item figure {
    margin: 0;
  }

  /* Positioned, so the visually hidden link text stays inside the scroller. */
  .frame {
    position: relative;
    display: block;
    border-radius: 14px;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 14px;
    background: var(--paper-raised);
  }

  .floor-item figcaption {
    margin-top: 12px;
    line-height: 1.4;
  }

  /* --- Closing panel ------------------------------------------------------ */
  .floor-end {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 12px;
    width: min(74vw, 300px);
    padding-left: 20px;
    border-left: 1px solid var(--clay);
  }
</style>
