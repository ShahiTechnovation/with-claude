---
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import { isLive } from '@/lib/city';
import { plural } from '@/lib/words';

/**
 * FIND YOUR CITY.
 *
 * The atlas introduces the geography; this is the browsable index of it.
 *
 * Note the framing. Cities without activity are not "available", "open", or
 * waiting to be claimed — they are plotted, and the page says exactly what is
 * true about each one. The action offered is to register interest, which is a
 * signal about where people are, not an application for anything.
 */
interface Props {
  heading?: string;
  showHead?: boolean;
  selectors?: RecordSelectors;
}

const { heading = 'Find your city', showHead = true, selectors } = Astro.props;

const data = selectors ?? staticData;

const signals = data.citySignalsRanked();
const live = signals.filter((s) => isLive(s.state));
const quiet = signals
  .filter((s) => !isLive(s.state))
  .sort((a, b) => a.city.name.localeCompare(b.city.name));
---

<div class="cities">
  {
    showHead && (
      <div class="section-head">
        <h2 id="cities-heading">{heading}</h2>
      </div>
    )
  }

  {
    live.length > 0 && (
      <div class="group">
        <h3 class="group-head">Active cities</h3>
        <ul class="live-list spotlight">
          {live.map((signal) => {
            // The one place per-city counts are shown: non-zero, unpadded.
            const counts = [
              signal.eventCount > 0 && plural(signal.eventCount, 'event'),
              signal.builderCount > 0 && plural(signal.builderCount, 'builder'),
              signal.projectCount > 0 && plural(signal.projectCount, 'project'),
            ]
              .filter(Boolean)
              .join(' · ');
            return (
              <li>
                <a class="city-name t-h3" href={`/cities/${signal.city.slug}/`}>
                  {signal.city.name}
                </a>
                {counts && <p class="meta">{counts}</p>}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  {
    quiet.length > 0 && (
      <div class="group">
        <h3 class="group-head">Other cities</h3>
        <ul class="quiet-list">
          {quiet.map((signal) => (
            <li>
              <a href={`/cities/${signal.city.slug}/`}>{signal.city.name}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="ask">
    <div>
      <h3 class="ask-title">Your city isn’t here yet?</h3>
      <p class="meta">Tell us where you are.</p>
    </div>
    <a class="btn btn-primary" href="/me/profile/edit/">
      Register your city
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path
          d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</div>

<style>
  .group + .group {
    margin-top: var(--head-after);
  }

  /* A label, not a title: sans 15px grey over a hairline. */
  .group-head {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-strong);
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink-3);
  }

  /* --- Cities with activity: the mockup's hairline rows -------------------- */
  .live-list li {
    display: grid;
    gap: 6px;
    padding-block: 20px;
    position: relative;
    border-bottom: 1px solid var(--rule);
  }

  /* The name link covers the whole row, so the lit row is all clickable. */
  .city-name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .city-name {
    justify-self: start;
    color: var(--ink);
    text-decoration: none;
  }

  .city-name:hover {
    color: var(--clay-deep);
  }

  .live-list .meta {
    margin: 0;
  }

  /* --- The quiet index: plain name links, two columns ---------------------- */
  .quiet-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  .quiet-list a {
    display: block;
    padding-block: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: var(--t-body);
    color: var(--ink-2);
    text-decoration: none;
  }

  .quiet-list a:hover {
    color: var(--ink);
  }

  /* --- The ask -------------------------------------------------------------- */
  .ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: var(--head-after);
  }

  .ask-title {
    font-family: var(--font-title);
    font-size: var(--t-body);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .ask .meta {
    margin-top: 4px;
  }
</style>
