---
import { builders, cityName } from '@/data';

/**
 * WHO'S BUILDING?
 *
 * The roster is short because the record is short. Rather than pad it with
 * stock avatars, the section says so plainly and ends on an open row — the
 * invitation to be the next entry. An honest index that grows is worth more
 * than a wall of invented profiles.
 */
const roster = builders.map((builder, i) => ({
  ...builder,
  index: String(i + 1).padStart(2, '0'),
  city: cityName(builder.citySlug),
}));
---

<div class="roster">
  <div class="section-head roster-head">
    <p class="section-index">05 — People</p>
    <h2 id="builders-heading">Who’s building?</h2>
    <p class="prose">
      Around sixty people were in the room for the last Claude Code Workshop in Bhopal. Two of them
      are on this list. The record is only as complete as what people add to it — so if you were
      there, or you are building something, put your name down.
    </p>
  </div>

  <div class="roster-table" data-reveal>
    <div class="roster-row roster-row-head" aria-hidden="true">
      <span>№</span>
      <span>Name</span>
      <span>Role</span>
      <span>City</span>
      <span>On record</span>
    </div>

    <ul>
      {
        roster.map((builder) => (
          <li>
            <a class="roster-row" href={`/builders/${builder.slug}`}>
              <span class="roster-index">{builder.index}</span>
              <span class="roster-name">{builder.name}</span>
              <span class="roster-role">{builder.role}</span>
              <span class="roster-city">{builder.city}</span>
              <span class="roster-events">
                {builder.eventSlugs?.length ?? 0} event
                {(builder.eventSlugs?.length ?? 0) === 1 ? '' : 's'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- The open row: the most important line in the section. -->
    <a
      class="roster-row roster-row-open"
      href="https://t.me/tog_guild"
      target="_blank"
      rel="noopener"
    >
      <span class="roster-index" aria-hidden="true">+</span>
      <span class="roster-name">Your name</span>
      <span class="roster-role">Whatever you build</span>
      <span class="roster-city">Your city</span>
      <span class="roster-events roster-add">
        Add yourself
        <span class="arrow" aria-hidden="true">↗</span>
      </span>
    </a>
  </div>
</div>

<style>
  .roster-head {
    max-width: 62ch;
  }

  .roster-table {
    margin-top: var(--s-7);
    border-top: var(--border-heavy) solid var(--ink);
  }

  .roster-row {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1.5fr) minmax(0, 1.2fr) minmax(0, 0.8fr) minmax(0, 0.9fr);
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur-1) var(--ease-out);
  }

  a.roster-row:hover,
  a.roster-row:focus-visible {
    background: color-mix(in srgb, var(--clay) 7%, transparent);
  }

  .roster-row-head {
    padding-block: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .roster-index {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .roster-name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
  }

  .roster-role,
  .roster-city,
  .roster-events {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* --- The open row ----------------------------------------------------- */
  .roster-row-open {
    border-bottom: 0;
    border-top: var(--border-hair) dashed var(--rule-strong);
    color: var(--ink-3);
  }

  .roster-row-open .roster-name {
    color: var(--clay-deep);
    font-style: italic;
    font-weight: 400;
  }

  .roster-row-open:hover,
  .roster-row-open:focus-visible {
    background: var(--clay-tint);
  }

  .roster-add {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--clay-deep);
  }

  .roster-add .arrow {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .roster-row-open:hover .arrow {
    transform: translate(3px, -3px);
  }

  /* --- Mobile: the table becomes stacked entries ------------------------ */
  @media (max-width: 47.99em) {
    .roster-row-head {
      display: none;
    }

    .roster-row {
      grid-template-columns: 3ch minmax(0, 1fr);
      gap: var(--s-1) var(--s-4);
    }

    .roster-name {
      grid-column: 2;
    }

    .roster-role,
    .roster-city,
    .roster-events {
      grid-column: 2;
    }

    .roster-role {
      margin-top: var(--s-1);
    }
  }
</style>
