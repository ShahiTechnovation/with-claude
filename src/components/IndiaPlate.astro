---
import { citySignals } from '@/data';
import { PLATE, formatCoords, graticule, project, threadPath } from '@/lib/geo';
import { dateParts } from '@/lib/datetime';
import type { ReadoutCity } from '@/lib/plate';

/**
 * THE SURVEY PLATE.
 *
 * A coordinate field, not a traced outline: every city sits at its true
 * latitude and longitude on a graticule. See `src/lib/geo.ts` for why.
 *
 * `ghost` is the hero's quiet backdrop; `plate` is the full instrument.
 */
interface Props {
  variant?: 'plate' | 'ghost';
  /** Whether nodes are interactive links with a readout. */
  interactive?: boolean;
  class?: string;
}

const { variant = 'plate', interactive = variant === 'plate', class: className = '' } = Astro.props;

const signals = citySignals();
const grid = graticule(5);
const anchor = project(23.2599, 77.4126); // Bhopal — where every thread starts.

/** Label side per city, hand-set to stop the north-west cluster colliding. */
const LABEL_LEFT = new Set([
  'chandigarh',
  'jaipur',
  'ahmedabad',
  'indore',
  'mumbai',
  'bengaluru',
  'kochi',
]);

const nodes = signals.map((signal) => {
  const point = project(signal.city.lat, signal.city.lon);
  const left = LABEL_LEFT.has(signal.city.slug);
  return {
    signal,
    point,
    left,
    labelX: left ? point.x - 11 : point.x + 11,
    thread: signal.city.slug === 'bhopal' ? null : threadPath(anchor, point, 0.13),
  };
});

const active = nodes.filter((n) => n.signal.city.status === 'active');
const others = nodes.filter((n) => n.signal.city.status !== 'active');

// Serialised for the readout island. Only what the panel renders.
const readoutData: ReadoutCity[] = signals.map(({ city, eventCount, next }) => ({
  slug: city.slug,
  name: city.name,
  state: city.state,
  status: city.status,
  coords: formatCoords(city.lat, city.lon),
  blurb: city.blurb,
  events: eventCount,
  organiser: city.organiser?.name ?? null,
  next: next
    ? {
        title: next.title,
        date: `${dateParts(next.date).dayPadded} ${dateParts(next.date).monthDisplay}`,
        slug: next.slug,
      }
    : null,
}));

const plateId = `plate-${variant}`;

// The readout's resting state is rendered on the server, so the panel reads
// correctly with scripts blocked. JS only ever replaces this content.
const initial = readoutData.find((c) => c.status === 'active') ?? readoutData[0];
const initialStatusLine = initial
  ? initial.status === 'active'
    ? `Active chapter · ${initial.events} event${initial.events === 1 ? '' : 's'}${initial.organiser ? ` · ${initial.organiser}` : ''}`
    : 'No chapter yet — this one is open'
  : '';
---

<div class:list={['plate-wrap', `is-${variant}`, className]}>
  <svg
    class="plate-svg"
    viewBox={`0 0 ${PLATE.width} ${PLATE.height}`}
    role={interactive ? 'group' : 'img'}
    aria-label={interactive
      ? 'Map of Claude India chapters, plotted by coordinate'
      : 'A coordinate plot of Indian cities'}
    data-plate={interactive ? plateId : undefined}
  >
    <!-- Frame -->
    <rect
      x="14"
      y="14"
      width={PLATE.width - 28}
      height={PLATE.height - 28}
      class="plate-frame"
      fill="none"></rect>

    <!-- Graticule -->
    <g class="plate-grid" aria-hidden="true">
      {grid.meridians.map((m) => <line x1={m.x} y1="14" x2={m.x} y2={PLATE.height - 14} />)}
      {grid.parallels.map((p) => <line x1="14" y1={p.y} x2={PLATE.width - 14} y2={p.y} />)}
    </g>

    <!-- Edge degree ticks -->
    <g class="plate-ticks" aria-hidden="true">
      {
        grid.meridians.map((m) => (
          <text x={m.x} y={PLATE.height - 22} text-anchor="middle">
            {m.lon}°E
          </text>
        ))
      }
      {
        grid.parallels.map((p) => (
          <text x="22" y={p.y - 6}>
            {p.lat}°N
          </text>
        ))
      }
    </g>

    <!-- Threads: every open city is one line away from the first chapter. -->
    <g class="plate-threads" aria-hidden="true">
      {nodes.map((n) => (n.thread ? <path d={n.thread} data-thread={n.signal.city.slug} /> : null))}
    </g>

    <!-- Open cities -->
    <g class="plate-nodes">
      {
        others.map((n) => {
          const Tag = interactive ? 'a' : 'g';
          return (
            <Tag
              class="node node-open"
              href={interactive ? `/cities/${n.signal.city.slug}` : undefined}
              data-node={n.signal.city.slug}
              aria-label={
                interactive
                  ? `${n.signal.city.name}, ${n.signal.city.state} — no chapter yet`
                  : undefined
              }
            >
              <circle class="node-hit" cx={n.point.x} cy={n.point.y} r="20" />
              <circle class="node-dot" cx={n.point.x} cy={n.point.y} r="3.6" />
              <text
                class="node-label"
                x={n.labelX}
                y={n.point.y + 4}
                text-anchor={n.left ? 'end' : 'start'}
              >
                {n.signal.city.name}
              </text>
            </Tag>
          );
        })
      }
    </g>

    <!-- Active chapters, drawn last so they sit above every thread -->
    <g class="plate-nodes">
      {
        active.map((n) => {
          const Tag = interactive ? 'a' : 'g';
          return (
            <Tag
              class="node node-active"
              href={interactive ? `/cities/${n.signal.city.slug}` : undefined}
              data-node={n.signal.city.slug}
              aria-label={
                interactive
                  ? `${n.signal.city.name}, ${n.signal.city.state} — active chapter, ${n.signal.eventCount} events`
                  : undefined
              }
            >
              <circle class="node-hit" cx={n.point.x} cy={n.point.y} r="24" />
              <circle class="node-halo" cx={n.point.x} cy={n.point.y} r="13" />
              {/* The station mark, drawn inline so it scales with the plate. */}
              <g class="node-mark" transform={`translate(${n.point.x} ${n.point.y})`}>
                <path d="M0 -11.5V-4.5M0 4.5v7M-11.5 0h7M4.5 0h7" />
                <path
                  d="M-7.8 -7.8l3.4 3.4M4.4 4.4l3.4 3.4M7.8 -7.8l-3.4 3.4M-4.4 4.4l-3.4 3.4"
                  opacity="0.5"
                />
                <circle r="3.4" class="node-mark-core" />
              </g>
              <text
                class="node-label node-label-active"
                x={n.labelX + 6}
                y={n.point.y + 5}
                text-anchor={n.left ? 'end' : 'start'}
              >
                {n.signal.city.name}
              </text>
            </Tag>
          );
        })
      }
    </g>
  </svg>

  {
    interactive && (
      <>
        <div
          class="readout"
          data-readout={plateId}
          data-status={initial?.status}
          aria-live="polite"
        >
          <p class="label readout-kicker">Selected</p>
          <p class="readout-name" data-readout-name>
            {initial && `${initial.name}, ${initial.state}`}
          </p>
          <p class="coords" data-readout-coords>
            {initial?.coords}
          </p>
          <p class="readout-status" data-readout-status data-status={initial?.status}>
            {initialStatusLine}
          </p>
          <p class="readout-blurb" data-readout-blurb>
            {initial?.blurb}
          </p>
          <p class="readout-next" data-readout-next>
            {initial?.next && `Next: ${initial.next.date} — ${initial.next.title}`}
          </p>
          <a
            class="link-arrow readout-go"
            data-readout-link
            href={`/cities/${initial?.slug ?? 'bhopal'}`}
          >
            <span>{initial ? `Open ${initial.name}` : 'Open city'}</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>

        <div class="plate-aside">
          <h3 class="label plate-legend-head">Legend</h3>
          <ul class="plate-legend">
            <li>
              <span class="legend-key legend-key-active" aria-hidden="true" />
              Active chapter — events have happened here
            </li>
            <li>
              <span class="legend-key legend-key-open" aria-hidden="true" />
              Plotted and open — no chapter yet
            </li>
            <li>
              <span class="legend-key legend-key-thread" aria-hidden="true" />
              One line from the first chapter to the next
            </li>
          </ul>
          <p class="plate-note">
            Positions are true latitude and longitude. No borders are drawn — this is a coordinate
            plot, not a political map.
          </p>
          <a class="btn plate-cta" href="https://t.me/tog_guild" target="_blank" rel="noopener">
            <span>Claim a dot</span>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
        <script
          is:inline
          type="application/json"
          data-readout-data={plateId}
          set:html={JSON.stringify(readoutData)}
        />
      </>
    )
  }
</div>

{interactive && <script>import '@/scripts/plate';</script>}

<style>
  .plate-wrap {
    position: relative;
    display: grid;
    gap: var(--s-6);
  }

  .plate-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* --- Frame & graticule ------------------------------------------------ */
  .plate-frame {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .plate-grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .plate-ticks text {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .plate-threads path {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    opacity: 0.5;
    transition:
      stroke var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .plate-threads path.is-lit {
    stroke: var(--clay);
    opacity: 1;
  }

  /* --- Nodes ------------------------------------------------------------ */
  .node {
    cursor: pointer;
    outline: none;
  }

  .node-hit {
    fill: transparent;
  }

  .node-dot {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.4;
    transition:
      fill var(--dur-2) var(--ease-out),
      stroke var(--dur-2) var(--ease-out),
      r var(--dur-2) var(--ease-out);
  }

  .node-label {
    fill: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.04em;
    transition: fill var(--dur-2) var(--ease-out);
  }

  .node-label-active {
    fill: var(--ink);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .node-mark {
    stroke: var(--clay);
    stroke-width: 1.7;
    stroke-linecap: round;
    fill: none;
  }

  .node-mark-core {
    fill: var(--clay);
    stroke: none;
  }

  .node-halo {
    fill: color-mix(in srgb, var(--clay) 14%, transparent);
    stroke: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .node-halo {
      transform-box: fill-box;
      transform-origin: center;
      animation: halo 3.4s var(--ease-in-out) infinite;
    }
  }

  @keyframes halo {
    0%,
    100% {
      transform: scale(0.72);
      opacity: 0.9;
    }
    55% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* Hover, focus and programmatic selection all read the same. */
  .node:hover .node-dot,
  .node.is-selected .node-dot {
    fill: var(--clay);
    stroke: var(--clay);
    r: 5;
  }

  .node:hover .node-label,
  .node.is-selected .node-label {
    fill: var(--ink);
  }

  .node:focus-visible .node-dot,
  .node:focus-visible .node-mark-core {
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .node:focus-visible .node-label {
    fill: var(--ink);
    font-weight: 500;
  }

  /* --- Readout ---------------------------------------------------------- */
  .readout {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    border: var(--border-hair) solid var(--rule);
    border-left: 2px solid var(--clay);
    background: var(--paper-raised);
  }

  .readout-kicker {
    color: var(--ink-3);
  }

  .readout-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .readout-status {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .readout-status[data-status='active'] {
    color: var(--clay-deep);
  }

  .readout-blurb {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .readout-next:empty {
    display: none;
  }

  .readout-next {
    margin-top: var(--s-2);
    padding-top: var(--s-3);
    border-top: var(--border-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .readout-go {
    justify-self: start;
    margin-top: var(--s-4);
  }

  /* --- Aside: legend, caveat, and the invitation ------------------------ */
  .plate-aside {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    justify-items: start;
    padding-top: var(--s-6);
    border-top: var(--border-hair) solid var(--rule);
  }

  .plate-legend-head {
    color: var(--ink-3);
  }

  .plate-legend {
    display: grid;
    gap: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .plate-legend li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
  }

  .legend-key {
    width: 18px;
    height: 12px;
    position: relative;
  }

  .legend-key::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .legend-key-active::before {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--clay);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--clay) 18%, transparent);
  }

  .legend-key-open::before {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.4px var(--ink-3);
  }

  .legend-key-thread::before {
    width: 18px;
    height: 1px;
    background: repeating-linear-gradient(to right, var(--rule-strong) 0 2px, transparent 2px 8px);
  }

  .plate-note {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.7;
    color: var(--ink-3);
  }

  .plate-cta {
    margin-top: var(--s-2);
  }

  /* --- Ghost variant: the hero's quiet backdrop ------------------------- */
  .is-ghost {
    pointer-events: none;
  }

  .is-ghost .plate-frame,
  .is-ghost .plate-ticks {
    display: none;
  }

  .is-ghost .plate-grid line {
    stroke: color-mix(in srgb, var(--ink) 11%, transparent);
  }

  .is-ghost .plate-threads path {
    stroke: color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .is-ghost .node-dot {
    stroke: color-mix(in srgb, var(--ink) 34%, transparent);
    stroke-width: 1.6;
  }

  .is-ghost .node-label {
    display: none;
  }

  .is-ghost .node-halo {
    fill: color-mix(in srgb, var(--clay) 10%, transparent);
  }

  .is-ghost .node-mark {
    stroke: color-mix(in srgb, var(--clay) 55%, transparent);
  }

  .is-ghost .node-mark-core {
    fill: color-mix(in srgb, var(--clay) 55%, transparent);
  }

  /* --- Small screens ----------------------------------------------------
     At phone width a 14px label inside a 720-unit viewBox renders at about
     6px and a node's hit area at about 9px — both unusable. So the plate stops
     pretending to be an instrument and becomes an orientation drawing: larger
     dots, one label, no pointer target to miss. The gazetteer further down the
     page is the real discovery interface on mobile. */
  @media (max-width: 47.99em) {
    .is-plate .plate-svg {
      pointer-events: none;
    }

    .is-plate .node-dot {
      r: 5;
    }

    .is-plate .node-open .node-label {
      display: none;
    }

    .is-plate .node-label-active {
      font-size: 26px;
    }

    .is-plate .node-mark {
      stroke-width: 2.4;
    }
  }

  /* --- Desktop split ---------------------------------------------------- */
  @media (min-width: 62em) {
    .plate-wrap.is-plate {
      grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.9fr);
      grid-template-rows: auto 1fr;
      gap: var(--s-6) var(--s-8);
      align-items: start;
    }

    .plate-svg {
      grid-row: 1 / 3;
    }

    .readout {
      position: sticky;
      top: 110px;
    }

    .plate-aside {
      align-self: start;
    }
  }
</style>
