---
import Mark from './Mark.astro';
import { nationalSignal } from '@/data';
import { plural } from '@/lib/words';

/**
 * The closing statement.
 *
 * It makes one promise and then demonstrates it with numbers pulled from the
 * record — including the zeros. A site that will show you its zeros is the
 * only kind worth believing about its other figures.
 */
const signal = nationalSignal();
---

<div class="manifesto">
  <p class="label manifesto-kicker">
    <Mark size={14} />
    The record
  </p>

  <h2 id="manifesto-heading" class="manifesto-statement">
    Everything here <em>happened</em>.
  </h2>

  <div class="manifesto-body">
    <p>
      Every event on this site is one people came to. Every photograph is a room someone sat in.
      Every name is someone who agreed to be here.
    </p>
    <p>
      Where a section is empty, it is empty because nobody has filled it in yet — not because a
      number is being hidden. There are
      {` ${plural(signal.projects, 'project')} `} in the archive and
      {` ${plural(signal.builders, 'builder')} `} on the index. Both of those are invitations.
    </p>
    <p class="manifesto-close">Come and make them out of date.</p>
  </div>

  <div class="manifesto-foot">
    <a class="btn btn-clay" href="/events">
      <span>Find an event</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
    <a class="link-arrow" href="/join#build">
      <span>Add your build</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .manifesto {
    display: grid;
    gap: var(--s-7);
  }

  .manifesto-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--clay);
  }

  .manifesto-statement {
    max-width: 13ch;
    font-size: clamp(2.6rem, 8.5vw, 7rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.042em;
  }

  .manifesto-statement em {
    font-style: italic;
    font-weight: 400;
    color: var(--clay);
  }

  .manifesto-body {
    display: grid;
    gap: var(--s-4);
    max-width: 48ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .manifesto-close {
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: 400;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    color: var(--ink);
  }

  .manifesto-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-6);
    padding-top: var(--s-6);
    border-top: var(--border-hair) solid var(--rule);
  }

  @media (min-width: 62em) {
    .manifesto {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas:
        'kicker kicker'
        'statement body'
        'foot foot';
      gap: var(--s-8) var(--s-9);
      align-items: end;
    }

    .manifesto-kicker {
      grid-area: kicker;
    }
    .manifesto-statement {
      grid-area: statement;
    }
    .manifesto-body {
      grid-area: body;
    }
    .manifesto-foot {
      grid-area: foot;
    }
  }
</style>
