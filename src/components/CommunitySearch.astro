---
import { buildSearchIndex, searchVocabulary } from '@/lib/search';
import { KIND_LABEL, SEARCH_KINDS, groupByKind } from '@/lib/search-core';
import { safeJsonLd } from '@/lib/seo';
import { formatDateCompact } from '@/lib/datetime';
import type { SearchKind, SearchRecord, SearchVocabulary } from '@/lib/search-core';
import * as staticData from '@/data';
import type { IsoDate } from '@/data';

interface Props {
  index?: SearchRecord[];
  vocab?: SearchVocabulary;
}

const { index: providedIndex, vocab: providedVocab } = Astro.props;

/**
 * SEARCH THE COMMUNITY.
 *
 * The whole index is server-rendered, ranked and grouped. That is the load-
 * bearing decision: with scripts blocked this page is a complete, ordered,
 * browsable directory of everything on the site, and the search field is the
 * only thing missing. Nothing here waits for JavaScript to become readable.
 *
 * Each row carries its precomputed haystack on `data-terms`, so the island
 * scores exactly what the server scored rather than fetching a second copy of
 * the index.
 *
 * `/discover?q=…` is a linkable result set, applied by the island on load.
 * The page is static, so the query never reaches the server and the canonical
 * URL stays `/discover` — there is one page here, not one per query.
 */
const index = providedIndex ?? buildSearchIndex(staticData.getStatic());
const vocabulary = providedVocab ?? searchVocabulary(staticData.getStatic());
const grouped = groupByKind(index.map((record) => ({ record, score: 0 })));

// Groups with nothing in them are not rendered at all: an empty PROJECTS
// heading on the search page reads as a broken filter rather than as an
// honest empty archive, which is what /projects is for.
const present = SEARCH_KINDS.filter((kind) => (grouped.get(kind)?.length ?? 0) > 0);
const total = index.length;

const tabs: { kind: SearchKind | 'all'; label: string; count: number }[] = [
  { kind: 'all', label: 'All', count: total },
  ...present.map((kind) => ({
    kind,
    label: KIND_LABEL[kind],
    count: grouped.get(kind)!.length,
  })),
];
---

<div class="search" data-search-root>
  <script
    type="application/json"
    data-search-vocabulary
    is:inline
    set:html={safeJsonLd(vocabulary)}
  />

  <form class="search-form js-only" data-search-form role="search" action="/discover/" method="get">
    <label class="search-label" for="q">Search the community</label>
    <div class="search-field">
      <span class="search-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <line x1="15.4" y1="15.4" x2="21" y2="21"></line>
        </svg>
      </span>
      <input
        id="q"
        name="q"
        type="search"
        class="search-input"
        data-search-input
        autocomplete="off"
        placeholder="Search people, projects, events, cities or Claude workflows…"
      />
      <button class="btn btn-primary btn-sm search-go" type="submit">Search</button>
    </div>
    <p class="search-status meta" data-search-status role="status">{`${total} records`}</p>
  </form>

  <div class="search-tabs js-only" role="group" aria-label="Filter results by type">
    {
      tabs.map((tab) => (
        <button
          type="button"
          class:list={['chip', 'search-tab', { 'is-on': tab.kind === 'all' }]}
          data-search-kind={tab.kind}
          aria-pressed={tab.kind === 'all' ? 'true' : 'false'}
        >
          <span>{tab.label}</span>
          <span class="search-tab-count" data-search-tab-count>
            {tab.count}
          </span>
        </button>
      ))
    }
    <button type="button" class="search-clear" data-search-clear hidden>Clear</button>
  </div>

  <p class="search-nojs no-js-only">Search needs JavaScript. Everything is listed below.</p>

  <div class="search-results">
    {
      present.map((kind) => (
        <section class="search-group" data-search-group={kind} aria-labelledby={`group-${kind}`}>
          <div class="search-group-head">
            <h3 class="t-h3" id={`group-${kind}`}>
              {KIND_LABEL[kind]}
            </h3>
            <span class="meta" data-search-group-count>
              {grouped.get(kind)!.length}
            </span>
          </div>

          <ul class="search-list">
            {grouped.get(kind)!.map(({ record }) => (
              <li
                class="search-item"
                data-search-item
                data-id={record.id}
                data-kind={record.kind}
                data-title={record.title}
                data-subtitle={record.subtitle}
                data-city={record.facets.city ?? ''}
                data-category={record.facets.category ?? ''}
                data-format={record.facets.format ?? ''}
                data-surfaces={(record.facets.surfaces ?? []).join('|')}
                data-terms={record.terms}
                data-weight={String(record.weight)}
              >
                <a class="search-row" href={record.href}>
                  <span class="search-row-main">
                    <span class="search-row-title">{record.title}</span>
                    {record.summary && <span class="search-row-summary">{record.summary}</span>}
                  </span>
                  <span class="search-row-meta">
                    {/* Several events share a title, city and format; the date tells them apart. */}
                    {record.kind === 'event' && record.date
                      ? `${record.subtitle} · ${formatDateCompact(record.date as IsoDate)}`
                      : record.subtitle}
                  </span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="search-empty" data-search-empty hidden>
    Nothing matches <strong data-search-empty-term></strong>. If it should be here,
    <a href="/me/profile/edit/">add it</a>.
  </p>
</div>

<script>
  import '@/scripts/search';
</script>

<style>
  .search {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-7);
  }

  /* ---- the field: the projects toolbar's 48px pill ---- */

  .search-label {
    display: block;
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 44rem;
    min-height: 48px;
    margin-top: var(--s-3);
    padding: 4px 4px 4px 18px;
    border: var(--border-hair) solid var(--rule-field);
    border-radius: var(--radius-pill);
    background: var(--paper-raised);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .search-field:hover {
    border-color: var(--ink-3);
  }

  .search-field:has(.search-input:focus) {
    border-color: var(--clay);
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .search-glyph {
    display: grid;
    place-items: center;
    width: 19px;
    height: 19px;
    color: var(--ink-3);
    flex: none;
  }

  .search-glyph svg {
    width: 100%;
    height: 100%;
    stroke-linecap: round;
  }

  .search-input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 38px;
    border: 0;
    background: none;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--ink);
    /* The placeholder is longer than a phone-width field. */
    text-overflow: ellipsis;
  }

  .search-input::placeholder {
    color: var(--ink-3);
  }

  /* The pill around the input carries the focus ring. */
  .search-input:focus {
    outline: none;
  }

  /* The search-type X is a Chrome affordance that fights the Clear button. */
  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-go {
    flex: none;
  }

  .search-status {
    margin-top: var(--s-3);
  }

  /* ---- type tabs: pills ---- */

  .search-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
    padding-bottom: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .search-tab {
    cursor: pointer;
  }

  .search-tab-count {
    color: var(--ink-3);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .search-tab.is-on .search-tab-count {
    color: inherit;
    opacity: 0.7;
  }

  .search-clear {
    min-height: 44px;
    margin-left: auto;
    border: 0;
    background: none;
    padding: 0 var(--s-2);
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--clay-deep);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- results ---- */

  .search-results {
    display: grid;
    gap: var(--s-8);
  }

  .search-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
  }

  .search-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .search-item {
    border-bottom: var(--border-hair) solid var(--rule);
  }

  /* The band's edge closes the last list; its last row keeps its padding as hit area. */
  .search-group:last-child {
    margin-bottom: calc(-1 * var(--s-4));
  }

  .search-group:last-child .search-item:last-child {
    border-bottom: 0;
  }

  .search-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: baseline;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-2);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-1) var(--ease-out);
  }

  .search-row:hover,
  .search-row:focus-visible {
    background: var(--paper-raised);
  }

  .search-row-main {
    display: grid;
    gap: var(--s-1);
    min-width: 0;
  }

  .search-row-title {
    color: var(--ink);
    font-family: var(--font-title);
    font-size: var(--t-body);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.006em;
  }

  .search-row-summary {
    font-size: var(--t-small);
    color: var(--ink-3);
    /* Two lines keeps a long project summary from dominating the row. */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-row-meta {
    font-size: var(--t-small);
    color: var(--ink-3);
    text-align: right;
  }

  .search-row .arrow {
    color: var(--ink-3);
    transition: transform var(--dur-1) var(--ease-out);
  }

  .search-row:hover .arrow,
  .search-row:focus-visible .arrow {
    transform: translateX(3px);
    color: var(--clay-deep);
  }

  .search-nojs {
    max-width: 56ch;
    padding-bottom: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .search-empty {
    padding: var(--s-7) 0;
    max-width: 52ch;
  }

  @media (max-width: 40rem) {
    .search-row {
      grid-template-columns: 1fr auto;
      row-gap: var(--s-1);
    }

    .search-row-meta {
      grid-column: 1;
      grid-row: 2;
      text-align: left;
    }
  }
</style>
