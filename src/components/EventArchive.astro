---
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import EventRecord from '@/components/EventRecord.astro';
import { lifecycleOf } from '@/lib/status';
import { plural } from '@/lib/words';
import type { CommunityEvent } from '@/data/types';

/**
 * The event archive for city and ambassador pages: an optional heading, then the same rows as
 * /events/ (`EventRecord`), flat, in the order chosen here.
 *
 * Status is computed per row at render time and never authored.
 */
interface Props {
  /**
   * An explicit list, when the caller already has one.
   *
   * The ambassador pages need "the events this person is credited on", which
   * is a set this component cannot select for itself — it comes out of
   * `event_hosts` via the leaderboard, not out of a city or a date range.
   *
   * An override rather than a second component: §65 says extend what exists,
   * and a bespoke event list on the ambassador page would be a second place
   * where a room's status and date are decided. The
   * default path is untouched — omit this and the archive selects exactly as
   * it always has.
   */
  events?: CommunityEvent[];
  citySlug?: string;
  limit?: number;
  order?: 'chronological' | 'upcoming-first';
  heading?: string;
  showHead?: boolean;
  showLink?: boolean;
  selectors?: RecordSelectors;
}

const {
  events: providedEvents,
  citySlug,
  limit,
  order = 'upcoming-first',
  heading = 'Events across India',
  showHead = true,
  showLink = true,
  selectors,
} = Astro.props;

const data = selectors ?? staticData;

const now = new Date();

function sortEvents(list: CommunityEvent[]): CommunityEvent[] {
  // Sorted by date, never by input order: callers pass lists in either direction.
  const newestFirst = (a: CommunityEvent, b: CommunityEvent) => b.date.localeCompare(a.date);
  if (order === 'chronological') return [...list].sort(newestFirst);
  // Upcoming ascending, then past descending — the useful order.
  const upcoming = list
    .filter((e) => lifecycleOf(e, now) !== 'past')
    .sort((a, b) => a.date.localeCompare(b.date));
  const past = list.filter((e) => lifecycleOf(e, now) === 'past').sort(newestFirst);
  return [...upcoming, ...past];
}

const source = providedEvents ?? data.eventsChronological;
const scoped = citySlug ? source.filter((e) => e.citySlug === citySlug) : source;
const all = sortEvents(scoped);
const rows = limit ? all.slice(0, limit) : all;
const remaining = all.length - rows.length;
// On a city's own page every row would repeat that city.
const showCity = !citySlug;
---

<div class="archive">
  {
    showHead && (
      <div class="section-head">
        <h2 id="events-heading">{heading}</h2>
        {showLink && (
          <a class="link section-more" href="/events/">
            All events
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path
                d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        )}
      </div>
    )
  }

  <EventRecord events={rows} showCity={showCity} selectors={selectors} />

  {
    remaining > 0 && (
      <p class="archive-more">
        <a class="link" href="/events/">
          {plural(remaining, 'more event')}
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </p>
    )
  }
</div>

<style>
  .archive-more {
    margin-top: var(--s-6);
  }
</style>
