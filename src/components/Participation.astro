---
import { official, participationPaths } from '@/data';

/**
 * Ways in.
 *
 * Six open paths and one that is not ours to give. The HOST path routes to
 * Anthropic's Ambassador programme and says plainly that this site does not
 * grant the status — it is set apart visually for the same reason it is set
 * apart in the data model.
 *
 * Tally-backed CTAs open a popup where the embed script is available and fall
 * back to a plain link everywhere else. The href is always real.
 */
interface Props {
  showHead?: boolean;
  heading?: string;
}

const { showHead = true, heading = 'Ways in' } = Astro.props;

const usesTally = participationPaths.some((item) => item.tallyId);

/**
 * A `submission` path maps to its authenticated destination here, rather than
 * routing through an anonymous form. That
 * makes `formId` load-bearing: name a form that does not exist and the build
 * stops here, the same way `SubmitPanel` stops. The alternative — a `formId`
 * nothing reads — is how the two drifted apart in the first place.
 */
function submissionHref(path: (typeof participationPaths)[number]): string {
  const destinations: Record<string, string> = {
    contribute: '/me/profile/edit/',
    build: '/me/projects/new/',
    practice: '/practice/',
    city: '/me/profile/edit/',
  };
  return path.formId ? (destinations[path.formId] ?? '/') : '/';
}

const paths = participationPaths.map((path) => {
  const url =
    path.kind === 'official'
      ? official.ambassadorProgramUrl
      : path.kind === 'submission'
        ? submissionHref(path)
        : path.url;
  return {
    ...path,
    href: url ?? '#',
    external: Boolean(url?.startsWith('http')),
  };
});

const open = paths.filter((p) => p.kind !== 'official');
const authorised = paths.filter((p) => p.kind === 'official');
---

<div class="ways">
  {
    showHead && (
      <div class="section-head">
        <h2 id="join-heading">{heading}</h2>
      </div>
    )
  }

  <ol class="paths">
    {
      open.map((item, i) => (
        <li data-reveal="fade" style={`--reveal-delay:${i * 45}ms`}>
          <a
            class="path"
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
            data-tally-open={item.tallyId}
            data-tally-layout={item.tallyId ? 'modal' : undefined}
            data-tally-auto-close={item.tallyId ? '3000' : undefined}
          >
            <span class="path-body">
              <span class="path-title t-title">{item.title}</span>
              <span class="path-desc">{item.description}</span>
            </span>
            <span class="path-cta">
              {item.ctaLabel}
              <span class="arrow" aria-hidden="true">
                {item.external ? '↗' : '→'}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  {
    authorised.map((item) => (
      <div class="official">
        <div class="official-body">
          <h3 class="official-title t-h3">{item.title}</h3>
          <p class="official-desc">{item.description}</p>
        </div>
        <div class="official-action">
          <a class="btn btn-primary" href={item.href} target="_blank" rel="noopener">
            <span>{item.ctaLabel}</span>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    ))
  }
</div>

{
  usesTally && (
    /* Loaded lazily and only because three real forms depend on it. Without it
       the links still open the forms in a new tab. */
    <script is:inline async src="https://tally.so/widgets/embed.js" />
  )
}

<style>
  /* Raised cards, three across from 1100px, two from 700px. The whole card is
     the link. */
  .paths {
    display: grid;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .paths li {
    display: grid;
  }

  .path {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--s-5);
    padding: 22px 24px 20px;
    border: var(--border-hair) solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .path:hover {
    border-color: var(--rule-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .path:hover {
      transform: translateY(-3px);
    }
  }

  .path-body {
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }

  .path-desc {
    max-width: 54ch;
    font-size: var(--t-ui);
    line-height: 1.5;
    color: var(--ink-3);
  }

  .path-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--clay-deep);
  }

  .path-cta .arrow {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .path:hover .arrow {
    transform: translateX(3px);
  }

  /* --- The path this site does not grant ----------------------------------
     Set apart: a raised panel with the glow, as the submit band. */
  .official {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--head-after);
    padding: clamp(28px, 3.4vw, 48px);
    border: var(--border-hair) solid var(--rule);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgb(var(--glow) / 0.12), transparent 60%), var(--paper-raised);
  }

  .official-desc {
    margin-top: var(--s-3);
    max-width: 56ch;
    color: var(--ink-3);
  }

  .official-action {
    display: grid;
    align-content: start;
    justify-items: start;
  }

  @media (min-width: 700px) {
    .paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 56em) {
    .official {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: var(--s-8);
      align-items: center;
    }

    .official-action {
      justify-items: end;
    }
  }

  @media (max-width: 699px) {
    .paths {
      gap: 14px;
    }
  }
</style>
