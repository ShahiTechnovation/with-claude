---
import { cityBySlug, cityName, communityChannel, hostAmbassador, upcomingEvents } from '@/data';
import { dateParts, formatTimeRange, isoDateTime, relativeDay } from '@/lib/datetime';
import { formatCoords } from '@/lib/geo';
import {
  formatName,
  isRegistrationOpen,
  lifecycleLabel,
  lifecycleOf,
  lifecycleTone,
} from '@/lib/status';

/**
 * The next useful action, made unmissable.
 *
 * The event shown here is whatever `upcomingEvents()` puts first — there is no
 * "featured" flag to forget to move, and the status under it is computed from
 * the clock every time the site builds.
 *
 * The host line is doing governance work, not decoration: an event carries the
 * verified chip because its host resolves to a published Ambassador record.
 */
const queue = upcomingEvents();
const [featured, ...rest] = queue;
const then = rest.slice(0, 2);

const parts = featured ? dateParts(featured.date) : undefined;
const lifecycle = featured ? lifecycleOf(featured) : undefined;
const city = featured ? cityBySlug.get(featured.citySlug) : undefined;
const canRegister = featured ? isRegistrationOpen(featured) : false;
const ambassador = featured ? hostAmbassador(featured) : undefined;
const organisations = featured?.host.organisations ?? [];
---

{
  featured && parts && lifecycle && (
    <div class="next">
      <div class="next-head">
        <p class="eyebrow">Next event</p>
        <span class:list={['pip', `pip-${lifecycleTone(lifecycle)}`]}>
          {lifecycleLabel(lifecycle)}
        </span>
      </div>

      <article class="next-card">
        <div class="next-date">
          <time class="next-day" datetime={isoDateTime(featured.date, featured.startTime)}>
            {parts.dayPadded}
          </time>
          <span class="next-month">{parts.monthDisplay}</span>
          <span class="next-year">{parts.year}</span>
          <span class="next-weekday">{parts.weekdayShort}</span>
        </div>

        <div class="next-main">
          <p class="label next-format">
            {formatName(featured.format)}
            {featured.volume ? ` · vol. ${String(featured.volume).padStart(2, '0')}` : ''}
          </p>

          <h2 id="next-heading" class="next-title">
            {featured.title}
          </h2>
          <p class="next-summary">{featured.description ?? featured.summary}</p>

          {ambassador && (
            <p class="next-host">
              <span class="chip chip-verified">Ambassador-led</span>
              <span class="next-host-name">
                Hosted by {ambassador.name}, {ambassador.title}
              </span>
            </p>
          )}

          <dl class="next-meta">
            <div>
              <dt class="label">City</dt>
              <dd>
                <a href={`/cities/${featured.citySlug}`}>{cityName(featured.citySlug)}</a>
                {city && <span class="coords next-coords">{formatCoords(city.lat, city.lon)}</span>}
              </dd>
            </div>
            <div>
              <dt class="label">Time</dt>
              <dd>{formatTimeRange(featured.startTime, featured.endTime)}</dd>
            </div>
            <div>
              <dt class="label">Venue</dt>
              <dd>
                {featured.venue.name}
                {featured.venue.address && (
                  <span class="next-address">{featured.venue.address}</span>
                )}
                {featured.venue.private && (
                  <span class="next-address">Shared with confirmed registrants</span>
                )}
              </dd>
            </div>
            <div>
              <dt class="label">Entry</dt>
              <dd>{featured.free ? 'Free · approval required' : 'Ticketed'}</dd>
            </div>
            {organisations.length > 0 && (
              <div>
                <dt class="label">With</dt>
                <dd>{organisations.join(', ')}</dd>
              </div>
            )}
          </dl>

          <div class="next-actions">
            {canRegister && featured.registrationUrl ? (
              <a
                class="btn btn-clay"
                href={featured.registrationUrl}
                target="_blank"
                rel="noopener"
              >
                <span>Register</span>
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ) : (
              <span class="btn btn-quiet" aria-disabled="true">
                {lifecycleLabel(lifecycle)}
              </span>
            )}
            <a class="link-arrow" href={`/events/${featured.slug}`}>
              <span>Event details</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
            <span class="next-countdown">{relativeDay(featured.date)}</span>
          </div>
        </div>
      </article>

      {then.length > 0 && (
        <ul class="next-then">
          {then.map((event) => {
            const p = dateParts(event.date);
            return (
              <li>
                <a href={`/events/${event.slug}`}>
                  <span class="next-then-label">Then</span>
                  <span class="next-then-date">{`${p.dayPadded} ${p.monthDisplay}`}</span>
                  <span class="next-then-title">{event.title}</span>
                  <span class="next-then-city">{cityName(event.citySlug)}</span>
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  )
}

{
  !featured && (
    <div class="next-empty">
      <p class="eyebrow">Next event</p>
      <h2 id="next-heading" class="next-empty-title">
        Nothing on the calendar.
      </h2>
      <p class="prose">
        No event is scheduled right now. New dates land in the community channel first, and appear
        here the moment they are confirmed.
      </p>
      <div class="next-empty-actions">
        <a class="btn" href={communityChannel.url} target="_blank" rel="noopener">
          <span>Join the channel</span>
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
        <a class="link-arrow" href="/events">
          <span>The full record</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>
  )
}

<style>
  .next-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-bottom: var(--s-4);
    border-bottom: var(--border-heavy) solid var(--ink);
  }

  /* --- The card --------------------------------------------------------- */
  .next-card {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-7);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  /* The date, at poster scale. This is the thing you see across the room. */
  .next-date {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 0 var(--s-3);
    line-height: 1;
  }

  .next-day {
    grid-row: 1 / 3;
    font-family: var(--font-display);
    font-size: clamp(4rem, 13vw, 8rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.055em;
    line-height: 0.78;
    font-variant-numeric: lining-nums;
  }

  .next-month {
    align-self: start;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.6vw, 1.45rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--clay-deep);
  }

  .next-year,
  .next-weekday {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    color: var(--ink-3);
    text-transform: uppercase;
  }

  .next-format {
    color: var(--ink-3);
    text-transform: uppercase;
  }

  .next-title {
    margin-top: var(--s-2);
    font-size: var(--t-display);
    letter-spacing: -0.032em;
    line-height: var(--lh-display);
    max-width: 16ch;
  }

  .next-summary {
    margin-top: var(--s-4);
    max-width: 54ch;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  /* --- Host ------------------------------------------------------------- */
  .next-host {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .next-host-name {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* --- Metadata --------------------------------------------------------- */
  .next-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .next-meta dt {
    color: var(--ink-3);
    margin-bottom: var(--s-2);
  }

  .next-meta dd {
    font-size: var(--t-small);
    line-height: 1.45;
  }

  .next-address,
  .next-coords {
    display: block;
    color: var(--ink-3);
    font-size: var(--t-micro);
    margin-top: 2px;
  }

  /* --- Actions ---------------------------------------------------------- */
  .next-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }

  .next-countdown {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
    margin-left: auto;
  }

  /* --- What comes after ------------------------------------------------- */
  .next-then a {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink-2);
    transition: color var(--dur-1) var(--ease-out);
  }

  .next-then a:hover,
  .next-then a:focus-visible {
    color: var(--ink);
  }

  .next-then-label,
  .next-then-date,
  .next-then-city {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
  }

  .next-then-label {
    color: var(--ink-3);
    min-width: 4ch;
  }

  .next-then-date {
    color: var(--clay-deep);
    font-variant-numeric: tabular-nums;
  }

  .next-then-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
  }

  .next-then-city {
    color: var(--ink-3);
  }

  .next-then .arrow {
    margin-left: auto;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .next-then a:hover .arrow {
    transform: translateX(4px);
  }

  /* --- Empty state ------------------------------------------------------ */
  .next-empty {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .next-empty-title {
    font-size: var(--t-h2);
  }

  .next-empty-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-5);
    margin-top: var(--s-3);
  }

  /* --- Desktop ---------------------------------------------------------- */
  @media (min-width: 48em) {
    .next-card {
      grid-template-columns: minmax(130px, 0.3fr) minmax(0, 1fr);
      gap: var(--s-8);
      padding-block: var(--s-8);
    }

    .next-date {
      position: sticky;
      top: 110px;
      align-self: start;
    }
  }
</style>
