---
/**
 * A project's cover, or an honest placeholder — always the same box.
 *
 * Cards used to omit the image area entirely when a project had no cover,
 * so a grid of mixed projects jumped between tall and short cards and the
 * first image to load shifted everything below it. This always reserves the
 * same aspect ratio.
 *
 * The placeholder is deterministic and is VISIBLY a placeholder — captioned
 * "No screenshot yet" — and it is never fake product imagery. What it shows
 * instead is an abstract motif: a small shape grammar that varies BY
 * CATEGORY (see `src/lib/project-motif.ts`), so every "research" project
 * reads as research and every "agent" project reads as agent, while a hash
 * of the title still drives hue and the motif's internal arrangement so two
 * projects in the same category don't look identical.
 *
 * `image` is either a verified Blob URL or a repository asset key, as produced
 * by `publicCover()` in `src/server/public/projects.ts`.
 */
import { Image } from 'astro:assets';
import { resolveProjectCover } from '@/lib/project-cover';
import { resolveMotif } from '@/lib/project-motif';
import { formatName } from '@/lib/status';

interface Props {
  image?: string | null;
  title: string;
  category?: string;
  /** `4/3` for cards, `16/10` for the detail page. */
  ratio?: '4/3' | '16/10';
  eager?: boolean;
  sizes?: string;
  zoom?: boolean;
}

const {
  image,
  title,
  category,
  ratio = '4/3',
  eager = false,
  sizes = '(max-width: 47.99em) 92vw, 380px',
  zoom = false,
} = Astro.props;

const cover = resolveProjectCover(image ?? undefined);
const motif = resolveMotif(title, category);
const initials = title
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? '')
  .join('');
const widths = ratio === '16/10' ? [640, 1100, 1400] : [400, 720];

// Per-project placement within the motif's shape grammar — derived from the
// same hash, offset so rotation/scale don't correlate with hue.
const spinDeg = Math.round(motif.spin * 360);
const driftPct = Math.round(motif.drift * 100);
---

<span
  class:list={['cover', { 'plate-zoom': zoom }]}
  style={`--cover-ratio:${ratio}; --cover-hue:${motif.hue}; --cover-spin:${spinDeg}deg; --cover-drift:${driftPct}%`}
  data-cover={cover.kind === 'none' ? 'placeholder' : 'image'}
  data-motif={cover.kind === 'none' ? motif.category : undefined}
>
  {
    cover.kind === 'blob' ? (
      <img
        src={cover.blobUrl}
        alt=""
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        width={ratio === '16/10' ? 1600 : 1200}
        height={ratio === '16/10' ? 1000 : 900}
      />
    ) : cover.kind === 'asset' ? (
      <Image
        src={cover.imageMetadata!}
        alt=""
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <span class="cover-placeholder" aria-hidden="true">
        <svg class="cover-motif" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
          {motif.category === 'product' && (
            <g stroke="currentColor" fill="none" stroke-width="2.5">
              <rect x="18" y="26" width="46" height="34" rx="3" transform={`rotate(${-6 + motif.spin * 4} 41 43)`} />
              <rect x="34" y="40" width="46" height="34" rx="3" opacity="0.55" transform={`rotate(${4 - motif.spin * 4} 57 57)`} />
              <line x1="24" y1="34" x2="50" y2="34" stroke-width="2" opacity="0.6" />
            </g>
          )}
          {motif.category === 'agent' && (
            <g stroke="currentColor" fill="none" stroke-width="2.5">
              <circle cx="50" cy="50" r="30" opacity="0.4" />
              <circle cx="50" cy="50" r="19" stroke-dasharray="5 6" transform={`rotate(${spinDeg} 50 50)`} />
              <circle cx="50" cy="50" r="6.5" fill="currentColor" stroke="none" />
              <circle cx={50 + 30 * Math.cos((motif.spin * 2 * Math.PI))} cy={50 + 30 * Math.sin((motif.spin * 2 * Math.PI))} r="4" fill="currentColor" stroke="none" />
            </g>
          )}
          {motif.category === 'developer-tool' && (
            <g stroke="currentColor" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M38 30 L22 50 L38 70" transform={`translate(${-4 + motif.drift * 8} 0)`} />
              <path d="M62 30 L78 50 L62 70" transform={`translate(${4 - motif.drift * 8} 0)`} />
              <line x1="54" y1="26" x2="46" y2="74" opacity="0.55" />
            </g>
          )}
          {motif.category === 'research' && (
            <g stroke="currentColor" fill="currentColor" stroke-width="1.6">
              <line x1="28" y1="64" x2="50" y2="34" opacity="0.5" />
              <line x1="50" y1="34" x2="74" y2="52" opacity="0.5" />
              <line x1="50" y1="34" x2="36" y2="40" opacity="0.5" />
              <circle cx="28" cy="64" r="4.5" />
              <circle cx="50" cy="34" r="5.5" />
              <circle cx="74" cy="52" r="4" />
              <circle cx="36" cy="40" r="3" />
            </g>
          )}
          {motif.category === 'creative' && (
            <g fill="currentColor">
              <circle cx={38 + motif.drift * 10} cy="42" r="15" opacity="0.5" />
              <circle cx={62 - motif.drift * 8} cy="50" r="13" opacity="0.45" transform={`rotate(${spinDeg} 62 50)`} />
              <circle cx="50" cy="66" r="10" opacity="0.6" />
            </g>
          )}
          {motif.category === 'campus' && (
            <g stroke="currentColor" fill="none" stroke-width="2.5" stroke-linejoin="round">
              <line x1="36" y1="24" x2="36" y2="76" />
              <path d="M36 28 L72 38 L36 50 Z" fill="currentColor" opacity="0.5" />
            </g>
          )}
          {motif.category === 'experiment' && (
            <g stroke="currentColor" fill="none" stroke-width="2.5" stroke-linejoin="round">
              <path d="M42 24 H58 V42 L70 68 Q72 74 65 74 H35 Q28 74 30 68 L42 42 Z" />
              <line x1="38" y1="24" x2="62" y2="24" stroke-linecap="round" />
              <circle cx="47" cy="62" r="2.6" fill="currentColor" stroke="none" opacity="0.7" transform={`translate(${motif.drift * 6 - 3} 0)`} />
              <circle cx="56" cy="67" r="2" fill="currentColor" stroke="none" opacity="0.5" />
            </g>
          )}
          {motif.category === 'startup' && (
            <g stroke="currentColor" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <rect x="28" y="56" width="8" height="16" fill="currentColor" stroke="none" opacity="0.55" />
              <rect x="44" y="46" width="8" height="26" fill="currentColor" stroke="none" opacity="0.7" />
              <rect x="60" y="32" width="8" height="40" fill="currentColor" stroke="none" />
              <path d="M28 40 L50 26 L72 40" opacity="0.6" />
            </g>
          )}
        </svg>
        <span class="cover-initials">{initials || '—'}</span>
        {category && <span class="cover-category">{formatName(category)}</span>}
        <span class="cover-note">No screenshot yet</span>
      </span>
    )
  }
</span>

<style>
  .cover {
    position: relative;
    display: block;
    aspect-ratio: var(--cover-ratio);
    overflow: hidden;
    background: var(--paper-sunk);
    border: var(--border-hair) solid var(--rule);
  }

  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.03);
    transition: transform var(--dur-4) var(--ease-out);
  }

  .plate-zoom:hover img {
    transform: scale(1.03);
  }

  .cover-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: var(--s-4);
    color: hsl(var(--cover-hue) 38% 26%);
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 10px,
        hsl(var(--cover-hue) 35% 50% / 0.06) 10px 11px
      ),
      hsl(var(--cover-hue) 42% 88%);
  }

  .cover-motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: hsl(var(--cover-hue) 45% 42%);
    opacity: 0.5;
    transform: translateX(calc(var(--cover-drift) * 0.12 - 6%)) scale(1.15);
  }

  .cover-initials {
    position: relative;
    align-self: center;
    justify-self: center;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    opacity: 0.88;
    text-shadow: 0 1px 0 hsl(var(--cover-hue) 42% 95% / 0.6);
  }

  .cover-category,
  .cover-note {
    position: relative;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cover-category {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
  }

  .cover-note {
    justify-self: end;
    opacity: 0.8;
  }
</style>
