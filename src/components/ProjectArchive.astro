---
import { Image } from 'astro:assets';
import { builderNamesOf, cityName, publicProjects } from '@/data';
import { asset } from '@/lib/images';
import { formatName } from '@/lib/status';

/**
 * MADE WITH CLAUDE — the project archive.
 *
 * The most valuable long-term asset on this site, and therefore the one it is
 * most important not to fake. It is empty because no project in this community
 * is documented anywhere citable yet.
 *
 * The empty state is designed rather than apologised for. It states the fact,
 * says what an entry holds so a submitter knows what is being asked, and gives
 * one clear action. It does not editorialise about its own emptiness.
 */
interface Props {
  limit?: number;
  citySlug?: string;
  builderSlug?: string;
  showHead?: boolean;
  heading?: string;
  eyebrow?: string;
  /** Show the filter bar. Only meaningful on the full archive page. */
  filters?: boolean;
}

const {
  limit,
  citySlug,
  builderSlug,
  showHead = true,
  heading = 'Made with Claude',
  eyebrow = 'Projects',
  filters = false,
} = Astro.props;

let scoped = publicProjects;
if (citySlug) scoped = scoped.filter((p) => p.citySlug === citySlug);
if (builderSlug) scoped = scoped.filter((p) => p.builderSlugs.includes(builderSlug));

const rows = limit ? scoped.slice(0, limit) : scoped;
const isEmpty = rows.length === 0;

const entries = rows.map((project) => ({
  project,
  city: cityName(project.citySlug),
  makers: builderNamesOf(project),
  image: asset(project.image),
}));

// Filter facets are built from what is actually in the archive, so a category
// with nothing in it never appears as an empty promise.
const categories = [...new Set(rows.map((p) => p.category))].sort();
const cities = [...new Set(rows.map((p) => p.citySlug))].sort();

const entryFields = [
  'What you called it',
  'Who built it, and where',
  'What it does, in one sentence',
  'How Claude was actually used',
  'A link — live, repo, or a video',
];
---

<div class="archive">
  {
    showHead && (
      <div class="section-head">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="projects-heading">{heading}</h2>
        <p class="prose">Things people across India are actually making.</p>
      </div>
    )
  }

  {
    isEmpty ? (
      <div class="empty">
        <div class="empty-main">
          <p class="empty-status">No projects published yet.</p>
          <p class="empty-ask">Have something worth showing?</p>
          <a class="btn btn-clay empty-cta" href="/join#build">
            <span>Submit your build</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>

        <div class="empty-aside">
          <h3 class="label empty-aside-head">What an entry holds</h3>
          <ul class="empty-fields">
            {entryFields.map((field, i) => (
              <li>
                <span class="empty-field-num">{String(i + 1).padStart(2, '0')}</span>
                {field}
              </li>
            ))}
          </ul>
          <p class="empty-note">
            Every entry is reviewed before it is published, then becomes a permanent part of the
            record — filterable by city, by category, and by the person who made it.
          </p>
        </div>
      </div>
    ) : (
      <>
        {filters && (categories.length > 1 || cities.length > 1) && (
          <div class="filters" data-filter-root>
            {categories.length > 1 && (
              <div class="filter-group" role="group" aria-label="Filter by category">
                <span class="label filter-label">Category</span>
                <button class="filter is-on" type="button" data-filter="category" data-value="all">
                  All
                </button>
                {categories.map((category) => (
                  <button class="filter" type="button" data-filter="category" data-value={category}>
                    {formatName(category)}
                  </button>
                ))}
              </div>
            )}
            {cities.length > 1 && (
              <div class="filter-group" role="group" aria-label="Filter by city">
                <span class="label filter-label">City</span>
                <button class="filter is-on" type="button" data-filter="city" data-value="all">
                  All
                </button>
                {cities.map((slug) => (
                  <button class="filter" type="button" data-filter="city" data-value={slug}>
                    {cityName(slug)}
                  </button>
                ))}
              </div>
            )}
            <p class="filter-count" data-filter-count aria-live="polite" />
          </div>
        )}

        <ul class="grid">
          {entries.map((entry, i) => (
            <li
              class="card"
              data-reveal
              style={`--reveal-delay:${i * 55}ms`}
              data-filter-item
              data-category={entry.project.category}
              data-city={entry.project.citySlug}
            >
              <a href={`/projects/${entry.project.slug}`}>
                {entry.image && (
                  <span class="plate plate-zoom card-image">
                    <Image
                      src={entry.image}
                      alt=""
                      widths={[400, 720]}
                      sizes="(max-width: 47.99em) 90vw, 360px"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}
                <span class="card-top">
                  <span class="label card-category">{formatName(entry.project.category)}</span>
                  <span class="label card-city">{entry.city}</span>
                </span>
                <span class="card-title">{entry.project.title}</span>
                <span class="card-summary">{entry.project.summary}</span>
                {entry.makers.length > 0 && (
                  <span class="card-makers">{entry.makers.map((m) => m.name).join(' \u00b7 ')}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</div>

{filters && !isEmpty && <script>import '@/scripts/filters';</script>}

<style>
  /* --- Empty state ------------------------------------------------------- */
  .empty {
    display: grid;
    gap: var(--s-8);
    padding-top: var(--s-4);
  }

  .empty-status {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3.4rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }

  .empty-ask {
    margin-top: var(--s-5);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-style: italic;
    font-weight: 400;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    color: var(--clay-deep);
  }

  .empty-cta {
    margin-top: var(--s-5);
  }

  .empty-aside-head {
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .empty-fields {
    display: grid;
    margin-top: var(--s-2);
  }

  .empty-fields li {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .empty-field-num {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    color: var(--ink-3);
  }

  .empty-note {
    margin-top: var(--s-5);
    max-width: 44ch;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.75;
    color: var(--ink-3);
  }

  /* --- Populated archive -------------------------------------------------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: var(--s-7) var(--s-6);
  }

  .card a {
    display: grid;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--ink);
  }

  .card-image {
    aspect-ratio: 4 / 3;
    margin-bottom: var(--s-3);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: var(--border-rule) solid var(--ink);
  }

  .card-category {
    color: var(--clay-deep);
  }

  .card-city {
    color: var(--ink-3);
  }

  .card-title {
    margin-top: var(--s-2);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .card a:hover .card-title {
    color: var(--clay-deep);
  }

  .card-summary {
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .card-makers {
    margin-top: var(--s-1);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  .card[hidden] {
    display: none;
  }

  @media (min-width: 56em) {
    .empty {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--s-10);
      align-items: start;
    }
  }
</style>
