---
import { Image } from 'astro:assets';
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import type { Builder } from '@/data/types';
import { asset } from '@/lib/images';
import { plural } from '@/lib/words';

/**
 * BUILDERS — the open index, as cards (three, two, one columns).
 *
 * Each card: portrait or initials, the name, role and city, and the counts
 * that are above zero. The one hierarchy that matters is verification: an
 * Ambassador carries the only filled chip on the site. The last card is
 * "Add yourself".
 */
interface Props {
  limit?: number;
  citySlug?: string;
  showHead?: boolean;
  heading?: string;
  builders?: Builder[];
  selectors?: RecordSelectors;
}

const {
  limit,
  citySlug,
  showHead = true,
  heading = 'Who’s building',
  builders,
  selectors,
} = Astro.props;

const data = selectors ?? staticData;
const list = builders ?? data.publicBuilders;

const scoped = citySlug ? list.filter((b) => b.citySlug === citySlug) : list;

// Ambassadors lead the index; everyone else follows in the order they joined.
/**
 * `builder.image` is one string with two possible meanings — see the note on
 * `getPublicBuilderList()` in `src/server/directory.ts`. A repository asset
 * key (`events/vol02-1.jpg`) resolves through the `astro:assets` registry and
 * renders via `<Image>`, which is what every other image on this site does.
 * An uploaded avatar is already an absolute Blob URL and cannot go through
 * that pipeline — it was never processed at build time — so it renders
 * through a plain `<img>` instead. The two are distinguished by the one fact
 * that actually tells them apart: whether the value parses as an absolute URL.
 */
function isRemoteUrl(value: string): boolean {
  try {
    return Boolean(new URL(value).protocol.startsWith('http'));
  } catch {
    return false;
  }
}

const entries = scoped
  .map((builder) => {
    const ambassador = data.ambassadorForBuilder(builder);
    const remote = builder.image && isRemoteUrl(builder.image) ? builder.image : undefined;
    return {
      builder,
      ambassador,
      city: data.cityName(builder.citySlug),
      portrait: remote ? undefined : asset(builder.image),
      remotePortrait: remote,
      // Same count as builders/[slug].astro: their own rooms plus those they hosted as an Ambassador.
      eventCount: new Set([
        ...data.eventsOf(builder),
        ...(ambassador ? data.eventsHostedBy(ambassador.slug) : []),
      ]).size,
      projectCount: data.projectsOf(builder).length,
    };
  })
  .sort((a, b) => Number(Boolean(b.ambassador)) - Number(Boolean(a.ambassador)));

const rows = limit ? entries.slice(0, limit) : entries;
const remaining = entries.length - rows.length;
---

<div class:list={['index', { 'is-city': citySlug }]}>
  {
    showHead && (
      <div class="section-head">
        <h2 id="builders-heading">{heading}</h2>
      </div>
    )
  }

  <ul class="roster spotlight">
    {
      rows.map((entry) => (
        <li>
          <a class="card" href={`/builders/${entry.builder.slug}/`}>
            <span class:list={['portrait', { 'is-verified': entry.ambassador }]} aria-hidden="true">
              {entry.portrait ? (
                <Image
                  src={entry.portrait}
                  alt=""
                  widths={[96, 192]}
                  sizes="56px"
                  loading="lazy"
                  decoding="async"
                />
              ) : entry.remotePortrait ? (
                <img src={entry.remotePortrait} alt="" loading="lazy" decoding="async" />
              ) : (
                entry.builder.name
                  .split(' ')
                  .map((part) => part[0])
                  .slice(0, 2)
                  .join('')
                  .toUpperCase()
              )}
            </span>

            <span class="body">
              <span class="name t-title">{entry.builder.name}</span>
              <span class="where">
                {entry.builder.role}
                {!citySlug && <span class="city">{entry.city}</span>}
              </span>
            </span>

            {(entry.ambassador || entry.eventCount > 0 || entry.projectCount > 0) && (
              <span class="foot">
                {entry.ambassador && <span class="chip chip-verified">Ambassador</span>}
                <span class="counts">
                  {entry.eventCount > 0 && <span>{plural(entry.eventCount, 'event')}</span>}
                  {entry.projectCount > 0 && <span>{plural(entry.projectCount, 'project')}</span>}
                </span>
              </span>
            )}
          </a>
        </li>
      ))
    }

    <li>
      <a class="card card-open" href="/me/profile/edit/">
        <span class="portrait" aria-hidden="true">+</span>
        <span class="body">
          <span class="name t-title">Add yourself</span>
        </span>
      </a>
    </li>
  </ul>

  {
    remaining > 0 && (
      <a class="link index-more" href="/builders/">
        See all builders
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  /* --- Cards: three, two, one columns -------------------------------------- */
  .roster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .roster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 1100px) {
    .roster {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .roster > li {
    display: grid;
  }

  .card {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    align-content: start;
    align-items: center;
    gap: 14px 18px;
    padding: 22px 24px 20px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.35s;
  }

  .card:hover {
    border-color: var(--rule-strong);
  }

  .card:focus-visible {
    border-radius: var(--radius-md);
  }

  .portrait {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--paper-raised-2);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    font-family: var(--font-title);
    font-size: var(--t-ui);
    font-weight: 600;
  }

  /* An Ambassador's initials sit on clay, as in the mockup's people list. */
  .portrait.is-verified {
    background: var(--clay);
    border-color: transparent;
    color: var(--btn-ink);
    box-shadow: var(--glow-tile);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .card:hover .name {
    color: var(--clay-deep);
  }

  .where {
    color: var(--ink-3);
    font-size: var(--t-small);
    line-height: 1.45;
  }

  .city::before {
    content: ' · ';
  }

  .foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    color: var(--ink-3);
    font-size: var(--t-small);
  }

  /* --- The last card: add yourself ----------------------------------------- */
  .card-open {
    background: transparent;
    border-style: dashed;
    border-color: var(--rule-strong);
  }

  .card-open .portrait {
    background: var(--clay-tint);
    border-color: transparent;
    color: var(--clay-deep);
    font-size: var(--t-title);
  }

  .card-open .name {
    color: var(--clay-deep);
  }

  .card-open:hover {
    border-color: var(--clay-deep);
  }

  .index-more {
    margin-top: var(--s-6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        border-color 0.35s,
        transform 0.6s var(--ease-cine),
        opacity var(--dur-2) var(--ease-out);
    }

    .card:hover {
      transform: translateY(-3px);
    }
  }
</style>
