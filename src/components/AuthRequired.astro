---
/**
 * Server-safe shell for an account URL whose verified session is absent or
 * whose server-side verification has a specific problem.
 *
 * ── REASON MAP ───────────────────────────────────────────────────────────
 *
 *   unauthenticated       → "Sign in to continue" + Privy CTA
 *                           (PrivyRoot portals the login button into #join-cta-root)
 *
 *   server-not-configured → "Sign-in is temporarily unavailable."
 *                           No Privy CTA — the user cannot fix a missing key.
 *                           #join-cta-root is NOT emitted so PrivyRoot does
 *                           not try to portal into it.
 *
 *   no-member             → "Finishing account setup…"
 *                           User is verified but bootstrap has not committed yet.
 *                           JoinCta will detect the 409 and trigger bootstrap.
 *
 *   member-unavailable    → "This account is not available."
 *                           No action CTA — suspensions are resolved by support.
 *
 *   profile-required      → "Finishing account setup…"
 *                           Same recovery as no-member.
 *
 * ── SECURITY NOTE ────────────────────────────────────────────────────────
 *
 * None of the reasons expose internal detail to the browser. The reason code
 * itself is not emitted into the HTML. `data-next` emits the server's pathname,
 * not anything accepted from the client, so the post-login redirect cannot
 * become an open redirect. A page whose content lives in its query (the claim
 * page) passes `pathname + search`: the query is appended to the server's own
 * path, so the destination still cannot leave it.
 */
import type { PageGuardFailureReason } from '@/server/http/page-guard';

interface Props {
  reason?: PageGuardFailureReason;
  next?: string;
}

const { reason = 'unauthenticated', next = Astro.url.pathname } = Astro.props;

/**
 * Safe user-facing text per reason.
 * Internal codes must not leak; these strings are chosen to inform without
 * exposing configuration state or token details.
 */
const headings: Record<PageGuardFailureReason, string> = {
  unauthenticated: 'Sign in to continue',
  'server-not-configured': 'Sign-in temporarily unavailable',
  'no-member': 'Setting up your account',
  'member-unavailable': 'Account not available',
  'profile-required': 'Setting up your account',
};

const subtext: Record<PageGuardFailureReason, string | null> = {
  unauthenticated: null,
  'server-not-configured': 'Sign-in is temporarily unavailable. Please try again shortly.',
  'no-member': 'Your account is being set up. This should only take a moment.',
  'member-unavailable':
    'This account is not available. Contact support if you think this is an error.',
  'profile-required': 'Your account is being set up. This should only take a moment.',
};

const showCta =
  reason === 'unauthenticated' || reason === 'no-member' || reason === 'profile-required';
---

<div class="auth-required">
  <h1>{headings[reason]}</h1>

  {subtext[reason] && <p class="auth-subtext">{subtext[reason]}</p>}

  {
    showCta && (
      <div id="join-cta-root" data-next={next} aria-live="polite">
        <p class="signin-status js-hydrate-hide">Preparing secure sign-in…</p>
      </div>
    )
  }

  <noscript><p>Please enable JavaScript to sign in to your account.</p></noscript>
</div>

<style>
  .auth-required {
    width: min(100% - 2 * var(--gutter), 32rem);
    /* Bottom stays small: the footer's own top padding adds to it. */
    margin: var(--s-10) auto var(--s-8);
    padding: var(--s-8) var(--s-6);
    background: var(--paper-raised);
    border: var(--border-hair) solid var(--rule);
    text-align: center;
  }

  .auth-required h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 300;
    margin-bottom: var(--s-5);
    color: var(--ink);
  }

  .auth-subtext {
    color: var(--ink-2);
    margin-bottom: var(--s-6);
  }

  /* The buttons PrivyRoot portals into #join-cta-root. They match `.button` in forms.css. */
  .auth-required :global(.signin-button),
  .auth-required :global(.signin-secondary) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    font-family: var(--font-title);
    font-size: var(--t-ui);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    background: var(--paper);
    border: var(--border-hair) solid var(--ink);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-out);
  }

  .auth-required :global(.signin-button) {
    color: var(--paper-raised);
    background: var(--ink);
  }

  .auth-required :global(.signin-button:hover),
  .auth-required :global(.signin-button:focus-visible) {
    background: var(--clay-deep);
    border-color: var(--clay-deep);
  }

  .auth-required :global(.signin-secondary:hover) {
    background: var(--paper-sunk);
  }

  .auth-required :global(.signin-status) {
    font-size: var(--t-small);
    color: var(--ink-2);
    margin-top: var(--s-4);
  }

  .auth-required :global(.signin-actions) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .auth-required :global(.signin-failed) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
  }
</style>
