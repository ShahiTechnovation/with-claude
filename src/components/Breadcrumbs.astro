---
import type { Crumb } from '@/lib/seo';
import { homeHref } from '@/lib/directory-host';

/**
 * The trail back up.
 *
 * Rendered as real links in the document, not just as JSON-LD: a breadcrumb
 * that only exists in structured data is a claim about a page's place in a
 * hierarchy that the page does not actually offer. The last crumb is the
 * current page, so it is plain text and carries `aria-current`.
 *
 * Shown only from three crumbs (Projects / an event / a project): one or two
 * crumbs repeat the nav and the page title. `Base.astro` emits the
 * `BreadcrumbList` JSON-LD under the same rule.
 */
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

{
  crumbs.length > 2 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol class="container crumbs-list">
        {crumbs.map((crumb, i) => {
          const last = i === crumbs.length - 1;
          return (
            <li class="crumb">
              {last ? (
                <span aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.href === '/' ? homeHref(Astro.url.hostname) : crumb.href}>
                  {crumb.name}
                </a>
              )}
              {!last && (
                <span class="crumb-sep" aria-hidden="true">
                  /
                </span>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .crumbs {
    padding-top: var(--s-5);
  }

  .crumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    list-style: none;
    margin-block: 0;
    font-size: var(--t-small);
    line-height: 1.4;
    color: var(--ink-3);
  }

  .crumb {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    /* A long event title should wrap rather than push the row wide. */
    min-width: 0;
  }

  .crumb a {
    /* The padding makes the trail tappable; it is not decoration. */
    padding-block: var(--s-2);
    color: var(--ink-3);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color var(--dur-1) var(--ease-out),
      text-decoration-color var(--dur-1) var(--ease-out);
  }

  .crumb a:hover {
    color: var(--ink);
    text-decoration-color: var(--rule-strong);
  }

  .crumb [aria-current='page'] {
    color: var(--ink);
  }

  .crumb-sep {
    color: var(--ink-3);
  }
</style>
