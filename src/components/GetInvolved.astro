---
import { involvement } from '@/data';

/**
 * Five ways in, set as numbered editorial entries rather than a grid of cards.
 * Tally-backed CTAs open a popup where the embed script is available and fall
 * back to a plain link everywhere else — the href is always real.
 */
const usesTally = involvement.some((item) => item.tallyId);
---

<div class="involve">
  <div class="section-head">
    <p class="section-index">10 — Take part</p>
    <h2 id="involved-heading">Ways in</h2>
    <p class="prose">None of this is gatekept. Pick the one that matches how much time you have.</p>
  </div>

  <ol class="involve-list">
    {
      involvement.map((item, i) => (
        <li class="involve-item" data-reveal style={`--reveal-delay:${i * 50}ms`}>
          <a
            class="involve-link"
            href={item.url}
            target={item.url.startsWith('http') ? '_blank' : undefined}
            rel={item.url.startsWith('http') ? 'noopener' : undefined}
            data-tally-open={item.tallyId}
            data-tally-layout={item.tallyId ? 'modal' : undefined}
            data-tally-auto-close={item.tallyId ? '3000' : undefined}
          >
            <span class="involve-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="involve-body">
              <span class="involve-label">{item.label}</span>
              <span class="involve-title">{item.title}</span>
              <span class="involve-desc">{item.description}</span>
            </span>
            <span class="involve-cta">
              {item.ctaLabel}
              <span class="arrow" aria-hidden="true">
                {item.url.startsWith('http') ? '↗' : '→'}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

{
  usesTally && (
    /* Loaded lazily and only because three real forms depend on it. Without
       it the links still open the forms in a new tab. */
    <script is:inline async src="https://tally.so/widgets/embed.js" />
  )
}

<style>
  .involve-list {
    border-top: var(--border-heavy) solid var(--ink);
  }

  .involve-link {
    display: grid;
    grid-template-columns: 4ch minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-5);
    padding-block: var(--s-6);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur-2) var(--ease-out);
  }

  .involve-link:hover,
  .involve-link:focus-visible {
    background: color-mix(in srgb, var(--clay) 7%, transparent);
  }

  .involve-num {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    color: var(--ink-3);
    padding-top: 0.55em;
  }

  .involve-body {
    display: grid;
    gap: var(--s-2);
  }

  .involve-label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--clay-deep);
  }

  .involve-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1.08;
    letter-spacing: -0.025em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .involve-link:hover .involve-title {
    color: var(--clay-deep);
  }

  .involve-desc {
    max-width: 52ch;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .involve-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    align-self: center;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .involve-cta .arrow {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .involve-link:hover .involve-cta {
    color: var(--ink);
  }

  .involve-link:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 47.99em) {
    .involve-link {
      grid-template-columns: 4ch minmax(0, 1fr);
      gap: var(--s-3) var(--s-4);
    }

    .involve-cta {
      grid-column: 2;
      justify-self: start;
      align-self: start;
      margin-top: var(--s-2);
      color: var(--clay-deep);
    }
  }
</style>
