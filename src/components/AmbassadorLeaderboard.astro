---
import * as staticData from '@/data';
import type { RecordSelectors } from '@/data/selectors';
import { plural } from '@/lib/words';
import type { LeaderboardEntry } from '@/lib/leaderboard';

/**
 * THE RANKED INDEX. §22.
 *
 * An editorial list with a number in the margin — not a metrics dashboard.
 * The distinction is deliberate and it is mostly about what is NOT here: no
 * sparklines, no percentage deltas, no progress bars, no trend arrows. Each of
 * those implies a measurement over time that a count of events cannot support.
 *
 * Every figure printed is one the record can answer exactly: how many events,
 * how many cities, and the score with its formula stated on the page. §23's
 * "do not show fake metrics", applied at the level of what the markup is even
 * capable of saying.
 */
interface Props {
  entries: LeaderboardEntry[];
  heading?: string;
  showHead?: boolean;
  /** Cap the list, for a discovery panel on another page. */
  limit?: number;
  selectors?: RecordSelectors;
}

const { entries, heading = 'Community activity', showHead = true, limit, selectors } = Astro.props;
const data = selectors ?? staticData;

const shown = limit ? entries.slice(0, limit) : entries;
---

<div class="board">
  {
    showHead && (
      <div class="section-head">
        <h2 id="activity-heading">{heading}</h2>
      </div>
    )
  }

  <ol class="entries spotlight">
    {
      shown.map((entry, index) => {
        const { ambassador } = entry;
        const home = data.cityName(ambassador.citySlug);
        return (
          <li>
            <a class="entry" href={`/ambassadors/${ambassador.slug}/`}>
              {/*
                The rank is `aria-hidden` because the list is already an `<ol>`:
                a screen reader announces "item 3" from the markup, and the
                printed "3" would make it "item 3, 3, Name".
              */}
              <span class="rank" aria-hidden="true">
                {index + 1}
              </span>

              <span class="name">{ambassador.name}</span>

              <span class="where">
                {home}
                {entry.cities.length > 1 && ` · active in ${entry.cities.length} cities`}
              </span>

              <span class="events">
                {entry.events.length === 0 ? 'No events yet' : plural(entry.events.length, 'event')}
              </span>

              <span class="score">
                <span class="score-value">{entry.score.toFixed(2)}</span> score
              </span>
            </a>

            {entry.unscoredCredits > 0 && (
              /*
                §19 — an attribution awaiting confirmation is visible and
                uncounted. Saying so in the margin is the honest version of a
                number that is lower than the person's own records would show.
              */
              <p class="pending">
                {`${plural(entry.unscoredCredits, 'attribution')} awaiting confirmation, not counted above`}
              </p>
            )}
          </li>
        );
      })
    }
  </ol>

  {shown.length === 0 && <p class="empty">No ambassadors yet.</p>}
</div>

<style>
  /* 17px rows: rank, name, city, events, score. */
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .entries > li {
    border-bottom: 1px solid var(--rule);
  }

  /* The list ends its section: the next section's hairline closes it, and the section's
     padding is the gap, so the last row draws no rule and keeps no padding of its own. */
  .entries > li:last-child {
    border-bottom: 0;
  }

  .entries > li:last-child > .entry:last-child {
    padding-bottom: 0;
  }

  .entries > li:last-child > .pending {
    margin-bottom: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1.4fr) minmax(0, 1.2fr) minmax(0, 0.8fr) auto;
    align-items: baseline;
    gap: 6px var(--s-5);
    padding-block: 18px;
    color: var(--ink-3);
    font-size: var(--t-body);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .name {
    color: var(--ink);
    font-family: var(--font-title);
    font-weight: 600;
  }

  .entry:hover .name {
    color: var(--clay-deep);
  }

  .score {
    justify-self: end;
  }

  .score-value {
    color: var(--clay-deep);
    font-family: var(--font-title);
    font-weight: 600;
  }

  .pending {
    margin: -6px 0 14px calc(2ch + var(--s-5));
    color: var(--ink-3);
    font-size: var(--t-small);
  }

  .empty {
    color: var(--ink-3);
  }

  @media (max-width: 699px) {
    .entry {
      grid-template-columns: 2ch minmax(0, 1fr) auto;
    }

    .where,
    .events {
      grid-column: 2 / -1;
    }

    .score {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
