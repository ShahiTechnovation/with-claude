---
/**
 * A movement of the page.
 *
 * Deliberately thin: one rhythm (`--section-y`), a hairline on top, and a
 * ground. `night` and `deep` are older names for the sunk ground.
 */
interface Props {
  id: string;
  /** The ground this section sits on. `night` and `deep` render as `sunk`. */
  tone?: 'paper' | 'sunk' | 'raised' | 'night' | 'deep';
  /** Content manages its own container — used for full-bleed photography. */
  bleed?: boolean;
  /** Id of the heading that names this section. */
  labelledby?: string;
  class?: string;
}

const { id, tone = 'paper', bleed = false, labelledby, class: className = '' } = Astro.props;
const ground = tone === 'night' || tone === 'deep' ? 'sunk' : tone;
---

<section id={id} class:list={['section', `is-${ground}`, className]} aria-labelledby={labelledby}>
  {
    bleed ? (
      <slot />
    ) : (
      <div class="container section-body">
        <slot />
      </div>
    )
  }
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--section-y);
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }

  /* One gap where two sections on the same ground meet, not two: each gives up
     half its padding, so the hairline sits in the middle of one --section-y.
     Where the ground changes both keep theirs; there the padding is inside a band.
     A ruled list that ends a section drops its last row's border-bottom: the next
     section's (or the footer's) hairline closes it, or the two rules sit 20-26px apart. */
  .is-paper:has(+ .is-paper),
  .is-sunk:has(+ .is-sunk),
  .is-raised:has(+ .is-raised) {
    padding-bottom: calc(var(--section-y) / 2);
  }

  .is-paper + .is-paper,
  .is-sunk + .is-sunk,
  .is-raised + .is-raised,
  :global(.page-intro) + .is-paper {
    padding-top: calc(var(--section-y) / 2);
  }

  /* A last section on paper meets the paper footer: it gives up half its padding and
     the footer's top padding finishes the gap. A sunk or raised one keeps its band, and
     a section with a sun in it keeps its room: the sun is sized to that padding. */
  .is-paper:not(:has(~ :not(script, style)), :has(> .sunrise)) {
    padding-bottom: calc(var(--section-y) / 2);
  }

  .is-sunk {
    background: var(--paper-sunk);
  }

  .is-raised {
    background: var(--paper-raised);
  }

  .section-body {
    position: relative;
  }
</style>
