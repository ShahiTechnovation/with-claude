---
/**
 * A movement of the page.
 *
 * Deliberately thin. The previous version stamped every section with a serial
 * number and a tick on the meridian, which made eleven different ideas read as
 * eleven entries in one scientific report. Sections now differ by ground,
 * width and air — and each one writes its own eyebrow.
 */
interface Props {
  id: string;
  /** The ground this section sits on. */
  tone?: 'paper' | 'sunk' | 'raised' | 'night' | 'deep';
  /** Vertical air. `lg` is for the moments that should slow a reader down. */
  size?: 'sm' | 'md' | 'lg';
  /** Content manages its own container — used for full-bleed photography. */
  bleed?: boolean;
  width?: 'standard' | 'wide';
  /** Id of the heading that names this section. */
  labelledby?: string;
  class?: string;
}

const {
  id,
  tone = 'paper',
  size = 'md',
  bleed = false,
  width = 'wide',
  labelledby,
  class: className = '',
} = Astro.props;

const isDark = tone === 'night' || tone === 'deep';
---

<section
  id={id}
  class:list={[
    'section',
    `is-${tone}`,
    `is-${size}`,
    { 'on-night': isDark, 'on-deep': tone === 'deep' },
    className,
  ]}
  aria-labelledby={labelledby}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class:list={[width === 'wide' ? 'container-wide' : 'container', 'section-body']}>
        <slot />
      </div>
    )
  }
</section>

<style>
  .section {
    position: relative;
    background: var(--paper);
    color: var(--ink);
  }

  .is-sunk {
    background: var(--paper-sunk);
  }

  .is-raised {
    background: var(--paper-raised);
  }

  .is-sm {
    padding-block: var(--section-y-sm);
  }

  .is-md {
    padding-block: var(--section-y);
  }

  .is-lg {
    padding-block: var(--section-y-lg);
  }

  .section-body {
    position: relative;
  }
</style>
