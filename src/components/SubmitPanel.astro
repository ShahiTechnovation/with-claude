---
/**
 * Compatibility panel for the former anonymous submission forms.
 *
 * Identity and project publishing now live in the authenticated account area;
 * these public SEO pages keep a useful, honest next step but no longer present
 * duplicate forms that cannot create an owned profile or project.
 */
interface Props { formId: string; showHead?: boolean; }
const { formId, showHead = true } = Astro.props;
const panels = {
  contribute: { eyebrow: 'Contribute', title: 'Add yourself to the builder index', text: 'Create your Builder Passport to add your profile and publish it when it is ready.', href: '/me/profile/edit/', action: 'Create your profile' },
  build: { eyebrow: 'Build', title: 'Publish a project', text: 'Projects are tied to your Builder Passport, so you stay in control of the work you share.', href: '/submit/', action: 'Add a project' },
  practice: { eyebrow: 'Practice', title: 'Share a practice', text: 'Practice publishing is being prepared. Your Builder Passport will be ready when it opens.', href: '/me/profile/edit/', action: 'Edit your profile' },
  city: { eyebrow: 'Your city', title: 'Update your city', text: 'Your city is part of your Builder Passport and can be updated any time.', href: '/city/', action: 'Update your city' },
} as const;
const panel = panels[formId as keyof typeof panels];
if (!panel) throw new Error(`Unknown contribution panel: ${formId}`);
---

<section class="submit" id={formId} aria-labelledby={`${formId}-heading`}>
  {showHead && <><p class="eyebrow">{panel.eyebrow}</p><h2 id={`${formId}-heading`}>{panel.title}</h2></>}
  <p>{panel.text}</p>
  <p><a href={panel.href}>{panel.action}</a></p>
</section>

<style>
  .submit { max-width: 56ch; padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .submit h2 { margin-top: var(--s-3); }
  .submit p:last-child { margin-top: var(--s-5); }
</style>
