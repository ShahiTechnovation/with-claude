---
import { citySignals, getCity } from '@/data';
import { inWordsCap } from '@/lib/words';
import { dateParts } from '@/lib/datetime';
import { distanceKm, formatCoords } from '@/lib/geo';

/**
 * FIND YOUR CITY.
 *
 * The map introduces the geography; this is the browsable index of it —
 * a gazetteer. Active chapters lead; open cities follow, and they are framed
 * as available rather than as absent.
 */
interface Props {
  index?: string;
  heading?: string;
  showHead?: boolean;
  /** Compact renders the open cities as a name grid instead of a full ledger. */
  compact?: boolean;
}

const {
  index = '09 — Cities',
  heading = 'Find your city',
  showHead = true,
  compact = false,
} = Astro.props;

const signals = citySignals();
const active = signals.filter((s) => s.city.status !== 'open');

// The first chapter is the origin every distance is measured from.
const origin = getCity('bhopal');

const open = signals
  .filter((s) => s.city.status === 'open')
  .map((s) => ({
    ...s,
    km: origin ? distanceKm(origin, s.city) : undefined,
  }))
  .sort((a, b) => (a.km ?? 0) - (b.km ?? 0));
---

<div class="gaz">
  {
    showHead && (
      <div class="section-head">
        <p class="section-index">{index}</p>
        <h2 id="cities-index-heading">{heading}</h2>
        <p class="prose">
          {`${inWordsCap(active.length)} chapter${active.length === 1 ? ' is' : 's are'} running. ${inWordsCap(open.length)} cities are plotted and open`}{' '}
          — if you want the first Claude event in yours, that is a conversation, not an application.
        </p>
      </div>
    )
  }

  <div class="gaz-group">
    <h3 class="label gaz-group-head">Running now</h3>
    <ul class="gaz-active">
      {
        active.map((signal) => {
          const next = signal.next ? dateParts(signal.next.date) : undefined;
          return (
            <li data-reveal>
              <a class="gaz-card" href={`/cities/${signal.city.slug}`}>
                <div class="gaz-card-top">
                  <span class="pip pip-next">Active chapter</span>
                  <span class="coords">{formatCoords(signal.city.lat, signal.city.lon)}</span>
                </div>
                <h4 class="gaz-name">{signal.city.name}</h4>
                <p class="gaz-state">{signal.city.state}</p>
                <p class="gaz-blurb">{signal.city.blurb}</p>
                <dl class="gaz-stats">
                  <div>
                    <dt>Events</dt>
                    <dd>{String(signal.eventCount).padStart(2, '0')}</dd>
                  </div>
                  {signal.city.reported?.members && (
                    <div>
                      <dt>Community</dt>
                      <dd>{signal.city.reported.members}+</dd>
                    </div>
                  )}
                  {signal.city.organiser && (
                    <div class="gaz-stat-wide">
                      <dt>Organised by</dt>
                      <dd>{signal.city.organiser.name}</dd>
                    </div>
                  )}
                </dl>
                {next && signal.next && (
                  <p class="gaz-next">
                    {`Next: ${next.dayPadded} ${next.monthDisplay} — ${signal.next.title}`}
                  </p>
                )}
              </a>
            </li>
          );
        })
      }

      <li class="gaz-invite" data-reveal>
        <div class="gaz-card gaz-card-invite">
          <span class="label label-accent">Open</span>
          <h4 class="gaz-name gaz-name-invite">Your city</h4>
          <p class="gaz-blurb">
            Bhopal started with one room and one workshop. Starting the second chapter needs a
            person who wants it, not a licence.
          </p>
          <a
            class="btn btn-solid gaz-invite-cta"
            href="https://t.me/tog_guild"
            target="_blank"
            rel="noopener"
          >
            <span>Start a chapter</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </li>
    </ul>
  </div>

  <div class="gaz-group">
    <h3 class="label gaz-group-head">
      Plotted and open <span class="gaz-count">{String(open.length).padStart(2, '0')}</span>
    </h3>
    {
      compact ? (
        <>
          <ul class="gaz-compact">
            {open.map((signal) => (
              <li>
                <a href={`/cities/${signal.city.slug}`}>
                  <span class="gaz-open-name">{signal.city.name}</span>
                  <span class="gaz-open-state">{signal.city.state}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="link-arrow gaz-more" href="/cities">
            <span>The full gazetteer</span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </>
      ) : (
        <ul class="gaz-open">
          <li class="gaz-open-row gaz-open-head" aria-hidden="true">
            <span>City</span>
            <span>State</span>
            <span>Coordinates</span>
            <span>From Bhopal</span>
          </li>
          {open.map((signal) => (
            <li>
              <a class="gaz-open-row" href={`/cities/${signal.city.slug}`}>
                <span class="gaz-open-name">{signal.city.name}</span>
                <span class="gaz-open-state">{signal.city.state}</span>
                <span class="coords gaz-open-coords">
                  {formatCoords(signal.city.lat, signal.city.lon, 1)}
                </span>
                <span class="gaz-open-distance">
                  <span class="gaz-open-km">{signal.km ? `${signal.km} km` : '—'}</span>
                  <span class="gaz-open-go">Start one →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  .gaz-group + .gaz-group {
    margin-top: var(--s-9);
  }

  .gaz-group-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-5);
    border-bottom: var(--border-hair) solid var(--rule-strong);
    color: var(--ink-3);
  }

  .gaz-count {
    color: var(--clay-deep);
  }

  /* --- Active chapter cards --------------------------------------------- */
  .gaz-active {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--s-5);
  }

  .gaz-card {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-5);
    border: var(--border-hair) solid var(--rule-strong);
    background: var(--paper-raised);
    text-decoration: none;
    color: var(--ink);
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  a.gaz-card:hover,
  a.gaz-card:focus-visible {
    border-color: var(--clay);
    transform: translateY(-2px);
  }

  .gaz-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-3);
  }

  .gaz-name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .gaz-state {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .gaz-blurb {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .gaz-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--border-hair) solid var(--rule);
  }

  .gaz-stats dt {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .gaz-stats dd {
    margin-top: var(--s-1);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1;
    font-variant-numeric: lining-nums;
  }

  .gaz-stat-wide dd {
    font-size: var(--t-small);
    font-family: var(--font-body);
    font-weight: 400;
    line-height: 1.3;
  }

  .gaz-next {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: var(--border-hair) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--clay-deep);
  }

  /* --- Invitation card --------------------------------------------------- */
  .gaz-card-invite {
    border-style: dashed;
    background: transparent;
    justify-items: start;
  }

  .gaz-name-invite {
    font-style: italic;
    font-weight: 400;
    color: var(--clay-deep);
    margin-top: var(--s-3);
  }

  .gaz-invite-cta {
    margin-top: var(--s-5);
  }

  /* --- Open cities index ------------------------------------------------- */
  .gaz-open {
    border-top: var(--border-hair) solid var(--rule);
  }

  .gaz-open-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink-2);
    transition:
      background var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .gaz-open-row:hover,
  .gaz-open-row:focus-visible {
    background: color-mix(in srgb, var(--clay) 7%, transparent);
    color: var(--ink);
  }

  .gaz-open-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    color: var(--ink);
  }

  .gaz-open-state,
  .gaz-open-status {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .gaz-open-head {
    padding-block: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-3);
    border-bottom: var(--border-hair) solid var(--rule);
  }

  /* The distance is a real, varying datum; hovering swaps it for the invitation. */
  .gaz-open-distance {
    position: relative;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .gaz-open-go {
    position: absolute;
    inset: 0 0 auto auto;
    color: var(--clay-deep);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .gaz-open-km {
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .gaz-open-row:hover .gaz-open-km,
  .gaz-open-row:focus-visible .gaz-open-km {
    opacity: 0;
  }

  .gaz-open-row:hover .gaz-open-go,
  .gaz-open-row:focus-visible .gaz-open-go {
    opacity: 1;
  }

  /* --- Compact list (homepage) ------------------------------------------ */
  .gaz-compact {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr));
    gap: 0 var(--s-5);
    border-top: var(--border-hair) solid var(--rule);
  }

  .gaz-compact a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: color var(--dur-1) var(--ease-out);
  }

  .gaz-compact a:hover .gaz-open-name,
  .gaz-compact a:focus-visible .gaz-open-name {
    color: var(--clay-deep);
  }

  .gaz-more {
    margin-top: var(--s-6);
  }

  @media (max-width: 47.99em) {
    .gaz-open-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--s-1) var(--s-4);
    }

    .gaz-open-state {
      grid-column: 1;
      grid-row: 2;
    }

    .gaz-open-coords {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }

    .gaz-open-distance {
      grid-column: 2;
      grid-row: 1;
    }

    .gaz-open-head {
      display: none;
    }
  }
</style>
