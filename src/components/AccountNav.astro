---
/**
 * The masthead's account slot.
 *
 * Rendered ANONYMOUS by the server — every page stays CDN-cacheable. The
 * PrivyRoot island upgrades it in the browser for signed-in visitors.
 *
 * With JS off: the fallback is the static "Join WITH CLAUDE" link rendered
 * server-side by AccountMenu (it returns a stable placeholder during Privy
 * hydration to prevent layout shift).
 */

import { isDirectoryHost, signInHref } from '@/lib/directory-host';

// On projects.withclaude.in the account lives on www: no Privy mount here (its
// bootstrap call would be redirected cross-origin and fail), and Sign in is a
// plain link to the account page on the main site.
const onDirectoryHost = isDirectoryHost(Astro.url.hostname);
const appId = onDirectoryHost ? undefined : (import.meta.env.PUBLIC_PRIVY_APP_ID as string | undefined);
const loginMethods = (import.meta.env.PUBLIC_PRIVY_LOGIN_METHODS as string | undefined)
  ?.split(',')
  .map((m) => m.trim())
  .filter(Boolean);
---

<!--
  Static baseline for no-JS and the moment before hydration. `PrivyRoot` — the
  ONE PrivyProvider on the site, see that file — portals into this node by id
  once it mounts, upgrading it for signed-in visitors. `js-hydrate-hide` marks
  content PrivyRoot removes on mount, since a portal target is a node React
  never rendered and so never clears on its own — without the marker, the
  static fallback and the live button would both stay in the DOM at once.
-->
<div id="account-slot-root" class="account-slot" data-account-state="anonymous">
  <a class="account-join js-hydrate-hide" href={signInHref(Astro.url.hostname)} data-account-signin>Sign in</a>
</div>

{/*
  Where `PrivyRoot` mounts. Not an Astro island: `src/scripts/account-boot.ts`
  loads it on demand (account pages, an existing session, or a click on
  Sign in), so readers who never sign in never download the Privy SDK.
*/}
{
  appId && (
    <div id="privy-root" data-app-id={appId} data-login-methods={(loginMethods ?? []).join(',')}></div>
  )
}
<script>
  import '@/scripts/account-boot';
</script>

<style is:global>
  /* The mount point must not be a flex item of the masthead: an empty block
     still takes a gap, which pushed the account control off the column edge.
     The island it replaced was `display: contents` for the same reason. */
  #privy-root {
    display: contents;
  }

  /*
   * `#account-slot-root` keeps `data-account-state="anonymous"` for good; PrivyRoot
   * portals a second `.account-slot` carrying the live state inside it.
   */
  .account-slot {
    position: relative;
    display: flex;
    align-items: center;
  }

  /*
   * Sign in, the hydration placeholder and the signed-in trigger share one box
   * (the ghost `.btn.btn-sm`), so nothing shifts while Privy hydrates.
   */
  .account-join,
  .account-link,
  .account-placeholder {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 18px;
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  .account-join:hover,
  .account-link:hover,
  .account-link[aria-expanded='true'] {
    border-color: var(--ink);
  }

  /* The signed-in trigger: badge, then name. */
  .account-link {
    padding-left: 4px;
  }

  /* Placeholder during Privy hydration: same box as Sign in, not interactive. */
  .account-placeholder {
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .account-nudge {
    margin-right: 6px;
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    white-space: nowrap;
    color: var(--clay-deep);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .account-nudge:hover,
  .account-nudge:focus-visible {
    text-decoration-color: currentColor;
  }

  .account-badge {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
  }

  .account-name {
    max-width: 14ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Dropdown */
  .account-menu-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    min-width: 12rem;
    padding: 6px;
    background: var(--paper-raised);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
  }

  .account-menu-dropdown a,
  .account-menu-dropdown button {
    display: block;
    width: 100%;
    padding: 10px 14px;
    text-align: left;
    font-family: var(--font-body);
    font-size: var(--t-ui);
    color: var(--ink);
    text-decoration: none;
    background: transparent;
    border: none;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .account-menu-dropdown a:hover,
  .account-menu-dropdown a:focus-visible,
  .account-menu-dropdown button:hover,
  .account-menu-dropdown button:focus-visible {
    background: var(--paper-raised-2);
  }

  .account-menu-dropdown :focus-visible {
    outline-offset: -2px;
  }

  /*
   * Under 900px the bar holds the account only once someone is signed in, and then as
   * the 40px badge alone. Signed out (and when Privy could not start) the menu sheet
   * carries Sign in instead.
   */
  @media (max-width: 899.98px) {
    #account-slot-root:not(
      :has(
        .account-slot:not(
          [data-account-state='anonymous'],
          [data-account-state='loading'],
          [data-account-state='unavailable']
        )
      )
    ) {
      display: none;
    }
  }

  /*
   * Under 1200px a signed-in member gets the 40px badge alone, so the bar never
   * outgrows the screen beside the nav links.
   */
  @media (max-width: 1199.98px) {
    .account-link {
      padding: 0;
      border: 0;
    }

    .account-link .account-badge {
      width: 40px;
      height: 40px;
    }

    .account-name {
      display: none;
    }

    /* A clay dot on the badge while the profile is unfinished. */
    .account-slot:has(.account-nudge) .account-badge::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--clay);
      box-shadow: 0 0 0 2px var(--paper);
    }

    /* Out of the bar, still focusable; shows as a pill under the bar while focused. */
    .account-nudge:not(:focus) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .account-nudge:focus {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      margin: 0;
      padding: 10px 16px;
      background: var(--paper-raised);
      border: 1px solid var(--rule-strong);
      border-radius: var(--radius-pill);
      text-decoration: none;
    }
  }
</style>
