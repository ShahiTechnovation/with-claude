---
/**
 * The masthead's account slot.
 *
 * Rendered ANONYMOUS by the server — every page stays CDN-cacheable. The
 * AccountMenu React island upgrades it in the browser for signed-in visitors.
 *
 * With JS off: the fallback is the static "Join WITH CLAUDE" link rendered
 * server-side by AccountMenu (it returns a stable placeholder during Privy
 * hydration to prevent layout shift).
 */
import AccountMenu from '@/components/react/AccountMenu';

const appId = import.meta.env.PUBLIC_PRIVY_APP_ID as string | undefined;
const loginMethods = (import.meta.env.PUBLIC_PRIVY_LOGIN_METHODS as string | undefined)
  ?.split(',')
  .map((m) => m.trim())
  .filter(Boolean);
---

{
  appId ? (
    <AccountMenu appId={appId} loginMethods={loginMethods} client:only="react" />
  ) : (
    <div class="account-slot" data-account-state="anonymous">
      <a class="account-join" href="/join/">Join WITH CLAUDE</a>
    </div>
  )
}

<style is:global>
  .account-slot {
    display: flex;
    align-items: center;
    min-height: 2rem;
  }

  /*
   * The join link and the authenticated account trigger share base styles so
   * swapping between them during Privy hydration produces no layout shift.
   */
  .account-join,
  .account-link,
  .account-placeholder {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--paper);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: 2px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    transition:
      background var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .account-join:hover,
  .account-join:focus-visible {
    background: var(--clay-deep, #92400e);
    border-color: var(--clay-deep, #92400e);
    outline: none;
  }

  .account-join:focus-visible,
  .account-link:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }

  /* Authenticated trigger: inverted colours */
  .account-link {
    color: var(--ink);
    background: transparent;
    border-color: var(--rule-strong);
  }

  .account-link:hover,
  .account-link:focus-visible,
  .account-link[aria-expanded='true'] {
    border-color: var(--ink);
    background: var(--paper-2, rgba(0, 0, 0, 0.04));
    color: var(--ink);
  }

  /* Placeholder during Privy hydration — visually identical to join but non-interactive */
  .account-placeholder {
    opacity: 0;
    pointer-events: none;
    user-select: none;
    /* Takes up the right space so nothing jumps when Privy hydrates */
  }

  .account-nudge {
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .account-nudge a {
    color: var(--clay-deep, #92400e);
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color var(--dur-1) var(--ease-out);
  }

  .account-nudge a:hover,
  .account-nudge a:focus-visible {
    text-decoration-color: currentColor;
  }

  .account-nudge button {
    background: none;
    border: none;
    color: var(--ink-3);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
    padding: 0.1rem;
  }

  .account-nudge button:hover,
  .account-nudge button:focus-visible {
    color: var(--ink);
  }

  /* Hide the nudge label on very narrow mastheads; keep the account control usable */
  @media (max-width: 26rem) {
    .account-nudge {
      display: none;
    }
  }

  .account-badge {
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0;
    flex-shrink: 0;
  }

  .account-name {
    max-width: 14ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Dropdown */
  .account-menu-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 11rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 2px;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.08),
      0 1px 3px rgba(0, 0, 0, 0.06);
    display: flex;
    flex-direction: column;
    padding: 0.4rem 0;
    z-index: 200;
  }

  .account-menu-dropdown a,
  .account-menu-dropdown button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.45rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-out);
  }

  .account-menu-dropdown a:hover,
  .account-menu-dropdown a:focus-visible,
  .account-menu-dropdown button:hover,
  .account-menu-dropdown button:focus-visible {
    background: var(--paper-2, #f5f5f5);
    outline: none;
  }

  .account-menu-dropdown a:focus-visible,
  .account-menu-dropdown button:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: -2px;
  }

  /* On narrow mastheads, hide the label; keep the badge */
  @media (max-width: 40rem) {
    .account-name {
      display: none;
    }
  }
</style>
