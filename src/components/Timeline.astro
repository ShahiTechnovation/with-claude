---
import { cityName, timeline } from '@/data';
import type { SignalKind } from '@/data';
import { formatDateLong, formatDayShort } from '@/lib/datetime';

/**
 * THE RECORD — community memory, by month.
 *
 * Reads forward in time, because that is what a record is: it starts where
 * the community started and ends at what is next. Everything on it is
 * generated from a dated record, so a quiet month is genuinely a quiet month
 * and nobody had to write a single line of this.
 *
 * The one visual distinction that matters is between what has happened and
 * what has not. Held entries get a filled mark; scheduled ones get an open
 * ring — the same form-before-colour rule the atlas runs on, so the two read
 * apart in monochrome.
 */
interface Props {
  /** Trim to the most recent months. Omit for the whole record. */
  limit?: number;
  citySlug?: string;
}

const { limit, citySlug } = Astro.props;

let months = timeline();
if (citySlug) {
  months = months
    .map((month) => ({ ...month, entries: month.entries.filter((e) => e.citySlug === citySlug) }))
    .filter((month) => month.entries.length > 0);
}
if (limit) months = months.slice(-limit);

/** What each kind of entry is called on the rail. */
const KIND_LABEL: Record<SignalKind, string> = {
  'event-scheduled': 'Event',
  'event-held': 'Event',
  'ambassador-verified': 'Ambassador',
  'builder-published': 'Builder',
  'project-published': 'Project',
  'story-published': 'Story',
  'use-case-published': 'Use case',
  'guide-published': 'Guide',
};
---

{
  months.length === 0 ? (
    <p class="meta">Nothing yet.</p>
  ) : (
    <ol class="record-months">
      {months.map((month) => (
        <li class="month" id={`m-${month.key}`}>
          <h2 class="t-h3 month-name" id={`m-${month.key}-heading`}>
            {/* "March 2026": the long date of an entry in the month, without the day. */}
            {formatDateLong(month.entries[0]!.date).replace(/^\d+ /, '')}
          </h2>

          <ul class="month-entries">
            {month.entries.map((entry) => (
              <li class:list={['entry', { 'is-ahead': entry.ahead }]}>
                <span class="entry-mark" aria-hidden="true" />
                <time class="meta entry-date" datetime={entry.date}>
                  {formatDayShort(entry.date)}
                </time>
                <p class="entry-subject">
                  <span class="t-title">
                    {entry.href ? <a href={entry.href}>{entry.subject}</a> : entry.subject}
                  </span>{' '}
                  <span class="meta entry-action">{entry.action}</span>
                </p>
                <p class="meta entry-kind">
                  {KIND_LABEL[entry.kind]}
                  {entry.citySlug && ` · ${cityName(entry.citySlug)}`}
                </p>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  )
}

<style>
  .record-months {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .month + .month {
    margin-top: clamp(40px, 4vw, 56px);
  }

  .month-name {
    padding-bottom: 12px;
    border-bottom: var(--border-hair) solid var(--rule);
  }

  .month-entries {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Phones: mark, date and kind on one line, the title under them. */
  .entry {
    display: grid;
    grid-template-columns: 9px auto minmax(0, 1fr);
    grid-template-areas:
      'mark date kind'
      '. subject subject';
    gap: 2px 14px;
    align-items: baseline;
    padding-block: 14px;
  }

  .entry + .entry {
    border-top: var(--border-hair) solid var(--rule);
  }

  .entry-mark {
    grid-area: mark;
  }

  .entry-date {
    grid-area: date;
  }

  .entry-subject {
    grid-area: subject;
  }

  .entry-kind {
    grid-area: kind;
  }

  /* Held is a filled mark, scheduled is an open ring. Form, not colour, so
     the distinction survives greyscale and colour blindness. */
  .entry-mark {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
    align-self: center;
  }

  .entry.is-ahead .entry-mark {
    background: none;
    border: var(--border-rule) solid var(--clay-deep);
  }

  .entry.is-ahead .entry-kind {
    color: var(--clay-deep);
  }

  .entry-subject a {
    color: inherit;
    text-decoration: none;
    border-bottom: var(--border-hair) solid var(--rule-strong);
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .entry-subject a:hover,
  .entry-subject a:focus-visible {
    border-bottom-color: var(--clay-deep);
  }

  /* From 700px each entry is one row: mark, date, title and what happened, kind. */
  @media (min-width: 700px) {
    .entry {
      grid-template-columns: 9px 6.5rem minmax(0, 1fr) auto;
      grid-template-areas: 'mark date subject kind';
      column-gap: 16px;
    }

    .entry-kind {
      text-align: right;
    }
  }

  @media (min-width: 1100px) {
    .month {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 32px;
      align-items: start;
    }

    .month-name {
      position: sticky;
      top: calc(var(--nav-h) + 1rem);
      padding-top: 12px;
      border-bottom: 0;
    }

    .month-entries {
      border-top: var(--border-hair) solid var(--rule);
    }
  }
</style>
