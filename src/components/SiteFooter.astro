---
import Wordmark from './Wordmark.astro';
import { official, site, socials } from '@/data';
import { homeHref } from '@/lib/directory-host';

const year = new Date().getFullYear();

/**
 * The closing moment.
 *
 * Four columns, and the Anthropic one is the point: the paths that belong to
 * Anthropic are grouped, labelled as theirs, and kept apart from the ones this
 * community runs. A visitor should never have to guess which is which.
 */
const columns = [
  {
    heading: 'Explore',
    links: [
      { label: 'Events', href: '/events/' },
      { label: 'Cities', href: '/cities/' },
      { label: 'Builders', href: '/builders/' },
      { label: 'Projects', href: '/projects/' },
      { label: 'Gallery', href: '/gallery/' },
      { label: 'Ambassadors', href: '/ambassadors/' },
      { label: 'About', href: '/about/' },
    ],
  },
  {
    heading: 'Take part',
    links: [
      { label: 'Add yourself', href: '/me/profile/edit/' },
      { label: 'Submit a build', href: '/me/projects/new/' },
      // Every way in (speaking, mentoring, volunteering, partnering) is listed there.
      { label: 'Speak or volunteer', href: '/community/#involved' },
    ],
  },
  {
    heading: 'Anthropic',
    links: [
      { label: 'Become an Ambassador', href: official.ambassadorProgramUrl },
      { label: 'Anthropic', href: official.anthropic },
      { label: 'Claude', href: official.claude },
    ],
  },
  {
    heading: 'Elsewhere',
    links: socials.map((link) => ({ label: link.label, href: link.url })),
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a
          href={homeHref(Astro.url.hostname)}
          class="footer-home"
          aria-label={`${site.wordmark} — home`}
        >
          <Wordmark mark size="md" />
        </a>
        <p class="lead">{site.manifesto}</p>
      </div>

      <div class="footer-columns">
        {
          columns.map((col) => (
            <nav class="footer-col" aria-label={col.heading}>
              <h2 class="footer-heading">{col.heading}</h2>
              <ul>
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      rel={link.href.startsWith('http') ? 'noopener' : undefined}
                      target={link.href.startsWith('http') ? '_blank' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="footer-legal">
      <p>{site.affiliation}</p>
      <p>© {year} {site.wordmark}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--s-6) var(--s-8);
    border-top: 1px solid var(--rule);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2.6fr);
    gap: var(--s-9);
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--rule);
  }

  .footer-brand {
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .footer-home {
    justify-self: start;
    text-decoration: none;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .footer-heading {
    margin-bottom: 16px;
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .footer-col li + li {
    margin-top: 10px;
  }

  .footer-col a {
    font-size: var(--t-ui);
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--ink);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: var(--s-5);
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--ink-3);
  }

  .footer-legal p:first-child {
    max-width: 68ch;
  }

  @media (max-width: 899.98px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }

    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s-7) var(--s-6);
    }
  }
</style>
