---
import Mark from './Mark.astro';
import { official, site, socials } from '@/data';

const year = new Date().getFullYear();

/**
 * The closing moment.
 *
 * Three columns, and the third one is the point: the paths that belong to
 * Anthropic are grouped, labelled as theirs, and kept apart from the ones this
 * community runs. A visitor should never have to guess which is which.
 */
const columns = [
  {
    heading: 'Discover',
    links: [
      { label: 'Events', href: '/events' },
      { label: 'Cities', href: '/cities' },
      { label: 'Builders', href: '/builders' },
      { label: 'Projects', href: '/projects' },
      { label: 'Stories', href: '/stories' },
      { label: 'How this works', href: '/community' },
    ],
  },
  {
    heading: 'Contribute',
    links: [
      { label: 'Add yourself', href: '/join#contribute' },
      { label: 'Submit a build', href: '/join#build' },
      { label: 'Register your city', href: '/join#city' },
      { label: 'Speak or mentor', href: 'https://tally.so/r/Y5lNo6' },
      { label: 'Volunteer', href: 'https://tally.so/r/D46gXj' },
      { label: 'Partner', href: 'https://tally.so/r/dWeBZy' },
    ],
  },
  {
    heading: 'Anthropic',
    note: 'Run by Anthropic, not by us.',
    links: [
      { label: 'Become an Ambassador', href: official.ambassadorProgramUrl },
      { label: 'Anthropic', href: official.anthropic },
      { label: 'Claude', href: official.claude },
    ],
  },
];
---

<footer class="site-footer on-night">
  <!-- Where the meridian ends: a station mark, then the record closes. -->
  <div class="rail-anchor terminus-anchor" aria-hidden="true">
    <div class="terminus">
      <span class="terminus-line"></span>
      <Mark size={24} />
    </div>
  </div>

  <div class="container-wide footer-inner">
    <div class="footer-brand">
      <p class="footer-wordmark">
        <span class="footer-with">With</span>
        <span class="footer-claude">Claude</span>
      </p>
      <p class="footer-line">{site.manifesto}</p>
      <p class="footer-descriptor">{site.descriptor}</p>
    </div>

    <div class="footer-columns">
      {
        columns.map((col) => (
          <nav class="footer-col" aria-label={col.heading}>
            <h2 class="label footer-heading">{col.heading}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel={link.href.startsWith('http') ? 'noopener' : undefined}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
            {col.note && <p class="footer-col-note">{col.note}</p>}
          </nav>
        ))
      }
    </div>
  </div>

  <div class="container-wide footer-social">
    <h2 class="label footer-heading">Elsewhere</h2>
    <ul class="socials">
      {
        socials.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container-wide footer-base">
    <p class="footer-affiliation">{site.affiliation}</p>
    <div class="footer-meta">
      <span>© {year} {site.wordmark}</span>
      <span aria-hidden="true">·</span>
      <span>{site.domain}</span>
      <span aria-hidden="true">·</span>
      <span>Community-run, non-commercial</span>
      <span aria-hidden="true">·</span>
      <span>Set in Fraunces, Inter &amp; IBM Plex Mono</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-top: var(--s-12);
    padding-bottom: var(--s-7);
    overflow: hidden;
  }

  /* --- Terminus: the meridian's full stop -------------------------------- */
  .terminus-anchor {
    top: 0;
  }

  .terminus {
    position: absolute;
    top: 0;
    left: calc(var(--gutter) - 20px);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--clay);
    transform: translateX(-50%);
  }

  .terminus-line {
    width: 1px;
    height: var(--s-9);
    background: linear-gradient(
      to bottom,
      var(--clay),
      color-mix(in srgb, var(--clay) 20%, transparent)
    );
  }

  /* --- Layout ------------------------------------------------------------ */
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.45fr);
    gap: var(--s-9) var(--s-8);
    padding-bottom: var(--s-9);
  }

  .footer-wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7.5vw, 5.4rem);
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer-with {
    font-weight: 400;
    font-style: italic;
    color: var(--clay);
  }

  .footer-claude {
    font-weight: 700;
  }

  .footer-line {
    margin-top: var(--s-5);
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 500;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .footer-descriptor {
    margin-top: var(--s-3);
    max-width: 34ch;
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .footer-heading {
    margin-bottom: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: var(--border-hair) solid var(--rule);
    color: var(--ink-3);
  }

  .footer-col ul {
    display: grid;
    gap: var(--s-3);
  }

  .footer-col a {
    font-size: var(--t-small);
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--clay);
  }

  .footer-col-note {
    margin-top: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    line-height: 1.6;
    color: var(--ink-3);
  }

  /* --- Social ------------------------------------------------------------- */
  .footer-social {
    padding-bottom: var(--s-8);
  }

  .footer-social .footer-heading {
    max-width: 12rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
  }

  .socials a {
    font-family: var(--font-mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-meta);
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .socials a:hover,
  .socials a:focus-visible {
    color: var(--clay);
  }

  /* --- Base --------------------------------------------------------------- */
  .footer-base {
    display: grid;
    gap: var(--s-4);
    padding-top: var(--s-6);
    border-top: var(--border-hair) solid var(--rule);
  }

  .footer-affiliation {
    max-width: 68ch;
    font-size: var(--t-small);
    color: var(--ink-3);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }

  @media (max-width: 63.99em) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }

  @media (max-width: 34.99em) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }
</style>
