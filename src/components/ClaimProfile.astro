---
/**
 * "Is this you?" — the claim control on a public builder page.
 *
 * ── WHY THIS RENDERS THE SAME FOR EVERYONE ───────────────────────────────
 *
 * `/builders/[slug]` is rendered on the server but publicly cached on the CDN
 * (`publicCache`), so the page cannot know who is reading it — that is what
 * makes it cacheable and it is worth keeping.
 * So the control is rendered identically for every visitor and the browser
 * decides what to do when it is pressed:
 *
 *   signed in     → POST the claim, show the answer in place
 *   not signed in → open the authenticated profile route and sign in
 *
 * The alternative, a personalised render per visitor, would give up that cache
 * to save one redirect.
 *
 * ── WHY IT IS ONLY SHOWN ON UNCLAIMED RECORDS ────────────────────────────
 *
 * `owned` comes from the page's own dataset, so a record somebody already
 * owns simply does not render this. That is a display decision, not a security
 * one — the endpoint refuses a claim on an owned record regardless, because a
 * stale CDN page must never be the thing standing between somebody and another
 * person's profile.
 */
interface Props {
  slug: string;
  name: string;
  /** True when this record already has an owner. Then nothing renders. */
  owned?: boolean;
}

const { slug, name, owned = false } = Astro.props;
---

{
  !owned && (
    <div class="claim js-only" data-claim data-claim-slug={slug}>
      <p class="claim-question">Is this you, {name}?</p>
      <p class="claim-detail">Claim this profile to keep it up to date.</p>
      <button type="button" class="btn btn-sm claim-button" data-claim-button>
        Claim this profile
      </button>
      <p class="claim-status" data-claim-status role="status" aria-live="polite" />
    </div>
  )
}

<script>
  import { claim } from '@/scripts/claim';
  claim();
</script>

<style>
  /* The claim needs the script (it POSTs JSON), so without JS it is not rendered (.js-only). */
  .claim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px var(--s-5);
    padding: 22px 24px;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }
  .claim-question {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-title);
    font-size: var(--t-title);
    font-weight: 600;
    line-height: 1.25;
  }
  .claim-detail {
    grid-column: 1;
    margin: 0;
    color: var(--ink-3);
    font-size: var(--t-small);
  }
  .claim-button {
    grid-column: 2;
    grid-row: 1 / 3;
  }
  .claim-status:empty {
    display: none;
  }
  .claim-status {
    grid-column: 1 / -1;
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: var(--t-small);
  }
  @media (max-width: 639px) {
    .claim {
      grid-template-columns: minmax(0, 1fr);
    }
    .claim-button {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 10px;
    }
  }
</style>
