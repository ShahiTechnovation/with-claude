---
/**
 * The not-found body, shared by the static `/404` page and by every
 * server-rendered route that has to answer 404 itself.
 *
 * SSR routes used to `return Astro.redirect('/404')`, which answers 302 and
 * then 200 — so a removed project looked like a live page to crawlers and
 * link checkers. They now set `Astro.response.status = 404` and render this.
 *
 * No next-event link: /404 is prerendered, so it would go stale.
 */
import PageIntro from '@/components/PageIntro.astro';
import { homeHref } from '@/lib/directory-host';

const routes = [
  { href: '/events/', label: 'Events' },
  { href: '/cities/', label: 'Cities' },
  { href: '/builders/', label: 'Builders' },
  { href: '/projects/', label: 'Projects' },
  { href: '/stories/', label: 'Stories' },
];
---

<PageIntro title="Page not found." size="lg">There is no page at this address.</PageIntro>

<div class="container missing">
  <ul class="missing-links">
    <li>
      <a class="link" href={homeHref(Astro.url.hostname)}>
        Back to the start
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </li>
    {
      routes.map((route) => (
        <li>
          <a class="link" href={route.href}>
            {route.label}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .missing {
    padding-bottom: var(--section-y);
  }

  .missing-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    margin-top: var(--s-5);
  }
</style>
