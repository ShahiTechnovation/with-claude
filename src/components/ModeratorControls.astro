---
import { ModeratorControls as ReactModeratorControls } from '@/components/react/ModeratorControls';

interface Props {
  entityType: 'builders' | 'projects';
  entityId: string;
  initialState: string;
  isModerator: boolean;
}

const { entityType, entityId, initialState, isModerator } = Astro.props;
---

{isModerator && (
  <ReactModeratorControls client:load entityType={entityType} entityId={entityId} initialState={initialState} />
)}
