---
import { Image } from 'astro:assets';
import logoImage from '@/assets/brand/logo.png';
import { site } from '@/data';

/**
 * WITH CLAUDE — the wordmark.
 *
 * Two words, two weights. WITH is the light italic and CLAUDE is the heavy
 * roman, so the relationship reads before the words do: the community is the
 * preposition, not the product. It is set in Fraunces rather than borrowing
 * Anthropic's identity, because this is an independent community site.
 *
 * `with` is the brand's recurring device — WITH PEOPLE, WITH YOUR CITY, MADE
 * WITH CLAUDE. It earns that by being the first word of the name, which is
 * also why it must not be sprayed across every heading.
 */
interface Props {
  layout?: 'inline' | 'stacked';
  /** Show the brand logo alongside. */
  mark?: boolean;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { layout = 'inline', mark = false, size = 'md', class: className = '' } = Astro.props;
const [first, second] = site.wordmark.split(' ');
---

<span class:list={['wm', `wm-${layout}`, `wm-${size}`, className]}>
  {
    mark && (
      <span class="wm-logo-wrap">
        <Image
          src={logoImage}
          alt={`${site.wordmark} logo`}
          width={80}
          height={80}
          class="wm-logo-img"
          loading="eager"
        />
      </span>
    )
  }
  <span class="wm-text">
    <span class="wm-with">{first}</span>
    <span class="wm-claude">{second}</span>
  </span>
</span>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--ink);
  }

  .wm-text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-display);
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .wm-stacked .wm-text {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.02em;
  }

  /* The preposition: light, italic, clay. */
  .wm-with {
    font-weight: 400;
    font-style: italic;
    color: var(--clay-deep);
    letter-spacing: 0.01em;
  }

  /* The subject: heavy, roman, ink. */
  .wm-claude {
    font-weight: 700;
  }

  .wm-sm .wm-text {
    font-size: 1rem;
  }
  .wm-md .wm-text {
    font-size: 1.22rem;
  }
  .wm-lg .wm-text {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  }
  .wm-xl .wm-text {
    font-size: clamp(2.6rem, 7.5vw, 5.4rem);
    letter-spacing: -0.03em;
  }

  /* Logo badge presentation */
  .wm-logo-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border-radius: 50%;
    overflow: hidden;
    background: #000;
    box-shadow:
      0 1px 4px rgba(0, 0, 0, 0.2),
      0 0 0 1px rgba(0, 0, 0, 0.1);
  }

  .wm-logo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .wm-sm .wm-logo-wrap {
    width: 24px;
    height: 24px;
  }

  .wm-md .wm-logo-wrap {
    width: 36px;
    height: 36px;
  }

  .wm-lg .wm-logo-wrap {
    width: 48px;
    height: 48px;
  }

  .wm-xl .wm-logo-wrap {
    width: 64px;
    height: 64px;
  }
</style>
