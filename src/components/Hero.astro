---
/**
 * The first screen, then the room.
 *
 * A screen of sky with three things on it: the claim, the descriptor and one
 * way in. Under it, a full-bleed photograph of the busiest room the record has
 * (the held event with the most projects), captioned with its city.
 *
 * The h1 is at full opacity on the first frame: it only rises and un-blurs. On
 * desktop and on the stage it is the LCP element. On a tall phone the static
 * hero shares its first screen with the photo, which can then be the LCP, so
 * the photo loads eagerly. Every animation sits inside the reduced-motion
 * gate, plays once, and the static state is the finished state.
 *
 * On browsers with scroll timelines (and JS, motion allowed, a tall enough
 * screen) the hero becomes a scroll stage: the copy lifts away, the room opens
 * out of the glow and its caption rises in. Everyone else gets the static
 * hero and band above.
 */
import { Image } from 'astro:assets';
import { site } from '@/data';
import type { PhotoRecordItem, RecordSelectors } from '@/data/selectors';
import { asset } from '@/lib/images';

interface Props {
  selectors: RecordSelectors;
  /** The room band's photograph, chosen by the page (the strip below skips it). */
  room?: PhotoRecordItem;
}

const { selectors, room } = Astro.props;
const next = selectors.nextEvent();
const action = next
  ? { href: '#next', label: 'Join the next event' }
  : { href: '/events/', label: 'See past events' };
const roomImage = room ? asset(room.src) : undefined;
const arrow = 'M4 10h11m-4.5-4.5L15 10l-4.5 4.5';
---

<section class:list={['hero', room && roomImage && 'has-room']} aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-top">
      <div class="sky" aria-hidden="true">
        <i class="beam"></i><i class="haze"></i><i class="sun"></i>
      </div>
      <div class="container hero-copy">
        <h1 id="hero-title" class="t-poster">India is<br />building<span class="dot">.</span></h1>
        <p class="lead">{site.descriptor}</p>
        <a class="btn btn-primary" href={action.href}>
          {action.label}
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path
              d={arrow}
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    {
      room && roomImage && (
        <figure class="room">
          <Image
            src={roomImage}
            alt={room.alt}
            widths={[640, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            decoding="async"
          />
          <figcaption class="container room-cap">
            <p class="room-title">
              Claude&nbsp;Community {selectors.cityName(room.event.citySlug)}
            </p>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--paper);
  }

  .hero-top {
    position: relative;
    display: grid;
    place-items: center;
    min-height: max(560px, calc(100svh - var(--nav-h)));
    overflow: hidden;
    isolation: isolate;
  }

  /* --- The sky ---------------------------------------------------------- */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .sky i {
    position: absolute;
  }

  .sun {
    left: 50%;
    bottom: 0;
    width: max(1500px, 150vw);
    aspect-ratio: 2 / 1;
    border-radius: 50%;
    transform: translate(-50%, 58%);
    background: radial-gradient(
      closest-side,
      rgb(var(--hot) / 0.95) 0%,
      rgb(var(--glow) / 0.9) 16%,
      rgb(var(--glow) / 0.42) 38%,
      rgb(var(--glow) / 0.12) 62%,
      transparent 80%
    );
  }

  :global([data-theme='light']) .sun {
    background: radial-gradient(
      closest-side,
      rgb(var(--hot) / 1) 0%,
      rgb(var(--glow) / 0.85) 16%,
      rgb(var(--glow) / 0.38) 38%,
      rgb(var(--glow) / 0.1) 62%,
      transparent 80%
    );
  }

  .beam {
    top: -35%;
    right: -12%;
    width: 62vw;
    height: 150%;
    transform: rotate(28deg);
    transform-origin: top right;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(var(--hot) / 0.08) 35%,
      rgb(var(--hot) / 0.15) 50%,
      rgb(var(--hot) / 0.06) 65%,
      transparent
    );
    filter: blur(30px);
  }

  .haze {
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(to top, rgb(var(--glow) / 0.16), transparent);
  }

  /* --- The copy --------------------------------------------------------- */
  .hero-copy {
    display: grid;
    justify-items: center;
    gap: 28px;
    padding-block: 48px 14vh;
    text-align: center;
  }

  .hero-copy h1 {
    margin-bottom: 8px;
  }

  .hero-copy .lead {
    max-width: 34ch;
    color: var(--ink-2);
  }

  /* The clay ring drops under 3:1 on the clay glow at desktop widths in dark. */
  .hero-copy .btn:focus-visible {
    outline-color: var(--ink);
  }

  @media (max-width: 640px) {
    /* The static hero (no JS, reduced motion, no scroll timelines, or a short screen) need
       not fill a tall phone: a full screen left a band of plain glow under the button, so
       the photo can start inside the first screen. The scroll stage sets its own height. */
    .hero-top {
      min-height: max(560px, 66svh);
    }

    .hero-copy {
      gap: 22px;
      padding-bottom: 18vh;
    }
  }

  /* --- The room --------------------------------------------------------- */
  .room {
    position: relative;
    height: clamp(420px, 64svh, 680px);
    margin: 0;
    /* clip, not hidden: a scroll container would become the img's view() source and
       the push-in would never move. */
    overflow: clip;
    background: #0c0b0a;
  }

  .room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.06) brightness(0.82);
  }

  .room::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  .room-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(36px, 7vh, 80px);
    z-index: 1;
  }

  /* Cream in both themes: it sits on the photograph's scrim, not the page. The
     size holds "Claude Community" on one line on phones. */
  .room-title {
    color: #faf9f5;
    font-family: var(--font-display);
    font-size: min(clamp(2.75rem, 6.6vw, 6rem), calc((100vw - 2 * var(--gutter)) / 8.7));
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  @media (max-width: 640px) {
    .room {
      height: clamp(360px, 60svh, 520px);
    }
  }

  /* Print is light: the band's dark ground and cream title would print faint on white. */
  @media print {
    .room {
      display: none;
    }
  }

  /* --- Motion: once, on load; the static state is the finished state ---- */
  @media (prefers-reduced-motion: no-preference) {
    .sun {
      animation: sunrise 2.4s var(--ease-cine) backwards;
    }

    /* Transform and filter only: the h1 is never below full opacity. */
    .hero-copy h1 {
      animation: settle 1.2s var(--ease-cine) backwards;
    }

    .hero-copy .lead,
    .hero-copy .btn {
      animation: enter 1.2s var(--ease-cine) 0.25s backwards;
    }

    .hero-copy .btn {
      animation-delay: 0.4s;
    }

    @supports (animation-timeline: view()) {
      .room img {
        animation: push linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }

      /* The scroll stage, from the approved mockup. Behind .js so a page without JS
         keeps the static band, and only where the first screen fits (landscape
         phones would clip the copy), and only when there is a room photo to open onto. The inset starts the timeline under the header,
         so the copy is untouched at scroll 0 and the h1 stays fully opaque. */
      @media screen and (min-height: 640px) {
        :global(.js) .hero.has-room {
          height: 250svh;
          view-timeline: --hero block;
          view-timeline-inset: var(--nav-h) 0px;
        }

        :global(.js) .has-room .hero-stage {
          position: sticky;
          top: var(--nav-h);
          height: calc(100svh - var(--nav-h));
          overflow: clip;
        }

        :global(.js) .has-room .hero-top {
          position: absolute;
          inset: 0;
          min-height: 0;
        }

        :global(.js) .has-room .room {
          position: absolute;
          inset: 0;
          z-index: 1;
          height: auto;
          /* A mask does not stop hit testing: the hidden photo must not eat the button's clicks. */
          pointer-events: none;
          mask-image: radial-gradient(
            ellipse calc(var(--open) * 1.3) var(--open) at 50% 104%,
            #000 58%,
            transparent 100%
          );
          animation: open linear both;
          animation-timeline: --hero;
          animation-range: contain 2% contain 48%;
        }

        :global(.js) .has-room .room img {
          animation: stage-push linear both;
          animation-timeline: --hero;
          animation-range: contain 0% contain 100%;
        }

        :global(.js) .has-room .hero-copy {
          position: relative;
          z-index: 2;
          animation: lift linear both;
          animation-timeline: --hero;
          animation-range: contain 0% contain 30%;
        }

        /* Tabbing to the button after the copy has lifted shows the first screen again:
           with its animation off, --open falls back to 0% and the photo is masked away. */
        :global(.js) .has-room .hero-stage:has(.hero-copy:focus-within) .room {
          animation: none;
        }

        :global(.js) .has-room .hero-copy:focus-within {
          animation: none;
        }

        :global(.js) .has-room .room-cap {
          animation: cap linear both;
          animation-timeline: --hero;
          animation-range: contain 38% contain 60%;
        }
      }
    }
  }

  @property --open {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  /* Transparent until the stage starts to open: a masked photo still paints and would
     take LCP from the h1. Opacity, not visibility, keeps the figure in the
     accessibility tree and in find-in-page. */
  @keyframes open {
    from {
      --open: 0%;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      --open: 200%;
    }
  }

  @keyframes stage-push {
    from {
      transform: scale(1.22);
    }
  }

  @keyframes lift {
    to {
      opacity: 0;
      /* Flips halfway: the faded copy stops taking clicks meant for the photo. */
      pointer-events: none;
      transform: translateY(-12vh) scale(0.96);
      filter: blur(10px);
    }
  }

  @keyframes cap {
    from {
      opacity: 0;
      transform: translateY(5vh);
    }
  }

  @keyframes sunrise {
    from {
      transform: translate(-50%, 66%);
      opacity: 0.55;
    }
  }

  @keyframes settle {
    from {
      transform: translateY(28px);
      filter: blur(12px);
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @keyframes push {
    from {
      transform: scale(1.12);
    }
  }
</style>
