---
/**
 * The first screen, then the room.
 *
 * A screen of sky with three things on it: the claim, the descriptor and one
 * way in. Under it, a full-bleed photograph of the busiest room the record has
 * (the held event with the most projects), captioned with its city.
 *
 * The h1 is at full opacity on the first frame: it only rises and un-blurs. On
 * desktop and on the stage it is the LCP element. On a tall phone the static
 * hero shares its first screen with the photo, which can then be the LCP, so
 * the photo loads eagerly. Every animation sits inside the reduced-motion
 * gate, plays once, and the static state is the finished state.
 *
 * On browsers with scroll timelines (and JS, motion allowed, a tall enough
 * screen) the hero becomes a scroll stage: the copy lifts away, the room opens
 * out of the glow and its caption rises in. Everyone else gets the static
 * hero and band above.
 *
 * Over the sun drifts a clay mist, a WebGL port of polkadot.com's hero shader
 * (noise plus two drifting wisps) without three.js. It eases in on load, then
 * drifts slowly while the hero is on screen; the scroll moves it further.
 * Reduced motion gets one still frame; no WebGL keeps the CSS sun alone.
 *
 * The sky runs up under the masthead's floating glass bar, and the way in is a
 * glass button of the same material (tokens.css), with a lens and a lean
 * toward the pointer from src/scripts/liquid-glass.ts.
 */
import { Image } from 'astro:assets';
import { site } from '@/data';
import type { PhotoRecordItem, RecordSelectors } from '@/data/selectors';
import { asset } from '@/lib/images';

interface Props {
  selectors: RecordSelectors;
  /** The room band's photograph, chosen by the page (the strip below skips it). */
  room?: PhotoRecordItem;
}

const { selectors, room } = Astro.props;
const next = selectors.nextEvent();
const action = next
  ? { href: '#next', label: 'Join the next event' }
  : { href: '/events/', label: 'See past events' };
const roomImage = room ? asset(room.src) : undefined;
const arrow = 'M4 10h11m-4.5-4.5L15 10l-4.5 4.5';
---

<section class:list={['hero', room && roomImage && 'has-room']} aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-top">
      <div class="sky" aria-hidden="true">
        <i class="beam"></i><i class="haze"></i><i class="sun"></i>
        <canvas class="mist"></canvas>
      </div>
      <div class="container hero-copy">
        <h1 id="hero-title" class="t-poster">India is<br />building<span class="dot">.</span></h1>
        <p class="lead">{site.descriptor}</p>
        <a
          class="btn btn-primary glass"
          href={action.href}
          data-lens="lg-apple"
          data-lens-scale="46"
          data-liquid
        >
          {action.label}
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path
              d={arrow}
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    {
      room && roomImage && (
        <figure class="room">
          <Image
            src={roomImage}
            alt={room.alt}
            widths={[640, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            decoding="async"
          />
          <figcaption class="container room-cap">
            <p class="room-title">
              Claude&nbsp;Community {selectors.cityName(room.event.citySlug)}
            </p>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<script>
  import '@/scripts/hero-mist';
</script>

<style>
  /* The sky runs up under the floating glass bar, so there is no seam above the hero and the
     bar has the glow to bend. The copy keeps its place with padding the bar's height. */
  .hero {
    position: relative;
    margin-top: calc(-1 * var(--nav-h));
    background: var(--paper);
  }

  .hero-top {
    position: relative;
    display: grid;
    place-items: center;
    padding-top: var(--nav-h);
    min-height: max(calc(560px + var(--nav-h)), 100svh);
    overflow: hidden;
    isolation: isolate;
  }

  /* --- The sky ---------------------------------------------------------- */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .sky i {
    position: absolute;
  }

  .sun {
    left: 50%;
    bottom: 0;
    width: max(1500px, 150vw);
    aspect-ratio: 2 / 1;
    border-radius: 50%;
    transform: translate(-50%, 58%);
    background: radial-gradient(
      closest-side,
      rgb(var(--hot) / 0.95) 0%,
      rgb(var(--glow) / 0.9) 16%,
      rgb(var(--glow) / 0.42) 38%,
      rgb(var(--glow) / 0.12) 62%,
      transparent 80%
    );
  }

  :global([data-theme='light']) .sun {
    background: radial-gradient(
      closest-side,
      rgb(var(--hot) / 1) 0%,
      rgb(var(--glow) / 0.85) 16%,
      rgb(var(--glow) / 0.38) 38%,
      rgb(var(--glow) / 0.1) 62%,
      transparent 80%
    );
  }

  .beam {
    top: -35%;
    right: -12%;
    width: 62vw;
    height: 150%;
    transform: rotate(28deg);
    transform-origin: top right;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(var(--hot) / 0.08) 35%,
      rgb(var(--hot) / 0.15) 50%,
      rgb(var(--hot) / 0.06) 65%,
      transparent
    );
    filter: blur(30px);
  }

  .haze {
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(to top, rgb(var(--glow) / 0.16), transparent);
  }

  /* The shader's strength is the --mist token. */
  .mist {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .mist.is-on {
    opacity: 1;
  }

  @media print {
    .mist {
      display: none;
    }
  }

  /* --- The copy --------------------------------------------------------- */
  .hero-copy {
    display: grid;
    justify-items: center;
    gap: 28px;
    padding-block: 48px 14vh;
    text-align: center;
  }

  .hero-copy h1 {
    margin-bottom: 8px;
  }

  .hero-copy .lead {
    max-width: 34ch;
    color: var(--ink-2);
  }

  /* The clay ring drops under 3:1 on the clay glow at desktop widths in dark. */
  .hero-copy .btn:focus-visible {
    outline-color: var(--ink);
  }

  /* --- The glass button ------------------------------------------------
     Clear glass over the glow (batch 019): the backdrop a little blurred and lifted, the shared
     rim, depth and shadow (tokens.css), and a light that follows the pointer. In Chromium,
     liquid-glass.ts draws a lens at the button's real size and sets html.lg-lens; there the rim
     bends what passes under it. Elsewhere, and with JS off, it is frosted glass. */
  .btn.glass {
    --bf: blur(5px) saturate(1.35) brightness(1.03);
    border-color: transparent;
    /* A warm light low in the glass, as if the glow below were caught in it: on narrow screens
       the button sits above the glow, and without it the button read as a dark outlined pill. */
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.07),
      rgb(255 255 255 / 0.01) 45%,
      rgb(var(--glow) / 0.2)
    );
    color: var(--ink);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.4);
    box-shadow:
      var(--glass-depth),
      inset 0 -14px 18px -12px rgb(var(--glow) / 0.55),
      inset 0 0 14px rgb(255 255 255 / 0.05),
      var(--glass-drop);
    backdrop-filter: var(--bf);
    /* The liquid motion: liquid-glass.ts sets the lean (--lx, --ly) and the stretch (--lsx,
       --lsy), and the spring is the transition, so a release or a leave wobbles and settles.
       This selector outweighs the primary's hover lift, so no state replaces the transform. */
    transform: translate(var(--lx, 0px), var(--ly, 0px)) scale(var(--lsx, 1), var(--lsy, 1));
    transition:
      transform 0.9s var(--spring),
      color 0.25s ease;
  }

  .btn.glass.is-pressed {
    transition:
      transform 0.14s ease-out,
      color 0.25s ease;
  }

  :global(html.lg-lens) .btn.glass {
    --bf: blur(1px) url(#lg-apple) saturate(1.35) brightness(1.03);
  }

  :global([data-theme='light']) .btn.glass {
    --bf: blur(5px) saturate(1.3) brightness(1.03);
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.42),
      rgb(255 255 255 / 0.16) 45%,
      rgb(var(--glow) / 0.16)
    );
    text-shadow: 0 1px 1px rgb(255 255 255 / 0.5);
    box-shadow:
      var(--glass-depth),
      inset 0 -14px 18px -12px rgb(var(--glow) / 0.3),
      var(--glass-drop);
  }

  :global(html.lg-lens[data-theme='light']) .btn.glass {
    --bf: blur(1px) url(#lg-apple) saturate(1.3) brightness(1.03);
  }

  /* The specular rim: a gradient border, bright where the light hits the curve. It stays on hover,
     where the primary would swap its glow layers. */
  .btn.glass::before {
    inset: -1px;
    padding: 1.25px;
    opacity: 1;
    box-shadow: none;
    background: var(--glass-rim);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  /* The light under the finger: follows the pointer, blooms on press. Kept low, as it sits right
     behind the label: at 0.22 hover measured 4.29:1. */
  .btn.glass::after {
    inset: -1px;
    opacity: 0;
    background: radial-gradient(
      110px circle at var(--mx, 50%) var(--my, 20%),
      rgb(255 255 255 / 0.1),
      transparent 70%
    );
    box-shadow: 0 16px 48px -16px rgb(var(--glow) / 0.5);
  }

  .btn.glass:hover::after {
    opacity: 1;
  }

  .btn.glass:active::after {
    opacity: 1;
    background: radial-gradient(
      150px circle at var(--mx, 50%) var(--my, 20%),
      rgb(255 255 255 / 0.16),
      transparent 72%
    );
  }

  /* Solid where glass cannot be read: no backdrop-filter (the build drops the -webkit- prefix, so
     that includes Safari before 18), or reduced transparency asked for. An opaque clay fill with the
     primary's dark label (5.9:1); `.hero-copy` in front outweighs the light theme's glass. */
  @supports not (backdrop-filter: blur(1px)) {
    .hero-copy .btn.glass {
      background: var(--clay);
      color: var(--btn-ink);
      text-shadow: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero-copy .btn.glass {
      background: var(--clay);
      color: var(--btn-ink);
      text-shadow: none;
      backdrop-filter: none;
    }
  }

  @media (max-width: 640px) {
    /* The static hero (no JS, reduced motion, no scroll timelines, or a short screen) need
       not fill a tall phone: a full screen left a band of plain glow under the button, so
       the photo can start inside the first screen. The scroll stage sets its own height. */
    .hero-top {
      min-height: max(calc(560px + var(--nav-h)), calc(66svh + var(--nav-h)));
    }

    .hero-copy {
      gap: 22px;
      padding-bottom: 18vh;
    }
  }

  /* --- The room --------------------------------------------------------- */
  .room {
    position: relative;
    height: clamp(420px, 64svh, 680px);
    margin: 0;
    /* clip, not hidden: a scroll container would become the img's view() source and
       the push-in would never move. */
    overflow: clip;
    background: #141413;
  }

  .room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.06) brightness(0.82);
  }

  .room::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  .room-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(36px, 7vh, 80px);
    z-index: 1;
  }

  /* Cream in both themes: it sits on the photograph's scrim, not the page. The
     size holds "Claude Community" on one line on phones. */
  .room-title {
    color: #faf9f5;
    font-family: var(--font-display);
    font-size: min(clamp(2.75rem, 6.6vw, 6rem), calc((100vw - 2 * var(--gutter)) / 8.7));
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  @media (max-width: 640px) {
    .room {
      height: clamp(360px, 60svh, 520px);
    }
  }

  /* Print is light: the band's dark ground and cream title would print faint on white. */
  @media print {
    .room {
      display: none;
    }
  }

  /* --- Motion: once, on load; the static state is the finished state ---- */
  @media (prefers-reduced-motion: no-preference) {
    .sun {
      animation: sunrise 2.4s var(--ease-cine) backwards;
    }

    .mist {
      transition: opacity 2.4s var(--ease-cine);
    }

    /* Transform and filter only: the h1 is never below full opacity. Split in two so
       the transform runs on the compositor; a blur cannot. */
    .hero-copy h1 {
      animation:
        settle 1.2s var(--ease-cine) backwards,
        settle-blur 1.2s var(--ease-cine) backwards;
    }

    .hero-copy .lead,
    .hero-copy .btn {
      animation: enter 1.2s var(--ease-cine) 0.25s backwards;
    }

    .hero-copy .btn {
      animation-delay: 0.4s;
    }

    @supports (animation-timeline: view()) {
      .room img {
        animation: push linear both;
        animation-duration: auto;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }

      /* The scroll stage, from the approved mockup. Behind .js so a page without JS
         keeps the static band, and only where the first screen fits (landscape
         phones would clip the copy), and only when there is a room photo to open onto.
         The stage starts at the top of the page, under the glass bar, so the copy is
         untouched at scroll 0 and the h1 stays fully opaque. The inset is written out:
         `auto` would take the page's scroll-padding. */
      @media screen and (min-height: 640px) {
        :global(.js) .hero.has-room {
          height: 250svh;
          view-timeline: --hero block;
          view-timeline-inset: 0px 0px;
        }

        /* The glass bar (Masthead.astro) is clear over the sky and has its readable tint
           back before the room reaches it: measured, the photo shows under the bar from
           about 25% of the stage. timeline-scope lets the bar, outside the hero, follow
           the hero's timeline. */
        :global(html.js body:has(.hero.has-room)) {
          timeline-scope: --hero;
        }

        :global(html.js body:has(.hero.has-room) .masthead-inner) {
          animation: bar-tint linear both;
          animation-duration: auto;
          animation-timeline: --hero;
          animation-range: contain 12% contain 26%;
        }

        :global(.js) .has-room .hero-stage {
          position: sticky;
          top: 0;
          height: 100svh;
          overflow: clip;
        }

        :global(.js) .has-room .hero-top {
          position: absolute;
          inset: 0;
          min-height: 0;
        }

        :global(.js) .has-room .room {
          position: absolute;
          inset: 0;
          z-index: 1;
          height: auto;
          /* A mask does not stop hit testing: the hidden photo must not eat the button's clicks. */
          pointer-events: none;
          mask-image: radial-gradient(
            ellipse calc(var(--open) * 1.3) var(--open) at 50% 104%,
            #000 58%,
            transparent 100%
          );
          animation: open linear both;
          animation-duration: auto;
          animation-timeline: --hero;
          animation-range: contain 2% contain 48%;
        }

        :global(.js) .has-room .room img {
          animation: stage-push linear both;
          animation-duration: auto;
          animation-timeline: --hero;
          animation-range: contain 0% contain 100%;
        }

        /* Only the move and the pointer-events flip stay on the copy: in Chrome a running
           opacity or filter animation on the glass button's container cuts its backdrop,
           and the button would show nothing behind it. The fade and the blur move to the
           words and to the button itself (their own opacity and filter cut nothing), each
           after its entrance in one list. Separate keyframe sets: the blur and the flip
           cannot run on the compositor, and sharing keyframes with them would keep the
           move and the fade on the main thread too. Those lists hold a `var()`, which the
           build's minifier leaves alone, so they take no `animation-duration: auto`: it
           would zero their timed entrances. */
        :global(.js) .has-room .hero-copy {
          position: relative;
          z-index: 2;
          animation:
            lift-move linear both,
            lift-hit linear both;
          animation-duration: auto;
          animation-timeline: --hero;
          animation-range: contain 0% contain 30%;
        }

        :global(.js) .has-room .hero-copy h1 {
          animation:
            settle 1.2s var(--ease-cine) backwards,
            settle-blur 1.2s var(--ease-cine) backwards,
            lift-fade linear both,
            lift-blur linear both;
          animation-timeline: auto, auto, --hero, --hero;
          animation-range:
            normal,
            normal,
            contain 0% contain 30%,
            contain 0% contain 30%;
        }

        :global(.js) .has-room .hero-copy .lead {
          animation:
            enter 1.2s var(--ease-cine) 0.25s backwards,
            lift-fade linear both,
            lift-blur linear both;
          animation-timeline: auto, --hero, --hero;
          animation-range:
            normal,
            contain 0% contain 30%,
            contain 0% contain 30%;
        }

        :global(.js) .has-room .hero-copy .btn {
          animation:
            enter 1.2s var(--ease-cine) 0.4s backwards,
            lift-fade linear both,
            lift-blur linear both;
          animation-timeline: auto, --hero, --hero;
          animation-range:
            normal,
            contain 0% contain 30%,
            contain 0% contain 30%;
        }

        /* Tabbing to the button after the copy has lifted shows the first screen again:
           with its animation off, --open falls back to 0% and the photo is masked away. */
        :global(.js) .has-room .hero-stage:has(.hero-copy:focus-within) .room {
          animation: none;
        }

        :global(.js) .has-room .hero-copy:focus-within,
        :global(.js) .has-room .hero-copy:focus-within :is(h1, .lead, .btn) {
          animation: none;
        }

        :global(.js) .has-room .room-cap {
          animation: cap linear both;
          animation-duration: auto;
          animation-timeline: --hero;
          animation-range: contain 38% contain 60%;
        }
      }
    }
  }

  @property --open {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  /* Transparent until the stage starts to open: a masked photo still paints and would
     take LCP from the h1. Opacity, not visibility, keeps the figure in the
     accessibility tree and in find-in-page. */
  @keyframes open {
    from {
      --open: 0%;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      --open: 200%;
    }
  }

  @keyframes stage-push {
    from {
      transform: scale(1.22);
    }
  }

  /* How clear the bar is (Masthead.astro registers --bar-clear): clear over the sky, readable
     before the room photo reaches it. */
  @keyframes bar-tint {
    from {
      --bar-clear: 1;
    }

    to {
      --bar-clear: 0;
    }
  }

  @keyframes lift-move {
    to {
      transform: translateY(-12vh) scale(0.96);
    }
  }

  @keyframes lift-fade {
    to {
      opacity: 0;
    }
  }

  @keyframes lift-blur {
    to {
      filter: blur(10px);
    }
  }

  /* Flips halfway: the faded copy stops taking clicks meant for the photo. */
  @keyframes lift-hit {
    to {
      pointer-events: none;
    }
  }

  @keyframes cap {
    from {
      opacity: 0;
      transform: translateY(5vh);
    }
  }

  @keyframes sunrise {
    from {
      transform: translate(-50%, 66%);
      opacity: 0.55;
    }
  }

  @keyframes settle {
    from {
      transform: translateY(28px);
    }
  }

  @keyframes settle-blur {
    from {
      filter: blur(12px);
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }

  @keyframes push {
    from {
      transform: scale(1.12);
    }
  }
</style>
