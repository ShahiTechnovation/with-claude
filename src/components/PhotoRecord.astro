---
import { Image } from 'astro:assets';
import { cityName, photoRecord, stories } from '@/data';
import { dateParts } from '@/lib/datetime';
import { requireAsset } from '@/lib/images';

/**
 * FROM THE FLOOR.
 *
 * Until written recaps exist, the editorial archive runs on the photographic
 * record — real rooms, original captions, plate numbers. A horizontal set of
 * plates you scroll through, not an autoplaying carousel: no timers, no
 * hover-only affordances, and it works with a trackpad, a finger, or Tab.
 */
const plates = photoRecord();
const hasStories = stories.length > 0;
---

<div class="floor">
  <div class="container-wide floor-head rail-pad">
    <div class="section-head">
      <p class="section-index">07 — Stories</p>
      <h2 id="stories-heading">From the floor</h2>
      <p class="prose">
        {
          hasStories
            ? 'Dispatches from the community.'
            : 'Written dispatches are coming. Until then, the record is photographic — every frame below is from a room that actually happened.'
        }
      </p>
    </div>
    <p class="label floor-hint">
      <span aria-hidden="true">←→</span> Scroll the plates
    </p>
  </div>

  <ul class="floor-track" tabindex="0" aria-label="Photographs from past events, scrollable">
    {
      plates.map((plate) => {
        const parts = dateParts(plate.event.date);
        return (
          <li class="floor-item">
            <figure>
              <div class="plate plate-zoom">
                <Image
                  src={requireAsset(plate.src)}
                  alt={plate.alt}
                  widths={[380, 620, 900]}
                  sizes="(max-width: 47.99em) 78vw, 420px"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="plate-caption floor-caption">
                <span class="floor-plate-no">{`Pl. ${plate.plate}`}</span>
                <span class="floor-where">{plate.event.title}</span>
                <span class="floor-when">
                  {`${cityName(plate.event.citySlug)} · ${parts.monthShort} ${parts.year}`}
                </span>
              </figcaption>
            </figure>
          </li>
        );
      })
    }

    <li class="floor-item floor-item-end">
      <div class="floor-end">
        <p class="floor-end-copy">
          Were you in one of these rooms? The archive wants your photographs and your write-up.
        </p>
        <a class="link-arrow" href="https://t.me/tog_guild" target="_blank" rel="noopener">
          <span>Send them in</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </li>
  </ul>
</div>

<style>
  /* Distance from the viewport edge to the content column. */
  .floor {
    /* 100% is this band's own width, so no scrollbar drift. */
    --edge: max(var(--gutter), calc((100% - var(--measure-wide)) / 2 + var(--gutter)));
    --track-pad: var(--gutter);
  }

  .floor-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .floor-head .section-head {
    margin-bottom: var(--s-6);
  }

  .floor-hint {
    color: var(--ink-3);
    margin-bottom: var(--s-7);
  }

  @media (min-width: 64em) {
    .rail-pad {
      padding-left: calc(var(--gutter) + var(--rail));
    }
  }

  .floor-track {
    display: flex;
    gap: var(--s-5);
    padding-inline: var(--track-pad);
    padding-bottom: var(--s-4);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    /* Without this the snap container scrolls its own leading padding away and
       clips the first plate against the viewport edge. */
    scroll-padding-left: var(--track-pad);
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
    overscroll-behavior-x: contain;
  }

  .floor-track:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  .floor-item {
    flex: 0 0 auto;
    width: min(78vw, 420px);
    scroll-snap-align: start;
  }

  .floor-item .plate {
    aspect-ratio: 3 / 2;
  }

  /* Alternate the plate heights so the row reads as a contact sheet laid out
     by hand rather than a grid of equal tiles. */
  .floor-item:nth-child(3n + 2) .plate {
    aspect-ratio: 4 / 5;
  }

  .floor-item:nth-child(3n + 2) {
    width: min(62vw, 320px);
    align-self: flex-end;
  }

  .floor-caption {
    display: grid;
    gap: 1px;
  }

  .floor-plate-no {
    color: var(--clay-deep);
    font-variant-numeric: tabular-nums;
  }

  .floor-where {
    color: var(--ink-2);
  }

  /* --- Closing panel ---------------------------------------------------- */
  .floor-item-end {
    width: min(72vw, 300px);
    display: flex;
    align-items: center;
  }

  .floor-end {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-5);
    border-left: var(--border-rule) solid var(--clay);
  }

  .floor-end-copy {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 400;
    font-variation-settings:
      'SOFT' 0,
      'WONK' 1;
    line-height: 1.25;
    color: var(--ink-2);
  }

  /* The track bleeds to the right edge but its first plate must line up with
     every other section's content column. */
  @media (min-width: 62em) {
    .floor {
      --track-pad: var(--edge);
    }

    .floor-track {
      gap: var(--s-6);
    }
  }

  @media (min-width: 64em) {
    .floor {
      --track-pad: calc(var(--edge) + var(--rail));
    }
  }
</style>
