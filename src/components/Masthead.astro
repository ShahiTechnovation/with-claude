---
import Wordmark from './Wordmark.astro';
import { site } from '@/data';
import AccountNav from '@/components/AccountNav.astro';
import { homeHref, signInHref } from '@/lib/directory-host';

interface Props {
  /** Route prefix of the current page, e.g. `/events`. */
  active?: string;
}

const { active = '/' } = Astro.props;
// The main site's homepage, also from projects.withclaude.in (where `/` is the directory).
const home = homeHref(Astro.url.hostname);

/**
 * Primary navigation.
 *
 * Five entries. Practice/use-cases, guides, stories, and the record are
 * reachable from their own pages and the footer — they do not need a header
 * slot. The rule: if it is not where someone starts, it is not here.
 */
// `active` is a slash-less route prefix ('/events'), so it is compared with its slash added.
const current = (href: string) => `${active}/`.startsWith(href);
const nav = [
  { href: '/events/', label: 'Events' },
  { href: '/cities/', label: 'Cities' },
  { href: '/builders/', label: 'Builders' },
  { href: '/projects/', label: 'Projects' },
  { href: '/gallery/', label: 'Gallery' },
];
---

<header class="masthead" data-masthead>
  <div class="masthead-inner container">
    <a href={home} class="brand" aria-label={`${site.wordmark} — home`}>
      <Wordmark mark size="sm" />
    </a>

    <nav class="nav-links" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <a
        href="/discover/"
        class="icon-btn nav-search"
        aria-current={current('/discover/') ? 'page' : undefined}
        aria-label="Search"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="9" cy="9" r="5.6" fill="none" stroke="currentColor" stroke-width="1.6"
          ></circle>
          <path d="M13.2 13.2L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></path>
        </svg>
      </a>

      {/* Hidden without JS (nothing could switch it) and on the locked-light account pages. */}
      <button
        class="icon-btn js-only theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
      >
        <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <path
            d="M10 2.5v1.8M10 15.7v1.8M2.5 10h1.8M15.7 10h1.8M4.7 4.7l1.3 1.3M14 14l1.3 1.3M4.7 15.3L6 14M14 6l1.3-1.3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M15.8 12.6A6.6 6.6 0 0 1 7.4 4.2a6.6 6.6 0 1 0 8.4 8.4z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      {/* The one account slot, at every width: PrivyRoot portals into it by id. */}
      <AccountNav />

      {/* Under 900px. A <details>, so it opens with JS off; Sign in is a plain link. */}
      <details class="menu">
        <summary class="icon-btn">
          <span class="visually-hidden">Menu</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M3.5 7h13M3.5 13h13"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="menu-sheet">
          <nav aria-label="Primary, mobile">
            <ul>
              <li>
                <a href="/discover/" aria-current={current('/discover/') ? 'page' : undefined}
                  >Search</a
                >
              </li>
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a class="btn menu-signin" href={signInHref(Astro.url.hostname)} data-account-signin
            >Sign in</a
          >
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--nav-h);
    /* --nav-bg is 95% paper: the --ink-3 links keep AA over photos and white embeds
       scrolling under the bar. */
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
    border-bottom: 1px solid var(--rule);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .masthead {
      background: var(--paper);
    }
  }

  /* A blurred ancestor is the containing block of a fixed child: drop the blur so the
     sheet covers the viewport, not the 60px bar. */
  .masthead:has(.menu[open]) {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: var(--paper);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
  }

  .brand {
    display: flex;
    flex: none;
    text-decoration: none;
  }

  /* The root's scroll-padding-top covers this bar, so Chrome counts a focused control in
     it as hidden and scrolls the page to it: the sticky bar stays, the content jumps.
     Move each control's scroll area below that padding. The sheet scrolls on its own. */
  .masthead-inner :global(:is(a, button, summary):not(.menu-sheet *)) {
    scroll-margin-top: calc(-1 * (var(--nav-h) + 1rem));
  }

  /* --- Desktop nav ------------------------------------------------------ */
  .nav-links {
    margin-left: auto;
  }

  .nav-links ul {
    display: flex;
    gap: 30px;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding-block: 10px;
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1;
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--ink);
  }

  .nav-links a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--clay);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-search[aria-current] {
    border-color: var(--ink);
  }

  .theme-toggle .i-moon,
  :global([data-theme='light']) .theme-toggle .i-sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle .i-moon {
    display: block;
  }

  /* --- Phone menu --------------------------------------------------------- */
  .menu {
    display: none;
  }

  .menu summary {
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-sheet {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    height: calc(100dvh - var(--nav-h));
    display: flex;
    flex-direction: column;
    padding: 24px var(--gutter) 40px;
    overflow-y: auto;
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .menu-sheet a:not(.btn) {
    display: block;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
  }

  /* Not colour alone: the same underline as the bar. */
  .menu-sheet a[aria-current] {
    color: var(--clay-deep);
    text-decoration: underline 1px var(--clay);
    text-underline-offset: 8px;
  }

  .menu-signin {
    width: 100%;
    margin-top: auto;
  }

  /* Gone once a member is signed in: their badge is in the bar. */
  .masthead:has(
      .account-slot:not(
        [data-account-state='anonymous'],
        [data-account-state='loading'],
        [data-account-state='unavailable']
      )
    )
    .menu-signin {
    display: none;
  }

  @media (max-width: 899.98px) {
    .masthead-inner {
      gap: 12px;
    }

    .nav-links,
    .nav-search {
      display: none;
    }

    .nav-actions {
      gap: 8px;
      margin-left: auto;
    }

    .menu {
      display: block;
    }

    /* Without JS nothing sets `inert`: hide the page under the open sheet so Tab
       cannot land on links it covers. */
    :global(body:has(.masthead .menu[open]) > :is(.skip-link, main, footer)) {
      visibility: hidden;
    }
  }
</style>

<script>
  /**
   * The theme toggle (the only writer of `wc-theme`; Base.astro's head script reads it
   * before first paint) and the phone menu's keyboard exits.
   */
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function syncTheme() {
    const light = root.dataset.theme === 'light';
    toggle?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
    if (themeColor) themeColor.content = light ? '#FAF9F5' : '#0C0B0A';
  }

  syncTheme();
  // A page restored from the back/forward cache, or a choice made in another tab, skips
  // the head script: read the saved theme again.
  function rereadTheme() {
    if (root.hasAttribute('data-theme-lock')) return;
    try {
      const t = localStorage.getItem('wc-theme');
      if (t === 'light' || t === 'dark') root.dataset.theme = t;
    } catch {
      // Storage blocked: keep the current theme.
    }
    syncTheme();
  }
  addEventListener('pageshow', (e) => e.persisted && rereadTheme());
  addEventListener('storage', (e) => e.key === 'wc-theme' && rereadTheme());
  toggle?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem('wc-theme', root.dataset.theme);
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    syncTheme();
  });

  const menu = document.querySelector<HTMLDetailsElement>('[data-masthead] details.menu');
  const summary = menu?.querySelector('summary');
  if (menu && summary) {
    let tabbed = false;
    document.addEventListener('pointerdown', () => (tabbed = false));
    document.addEventListener('keydown', (e) => {
      tabbed = e.key === 'Tab';
      if (e.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      summary.focus();
    });
    // Tab never lands on the page hidden under the sheet. Read where focus went after
    // the move (focusout's relatedTarget is sometimes null); a click on the sheet's
    // blank space leaves focus on <body> and keeps the menu open; Tab past the last item
    // also lands on <body> (the page behind is inert), and that closes it.
    menu.addEventListener('focusout', () => {
      setTimeout(() => {
        const now = document.activeElement;
        if (menu.open && now && (tabbed || now !== document.body) && !menu.contains(now))
          menu.open = false;
      });
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches) menu.open = false;
    });
    // Every close goes through menu.open, so this frees the page on all paths: no
    // scrolling the page under the sheet, and screen readers stay in the sheet. Lock body,
    // not <html>: body's overflow-x makes it its own scroller once <html> is not visible,
    // and the sticky bar would then stick to the unscrolled body, off screen.
    menu.addEventListener('toggle', () => {
      const behind = document.querySelectorAll<HTMLElement>('body > :is(.skip-link, main, footer)');
      for (const el of behind) el.inert = menu.open;
      document.body.style.overflow = menu.open ? 'hidden' : '';
    });
  }

  // Under 900px the bar's account slot is hidden while signed out, so the sheet's Sign in
  // stands in for PrivyRoot's live button. account-boot only catches it before Privy has
  // booted (and then prevents the default); after that, hand the tap to the live button
  // instead of following the no-JS href.
  const signin = document.querySelector<HTMLAnchorElement>('[data-masthead] .menu-signin');
  const slotRoot = document.getElementById('account-slot-root');
  signin?.addEventListener('click', (e) => {
    if (e.defaultPrevented) return;
    const live = slotRoot?.querySelector<HTMLElement>('.account-slot .account-join');
    if (!live) return;
    e.preventDefault();
    if (live.matches('.account-placeholder')) return; // Privy is still loading.
    if (menu) menu.open = false;
    live.click();
  });
  // account-boot relabels the link "Opening sign-in…"; once PrivyRoot has rendered, put it back.
  if (signin && slotRoot) {
    new MutationObserver(() => {
      if (!slotRoot.querySelector('.account-slot') || !signin.hasAttribute('aria-busy')) return;
      signin.removeAttribute('aria-busy');
      signin.textContent = 'Sign in';
    }).observe(slotRoot, { childList: true, subtree: true });
  }
</script>
