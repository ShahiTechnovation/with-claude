---
import Wordmark from './Wordmark.astro';
import { site } from '@/data';
import AccountNav from '@/components/AccountNav.astro';
import { homeHref, signInHref } from '@/lib/directory-host';

interface Props {
  /** Route prefix of the current page, e.g. `/events`. */
  active?: string;
}

const { active = '/' } = Astro.props;
// The main site's homepage, also from projects.withclaude.in (where `/` is the directory).
const home = homeHref(Astro.url.hostname);

/**
 * Primary navigation.
 *
 * Six entries. Practice/use-cases, guides, stories, and the record are
 * reachable from their own pages and the footer — they do not need a header
 * slot. The rule: if it is not where someone starts, it is not here.
 */
// `active` is a slash-less route prefix ('/events'), so it is compared with its slash added.
// The hash is dropped so Community (`/community/#involved`) still marks /community as current.
const current = (href: string) => `${active}/`.startsWith(href.split('#')[0]);
const nav = [
  { href: '/events/', label: 'Events' },
  { href: '/cities/', label: 'Cities' },
  { href: '/builders/', label: 'Builders' },
  { href: '/projects/', label: 'Projects' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/community/#involved', label: 'Community' },
];
---

<header class="masthead" data-masthead>
  <div class="masthead-inner container" data-lens="lg-lens-nav" data-lens-scale="30">
    <a href={home} class="brand" aria-label={`${site.wordmark} — home`}>
      <Wordmark mark size="sm" />
    </a>

    <nav class="nav-links" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <a
        href="/discover/"
        class="icon-btn nav-search"
        aria-current={current('/discover/') ? 'page' : undefined}
        aria-label="Search"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="9" cy="9" r="5.6" fill="none" stroke="currentColor" stroke-width="1.6"
          ></circle>
          <path d="M13.2 13.2L17 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></path>
        </svg>
      </a>

      {/* Hidden without JS: nothing could switch it. */}
      <button
        class="icon-btn js-only theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
      >
        <svg class="i-sun" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
          <path
            d="M10 2.5v1.8M10 15.7v1.8M2.5 10h1.8M15.7 10h1.8M4.7 4.7l1.3 1.3M14 14l1.3 1.3M4.7 15.3L6 14M14 6l1.3-1.3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <svg class="i-moon" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M15.8 12.6A6.6 6.6 0 0 1 7.4 4.2a6.6 6.6 0 1 0 8.4 8.4z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
      </button>

      {/* The one account slot, at every width: PrivyRoot portals into it by id. */}
      <AccountNav />

      {/* Under 1024px. A <details>, so it opens with JS off; Sign in is a plain link. */}
      <details class="menu">
        <summary class="icon-btn">
          <span class="visually-hidden">Menu</span>
          <svg class="i-menu" viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M3.5 7h13M3.5 13h13"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
          <svg class="i-close" viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M5 5l10 10M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <div class="menu-sheet">
          <nav aria-label="Primary, mobile">
            <ul>
              <li>
                <a href="/discover/" aria-current={current('/discover/') ? 'page' : undefined}
                  >Search</a
                >
              </li>
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a class="btn menu-signin" href={signInHref(Astro.url.hostname)} data-account-signin
            >Sign in</a
          >
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* How clear the bar is: 0 readable, 1 clear. Registered so it can animate and transition. */
  @property --bar-clear {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  /* The bar is a floating liquid-glass capsule. The band around it is clear and lets clicks
     through to the page. */
  .masthead {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    height: var(--nav-h);
    pointer-events: none;
  }

  .masthead-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    /* The capsule's content lines up with the page container; on narrow screens it keeps 12px
       of air from the screen edge instead. */
    width: min(calc(100% - 2 * var(--gutter) + 2 * 16px), calc(100% - 24px));
    max-width: calc(var(--measure) + 2 * 16px);
    height: calc(100% - 14px);
    padding-inline: 16px 7px;
    border-radius: var(--radius-pill);
    pointer-events: auto;
    /* --bar-clear runs from 0 (the readable bar: a light tint and a dimmed backdrop keep the
       links at AA over a white photo) to 1 (clear glass, over the home hero's sky, where the
       links need no help). Hero.astro drives it with the scroll stage; `bar-over-sky` (the
       script below) does without it. Declared here as well as registered: Firefox before 128
       has backdrop-filter but not @property, and without a value every tint, blur and shadow
       below dropped out, leaving the bar see-through. */
    --bar-clear: 0;
    --bar-dim: calc(0.55 + 0.45 * var(--bar-clear));
    --bar-sat: 1.5;
    /* The brand end's frost (::after below). A plain custom property, so the pseudo-element
       inherits it: --bar-clear itself is registered not to inherit. */
    --brand-frost: calc(0.8 - 0.6 * var(--bar-clear));
    background: linear-gradient(
      180deg,
      rgb(20 20 19 / calc(0.22 - 0.2 * var(--bar-clear))),
      rgb(20 20 19 / calc(0.34 - 0.3 * var(--bar-clear)))
    );
    backdrop-filter: blur(6px) saturate(var(--bar-sat)) brightness(var(--bar-dim));
    box-shadow:
      var(--glass-depth),
      0 10px 28px -12px rgb(0 0 0 / calc(0.5 - 0.34 * var(--bar-clear))),
      0 2px 6px -2px rgb(0 0 0 / calc(0.3 - 0.2 * var(--bar-clear)));
    transition: --bar-clear 0.5s var(--ease-out);
  }

  :global(html.bar-over-sky) .masthead-inner {
    --bar-clear: 1;
  }

  /* Chromium only (liquid-glass.ts sets html.lg-lens): the rim bends what passes under the bar. */
  :global(html.lg-lens) .masthead-inner {
    backdrop-filter: blur(3px) url(#lg-lens-nav) saturate(var(--bar-sat)) brightness(var(--bar-dim));
  }

  /* The specular rim (tokens.css), lit from the top left. */
  .masthead-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: var(--glass-rim);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  /* The brand end frosts over with the page colour as the bar turns readable: "WITH" is clay, and
     clay on clear glass over a busy photo fell to 2:1. At 80% it measured 4.91:1 or better over
     the home page and the gallery, in both themes. Over the hero's sky it thins to 20%, which
     does not show there and lifts "WITH" from 4.72 to 4.98 on a phone. The frost covers the
     wordmark (which ends 168px into the capsule on phones, 183px wider); over plain page it
     matches the page. z-index -1 keeps it under the content, inside the glass's stacking
     context; a solid bar covers it. */
  .masthead-inner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--paper) calc(var(--brand-frost) * 100%), transparent) 195px,
      transparent 245px
    );
  }

  /* Over a black photo the cream tint alone has to carry the dark links: 52% is the floor for
     4.5:1. */
  :global([data-theme='light']) .masthead-inner {
    --bar-dim: calc(1.5 - 0.48 * var(--bar-clear));
    --bar-sat: 1.3;
    background: linear-gradient(
      180deg,
      rgb(250 249 245 / calc(0.52 - 0.34 * var(--bar-clear))),
      rgb(250 249 245 / calc(0.62 - 0.4 * var(--bar-clear)))
    );
    box-shadow:
      var(--glass-depth),
      0 10px 28px -12px rgb(120 50 30 / calc(0.3 - 0.08 * var(--bar-clear))),
      0 2px 6px -2px rgb(120 50 30 / calc(0.18 - 0.04 * var(--bar-clear)));
  }

  /* The controls inside the glass have no outlines of their own, like a toolbar: icons are bare,
     Sign in is a faint pill, and both fill a little on hover. The phone sheet keeps its own. */
  .masthead-inner :global(:is(.icon-btn, .btn, .account-join):not(.menu-sheet *)) {
    border-color: transparent;
  }

  .masthead-inner :global(:is(.btn, .account-join):not(.menu-sheet *)) {
    background: rgb(255 255 255 / 0.08);
  }

  .masthead-inner :global(:is(.icon-btn, .btn, .account-join):not(.menu-sheet *):hover) {
    border-color: transparent;
    background: rgb(255 255 255 / 0.14);
  }

  :global([data-theme='light'])
    .masthead-inner
    :global(:is(.btn, .account-join):not(.menu-sheet *)) {
    background: rgb(20 20 19 / 0.05);
  }

  :global([data-theme='light'])
    .masthead-inner
    :global(:is(.icon-btn, .btn, .account-join):not(.menu-sheet *):hover) {
    background: rgb(20 20 19 / 0.09);
  }

  /* Solid where glass cannot be read: no backdrop-filter (the build drops the -webkit- prefix,
     so that includes Safari before 18), reduced transparency asked for, or print (the dimmed
     backdrop printed a grey bar). `.masthead` in front outweighs the light theme's tint and the
     lens. */
  @supports not (backdrop-filter: blur(1px)) {
    .masthead .masthead-inner {
      background: var(--paper);
    }
  }

  @media print, (prefers-reduced-transparency: reduce) {
    .masthead .masthead-inner {
      backdrop-filter: none;
      background: var(--paper);
    }
  }

  /* A blurred ancestor is the containing block of a fixed child: drop the glass so the
     sheet covers the viewport, not the bar. */
  .masthead:has(.menu[open]) .masthead-inner {
    backdrop-filter: none;
    background: var(--paper);
  }

  /* Without :has() (Firefox before 121, Chrome before 105) the rule above never matches and the
     open sheet is boxed in the capsule, so there the bar stays solid. */
  @supports not selector(:has(*)) {
    .masthead .masthead-inner {
      backdrop-filter: none;
      background: var(--paper);
    }
  }

  .brand {
    display: flex;
    flex: none;
    text-decoration: none;
  }

  /* The root's scroll-padding-top covers this bar, so Chrome counts a focused control in
     it as hidden and scrolls the page to it: the sticky bar stays, the content jumps.
     Move each control's scroll area below that padding. The sheet scrolls on its own. */
  .masthead-inner :global(:is(a, button, summary):not(.menu-sheet *)) {
    scroll-margin-top: calc(-1 * (var(--nav-h) + 1rem));
  }

  /* --- Desktop nav ------------------------------------------------------ */
  .nav-links {
    margin-left: auto;
  }

  .nav-links ul {
    display: flex;
    gap: 30px;
  }

  .nav-links a {
    position: relative;
    display: block;
    padding-block: 10px;
    font-family: var(--font-title);
    font-size: var(--t-small);
    font-weight: 600;
    line-height: 1;
    /* --ink on the clear glass (was --ink-3), with a soft shadow: AA over bright photos passing
       under the bar. */
    color: var(--ink);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
    text-decoration: none;
  }

  :global([data-theme='light']) .nav-links a {
    text-shadow: 0 1px 1px rgb(255 255 255 / 0.6);
  }

  /* Every link is --ink, so the current page is its clay line, and hover shows it fainter. */
  .nav-links a[aria-current]::after,
  .nav-links a:hover::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--clay);
  }

  .nav-links a:hover:not([aria-current])::after {
    background: rgb(var(--glow) / 0.55);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Its ring marks the current page: `.masthead-inner` in front outweighs the bare toolbar look. */
  .masthead-inner .nav-search[aria-current] {
    border-color: var(--ink);
  }

  /* The sun turns a little under a real pointer (the icon's transition is in primitives.css). */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .theme-toggle:hover svg {
      rotate: 24deg;
    }
  }

  .theme-toggle .i-moon,
  :global([data-theme='light']) .theme-toggle .i-sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle .i-moon {
    display: block;
  }

  /* --- Phone menu --------------------------------------------------------- */
  .menu {
    display: none;
  }

  .menu summary {
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  /* Two bars shut, a cross open: CSS on [open], so it holds with JS off too. */
  .menu .i-close,
  .menu[open] .i-menu {
    display: none;
  }

  .menu[open] .i-close {
    display: block;
  }

  .menu-sheet {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    height: calc(100dvh - var(--nav-h));
    display: flex;
    flex-direction: column;
    padding: 24px var(--gutter) 40px;
    overflow-y: auto;
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .menu-sheet a:not(.btn) {
    display: block;
    padding-block: 14px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
  }

  /* Not colour alone: the same underline as the bar. */
  .menu-sheet a[aria-current] {
    color: var(--clay-deep);
    text-decoration: underline 1px var(--clay);
    text-underline-offset: 8px;
  }

  .menu-signin {
    width: 100%;
    margin-top: auto;
  }

  /* Gone once a member is signed in: their badge is in the bar. */
  .masthead:has(
      .account-slot:not(
        [data-account-state='anonymous'],
        [data-account-state='loading'],
        [data-account-state='unavailable']
      )
    )
    .menu-signin {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .masthead-inner {
      gap: 12px;
    }

    .nav-links,
    .nav-search {
      display: none;
    }

    .nav-actions {
      gap: 8px;
      margin-left: auto;
    }

    .menu {
      display: block;
    }

    /* Without JS nothing sets `inert`: hide the page under the open sheet so Tab
       cannot land on links it covers. */
    :global(body:has(.masthead .menu[open]) > :is(.skip-link, main, footer)) {
      visibility: hidden;
    }

    /* Astro's dev toolbar (dev server only) would float over the sheet's Sign in. */
    :global(body:has(.masthead .menu[open]) > astro-dev-toolbar) {
      visibility: hidden;
    }
  }
</style>

<script>
  /**
   * The theme toggle (the only writer of `wc-theme`; Base.astro's head script reads it
   * before first paint) and the phone menu's keyboard exits.
   */
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function syncTheme() {
    const light = root.dataset.theme === 'light';
    toggle?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
    if (themeColor) themeColor.content = light ? '#FAF9F5' : '#141413';
  }

  syncTheme();
  // A page restored from the back/forward cache, or a choice made in another tab, skips
  // the head script: read the saved theme again.
  function rereadTheme() {
    try {
      const t = localStorage.getItem('wc-theme');
      if (t === 'light' || t === 'dark') root.dataset.theme = t;
    } catch {
      // Storage blocked: keep the current theme.
    }
    syncTheme();
  }
  addEventListener('pageshow', (e) => e.persisted && rereadTheme());
  addEventListener('storage', (e) => e.key === 'wc-theme' && rereadTheme());
  const flipTheme = () => {
    root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem('wc-theme', root.dataset.theme);
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    syncTheme();
  };
  // The two themes cross-fade, as pages do (motion.css), where the browser can and motion is wanted.
  toggle?.addEventListener('click', () => {
    if (
      'startViewTransition' in document &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches
    )
      document.startViewTransition(flipTheme);
    else flipTheme();
  });

  const menu = document.querySelector<HTMLDetailsElement>('[data-masthead] details.menu');
  const summary = menu?.querySelector('summary');
  if (menu && summary) {
    let tabbed = false;
    document.addEventListener('pointerdown', () => (tabbed = false));
    document.addEventListener('keydown', (e) => {
      tabbed = e.key === 'Tab';
      if (e.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      summary.focus();
    });
    // Tab never lands on the page hidden under the sheet. Read where focus went after
    // the move (focusout's relatedTarget is sometimes null); a click on the sheet's
    // blank space leaves focus on <body> and keeps the menu open; Tab past the last item
    // also lands on <body> (the page behind is inert), and that closes it.
    menu.addEventListener('focusout', () => {
      setTimeout(() => {
        const now = document.activeElement;
        if (menu.open && now && (tabbed || now !== document.body) && !menu.contains(now))
          menu.open = false;
      });
    });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) menu.open = false;
    });
    // Every close goes through menu.open, so this frees the page on all paths: no
    // scrolling the page under the sheet, and screen readers stay in the sheet. Lock body,
    // not <html>: body's overflow-x makes it its own scroller once <html> is not visible,
    // and the sticky bar would then stick to the unscrolled body, off screen.
    menu.addEventListener('toggle', () => {
      const behind = document.querySelectorAll<HTMLElement>('body > :is(.skip-link, main, footer)');
      for (const el of behind) el.inert = menu.open;
      document.body.style.overflow = menu.open ? 'hidden' : '';
    });
  }

  // Under 1024px the bar's account slot is hidden while signed out, so the sheet's Sign in
  // stands in for PrivyRoot's live button. account-boot only catches it before Privy has
  // booted (and then prevents the default); after that, hand the tap to the live button
  // instead of following the no-JS href. While Privy is still loading there is no live
  // button yet, so the tap follows the href to the /me/ sign-in gate.
  const signin = document.querySelector<HTMLAnchorElement>('[data-masthead] .menu-signin');
  const slotRoot = document.getElementById('account-slot-root');
  signin?.addEventListener('click', (e) => {
    if (e.defaultPrevented) return;
    const live = slotRoot?.querySelector<HTMLElement>('.account-slot .account-join');
    if (!live || live.matches('.account-placeholder')) return;
    e.preventDefault();
    if (menu) menu.open = false;
    live.click();
  });
  // account-boot relabels the link "Opening sign-in…"; once PrivyRoot has rendered, put it back.
  if (signin && slotRoot) {
    new MutationObserver(() => {
      if (!slotRoot.querySelector('.account-slot') || !signin.hasAttribute('aria-busy')) return;
      signin.removeAttribute('aria-busy');
      signin.textContent = 'Sign in';
    }).observe(slotRoot, { childList: true, subtree: true });
  }
</script>

<script>
  // The lens for the bar and the hero's button (every [data-lens] on the page), and the hero
  // button's lean. Imported here so every page has it.
  import '@/scripts/liquid-glass';

  // Home without the scroll stage (reduced motion, no scroll timelines, a short screen): the bar
  // is clear only at the top of the page. There the headline does not lift away, so a clear bar
  // would let it slide under the links (measured 1.05:1); the readable bar takes over after 40px.
  // With the stage, Hero.astro's scroll-driven animation decides instead and overrides this.
  if (document.querySelector('.hero-top')) {
    const mark = () => document.documentElement.classList.toggle('bar-over-sky', scrollY < 40);
    addEventListener('scroll', mark, { passive: true });
    mark();
  }
</script>
